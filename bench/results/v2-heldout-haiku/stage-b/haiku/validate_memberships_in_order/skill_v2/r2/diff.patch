+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Ensure that every position requiring a membership uses a membership of ``customer`` that is allowed for the
+    position and can still be used. Raises a ``ValidationError`` otherwise.
+
+    ``lock`` locks the membership rows until the surrounding transaction ends, so that concurrent orders cannot
+    both use the last remaining usage. ``ignored_order`` is excluded from the usage count, which is needed when
+    an existing order is changed. ``valid_from_not_chosen`` only checks that the membership has not ended, which
+    is used when the customer has not yet picked the start date of the ticket.
+    """
+    error_missing = _('Your cart includes a product that requires an active membership to be selected.')
+    if any(p.used_membership_id and not _requires_membership(p) for p in positions):
+        raise ValidationError(_('A membership cannot be used for a product that does not require one.'))
+
+    applicable = [p for p in positions if _requires_membership(p)]
+    if not applicable:
+        return
+
+    if customer is None:
+        raise ValidationError(error_missing)
+
+    membership_ids = {p.used_membership_id for p in applicable if p.used_membership_id}
+
+    with transaction.atomic():
+        if lock and membership_ids:
+            # Lock in a fixed order to avoid deadlocks between concurrent checkouts
+            list(customer.memberships.select_for_update(of=OF_SELF).filter(pk__in=membership_ids).order_by('pk'))
+
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order).select_related('membership_type').filter(
+                pk__in=membership_ids
+            )
+        }
+
+        usages_in_batch = Counter()
+        for p in applicable:
+            m = memberships.get(p.used_membership_id)
+            if m is None:
+                raise ValidationError(error_missing)
+
+            if p.variation and p.variation.require_membership:
+                allowed_types = p.variation.require_membership_types
+            else:
+                allowed_types = p.item.require_membership_types
+            if m.testmode != testmode or not allowed_types.filter(pk=m.membership_type_id).exists():
+                raise ValidationError(error_missing)
+
+            # Same rule as MembershipForm: a dynamic start choice of the item also skips the start date check
+            if not m.is_valid(p.subevent or event, p.valid_from,
+                              valid_from_not_chosen=valid_from_not_chosen or p.item.validity_dynamic_start_choice):
+                raise ValidationError(error_missing)
+
+            usages_in_batch[m.pk] += 1
+            max_usages = m.membership_type.max_usages
+            if max_usages is not None and m.usages + usages_in_batch[m.pk] > max_usages:
+                raise ValidationError(_('The selected membership has already been used for the maximum number of '
+                                        'products allowed by its membership type.'))
+
+
