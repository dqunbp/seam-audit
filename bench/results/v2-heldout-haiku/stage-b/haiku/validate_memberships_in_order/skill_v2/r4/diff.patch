+
+
+@pytest.mark.django_db
+def test_validate_memberships_parallel_usage(event, customer, membership, requiring_ticket):
+    order = Order.objects.create(event=event, status=Order.STATUS_PAID, customer=customer,
+                                 expires=now() + timedelta(days=3),
+                                 sales_channel=event.organizer.sales_channels.get(identifier="web"),
+                                 total=4)
+    OrderPosition.objects.create(order=order, item=requiring_ticket, price=23, used_membership=membership)
+    position = _cart_position(requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [position], event)
+
+    membership.membership_type.allow_parallel_usage = True
+    membership.membership_type.save()
+    validate_memberships_in_order(customer, [position], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_parallel_usage_within_cart(event, customer, membership, requiring_ticket):
+    with pytest.raises(ValidationError):
