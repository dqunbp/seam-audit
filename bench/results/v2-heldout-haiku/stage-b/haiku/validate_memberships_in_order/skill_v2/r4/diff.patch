+
+
+def _cart_position(item, membership, **kwargs):
+    return CartPosition(
+        item=item, price=23, expires=now() + timedelta(days=1), event=item.event, cart_id="123",
+        used_membership=membership, **kwargs
+    )
+
+
+@pytest.mark.django_db
+def test_validate_memberships_valid(event, customer, membership, requiring_ticket):
+    validate_memberships_in_order(customer, [_cart_position(requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_ignores_positions_without_requirement(event, customer, granting_ticket):
+    validate_memberships_in_order(customer, [_cart_position(granting_ticket, None)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_missing(event, customer, requiring_ticket):
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(customer, [_cart_position(requiring_ticket, None)], event)
+    assert 'membership' in excinfo.value.message
+
+
+@pytest.mark.django_db
+def test_validate_memberships_other_customer(event, customer, membership, requiring_ticket):
+    other = event.organizer.customers.create(email="jane@example.org")
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(other, [_cart_position(requiring_ticket, membership)], event)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(None, [_cart_position(requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_type_not_allowed(event, customer, membership, requiring_ticket):
+    membership.membership_type = event.organizer.membership_types.create(name="Other")
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_testmode_mismatch(event, customer, membership, requiring_ticket):
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(requiring_ticket, membership)], event, testmode=True)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_canceled(event, customer, membership, requiring_ticket):
+    membership.canceled = True
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_not_valid_for_event(event, customer, membership, requiring_ticket):
+    membership.date_start -= timedelta(days=100)
+    membership.date_end -= timedelta(days=100)
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_valid_from_not_chosen(event, customer, membership, requiring_ticket):
+    # Membership has not ended yet, but does not cover the event date
+    membership.date_start = now() - timedelta(days=1)
+    membership.date_end = now() + timedelta(days=30)
+    membership.save()
+    position = _cart_position(requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [position], event)
+    validate_memberships_in_order(customer, [position], event, valid_from_not_chosen=True)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_usage_limit_existing_order(event, customer, membership, requiring_ticket):
+    membership.membership_type.max_usages = 1
+    membership.membership_type.save()
+    order = Order.objects.create(event=event, status=Order.STATUS_PAID, customer=customer,
+                                 expires=now() + timedelta(days=3),
+                                 sales_channel=event.organizer.sales_channels.get(identifier="web"),
+                                 total=4)
+    OrderPosition.objects.create(order=order, item=requiring_ticket, price=23, used_membership=membership)
+
+    position = _cart_position(requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [position], event)
+    # The order itself does not count against its own usages, e.g. when its positions are changed
+    validate_memberships_in_order(customer, [position], event, ignored_order=order)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_usage_limit_within_cart(event, customer, membership, requiring_ticket):
+    membership.membership_type.max_usages = 1
+    membership.membership_type.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [
+            _cart_position(requiring_ticket, membership),
+            _cart_position(requiring_ticket, membership),
