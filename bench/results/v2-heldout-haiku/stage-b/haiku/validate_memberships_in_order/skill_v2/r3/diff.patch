+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order]=None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Ensures that every position requiring a membership references a membership of ``customer`` that is allowed
+    for the position's product and still valid for it. Raises a ``ValidationError`` otherwise.
+
+    :param lock: Lock the memberships involved, so that concurrent purchases cannot both use the last usage. Must be
+                 called within a transaction.
+    :param ignored_order: Usages by this order are not counted, e.g. because it is being changed right now.
+    :param testmode: Only memberships in the same mode (test or live) as the order can be used.
+    :param valid_from_not_chosen: The start of validity has not been chosen yet, so only the end date is checked.
+    """
+    missing_msg = _('Your cart includes a product that requires an active membership to be selected.')
+    invalid_msg = _('The membership you selected for "{item}" is not valid for this product.')
+
+    def requires_membership(p):
+        return p.item.require_membership or bool(p.variation and p.variation.require_membership)
+
+    memberships = {}
+    if customer:
+        if lock:
+            lock_objects(list(customer.memberships.filter(
+                pk__in={p.used_membership_id for p in positions if p.used_membership_id}
+            )))
+
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order=ignored_order).filter(
+                canceled=False,
+                testmode=testmode,
+            ).select_related('membership_type')
+        }
+
+    # Usages by the positions being validated right now are not in the database yet, so they are counted here
+    used_in_batch = Counter()
+    for p in positions:
+        if not requires_membership(p):
+            if p.used_membership_id:
+                raise ValidationError(invalid_msg.format(item=str(p.item)))
+            continue
+
+        if not p.used_membership_id:
+            raise ValidationError(missing_msg)
+
+        m = memberships.get(p.used_membership_id)
+        if p.variation and p.variation.require_membership:
+            types = p.variation.require_membership_types.all()
+        else:
+            types = p.item.require_membership_types.all()
+
+        ev = p.subevent or event
+        if m is None or m.membership_type not in types or not m.is_valid(
+            ev, ticket_valid_from=p.valid_from, valid_from_not_chosen=valid_from_not_chosen
+        ):
+            raise ValidationError(invalid_msg.format(item=str(p.item)))
+
+        used_in_batch[m.pk] += 1
+        if m.membership_type.max_usages is not None and m.usages + used_in_batch[m.pk] > m.membership_type.max_usages:
+            raise ValidationError(_('The membership you selected for "{item}" has no usages left.').format(
+                item=str(p.item),
+            ))
