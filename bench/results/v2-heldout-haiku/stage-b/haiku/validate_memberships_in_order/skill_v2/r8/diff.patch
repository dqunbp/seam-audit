+def _position_validity(position: AbstractPosition) -> Tuple[Optional[datetime], Optional[datetime]]:
+    # Order changes set override_valid_from/until on the positions they check, see OrderChangeManager
+    if hasattr(position, 'override_valid_from'):
+        return position.override_valid_from, position.override_valid_until
+    return position.valid_from, position.valid_until
+
+
+def _usage_window(valid_from, valid_until, ev: Union[Event, SubEvent]) -> Tuple[Optional[datetime], Optional[datetime]]:
+    # Positions with a product-level validity occupy that time frame, positions without one occupy the start of the event
+    if valid_from is None and valid_until is None:
+        return ev.date_from, ev.date_from
+    return valid_from, valid_until
+
+
+def _windows_overlap(a, b) -> bool:
+    # A window boundary of None means open-ended
+    return (a[0] is None or b[1] is None or a[0] <= b[1]) and (b[0] is None or a[1] is None or b[0] <= a[1])
+
+
+def _format_window_part(dt: Optional[datetime], open_label) -> str:
+    if dt is None:
+        return str(open_label)
+    return date_format(dt, 'SHORT_DATETIME_FORMAT')
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order=None, testmode=False, valid_from_not_chosen=False):
+    """
+    Checks that all positions requiring a membership use a membership of ``customer`` that may be used for them, and
+    that no other position refers to a membership. Raises a ``ValidationError`` with a user-facing message for the
+    first problem found.
+
+    :param customer: The customer the memberships need to belong to, or ``None`` if there is no customer account.
+    :param positions: The cart or order positions to check.
+    :param event: The event the positions belong to.
+    :param lock: Lock the used memberships for update until the surrounding transaction ends.
+    :param ignored_order: Usages by this order are not counted, e.g. because the order is being changed.
+    :param testmode: Whether the positions are in test mode.
+    :param valid_from_not_chosen: The start date of the ticket is not chosen yet, so only the membership's end date is
+                                  checked against it.
+    """
+    used_ids = sorted({p.used_membership_id for p in positions if p.used_membership_id})
+    if lock and used_ids:
+        # Ordered by primary key to prevent deadlocks between concurrent purchases
+        list(Membership.objects.select_for_update(of=OF_SELF).filter(pk__in=used_ids).order_by('pk'))
+
+    memberships = {
+        m.pk: m for m in Membership.objects.with_usages(ignored_order=ignored_order).filter(pk__in=used_ids)
+    }
+
+    existing_windows = defaultdict(list)
+    if used_ids:
+        qs = OrderPosition.all.filter(
+            used_membership_id__in=used_ids, canceled=False,
+        ).exclude(order__status=Order.STATUS_CANCELED).select_related('subevent', 'order__event')
+        if ignored_order:
+            qs = qs.exclude(order_id=ignored_order.pk)
+        for op in qs:
+            ev = op.subevent or op.order.event
+            existing_windows[op.used_membership_id].append(_usage_window(op.valid_from, op.valid_until, ev))
+
+    batch_windows = defaultdict(list)
+    for pos in positions:
+        item = pos.item
+        variation = pos.variation
+        product = str(item)
+
+        requires_membership = item.require_membership or (variation and variation.require_membership)
+        if not requires_membership:
+            if pos.used_membership_id:
+                raise ValidationError(
+                    _('You selected a membership for the product "{product}" which does not require a membership.').format(
+                        product=product,
+                    )
+                )
+            continue
+
+        if not pos.used_membership_id:
+            raise ValidationError(
+                _('You selected the product "{product}" which requires an active membership to be selected.').format(
+                    product=product,
+                )
+            )
+
+        membership = memberships[pos.used_membership_id]
+        if customer is None or membership.customer_id != customer.pk:
+            raise ValidationError(_('You selected a membership that is connected to a different customer account.'))
+        if membership.canceled:
+            raise ValidationError(_('You selected membership that has been canceled.'))
+        if membership.testmode and not testmode:
+            raise ValidationError(
+                _('You can not use a test mode membership for tickets that are not in test mode.')
+            )
+        if testmode and not membership.testmode:
+            raise ValidationError(
+                _('You need to add a test mode membership to the customer account to use it in test mode.')
+            )
+
+        if variation and variation.require_membership:
+            types = variation.require_membership_types.all()
+        else:
+            types = item.require_membership_types.all()
+        if membership.membership_type not in types:
+            raise ValidationError(
+                _('You selected a membership of type "{type}", which is not allowed for the product "{product}".').format(
+                    type=str(membership.membership_type), product=product,
+                )
+            )
+
+        ev = pos.subevent or event
+        valid_from, valid_until = _position_validity(pos)
+        if valid_from_not_chosen:
+            valid = membership.is_valid(valid_from_not_chosen=True)
+        else:
+            valid = membership.is_valid(ev, valid_from)
+        if not valid:
+            if valid_from is not None:
+                raise ValidationError(
+                    _('You selected a membership that is valid from {start} to {end}, but selected a ticket that starts '
+                      'to be valid on {date}.').format(
+                        start=date_format(membership.date_start, 'SHORT_DATE_FORMAT'),
+                        end=date_format(membership.date_end, 'SHORT_DATE_FORMAT'),
+                        date=date_format(valid_from, 'SHORT_DATETIME_FORMAT'),
+                    )
+                )
+            raise ValidationError(
+                _('You selected a membership that is valid from {start} to {end}, but selected an event taking place '
+                  'at {date}.').format(
+                    start=date_format(membership.date_start, 'SHORT_DATE_FORMAT'),
+                    end=date_format(membership.date_end, 'SHORT_DATE_FORMAT'),
+                    date=date_format(ev.date_from, 'SHORT_DATETIME_FORMAT'),
+                )
+            )
+
+        if membership.membership_type.max_usages is not None:
+            if membership.usages + len(batch_windows[membership.pk]) + 1 > membership.membership_type.max_usages:
+                raise ValidationError(
+                    _('You are trying to use a membership of type "{type}" more than {number} times, which is the '
+                      'maximum amount.').format(
+                        type=str(membership.membership_type),
+                        number=membership.membership_type.max_usages,
+                    )
+                )
+
+        window = _usage_window(valid_from, valid_until, ev)
+        if not membership.membership_type.allow_parallel_usage:
+            for other in existing_windows[membership.pk] + batch_windows[membership.pk]:
+                if not _windows_overlap(window, other):
+                    continue
+                if valid_from is None and valid_until is None:
+                    raise ValidationError(
+                        _('You are trying to use a membership of type "{type}" for an event taking place at {date}, '
+                          'however you already used the same membership for a different ticket at the same time.').format(
+                            type=str(membership.membership_type),
+                            date=date_format(ev.date_from, 'SHORT_DATETIME_FORMAT'),
+                        )
+                    )
+                raise ValidationError(
+                    _('You are trying to use a membership of type "{type}" for a ticket valid from {valid_from} until '
+                      '{valid_until}, however you already used the same membership for a different ticket that overlaps '
+                      'with this time frame ({conflict_from} – {conflict_until}).').format(
+                        type=str(membership.membership_type),
+                        valid_from=_format_window_part(valid_from, _('start')),
+                        valid_until=_format_window_part(valid_until, _('open end')),
+                        conflict_from=_format_window_part(other[0], _('start')),
+                        conflict_until=_format_window_part(other[1], _('open end')),
+                    )
+                )
+
+        batch_windows[membership.pk].append(window)
+
+
