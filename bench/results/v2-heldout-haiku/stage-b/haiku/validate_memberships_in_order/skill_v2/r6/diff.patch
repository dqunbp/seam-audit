+def _ticket_validity(position):
+    """
+    Returns the product-level ``(valid_from, valid_until)`` of a position, both ``None`` if it has none. Order changes
+    set ``override_valid_from`` and ``override_valid_until`` on their fake cart positions, which take precedence.
+    """
+    valid_from = position.override_valid_from if hasattr(position, 'override_valid_from') else position.valid_from
+    valid_until = position.override_valid_until if hasattr(position, 'override_valid_until') else position.valid_until
+    return valid_from, valid_until
+
+
+def _time_window(valid_from, valid_until, ev):
+    """
+    Returns the ``(start, end)`` a ticket occupies, falling back to the event date if there is no product-level validity.
+    ``end`` is ``None`` for an open end.
+    """
+    if valid_until:
+        end = valid_until
+    elif valid_from:
+        end = None
+    else:
+        end = ev.date_to or ev.date_from
+    return valid_from or ev.date_from, end
+
+
+def _format_dt(dt, event, default):
+    if dt is None:
+        return default
+    return date_format(dt.astimezone(event.timezone), 'SHORT_DATETIME_FORMAT')
+
+
+def _windows_overlap(a, b):
+    (a_start, a_end), (b_start, b_end) = a, b
+    return (a_end is None or b_start <= a_end) and (b_end is None or a_start <= b_end)
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order=None, testmode=False, valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that is allowed for it, and
+    raises a ``ValidationError`` with a user-facing message otherwise.
+
+    :param customer: The customer the memberships must belong to, or ``None``.
+    :param positions: Cart or order positions to check.
+    :param event: The event the positions belong to, used for event-based validity.
+    :param lock: Lock the used membership rows. Must be called within a transaction.
+    :param ignored_order: An order whose existing usages are not counted, e.g. when it is being changed.
+    :param testmode: Whether the purchase is in test mode.
+    :param valid_from_not_chosen: The start of the validity is not chosen yet, so only the membership's expiry is
+                                  checked and overlaps are not evaluated.
+    """
+    used_ids = {p.used_membership_id for p in positions if p.used_membership_id}
+    memberships = {}
+    if customer and used_ids:
+        if lock:
+            list(customer.memberships.select_for_update(of=OF_SELF).filter(pk__in=used_ids).order_by('pk'))
+        memberships = {
+            m.pk: m for m in customer.memberships.filter(pk__in=used_ids).with_usages(ignored_order)
+        }
+
+    cart_usages = Counter()
+    cart_windows = {}  # membership id -> list of (window, window_based) of the cart positions using it
+    for position in positions:
+        item = position.item
+        variation = position.variation
+        if variation and variation.require_membership:
+            requires = True
+            types = variation.require_membership_types.all()
+        else:
+            requires = item.require_membership
+            types = item.require_membership_types.all()
+
+        if not position.used_membership_id:
+            if requires:
+                raise ValidationError(
+                    _('You selected the product "{product}" which requires an active membership to be selected.').format(
+                        product=str(item),
+                    )
+                )
+            continue
+
+        if not requires:
+            raise ValidationError(
+                _('You selected a membership for the product "{product}" which does not require a membership.').format(
+                    product=str(item),
+                )
+            )
+
+        membership = memberships.get(position.used_membership_id)
+        if membership is None or membership.customer_id != customer.pk:
+            raise ValidationError(_('You selected a membership that is connected to a different customer account.'))
+        if membership.canceled:
+            raise ValidationError(_('You selected membership that has been canceled.'))
+        if membership.testmode and not testmode:
+            raise ValidationError(_('You can not use a test mode membership for tickets that are not in test mode.'))
+        if not membership.testmode and testmode:
+            raise ValidationError(
+                _('You need to add a test mode membership to the customer account to use it in test mode.')
+            )
+        if membership.membership_type_id not in {t.pk for t in types}:
+            raise ValidationError(
+                _('You selected a membership of type "{type}", which is not allowed for the product "{product}".').format(
+                    type=str(membership.membership_type),
+                    product=str(item),
+                )
+            )
+
+        ev = position.subevent or event
+        valid_from, valid_until = _ticket_validity(position)
+        window = _time_window(valid_from, valid_until, ev)
+        product_validity = valid_from is not None or valid_until is not None
+        if not membership.is_valid(ev, ticket_valid_from=valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            if valid_from:
+                raise ValidationError(
+                    _('You selected a membership that is valid from {start} to {end}, but selected a ticket that starts '
+                      'to be valid on {date}.').format(
+                        start=_format_dt(membership.date_start, event, _('start')),
+                        end=_format_dt(membership.date_end, event, _('open end')),
+                        date=_format_dt(valid_from, event, _('start')),
+                    )
+                )
+            raise ValidationError(
+                _('You selected a membership that is valid from {start} to {end}, but selected an event taking place '
+                  'at {date}.').format(
+                    start=_format_dt(membership.date_start, event, _('start')),
+                    end=_format_dt(membership.date_end, event, _('open end')),
+                    date=_format_dt(ev.date_from, event, _('start')),
+                )
+            )
+
+        if not valid_from_not_chosen:
+            # Parallel usage of a membership is only exempt for event-based tickets; product-level validity is always checked
+            other_windows = list(cart_windows.get(membership.pk, []))
+            existing = OrderPosition.all.filter(
+                used_membership=membership, canceled=False,
+            ).exclude(order__status=Order.STATUS_CANCELED).select_related('order__event', 'subevent')
+            if ignored_order:
+                existing = existing.exclude(order=ignored_order)
+            for op in existing:
+                op_from, op_until = _ticket_validity(op)
+                other_windows.append((
+                    _time_window(op_from, op_until, op.subevent or op.order.event),
+                    op_from is not None or op_until is not None,
+                ))
+            for other, other_product_validity in other_windows:
+                if membership.membership_type.allow_parallel_usage and not product_validity and not other_product_validity:
+                    continue
+                if not _windows_overlap(window, other):
+                    continue
+                if product_validity:
+                    raise ValidationError(
+                        _('You are trying to use a membership of type "{type}" for a ticket valid from {valid_from} until '
+                          '{valid_until}, however you already used the same membership for a different ticket that overlaps '
+                          'with this time frame ({conflict_from} – {conflict_until}).').format(
+                            type=str(membership.membership_type),
+                            valid_from=_format_dt(valid_from, event, _('start')),
+                            valid_until=_format_dt(valid_until, event, _('open end')),
+                            conflict_from=_format_dt(other[0], event, _('start')),
+                            conflict_until=_format_dt(other[1], event, _('open end')),
+                        )
+                    )
+                raise ValidationError(
+                    _('You are trying to use a membership of type "{type}" for an event taking place at {date}, however '
+                      'you already used the same membership for a different ticket at the same time.').format(
+                        type=str(membership.membership_type),
+                        date=_format_dt(ev.date_from, event, _('start')),
+                    )
+                )
+
+        cart_windows.setdefault(membership.pk, []).append((window, product_validity))
+        cart_usages[membership.pk] += 1
+        max_usages = membership.membership_type.max_usages
+        if max_usages is not None and membership.usages + cart_usages[membership.pk] > max_usages:
+            raise ValidationError(
+                _('You are trying to use a membership of type "{type}" more than {number} times, which is the maximum '
+                  'amount.').format(type=str(membership.membership_type), number=max_usages)
+            )
+
+
