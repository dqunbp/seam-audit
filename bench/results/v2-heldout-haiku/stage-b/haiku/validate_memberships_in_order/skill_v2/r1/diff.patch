+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _allowed_membership_type_ids(position: AbstractPosition) -> Set[int]:
+    if position.variation and position.variation.require_membership:
+        types = position.variation.require_membership_types.all()
+    else:
+        types = position.item.require_membership_types.all()
+    return {t.pk for t in types}
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Ensures that every position requiring a membership uses a membership of ``customer`` that is valid for that
+    position. Raises a ``ValidationError`` otherwise.
+
+    The memberships are read from ``used_membership`` on the positions themselves, so this works for cart positions
+    whose selection has not been saved yet. Usages by existing positions of ``ignored_order`` are not counted, which
+    lets an order change re-validate its own positions. With ``lock=True``, the membership rows are locked so that
+    concurrent purchases using the same membership cannot both pass the usage check. The caller must be inside a
+    transaction in that case.
+    """
+    membership_ids = {p.used_membership_id for p in positions if p.used_membership_id}
+    if not membership_ids and not any(_requires_membership(p) for p in positions):
+        return
+
+    if lock and customer and membership_ids:
+        list(
+            Membership.objects.select_for_update(of=OF_SELF).filter(pk__in=membership_ids).values_list('pk', flat=True)
+        )
+
+    # Memberships of other customers are simply absent from this mapping and are rejected below
+    memberships = {}
+    if customer:
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order).select_related('membership_type').filter(
+                pk__in=membership_ids,
+            )
+        }
+
+    # Existing usages on the same start time, only needed for memberships that do not allow parallel usage
+    serial_ids = {
+        pk for pk, m in memberships.items() if not m.membership_type.allow_parallel_usage
+    }
+    existing_starts = defaultdict(set)
+    if serial_ids:
+        with scopes_disabled():
+            ops = OrderPosition.all.filter(
+                used_membership_id__in=serial_ids,
+                canceled=False,
+            ).exclude(
+                order__status=Order.STATUS_CANCELED,
+            ).select_related('subevent', 'order__event')
+            if ignored_order:
+                ops = ops.exclude(order=ignored_order)
+            for op in ops:
+                existing_starts[op.used_membership_id].add((op.subevent or op.order.event).date_from)
+
+    batch_usages = Counter()
+    batch_starts = defaultdict(set)
+    for p in positions:
+        if not _requires_membership(p):
+            # A membership is only usable for products that list its type as a requirement
+            if p.used_membership_id:
+                raise ValidationError(_('The membership selected for "{item}" cannot be used for this product.').format(
+                    item=p.item,
+                ))
+            continue
+
+        if not p.used_membership_id:
+            raise ValidationError(_('The product "{item}" requires a valid membership, but none has been selected.').format(
+                item=p.item,
+            ))
+
+        m = memberships.get(p.used_membership_id)
+        if m is None or m.testmode != testmode or m.canceled:
+            raise ValidationError(_('The membership selected for "{item}" is not valid.').format(item=p.item))
+
+        if m.membership_type_id not in _allowed_membership_type_ids(p):
+            raise ValidationError(_('The membership selected for "{item}" cannot be used for this product.').format(
+                item=p.item,
+            ))
+
+        ev = p.subevent or event
+        if not m.is_valid(ev, ticket_valid_from=p.valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('The membership selected for "{item}" is not valid for the date of this ticket.').format(
+                item=p.item,
+            ))
+
+        batch_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + batch_usages[m.pk] > max_usages:
+            raise ValidationError(_('The membership selected for "{item}" has no usages left.').format(item=p.item))
+
+        if not m.membership_type.allow_parallel_usage:
+            start = ev.date_from
+            if start in existing_starts[m.pk] or start in batch_starts[m.pk]:
+                raise ValidationError(
+                    _('The membership selected for "{item}" cannot be used for another event at the same time.').format(
+                        item=p.item,
+                    )
+                )
+            batch_starts[m.pk].add(start)
+
+
