+def validate_memberships_in_order(customer, positions, event, lock=False, ignored_order=None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that is allowed for the
+    product and can still be used for this purchase. Raises a ``ValidationError`` otherwise.
+
+    :param lock: Lock the membership rows so concurrent purchases using the same membership are serialized. Must be
+                 called inside a transaction.
+    :param ignored_order: Usages by positions of this order are not counted, used when changing an existing order.
+    :param testmode: Only memberships with the same test mode are accepted.
+    :param valid_from_not_chosen: The customer has not chosen the start date yet, so only check that the membership
+                                  has not ended.
+    """
+    missing_msg = _('Your cart includes a product that requires an active membership to be selected.')
+    relevant = []
+    for p in positions:
+        requires = p.item.require_membership or (p.variation and p.variation.require_membership)
+        if requires and not p.used_membership_id:
+            raise ValidationError(missing_msg)
+        # A membership may only be used for a product that allows it, even if the product does not require one
+        if p.used_membership_id:
+            relevant.append(p)
+    if not relevant:
+        return
+
+    membership_ids = {p.used_membership_id for p in relevant}
+    if lock:
+        # Lock before counting usages, so that a concurrent purchase can not pass the same limit
+        list(Membership.objects.select_for_update(of=OF_SELF).filter(pk__in=membership_ids).order_by('pk'))
+    memberships = {}
+    if customer:
+        memberships = Membership.objects.with_usages(ignored_order=ignored_order).filter(
+            pk__in=membership_ids, customer=customer,
+        ).in_bulk()
+
+    purchase_count = Counter()
+    purchase_starts = defaultdict(set)
+    existing_starts = {}
+    for p in relevant:
+        m = memberships.get(p.used_membership_id)
+        if p.variation and p.variation.require_membership:
+            types = p.variation.require_membership_types.all()
+        else:
+            types = p.item.require_membership_types.all()
+        ev = p.subevent or event
+        if (
+            m is None or
+            m.membership_type_id not in {t.pk for t in types} or
+            m.testmode != testmode or
+            not m.is_valid(ev, p.valid_from, valid_from_not_chosen=valid_from_not_chosen)
+        ):
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this product.').format(item=p.item.name)
+            )
+
+        purchase_count[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + purchase_count[m.pk] > max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" can not be used any more times.').format(item=p.item.name)
+            )
+
+        if not m.membership_type.allow_parallel_usage:
+            if m.pk not in existing_starts:
+                qs = OrderPosition.all.filter(
+                    used_membership=m, canceled=False,
+                ).exclude(order__status=Order.STATUS_CANCELED).select_related('subevent', 'order__event')
+                if ignored_order:
+                    qs = qs.exclude(order=ignored_order)
+                existing_starts[m.pk] = {(op.subevent or op.order.event).date_from for op in qs}
+
+            start = ev.date_from
+            if start in existing_starts[m.pk] or start in purchase_starts[m.pk]:
+                raise ValidationError(
+                    _('The membership selected for "{item}" can not be used for multiple products at the same '
+                      'time.').format(item=p.item.name)
+                )
+            purchase_starts[m.pk].add(start)
+
+
