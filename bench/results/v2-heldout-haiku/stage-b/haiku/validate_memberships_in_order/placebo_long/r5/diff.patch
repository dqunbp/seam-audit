+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it: the membership
+    must exist, be of an allowed type, be valid for the position, and not be used up or used twice in parallel.
+
+    :param lock: Lock the membership rows until the surrounding transaction ends.
+    :param ignored_order: Usages by positions of this order are not counted (used when an order is changed).
+    :param testmode: Only memberships in this test mode are accepted.
+    :param valid_from_not_chosen: The validity start of the positions is not known yet (e.g. in checkout), so only
+                                  check that the membership has not expired.
+    :raises ValidationError: with a user-facing message if the memberships are not sufficient.
+    """
+    required = []
+    for p in positions:
+        if _requires_membership(p):
+            required.append(p)
+        elif p.used_membership_id:
+            raise ValidationError(_('The membership selected for "{item}" cannot be used for this product.').format(
+                item=str(p.item.name),
+            ))
+    if not required:
+        return
+
+    if not customer:
+        raise ValidationError(_('Some of the products you selected require a valid membership, but you are not logged in.'))
+
+    memberships = customer.memberships.with_usages(ignored_order).select_related('membership_type').filter(
+        pk__in=[p.used_membership_id for p in required if p.used_membership_id],
+        testmode=testmode,
+    )
+    if lock:
+        memberships = memberships.select_for_update(of=OF_SELF)
+    memberships = {m.pk: m for m in memberships}
+
+    new_usages = Counter()
+    parallel_slots = set()
+    for p in required:
+        ev = p.subevent or event
+        allowed_types = (p.variation if p.variation and p.variation.require_membership else p.item).require_membership_types
+        valid_from = getattr(p, 'override_valid_from', None) or p.valid_from
+
+        m = memberships.get(p.used_membership_id)
+        if m is None:
+            if not p.used_membership_id:
+                raise ValidationError(_('The product "{item}" requires a valid membership, but none was selected.').format(
+                    item=str(p.item.name),
+                ))
+            raise ValidationError(_('The membership selected for "{item}" is not valid for your customer account.').format(
+                item=str(p.item.name),
+            ))
+
+        if m.membership_type_id not in set(allowed_types.values_list('pk', flat=True)):
+            raise ValidationError(_('The membership selected for "{item}" is not allowed for this product.').format(
+                item=str(p.item.name),
+            ))
+
+        if not m.is_valid(ev=ev, ticket_valid_from=valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('The membership selected for "{item}" is not valid for the date of this product.').format(
+                item=str(p.item.name),
+            ))
+
+        new_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + new_usages[m.pk] > max_usages:
+            raise ValidationError(_('The membership selected for "{item}" has already been used the maximum number of times.').format(
+                item=str(p.item.name),
+            ))
+
+        if not m.membership_type.allow_parallel_usage:
+            slot = (m.pk, valid_from or ev.date_from)
+            if slot in parallel_slots:
+                raise ValidationError(_('The membership selected for "{item}" cannot be used for multiple products starting at the same time.').format(
+                    item=str(p.item.name),
+                ))
+            parallel_slots.add(slot)
