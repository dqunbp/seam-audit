+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it for this
+    position, and that no membership is used more often than its membership type permits. Raises a
+    ``ValidationError`` for the first problem found.
+
+    Usages by the positions of ``ignored_order`` are not counted, as ``positions`` replaces them.
+    """
+    required_positions = []
+    for position in positions:
+        if position.item.require_membership or (position.variation and position.variation.require_membership):
+            required_positions.append(position)
+        elif position.used_membership_id:
+            raise ValidationError(
+                _('The product "{item}" does not allow a membership to be used.').format(item=position.item.name)
+            )
+    used_ids = {p.used_membership_id for p in required_positions if p.used_membership_id}
+
+    memberships = {}
+    if customer and used_ids:
+        candidates = customer.memberships.filter(pk__in=used_ids, testmode=testmode)
+        if lock:
+            # Lock before counting usages, so that concurrent purchases cannot exceed max_usages
+            candidates = candidates.select_for_update(of=OF_SELF)
+        memberships = {
+            m.pk: m for m in candidates.with_usages(ignored_order).select_related('membership_type')
+        }
+
+    usages_in_batch = Counter()
+    for position in required_positions:
+        if not position.used_membership_id:
+            raise ValidationError(
+                _('The product "{item}" requires a valid membership, but none was selected.').format(
+                    item=position.item.name,
+                )
+            )
+
+        membership = memberships.get(position.used_membership_id)
+        if position.variation and position.variation.require_membership:
+            allowed_types = position.variation.require_membership_types.all()
+        else:
+            allowed_types = position.item.require_membership_types.all()
+        ev = position.subevent or event
+        if (
+            membership is None
+            or not allowed_types.filter(pk=membership.membership_type_id).exists()
+            or not membership.is_valid(ev, position.valid_from, valid_from_not_chosen=valid_from_not_chosen)
+        ):
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this product.').format(
+                    item=position.item.name,
+                )
+            )
+
+        max_usages = membership.membership_type.max_usages
+        if max_usages is not None and membership.usages + usages_in_batch[membership.pk] >= max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" has no usages left.').format(item=position.item.name)
+            )
+        usages_in_batch[membership.pk] += 1
+
