+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _allowed_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position which requires a membership has a membership of ``customer`` attached, and that all
+    memberships attached to positions are usable for them. Raises a ``ValidationError`` otherwise.
+
+    ``lock`` locks the memberships involved until the surrounding transaction ends. ``ignored_order`` is an order whose
+    existing membership usages should not count, e.g. because it is being changed. ``valid_from_not_chosen`` is used
+    during checkout, before the validity of the tickets is known, so only the expiry of the membership is checked.
+    """
+    positions_to_check = [p for p in positions if p.used_membership_id or _requires_membership(p)]
+    if not positions_to_check:
+        return
+
+    for p in positions_to_check:
+        if not p.used_membership_id:
+            raise ValidationError(_('One of the products in your cart requires a valid membership, but no membership '
+                                    'has been selected for it.'))
+
+    if not customer:
+        raise ValidationError(_('The products in your cart require a membership, but no customer account is '
+                                'logged in.'))
+
+    memberships_qs = customer.memberships.with_usages(ignored_order=ignored_order).select_related('membership_type')
+    if lock:
+        memberships_qs = memberships_qs.select_for_update(of=OF_SELF)
+    memberships = {
+        m.pk: m for m in memberships_qs.filter(pk__in={p.used_membership_id for p in positions_to_check})
+    }
+
+    batch_usages = Counter()
+    for p in positions_to_check:
+        m = memberships.get(p.used_membership_id)
+        if m is None or m.testmode != testmode:
+            raise ValidationError(_('The selected membership is not valid for this purchase.'))
+
+        if not _allowed_membership_types(p).filter(pk=m.membership_type_id).exists():
+            raise ValidationError(_('The membership "{membership}" cannot be used for the product "{product}".').format(
+                membership=m.membership_type, product=p.item,
+            ))
+
+        # The validity of a ticket is taken from its override, if one is set, and from the product otherwise
+        ticket_valid_from = getattr(p, 'override_valid_from', None) or p.valid_from
+        if not m.is_valid(ev=p.subevent or event, ticket_valid_from=ticket_valid_from,
+                          valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('The membership "{membership}" is not valid for the product "{product}".').format(
+                membership=m.membership_type, product=p.item,
+            ))
+
+        batch_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + batch_usages[m.pk] > max_usages:
+            raise ValidationError(_('The membership "{membership}" has no usages left.').format(
+                membership=m.membership_type,
+            ))
+
