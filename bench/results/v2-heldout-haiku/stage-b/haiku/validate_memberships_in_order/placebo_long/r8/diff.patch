+def _required_membership_type_ids(position: AbstractPosition) -> Optional[set]:
+    """
+    Returns the ids of the membership types that can be used for ``position``, or ``None`` if the position does
+    not require a membership at all. A variation with its own membership requirement overrides the item's.
+    """
+    if position.variation and position.variation.require_membership:
+        source = position.variation
+    elif position.item.require_membership:
+        source = position.item
+    else:
+        return None
+    return set(source.require_membership_types.values_list('pk', flat=True))
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order=None, testmode=False, valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it, and that
+    no position without a membership requirement uses one. Raises a ``ValidationError`` otherwise.
+
+    * ``lock``: lock the memberships until the end of the transaction, so concurrent purchases cannot exceed their
+      usage limit. Must be called within a transaction.
+    * ``ignored_order``: usages by this order are not counted, because the order is being changed.
+    * ``testmode``: only memberships in the same test mode as the cart or order can be used.
+    * ``valid_from_not_chosen``: passed on to ``Membership.is_valid``, see there.
+    """
+    required = []
+    for p in positions:
+        type_ids = _required_membership_type_ids(p)
+        if type_ids is not None:
+            required.append((p, type_ids))
+        elif p.used_membership_id:
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this product.').format(item=p.item)
+            )
+    if not required:
+        return
+
+    membership_ids = {p.used_membership_id for p, _type_ids in required if p.used_membership_id}
+    if customer and lock:
+        lock_objects(list(customer.memberships.filter(pk__in=membership_ids)))
+
+    memberships = {}
+    if customer:
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order=ignored_order).filter(
+                pk__in=membership_ids,
+            ).select_related('membership_type')
+        }
+
+    new_usages = Counter()
+    positions_by_membership = {}
+    for p, allowed_type_ids in required:
+        if not p.used_membership_id:
+            raise ValidationError(
+                _('The product "{item}" requires a valid membership, but none was selected.').format(item=p.item)
+            )
+        m = memberships.get(p.used_membership_id)
+        if (
+            not m
+            or m.membership_type_id not in allowed_type_ids
+            or m.testmode != testmode
+            or not m.is_valid(p.subevent or event, ticket_valid_from=p.valid_from,
+                              valid_from_not_chosen=valid_from_not_chosen)
+        ):
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this product.').format(item=p.item)
+            )
+        new_usages[m.pk] += 1
+        positions_by_membership.setdefault(m.pk, p)
+
+    for pk, count in new_usages.items():
+        m = memberships[pk]
+        if m.membership_type.max_usages is not None and m.usages + count > m.membership_type.max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" has no usages left.').format(
+                    item=positions_by_membership[pk].item
+                )
+            )
+
