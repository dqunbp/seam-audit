+def _paid_order_with_membership(event, customer, item, membership):
+    order = Order.objects.create(
+        event=event, email='dummy@example.org', status=Order.STATUS_PAID, datetime=now(),
+        expires=now() + timedelta(days=10), total=Decimal('23.00'), testmode=membership.testmode,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"), customer=customer,
+    )
+    OrderPosition.objects.create(
+        order=order, item=item, price=Decimal('23.00'), used_membership=membership,
