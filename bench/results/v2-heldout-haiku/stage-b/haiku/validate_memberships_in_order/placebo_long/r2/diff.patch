+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _required_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def _validity_interval(position: AbstractPosition, ev) -> Tuple[datetime, datetime]:
+    # Without product-level validity, a position is only bound to the start time of its event
+    start = position.valid_from or ev.date_from
+    end = position.valid_until or start
+    return start, end
+
+
+def _intervals_overlap(a: Tuple[datetime, datetime], b: Tuple[datetime, datetime]) -> bool:
+    return a[0] <= b[1] and b[0] <= a[1]
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it, and that no
+    other position uses a membership. Raises a ``ValidationError`` otherwise.
+
+    :param lock: Lock the memberships until the end of the current transaction.
+    :param ignored_order: Usages of this order are not counted, e.g. because it is being changed right now.
+    :param testmode: Only memberships in the same test mode are accepted.
+    :param valid_from_not_chosen: The start date of the positions has not been chosen yet, so only check that the
+                                  membership has not expired.
+    """
+    relevant = [p for p in positions if _requires_membership(p) or p.used_membership_id]
+    if not relevant:
+        return
+
+    no_membership_msg = _('Your cart includes a product that requires an active membership to be selected.')
+    if not customer:
+        raise ValidationError(no_membership_msg)
+
+    memberships_qs = customer.memberships.with_usages(ignored_order=ignored_order).filter(
+        testmode=testmode,
+        canceled=False,
+    ).select_related('membership_type')
+    if lock:
+        memberships_qs = memberships_qs.select_for_update(of=OF_SELF)
+    memberships = {m.pk: m for m in memberships_qs}
+
+    # Intervals of the existing usages of each membership, needed to detect overlapping usages
+    booked = defaultdict(list)
+    existing_usages = OrderPosition.all.filter(
+        used_membership_id__in=list(memberships.keys()),
+        canceled=False,
+    ).exclude(
+        order__status=Order.STATUS_CANCELED,
+    ).select_related('subevent', 'order__event')
+    if ignored_order:
+        existing_usages = existing_usages.exclude(order=ignored_order)
+    for op in existing_usages:
+        booked[op.used_membership_id].append(_validity_interval(op, op.subevent or op.order.event))
+
+    new_usages = Counter()
+    for p in relevant:
+        if not p.used_membership_id:
+            raise ValidationError(no_membership_msg)
+
+        m = memberships.get(p.used_membership_id)
+        if m is None:
+            raise ValidationError(
+                _('The membership selected for "{item}" is not available.').format(item=p.item)
+            )
+
+        if not _requires_membership(p) or not _required_membership_types(p).filter(pk=m.membership_type_id).exists():
+            raise ValidationError(
+                _('The membership selected for "{item}" does not grant access to this product.').format(item=p.item)
+            )
+
+        ev = p.subevent or event
+        if not m.is_valid(ev, p.valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(
+                _('The membership selected for "{item}" is only valid from {start} to {end}.').format(
+                    item=p.item,
+                    start=date_format(m.date_start, 'SHORT_DATE_FORMAT'),
+                    end=date_format(m.date_end, 'SHORT_DATE_FORMAT'),
+                )
+            )
+
+        new_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + new_usages[m.pk] > max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" can not be used for any more products.').format(item=p.item)
+            )
+
+        if not m.membership_type.allow_parallel_usage:
+            interval = _validity_interval(p, ev)
+            if any(_intervals_overlap(interval, b) for b in booked[m.pk]):
+                raise ValidationError(
+                    _('The membership selected for "{item}" is already used for another product at the same time.').format(
+                        item=p.item,
+                    )
+                )
+            booked[m.pk].append(interval)
