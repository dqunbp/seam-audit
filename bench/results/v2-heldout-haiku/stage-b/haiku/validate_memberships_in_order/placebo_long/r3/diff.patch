+def _membership_requirement(position: AbstractPosition):
+    """
+    Returns whether the position requires a membership and, if so, the IDs of the membership types it accepts.
+    Mirrors the rules used in the checkout membership selection.
+    """
+    if position.variation and position.variation.require_membership:
+        return True, set(position.variation.require_membership_types.values_list('pk', flat=True))
+    if position.item.require_membership:
+        return True, set(position.item.require_membership_types.values_list('pk', flat=True))
+    return False, set()
+
+
+def _membership_usages(membership: Membership, ignored_order: Optional[Order]) -> List[OrderPosition]:
+    """
+    Returns the existing, non-canceled order positions that already use this membership.
+    """
+    qs = OrderPosition.all.filter(
+        used_membership=membership,
+        canceled=False,
+    ).exclude(
+        order__status=Order.STATUS_CANCELED,
+    ).select_related('subevent', 'order__event')
+    if ignored_order:
+        qs = qs.exclude(order=ignored_order)
+    return list(qs)
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order]=None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership has a membership of ``customer`` selected that allows it, and
+    that no position uses a membership although its product does not require one. Raises a ``ValidationError``
+    otherwise.
+
+    ``ignored_order`` is excluded from the existing usages of a membership, since its positions are part of
+    ``positions`` already. ``valid_from_not_chosen`` only checks that a membership has not yet expired, instead of
+    requiring it to be valid on the start date of the position.
+    """
+    memberships_in_use = {}
+
+    for position in positions:
+        requires_membership, type_ids = _membership_requirement(position)
+        product = str(position.item)
+
+        if not requires_membership:
+            if position.used_membership_id:
+                raise ValidationError(
+                    _('The product "{product}" cannot be purchased with a membership.').format(product=product)
+                )
+            continue
+
+        m = position.used_membership
+        if not m:
+            raise ValidationError(
+                _('The product "{product}" requires a valid membership, but none has been selected.').format(
+                    product=product
+                )
+            )
+        if (not customer or m.customer_id != customer.pk or m.testmode != testmode or m.canceled
+                or m.membership_type_id not in type_ids):
+            raise ValidationError(
+                _('The membership selected for "{product}" cannot be used for this product.').format(product=product)
+            )
+
+        ev = position.subevent or event
+        if not m.is_valid(
+            ev, position.valid_from,
+            valid_from_not_chosen=valid_from_not_chosen or position.item.validity_dynamic_start_choice,
+        ):
+            raise ValidationError(
+                _('The membership selected for "{product}" is not valid for the selected date.').format(product=product)
+            )
+
+        memberships_in_use.setdefault(m.pk, (m, []))[1].append(position)
+
+    if lock and memberships_in_use:
+        lock_objects([m for m, _positions in memberships_in_use.values()], shared_lock_objects=[event])
+
+    for m, used_by in memberships_in_use.values():
+        mt = m.membership_type
+        existing = _membership_usages(m, ignored_order)
+
+        if mt.max_usages is not None and len(existing) + len(used_by) > mt.max_usages:
+            raise ValidationError(
+                _('The membership "{membership}" has reached its maximum number of usages.').format(
+                    membership=str(mt.name)
+                )
+            )
+
+        if not mt.allow_parallel_usage:
+            taken_starts = {(p.subevent or p.order.event).date_from for p in existing}
+            for position in used_by:
+                start = (position.subevent or event).date_from
+                if start in taken_starts:
+                    raise ValidationError(
+                        _('The membership "{membership}" can not be used for more than one event starting at the '
+                          'same time.').format(membership=str(mt.name))
+                    )
+                taken_starts.add(start)
+
+
