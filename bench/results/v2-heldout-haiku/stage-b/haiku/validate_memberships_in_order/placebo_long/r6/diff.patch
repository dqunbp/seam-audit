     )
 
 
+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _allowed_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order]=None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position that requires a membership uses a membership of ``customer`` that allows it. Raises a
+    ``ValidationError`` with a user-facing message otherwise.
+
+    :param lock: Lock the customer's memberships before counting their usages, to be used inside a transaction.
+    :param ignored_order: An existing order whose positions do not count towards membership usages, e.g. because the
+                          order is being changed and the positions are passed in as a cart.
+    :param valid_from_not_chosen: The validity start of the positions is not known yet, so the membership only has to
+                                  not have expired yet.
+    """
+    if any(p.used_membership_id and not _requires_membership(p) for p in positions):
+        raise ValidationError(_('The membership selected for one of your products is not valid for that product.'))
+
+    applicable = [p for p in positions if _requires_membership(p)]
+    if not applicable:
+        return
+
+    if not customer or any(not p.used_membership_id for p in applicable):
+        raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+
+    membership_ids = {p.used_membership_id for p in applicable}
+    if lock:
+        lock_objects(list(customer.memberships.filter(pk__in=membership_ids)))
+
+    memberships = {
+        m.pk: m for m in customer.memberships.with_usages(ignored_order=ignored_order).select_related(
+            'membership_type'
+        ).filter(pk__in=membership_ids, testmode=testmode)
+    }
+
+    usages_in_cart = Counter()
+    positions_by_membership = defaultdict(list)
+    for p in applicable:
+        m = memberships.get(p.used_membership_id)
+        if not m or m.membership_type not in _allowed_membership_types(p) or not m.is_valid(
+            p.subevent or event, p.valid_from, valid_from_not_chosen=valid_from_not_chosen
+        ):
+            raise ValidationError(_('The membership selected for one of your products is not valid for that product.'))
+        usages_in_cart[m.pk] += 1
+        positions_by_membership[m.pk].append(p)
+
+    for m_pk, count in usages_in_cart.items():
+        m = memberships[m_pk]
+        if m.membership_type.max_usages is not None and m.usages + count > m.membership_type.max_usages:
+            raise ValidationError(_('The membership selected for one of your products has already been used the maximum '
+                                    'number of times.'))
+
+    for m_pk, ps in positions_by_membership.items():
+        m = memberships[m_pk]
+        if m.membership_type.allow_parallel_usage:
+            continue
+
+        starts = [(p.subevent or event).date_from for p in ps]
+        existing = OrderPosition.all.filter(
+            used_membership=m, canceled=False,
+        ).exclude(
+            order__status=Order.STATUS_CANCELED,
+        ).select_related('subevent', 'order__event')
+        if ignored_order:
+            existing = existing.exclude(order=ignored_order)
+
+        if len(set(starts)) != len(starts) or any((op.subevent or op.order.event).date_from in starts for op in existing):
+            raise ValidationError(_('The membership selected for one of your products is already used for another '
+                                    'product at the same time.'))
+
+
