     )
 
 
+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _allowed_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def _product_validity(position: AbstractPosition):
+    # Fake carts used for order changes carry the new validity as override values
+    return (
+        getattr(position, 'override_valid_from', None) or position.valid_from,
+        getattr(position, 'override_valid_until', None) or position.valid_until,
+    )
+
+
+def _occupied_window(position: AbstractPosition, ev: Event):
+    valid_from, valid_until = _product_validity(position)
+    return valid_from or ev.date_from, valid_until or ev.date_to
+
+
+def _windows_overlap(a, b):
+    a_start, a_end = a
+    b_start, b_end = b
+    return (b_end is None or a_start <= b_end) and (a_end is None or b_start <= a_end)
+
+
+def validate_memberships_in_order(customer, positions, event, lock=False, ignored_order=None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it for this
+    purchase, and that no membership is used beyond its limits. Raises a ``ValidationError`` for the first problem found.
+
+    ``lock`` locks the customer's memberships to serialize concurrent purchases. ``ignored_order`` is the order being
+    changed; its existing usages are not counted. ``valid_from_not_chosen`` means the start of the validity has not been
+    chosen yet, so only the end of the membership is checked.
+    """
+    for p in positions:
+        if p.used_membership_id and not _requires_membership(p):
+            raise ValidationError(
+                _('You selected a membership for the product "{product}" which does not require a membership.').format(
+                    product=str(p.item),
+                )
+            )
+
+    required = [p for p in positions if _requires_membership(p)]
+    for p in required:
+        if not customer or not p.used_membership_id:
+            raise ValidationError(
+                _('You selected the product "{product}" which requires an active membership to be selected.').format(
+                    product=str(p.item),
+                )
+            )
+
+    if not required:
+        return
+
+    membership_pks = {p.used_membership_id for p in required}
+
+    if lock:
+        list(customer.memberships.select_for_update(of=OF_SELF).filter(pk__in=membership_pks).order_by('pk'))
+
+    usages = dict(
+        customer.memberships.with_usages(ignored_order=ignored_order).filter(
+            pk__in=membership_pks,
+        ).values_list('pk', 'usages')
+    )
+
+    # Positions that already use these memberships, with the event they belong to. Positions of this purchase are
+    # added to the same mapping as they are checked.
+    booked = defaultdict(list)
+    existing = OrderPosition.all.filter(
+        used_membership_id__in=membership_pks, canceled=False,
+    ).exclude(order__status=Order.STATUS_CANCELED).select_related('subevent', 'order__event')
+    if ignored_order:
+        existing = existing.exclude(order__id=ignored_order.pk)
+    for op in existing:
+        booked[op.used_membership_id].append((op, op.subevent or op.order.event))
+
+    usages_in_purchase = Counter()
+    for p in required:
+        m = p.used_membership
+        ev = p.subevent or event
+        valid_from = _product_validity(p)[0]
+
+        if m.customer_id != customer.pk:
+            raise ValidationError(_('You selected a membership that is connected to a different customer account.'))
+        if m.canceled:
+            raise ValidationError(_('You selected membership that has been canceled.'))
+        if m.testmode and not testmode:
+            raise ValidationError(_('You can not use a test mode membership for tickets that are not in test mode.'))
+        if testmode and not m.testmode:
+            raise ValidationError(_('You need to add a test mode membership to the customer account to use it in test mode.'))
+
+        allowed_types = {t.pk for t in _allowed_membership_types(p)}
+        if m.membership_type_id not in allowed_types:
+            raise ValidationError(
+                _('You selected a membership of type "{type}", which is not allowed for the product "{product}".').format(
+                    type=str(m.membership_type), product=str(p.item),
+                )
+            )
+
+        if not m.is_valid(ev, valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            membership_dates = {
+                'start': date_format(m.date_start, 'SHORT_DATE_FORMAT'),
+                'end': date_format(m.date_end, 'SHORT_DATE_FORMAT'),
+            }
+            if valid_from:
+                raise ValidationError(
+                    _('You selected a membership that is valid from {start} to {end}, but selected a ticket that starts '
+                      'to be valid on {date}.').format(
+                        date=date_format(valid_from, 'SHORT_DATETIME_FORMAT'), **membership_dates,
+                    )
+                )
+            raise ValidationError(
+                _('You selected a membership that is valid from {start} to {end}, but selected an event taking place at '
+                  '{date}.').format(date=date_format(ev.date_from, 'SHORT_DATETIME_FORMAT'), **membership_dates)
+            )
+
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and usages.get(m.pk, 0) + usages_in_purchase[m.pk] + 1 > max_usages:
+            raise ValidationError(
+                _('You are trying to use a membership of type "{type}" more than {number} times, which is the maximum '
+                  'amount.').format(type=str(m.membership_type), number=max_usages)
+            )
+
+        if not m.membership_type.allow_parallel_usage:
+            window = _occupied_window(p, ev)
+            for other, other_ev in booked[m.pk]:
+                if valid_from:
+                    other_window = _occupied_window(other, other_ev)
+                    if _windows_overlap(window, other_window):
+                        raise ValidationError(
+                            _('You are trying to use a membership of type "{type}" for a ticket valid from {valid_from} until '
+                              '{valid_until}, however you already used the same membership for a different ticket that '
+                              'overlaps with this time frame ({conflict_from} – {conflict_until}).').format(
+                                type=str(m.membership_type),
+                                valid_from=date_format(window[0], 'SHORT_DATETIME_FORMAT'),
+                                valid_until=date_format(window[1], 'SHORT_DATETIME_FORMAT') if window[1] else _('open end'),
+                                conflict_from=date_format(other_window[0], 'SHORT_DATETIME_FORMAT'),
+                                conflict_until=(
+                                    date_format(other_window[1], 'SHORT_DATETIME_FORMAT') if other_window[1] else _('open end')
+                                ),
+                            )
+                        )
+                elif other_ev.date_from == ev.date_from:
+                    raise ValidationError(
+                        _('You are trying to use a membership of type "{type}" for an event taking place at {date}, however '
+                          'you already used the same membership for a different ticket at the same time.').format(
+                            type=str(m.membership_type), date=date_format(ev.date_from, 'SHORT_DATETIME_FORMAT'),
+                        )
+                    )
+
+        usages_in_purchase[m.pk] += 1
+        booked[m.pk].append((p, ev))
+
+
