+from collections import Counter
 from datetime import timedelta
 from typing import List, Optional
 
@@ -83,3 +84,90 @@ def create_membership(customer: Customer, position: OrderPosition):
     )
 
 
+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(
+        position.item.require_membership or
+        (position.variation and position.variation.require_membership)
+    )
+
+
+def _allowed_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def _counted_in_database(position: AbstractPosition, ignored_order: Optional[Order]) -> bool:
+    # Positions that are already stored as part of an order are already part of the usage count in the database,
+    # unless that order is the one we are ignoring.
+    return isinstance(position, OrderPosition) and not (ignored_order and position.order_id == ignored_order.pk)
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position that requires a membership uses a membership of ``customer`` that is allowed for the
+    position's product and still has usages left. Positions that do not require a membership but reference one are
+    checked the same way. Raises a ``ValidationError`` otherwise.
+
+    :param customer: The customer the memberships must belong to.
+    :param positions: The cart or order positions to check. They do not need to be saved yet.
+    :param event: The event the positions belong to.
+    :param lock: If ``True``, the memberships are locked until the end of the surrounding transaction, so concurrent
+                 purchases cannot exceed the usage limits.
+    :param ignored_order: An order whose existing usages should not count, e.g. because it is being changed.
+    :param testmode: Only memberships in the same test mode are accepted.
+    :param valid_from_not_chosen: If ``True``, the validity start date is not known yet, so only the end date of
+                                  the membership is checked.
+    """
+    to_check = [p for p in positions if _requires_membership(p) or p.used_membership_id]
+    if not to_check:
+        return
+
+    membership_ids = {p.used_membership_id for p in to_check if p.used_membership_id}
+    if customer and membership_ids and lock:
+        list(customer.memberships.select_for_update(of=OF_SELF).filter(pk__in=membership_ids).order_by('pk'))
+
+    memberships = {}
+    if customer and membership_ids:
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order=ignored_order).filter(
+                pk__in=membership_ids, testmode=testmode,
+            ).select_related('membership_type')
+        }
+
+    # Usages from this purchase that are not yet counted in the database, including positions that do not need a
+    # membership themselves but still reference one
+    pending_usages = Counter(
+        p.used_membership_id for p in positions
+        if p.used_membership_id and not _counted_in_database(p, ignored_order)
+    )
+
+    for p in to_check:
+        if not p.used_membership_id:
+            raise ValidationError(
+                _('The product "{item}" requires a valid membership, but no membership is selected for it.')
+                .format(item=str(p.item))
+            )
+
+        membership = memberships.get(p.used_membership_id)
+        allowed_type_ids = {t.pk for t in _allowed_membership_types(p)}
+        if not membership or membership.membership_type_id not in allowed_type_ids:
+            raise ValidationError(
+                _('The membership selected for "{item}" cannot be used for this product.').format(item=str(p.item))
+            )
+
+        # Override set by order changes, which are not stored on the position yet
+        valid_from = getattr(p, 'override_valid_from', None) or p.valid_from
+        if not membership.is_valid(p.subevent or event, ticket_valid_from=valid_from,
+                                   valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this date.').format(item=str(p.item))
+            )
+
+        max_usages = membership.membership_type.max_usages
+        if max_usages is not None and membership.usages + pending_usages[membership.pk] > max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" cannot be used any more times.').format(item=str(p.item))
+            )
