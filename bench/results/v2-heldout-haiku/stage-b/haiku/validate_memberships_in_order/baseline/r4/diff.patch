+def _cart_position(event, item, membership=None, valid_from=None, valid_until=None, variation=None):
+    cp = CartPosition(event=event, item=item, variation=variation, price=Decimal('23.00'), used_membership=membership)
+    # Order changes validate fake carts with the new validity set like this, see OrderChangeManager
+    if valid_from is not None:
+        cp.override_valid_from = valid_from
+    if valid_until is not None:
+        cp.override_valid_until = valid_until
+    return cp
+
+
+@pytest.mark.django_db
+def test_validate_memberships_valid(event, customer, membership, requiring_ticket):
+    cp = _cart_position(event, requiring_ticket, membership)
+    validate_memberships_in_order(customer, [cp], event, lock=True)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_no_requirement(event, customer):
+    item = Item.objects.create(event=event, name='Plain', default_price=Decimal('23.00'))
+    validate_memberships_in_order(customer, [_cart_position(event, item)], event)
