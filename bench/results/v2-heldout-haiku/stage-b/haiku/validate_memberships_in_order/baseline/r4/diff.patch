+def _allowed_membership_type_ids(position: AbstractPosition) -> Optional[set]:
+    """
+    Returns the ids of the membership types ``position`` may be bought with, or ``None`` if it requires no membership.
+    A variation's own membership requirement takes precedence over the item's, as it does in the checkout.
+    """
+    if position.variation and position.variation.require_membership:
+        return set(position.variation.require_membership_types.values_list('pk', flat=True))
+    if position.item.require_membership:
+        return set(position.item.require_membership_types.values_list('pk', flat=True))
+    return None
+
+
+def _position_validity(position: AbstractPosition):
+    # Order changes validate a fake cart whose new validity is stored in ``override_valid_*``
+    valid_from = position.override_valid_from if hasattr(position, 'override_valid_from') else position.valid_from
+    valid_until = position.override_valid_until if hasattr(position, 'override_valid_until') else position.valid_until
+    return valid_from, valid_until
+
+
+def _time_frame(position: AbstractPosition, event: Event):
+    """
+    Returns ``(start, end, has_validity)`` of the time the position occupies a membership. ``None`` means open-ended.
+    Positions without ticket validity occupy the time of their event or subevent.
+    """
+    valid_from, valid_until = _position_validity(position)
+    if valid_from or valid_until:
+        return valid_from, valid_until, True
+    ev = position.subevent or event
+    return ev.date_from, ev.date_to or ev.date_from, False
+
+
+def _frames_overlap(a, b) -> bool:
+    a_start, a_end = a[0], a[1]
+    b_start, b_end = b[0], b[1]
+    return (
+        (a_start is None or b_end is None or a_start <= b_end) and
+        (b_start is None or a_end is None or b_start <= a_end)
+    )
+
+
+def _format_datetime(value, tz, default):
+    if value is None:
+        return default
+    return date_format(value.astimezone(tz), 'SHORT_DATETIME_FORMAT')
+
+
+def validate_memberships_in_order(customer, positions, event, lock=False, ignored_order=None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position that requires a membership uses a membership of ``customer`` that is allowed for it,
+    and that no membership is used beyond its limits or for overlapping tickets. Raises a ``ValidationError`` otherwise.
+
+    :param customer: The customer the memberships have to belong to.
+    :param positions: The cart or order positions to check.
+    :param event: The event the positions belong to.
+    :param lock: Lock the memberships in use until the end of the transaction, so concurrent purchases cannot exceed
+                 their limits. Must be called inside a transaction.
+    :param ignored_order: Usages of memberships in this order are not counted, e.g. because it is being changed.
+    :param testmode: Whether the positions are purchased in test mode.
+    :param valid_from_not_chosen: The validity of the tickets has not been chosen yet, so only the membership itself
+                                  is checked.
+    """
+    membership_positions = []
+    for position in positions:
+        allowed_type_ids = _allowed_membership_type_ids(position)
+        if allowed_type_ids is None:
+            if position.used_membership_id:
+                raise ValidationError(
+                    _('You selected a membership for the product "{product}" which does not require a membership.').format(
+                        product=str(position.item),
+                    )
+                )
+            continue
+
+        if not position.used_membership_id:
+            raise ValidationError(
+                _('You selected the product "{product}" which requires an active membership to be selected.').format(
+                    product=str(position.item),
+                )
+            )
+        membership_positions.append((position, allowed_type_ids))
+
+    if not membership_positions:
+        return
+
+    membership_ids = {p.used_membership_id for p, _allowed in membership_positions}
+    if lock and customer:
+        list(customer.memberships.select_for_update(of=OF_SELF).filter(pk__in=membership_ids).order_by('pk'))
+
+    for position, allowed_type_ids in membership_positions:
+        membership = position.used_membership
+        if not customer or membership.customer_id != customer.pk:
+            raise ValidationError(_('You selected a membership that is connected to a different customer account.'))
+        if membership.canceled:
+            raise ValidationError(_('You selected membership that has been canceled.'))
+        if membership.testmode and not testmode:
+            raise ValidationError(_('You can not use a test mode membership for tickets that are not in test mode.'))
+        if testmode and not membership.testmode:
+            raise ValidationError(_('You need to add a test mode membership to the customer account to use it in test mode.'))
+        if membership.membership_type_id not in allowed_type_ids:
+            raise ValidationError(
+                _('You selected a membership of type "{type}", which is not allowed for the product "{product}".').format(
+                    type=membership.membership_type.name,
+                    product=str(position.item),
+                )
+            )
+
+        ev = position.subevent or event
+        valid_from, valid_until = _position_validity(position)
+        if valid_from_not_chosen:
+            if not membership.is_valid(valid_from_not_chosen=True):
+                raise ValidationError(_('You selected a membership that is no longer valid.'))
+        elif not membership.is_valid(ev=ev, ticket_valid_from=valid_from):
+            if valid_from:
+                raise ValidationError(
+                    _('You selected a membership that is valid from {start} to {end}, but selected a ticket that starts '
+                      'to be valid on {date}.').format(
+                        start=date_format(membership.date_start, 'SHORT_DATE_FORMAT'),
+                        end=date_format(membership.date_end, 'SHORT_DATE_FORMAT'),
+                        date=_format_datetime(valid_from, event.timezone, None),
+                    )
+                )
+            raise ValidationError(
+                _('You selected a membership that is valid from {start} to {end}, but selected an event taking place '
+                  'at {date}.').format(
+                    start=date_format(membership.date_start, 'SHORT_DATE_FORMAT'),
+                    end=date_format(membership.date_end, 'SHORT_DATE_FORMAT'),
+                    date=_format_datetime(ev.date_from, event.timezone, None),
+                )
+            )
+
+    # Usages by positions that are not part of this check, e.g. in other orders
+    existing = defaultdict(list)
+    with scopes_disabled():
+        usages = OrderPosition.all.filter(
+            used_membership_id__in=membership_ids,
+            canceled=False,
+        ).exclude(
+            order__status=Order.STATUS_CANCELED,
+        ).exclude(
+            pk__in=[p.pk for p in positions if isinstance(p, OrderPosition)],
+        ).select_related('subevent', 'order__event')
+        if ignored_order:
+            usages = usages.exclude(order=ignored_order)
+        for op in usages:
+            existing[op.used_membership_id].append((op, _time_frame(op, op.order.event)))
+
+    for position, _allowed in membership_positions:
+        membership = position.used_membership
+        same = [
+            (p, _time_frame(p, event)) for p, _a in membership_positions
+            if p.used_membership_id == membership.pk
+        ]
+        max_usages = membership.membership_type.max_usages
+        if max_usages is not None and len(existing[membership.pk]) + len(same) > max_usages:
+            raise ValidationError(
+                _('You are trying to use a membership of type "{type}" more than {number} times, which is the maximum '
+                  'amount.').format(
+                    type=membership.membership_type.name,
+                    number=max_usages,
+                )
+            )
+
+        if valid_from_not_chosen:
+            continue
+
+        frame = _time_frame(position, event)
+        others = existing[membership.pk] + [(p, f) for p, f in same if p is not position]
+        for _other, other_frame in others:
+            if not _frames_overlap(frame, other_frame):
+                continue
+            conflict_from = _format_datetime(other_frame[0], event.timezone, _('start'))
+            conflict_until = _format_datetime(other_frame[1], event.timezone, _('open end'))
+            if frame[2]:
+                raise ValidationError(
+                    _('You are trying to use a membership of type "{type}" for a ticket valid from {valid_from} until '
+                      '{valid_until}, however you already used the same membership for a different ticket that overlaps '
+                      'with this time frame ({conflict_from} – {conflict_until}).').format(
+                        type=membership.membership_type.name,
+                        valid_from=_format_datetime(frame[0], event.timezone, _('start')),
+                        valid_until=_format_datetime(frame[1], event.timezone, _('open end')),
+                        conflict_from=conflict_from,
+                        conflict_until=conflict_until,
+                    )
+                )
+            raise ValidationError(
+                _('You are trying to use a membership of type "{type}" for an event taking place at {date}, however '
+                  'you already used the same membership for a different ticket at the same time.').format(
+                    type=membership.membership_type.name,
+                    date=_format_datetime(frame[0], event.timezone, None),
+                )
+            )
+
+
