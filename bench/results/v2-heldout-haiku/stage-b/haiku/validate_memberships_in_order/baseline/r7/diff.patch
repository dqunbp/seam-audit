     )
 
 
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it for this
+    position, is valid, and still has usages left. Raises a ``ValidationError`` otherwise.
+
+    ``ignored_order`` is not counted towards membership usages, which is needed when an existing order is changed.
+    ``valid_from_not_chosen`` is passed on to the validity check of the membership.
+    """
+    required = []
+    for p in positions:
+        if p.item.require_membership or (p.variation and p.variation.require_membership):
+            required.append(p)
+        elif p.used_membership_id:
+            raise ValidationError(_('The product "{item}" does not require a membership, but one was selected.').format(
+                item=p.item.name,
+            ))
+
+    if not required:
+        return
+
+    for p in required:
+        m = p.used_membership
+        if not m:
+            raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+        if not customer or m.customer_id != customer.pk:
+            raise ValidationError(_('The membership selected for "{item}" does not belong to your account.').format(
+                item=p.item.name,
+            ))
+        if m.testmode != testmode:
+            raise ValidationError(_('The membership selected for "{item}" can not be used for this order.').format(
+                item=p.item.name,
+            ))
+
+        if p.variation and p.variation.require_membership:
+            types = p.variation.require_membership_types.all()
+        else:
+            types = p.item.require_membership_types.all()
+        if m.membership_type_id not in {t.pk for t in types}:
+            raise ValidationError(_('The membership selected for "{item}" does not allow this product.').format(
+                item=p.item.name,
+            ))
+
+        if not m.is_valid(p.subevent or event, ticket_valid_from=p.valid_from,
+                          valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('The membership selected for "{item}" is not valid for this date.').format(
+                item=p.item.name,
+            ))
+
+    requested = Counter(p.used_membership_id for p in required)
+    memberships = Membership.objects.with_usages(ignored_order=ignored_order)
+    if lock:
+        memberships = memberships.select_for_update(of=OF_SELF)
+    for m in memberships.filter(pk__in=list(requested)).select_related('membership_type'):
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + requested[m.pk] > max_usages:
+            raise ValidationError(_('The membership "{name}" does not have enough usages left for all selected products.').format(
+                name=m.membership_type.name,
+            ))
+
+
