+from collections import Counter, defaultdict
 from datetime import timedelta
 from typing import List, Optional
 
@@ -83,3 +84,103 @@ def create_membership(customer: Customer, position: OrderPosition):
     )
 
 
+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _allowed_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def _start_of_usage(position: AbstractPosition, event: Event):
+    return (position.subevent or event).date_from
+
+
+def validate_memberships_in_order(customer, positions, event, lock=False, ignored_order=None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership has been assigned a membership of ``customer`` that is
+    valid for it, that positions not requiring one have no membership assigned, and that the usage limits of
+    the memberships are respected. Raises a ``ValidationError`` otherwise.
+
+    ``ignored_order`` is the order being modified, its existing membership usages are not counted. If
+    ``valid_from_not_chosen`` is set, the validity of the membership is only checked against its end date, since
+    the start of the ticket validity has not been chosen yet.
+    """
+    if not any(_requires_membership(p) or p.used_membership_id for p in positions):
+        return
+
+    if lock and customer:
+        # Serialize purchases of the same customer so that usage limits cannot be exceeded by concurrent requests
+        Customer.objects.select_for_update(of=OF_SELF).get(pk=customer.pk)
+
+    batch_usages = Counter()
+    db_usages = {}
+    db_starts = defaultdict(set)
+    batch_starts = defaultdict(set)
+
+    for p in positions:
+        if not _requires_membership(p):
+            if p.used_membership_id:
+                raise ValidationError(
+                    _('The product "{item}" can not be purchased with a membership.').format(item=str(p.item))
+                )
+            continue
+
+        m = p.used_membership
+        if not m:
+            raise ValidationError(
+                _('The product "{item}" requires a valid membership, but none has been selected.').format(
+                    item=str(p.item)
+                )
+            )
+
+        if not customer or m.customer_id != customer.pk or m.testmode != testmode:
+            raise ValidationError(
+                _('The membership selected for "{item}" does not belong to your account.').format(item=str(p.item))
+            )
+
+        ev = p.subevent or event
+        valid_from = getattr(p, 'override_valid_from', None) or p.valid_from
+        if (
+            m.membership_type_id not in [t.pk for t in _allowed_membership_types(p)] or
+            not m.is_valid(
+                ev, valid_from,
+                valid_from_not_chosen=valid_from_not_chosen or p.item.validity_dynamic_start_choice,
+            )
+        ):
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this product.').format(item=str(p.item))
+            )
+
+        if m.pk not in db_usages:
+            db_usages[m.pk] = Membership.objects.with_usages(ignored_order=ignored_order).get(pk=m.pk).usages
+            if not m.membership_type.allow_parallel_usage:
+                db_starts[m.pk] = {
+                    _start_of_usage(op, op.order.event) for op in OrderPosition.all.filter(
+                        used_membership=m, canceled=False,
+                    ).exclude(
+                        order__status=Order.STATUS_CANCELED,
+                    ).exclude(
+                        order=ignored_order,
+                    ).select_related('subevent', 'order__event')
+                }
+
+        batch_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and db_usages[m.pk] + batch_usages[m.pk] > max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" can not be used any more.').format(item=str(p.item))
+            )
+
+        if not m.membership_type.allow_parallel_usage:
+            batch_starts[m.pk].add(_start_of_usage(p, event))
+            if len(db_starts[m.pk] | batch_starts[m.pk]) > 1:
+                raise ValidationError(
+                    _('The membership selected for "{item}" can not be used for another event at the same '
+                      'time.').format(item=str(p.item))
+                )
+
+
