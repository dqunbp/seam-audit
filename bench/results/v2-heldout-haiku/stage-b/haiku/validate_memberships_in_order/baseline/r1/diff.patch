+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it for that
+    position. Raises a ``ValidationError`` otherwise.
+
+    :param customer: The customer whose memberships may be used. ``None`` if there is no customer.
+    :param positions: The cart or order positions to check. Positions not requiring a membership are ignored.
+    :param event: The event the positions belong to.
+    :param lock: Lock the customer's membership rows until the surrounding transaction ends, so that concurrent
+                 purchases cannot exceed usage limits.
+    :param ignored_order: An existing order whose memberships usages should not be counted, e.g. because it is
+                          being changed right now.
+    :param testmode: Only memberships in the same test mode are considered.
+    :param valid_from_not_chosen: The start date of the positions has not been chosen yet, so only check that the
+                                  membership has not ended.
+    """
+    # Positions that require a membership, plus positions that use one, since a membership may only be used for
+    # products that allow its membership type
+    checked = [
+        p for p in positions
+        if p.used_membership_id or p.item.require_membership or (p.variation and p.variation.require_membership)
+    ]
+    if not checked:
+        return
+
+    if customer and lock:
+        list(customer.memberships.select_for_update(of=OF_SELF).all())
+
+    memberships = {}
+    if customer:
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order=ignored_order).filter(
+                testmode=testmode,
+            ).select_related('membership_type')
+        }
+
+    batch_usages = Counter(p.used_membership_id for p in checked if p.used_membership_id)
+
+    # Start times at which the memberships are already used by existing orders, for memberships that do not allow
+    # parallel usage
+    non_parallel_ids = [
+        pk for pk, m in memberships.items()
+        if pk in batch_usages and not m.membership_type.allow_parallel_usage
+    ]
+    taken = set()
+    if non_parallel_ids:
+        existing = OrderPosition.all.filter(
+            used_membership_id__in=non_parallel_ids,
+            canceled=False,
+        ).exclude(
+            order__status=Order.STATUS_CANCELED,
+        ).select_related('subevent', 'order__event')
+        if ignored_order:
+            existing = existing.exclude(order_id=ignored_order.pk)
+        taken = {
+            (op.used_membership_id, (op.subevent or op.order.event).date_from)
+            for op in existing
+        }
+
+    for p in checked:
+        if not p.used_membership_id:
+            raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+
+        m = memberships.get(p.used_membership_id)
+        if m is None:
+            raise ValidationError(_('The membership selected for the product "{item}" is not valid.').format(item=p.item))
+
+        if p.variation and p.variation.require_membership:
+            types = p.variation.require_membership_types.all()
+        else:
+            types = p.item.require_membership_types.all()
+        if m.membership_type not in types:
+            raise ValidationError(_('The product "{item}" cannot be purchased with the selected membership.').format(item=p.item))
+
+        ev = p.subevent or event
+        if not m.is_valid(ev, ticket_valid_from=getattr(p, 'override_valid_from', None) or p.valid_from,
+                          valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('The membership selected for the product "{item}" is not valid.').format(item=p.item))
+
+        mt = m.membership_type
+        if mt.max_usages is not None and m.usages + batch_usages[m.pk] > mt.max_usages:
+            raise ValidationError(_('The membership selected for the product "{item}" cannot be used any more times.').format(item=p.item))
+
+        if not mt.allow_parallel_usage:
+            key = (m.pk, ev.date_from)
+            if key in taken:
+                raise ValidationError(_('The membership selected for the product "{item}" is already used for another event '
+                                        'at the same time.').format(item=p.item))
+            taken.add(key)
+
+
 def create_membership(customer: Customer, position: OrderPosition):
     item = position.item
 
