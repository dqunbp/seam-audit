+def _required_membership_types(position: AbstractPosition):
+    """
+    Returns the membership types a position requires, or ``None`` if the position does not require a membership.
+    Mirrors the rules used by the membership selection form in the checkout flow.
+    """
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    if position.item.require_membership:
+        return position.item.require_membership_types.all()
+    return None
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it. Raises a
+    ``ValidationError`` for the first position that does not.
+
+    :param lock: Lock the customer's memberships until the surrounding transaction ends, so that concurrent purchases
+                 cannot exceed the usage limit of a membership.
+    :param ignored_order: Usages by this order are not counted, e.g. when the order is being changed.
+    :param testmode: Only memberships in the same test mode are accepted.
+    :param valid_from_not_chosen: The start date of the ticket is not known yet, so only check that the membership
+                                  has not ended yet.
+    """
+    required = []
+    for p in positions:
+        types = _required_membership_types(p)
+        if types is not None:
+            required.append((p, {t.pk for t in types}))
+        elif p.used_membership_id:
+            raise ValidationError(
+                _('The product "{item}" cannot be used together with a membership.').format(
+                    item=p.item,
+                )
+            )
+
+    if not required:
+        return
+
+    memberships = {}
+    if customer:
+        with transaction.atomic():
+            if lock:
+                list(customer.memberships.select_for_update(of=OF_SELF).order_by('pk').values_list('pk', flat=True))
+            memberships = {
+                m.pk: m for m in customer.memberships.with_usages(ignored_order).select_related('membership_type')
+            }
+
+    new_usages = Counter()
+    for p, allowed_type_ids in required:
+        m = memberships.get(p.used_membership_id) if p.used_membership_id else None
+        if m is None:
+            raise ValidationError(
+                _('The product "{item}" requires a valid membership, but no membership has been selected.').format(
+                    item=p.item,
+                )
+            )
+
+        ev = p.subevent or event
+        if (
+            m.membership_type_id not in allowed_type_ids
+            or m.testmode != testmode
+            or not m.is_valid(ev, p.valid_from, valid_from_not_chosen=valid_from_not_chosen)
+        ):
+            raise ValidationError(
+                _('The membership selected for the product "{item}" is not valid for this purchase.').format(
+                    item=p.item,
+                )
+            )
+
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + new_usages[m.pk] >= max_usages:
+            raise ValidationError(
+                _('The membership selected for the product "{item}" has no usages left.').format(
+                    item=p.item,
+                )
+            )
+        new_usages[m.pk] += 1
+
+
