+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _membership_allowed(position: AbstractPosition, membership: Membership, event: Event, testmode: bool,
+                        valid_from_not_chosen: bool) -> bool:
+    if position.variation and position.variation.require_membership:
+        allowed_types = position.variation.require_membership_types.all()
+    else:
+        allowed_types = position.item.require_membership_types.all()
+
+    if membership.membership_type not in allowed_types or membership.testmode != testmode:
+        return False
+
+    # Mirrors the filter in MembershipForm, so that every membership offered in the checkout is accepted here
+    return membership.is_valid(
+        position.subevent or event,
+        position.valid_from,
+        valid_from_not_chosen=valid_from_not_chosen or position.item.validity_dynamic_start_choice,
+    )
+
+
+def _usages_conflict(a: AbstractPosition, a_event: Event, b: AbstractPosition, b_event: Event) -> bool:
+    if a.valid_from and a.valid_until and b.valid_from and b.valid_until:
+        return a.valid_from < b.valid_until and b.valid_from < a.valid_until
+    return (a.subevent or a_event).date_from == (b.subevent or b_event).date_from
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it, and that
+    the memberships used by the positions are not used beyond their limits. Raises a ``ValidationError`` otherwise.
+
+    :param customer: The customer the memberships need to belong to.
+    :param positions: The cart or order positions of the purchase.
+    :param event: The event the purchase is made for.
+    :param lock: Lock the customer's memberships until the surrounding transaction ends, so that two concurrent
+                 purchases cannot both use the last remaining usage of a membership.
+    :param ignored_order: An order whose existing membership usages are not counted, e.g. because it is being changed.
+    :param testmode: Whether the purchase is made in test mode. Only memberships in the same mode can be used.
+    :param valid_from_not_chosen: Only check that the membership has not expired, instead of checking that it covers
+                                  the validity start of the position. Used when the customer has not chosen the start yet.
+    """
+    positions = list(positions)
+    if not any(_requires_membership(p) or p.used_membership_id for p in positions):
+        return
+
+    memberships = {}
+    if customer:
+        qs = customer.memberships.with_usages(ignored_order=ignored_order).select_related('membership_type')
+        if lock:
+            qs = qs.select_for_update(of=OF_SELF)
+        memberships = {m.pk: m for m in qs}
+
+    used = {}  # membership id => positions of this purchase using it
+    for p in positions:
+        if not p.used_membership_id:
+            if _requires_membership(p):
+                raise ValidationError(
+                    _('The product "{item}" requires a valid membership, but none has been selected.').format(item=p.item)
+                )
+            continue
+
+        m = memberships.get(p.used_membership_id)
+        if m is None or not _membership_allowed(p, m, event, testmode, valid_from_not_chosen):
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this purchase.').format(item=p.item)
+            )
+        used.setdefault(m.pk, []).append(p)
+
+    for mid, ps in used.items():
+        m = memberships[mid]
+        if m.membership_type.max_usages is not None and m.usages + len(ps) > m.membership_type.max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" cannot be used for any more purchases.').format(item=ps[0].item)
+            )
+
+        if not m.membership_type.allow_parallel_usage:
+            with scopes_disabled():
+                existing = list(
+                    OrderPosition.all.filter(used_membership=m, canceled=False)
+                    .exclude(order__status=Order.STATUS_CANCELED)
+                    .select_related('order__event', 'subevent')
+                )
+            if ignored_order:
+                existing = [op for op in existing if op.order_id != ignored_order.pk]
+
+            for i, p in enumerate(ps):
+                conflicts = any(_usages_conflict(p, event, q, event) for q in ps[i + 1:]) or any(
+                    _usages_conflict(p, event, op, op.order.event) for op in existing
+                )
+                if conflicts:
+                    raise ValidationError(
+                        _('The membership selected for "{item}" cannot be used for multiple products at the same time.').format(item=p.item)
+                    )
+
