+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order=None, testmode=False, valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it, and that
+    no position uses a membership although its product does not require one. Raises a ``ValidationError`` otherwise.
+
+    :param lock: Lock the memberships involved, so that concurrent purchases cannot exceed their usage limits. Must be
+                 called within a transaction.
+    :param ignored_order: An order whose existing membership usages should not count against the limits, e.g. the
+                          order that is currently being changed.
+    :param testmode: Only memberships in the same mode (test or live) are accepted.
+    :param valid_from_not_chosen: The start of the validity of dynamic-start products is not chosen yet, so only
+                                  check that the membership has not ended yet.
+    """
+    required_message = _('Your cart includes a product that requires an active membership to be selected.')
+    invalid_message = _('The membership selected for a product in your cart is not valid for this purchase.')
+    usage_message = _('The membership selected for a product in your cart has already been used the maximum number '
+                      'of times.')
+    parallel_message = _('The membership selected for a product in your cart cannot be used for multiple events taking '
+                         'place at the same time.')
+    forbidden_message = _('A product in your cart uses a membership, but it does not require one.')
+
+    requiring = []
+    for p in positions:
+        if p.variation and p.variation.require_membership:
+            requires = True
+            types = p.variation.require_membership_types.all()
+        else:
+            requires = p.item.require_membership
+            types = p.item.require_membership_types.all()
+
+        if not requires:
+            if p.used_membership_id:
+                raise ValidationError(forbidden_message)
+            continue
+        requiring.append((p, {t.pk for t in types}))
+
+    if not requiring:
+        return
+
+    if not customer:
+        raise ValidationError(required_message)
+
+    used_ids = {p.used_membership_id for p, _types in requiring if p.used_membership_id}
+    if lock:
+        lock_objects(list(customer.memberships.filter(pk__in=used_ids, testmode=testmode)))
+
+    memberships = {
+        m.pk: m for m in customer.memberships.with_usages(ignored_order).select_related('membership_type').filter(
+            pk__in=used_ids, testmode=testmode,
+        )
+    }
+
+    new_usages = Counter()
+    new_slots = defaultdict(list)  # membership pk -> (start, event pk, subevent pk) of positions in this purchase
+    for p, allowed_type_ids in requiring:
+        if not p.used_membership_id:
+            raise ValidationError(required_message)
+
+        m = memberships.get(p.used_membership_id)
+        if not m or m.membership_type_id not in allowed_type_ids:
+            raise ValidationError(invalid_message)
+
+        ev = p.subevent or event
+        if not m.is_valid(
+            ev,
+            ticket_valid_from=p.valid_from,
+            valid_from_not_chosen=valid_from_not_chosen and p.item.validity_dynamic_start_choice,
+        ):
+            raise ValidationError(invalid_message)
+
+        new_usages[m.pk] += 1
+        if m.membership_type.max_usages is not None and m.usages + new_usages[m.pk] > m.membership_type.max_usages:
+            raise ValidationError(usage_message)
+
+        new_slots[m.pk].append((ev.date_from, event.pk, p.subevent_id))
+
+    # Memberships that do not allow parallel usage must not be used for events at the same time at different events
+    # or subevents. Usages by other orders are checked against the database, usages within this purchase above.
+    parallel_check_ids = [pk for pk, m in memberships.items() if not m.membership_type.allow_parallel_usage]
+    if parallel_check_ids:
+        with scopes_disabled():
+            existing = OrderPosition.all.filter(
+                used_membership_id__in=parallel_check_ids,
+                canceled=False,
+            ).exclude(
+                order__status=Order.STATUS_CANCELED,
+            ).select_related('subevent', 'order__event')
+            if ignored_order:
+                existing = existing.exclude(order=ignored_order)
+            slots = defaultdict(list)
+            for op in existing:
+                ev = op.subevent or op.order.event
+                slots[op.used_membership_id].append((ev.date_from, op.order.event_id, op.subevent_id))
+
+        for pk in parallel_check_ids:
+            for start, event_pk, subevent_pk in new_slots[pk]:
+                for other_start, other_event_pk, other_subevent_pk in slots[pk] + new_slots[pk]:
+                    if other_start == start and (other_event_pk, other_subevent_pk) != (event_pk, subevent_pk):
+                        raise ValidationError(parallel_message)
+
+
