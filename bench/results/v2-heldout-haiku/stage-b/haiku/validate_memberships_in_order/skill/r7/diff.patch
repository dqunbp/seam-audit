+from datetime import datetime
+from decimal import Decimal
+from zoneinfo import ZoneInfo
+
+import pytest
+from django.core.exceptions import ValidationError
+from django.db import transaction
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.i18n import language
+from pretix.base.models import (
+    CartPosition, Event, Item, Order, OrderPosition, Organizer,
+)
+from pretix.base.services.memberships import validate_memberships_in_order
+
+TZ = ZoneInfo('Europe/Berlin')
+
+
+@pytest.fixture(scope='function')
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+    o.settings.customer_accounts = True
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=datetime(2021, 4, 27, 10, 0, 0, 0, tzinfo=TZ),
+        date_to=datetime(2021, 4, 28, 10, 0, 0, 0, tzinfo=TZ),
+        presale_end=datetime(2221, 4, 28, 10, 0, 0, 0, tzinfo=TZ),
+        plugins='pretix.plugins.banktransfer'
+    )
+    event.settings.timezone = 'Europe/Berlin'
+    with scope(organizer=o), language('en'):
+        yield event
+
+
+@pytest.fixture
+def customer(event):
+    return event.organizer.customers.create(email="john@example.org")
+
+
+@pytest.fixture
+def membership_type(event):
+    return event.organizer.membership_types.create(name="Full pass")
+
+
+@pytest.fixture
+def membership(event, membership_type, customer):
+    return customer.memberships.create(
+        membership_type=membership_type,
+        date_start=datetime(2021, 4, 1, 0, 0, 0, 0, tzinfo=TZ),
+        date_end=datetime(2021, 4, 30, 23, 59, 59, 999999, tzinfo=TZ),
+    )
+
+
+@pytest.fixture
+def requiring_ticket(event, membership_type):
+    i = Item.objects.create(
+        event=event, name='Day ticket',
+        default_price=Decimal('23.00'),
+        admission=True,
+        require_membership=True,
+    )
+    i.require_membership_types.add(membership_type)
+    return i
+
+
+@pytest.fixture
+def plain_ticket(event):
+    return Item.objects.create(
+        event=event, name='Plain ticket',
+        default_price=Decimal('23.00'),
+        admission=True,
+    )
+
+
+def _cart_position(event, item, membership=None, **kwargs):
+    return CartPosition(event=event, item=item, price=Decimal('23.00'), used_membership=membership, **kwargs)
+
+
+@pytest.mark.django_db
+def test_valid(event, customer, membership, requiring_ticket):
+    validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_valid_locked(event, customer, membership, requiring_ticket):
+    with transaction.atomic():
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event,
+                                      lock=True)
+
+
+@pytest.mark.django_db
+def test_no_membership_given(event, customer, requiring_ticket):
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket)], event)
+    assert 'membership' in str(excinfo.value)
+
+
+@pytest.mark.django_db
+def test_no_customer(event, membership, requiring_ticket):
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(None, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_membership_of_other_customer(event, membership, requiring_ticket):
+    other = event.organizer.customers.create(email="jane@example.org")
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(other, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_membership_of_other_testmode(event, customer, membership, requiring_ticket):
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event,
+                                      testmode=True)
+
+
+@pytest.mark.django_db
+def test_membership_type_not_allowed(event, customer, membership, requiring_ticket):
+    membership.membership_type = event.organizer.membership_types.create(name="Other pass")
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_membership_not_valid_for_date(event, customer, membership, requiring_ticket):
+    membership.date_start = datetime(2021, 5, 1, 0, 0, 0, 0, tzinfo=TZ)
+    membership.date_end = datetime(2021, 5, 30, 23, 59, 59, 999999, tzinfo=TZ)
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_membership_date_not_checked_if_validity_not_chosen_yet(event, customer, membership, requiring_ticket):
+    membership.date_start = datetime(2050, 5, 1, 0, 0, 0, 0, tzinfo=TZ)
+    membership.date_end = datetime(2050, 5, 30, 23, 59, 59, 999999, tzinfo=TZ)
+    membership.save()
+    position = _cart_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [position], event)
+    validate_memberships_in_order(customer, [position], event, valid_from_not_chosen=True)
+
+
+@pytest.mark.django_db
+def test_max_usages_within_purchase(event, customer, membership, membership_type, requiring_ticket):
+    membership_type.max_usages = 1
+    membership_type.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [
+            _cart_position(event, requiring_ticket, membership),
+            _cart_position(event, requiring_ticket, membership),
+        ], event)
+
+
+@pytest.mark.django_db
+def test_max_usages_existing_order_and_ignored_order(event, customer, membership, membership_type, requiring_ticket):
+    membership_type.max_usages = 1
+    membership_type.save()
+    with scope(organizer=event.organizer):
+        order = Order.objects.create(
+            code='FOO', event=event, email='dummy@example.org', status=Order.STATUS_PENDING,
+            datetime=now(), expires=now(), total=Decimal('23.00'), customer=customer,
+            sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        )
+        OrderPosition.objects.create(
+            order=order, item=requiring_ticket, price=Decimal('23.00'), used_membership=membership,
+        )
+    position = _cart_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [position], event)
+    validate_memberships_in_order(customer, [position], event, ignored_order=order)
+
+
+@pytest.mark.django_db
+def test_no_parallel_usage(event, customer, membership, requiring_ticket):
+    positions = [_cart_position(event, requiring_ticket, membership) for _ in range(2)]
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, positions, event)
+
+
+@pytest.mark.django_db
+def test_parallel_usage_allowed(event, customer, membership, membership_type, requiring_ticket):
+    membership_type.allow_parallel_usage = True
+    membership_type.save()
+    positions = [_cart_position(event, requiring_ticket, membership) for _ in range(2)]
+    validate_memberships_in_order(customer, positions, event)
+
+
+@pytest.mark.django_db
+def test_membership_on_product_not_requiring_one(event, customer, membership, plain_ticket):
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(event, plain_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_plain_product_without_membership(event, customer, plain_ticket):
+    validate_memberships_in_order(customer, [_cart_position(event, plain_ticket)], event)
