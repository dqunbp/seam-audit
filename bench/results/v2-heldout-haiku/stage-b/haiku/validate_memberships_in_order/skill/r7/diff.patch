+def _requires_membership(position: AbstractPosition) -> bool:
+    return position.item.require_membership or bool(position.variation and position.variation.require_membership)
+
+
+def _allowed_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses one of the customer's memberships that is allowed for
+    it, and that a position not requiring one does not use a membership at all. Raises a ``ValidationError``
+    otherwise.
+
+    :param lock: Lock the memberships involved, so that concurrent purchases cannot use up the same membership.
+                 Must be called within a transaction.
+    :param ignored_order: An existing order whose membership usages are not counted, e.g. because it is being changed.
+    :param testmode: Only memberships in the same mode (test or live) are considered.
+    :param valid_from_not_chosen: The validity of the positions is not known yet, e.g. during the membership
+                                  selection step of the checkout.
+    """
+    positions = list(positions)
+    membership_ids = {p.used_membership_id for p in positions if p.used_membership_id}
+
+    for p in positions:
+        if p.used_membership_id and not _requires_membership(p):
+            raise ValidationError(_('The product "{item}" does not allow the use of a membership.').format(item=p.item))
+
+    if not any(_requires_membership(p) for p in positions):
+        return
+
+    if customer is None:
+        memberships = {}
+    else:
+        if lock and membership_ids:
+            lock_objects(list(customer.memberships.filter(pk__in=membership_ids)))
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order).filter(pk__in=membership_ids, testmode=testmode)
+        }
+
+    purchase_usages = Counter()
+    purchase_starts = defaultdict(set)
+
+    for p in positions:
+        if not _requires_membership(p):
+            continue
+
+        if not p.used_membership_id:
+            raise ValidationError(_('The product "{item}" requires a valid membership.').format(item=p.item))
+
+        m = memberships.get(p.used_membership_id)
+        ev = p.subevent or event
+        if (
+            m is None
+            or m.membership_type not in _allowed_membership_types(p)
+            or not m.is_valid(ev, p.valid_from, valid_from_not_chosen=valid_from_not_chosen)
+        ):
+            raise ValidationError(_('The membership used for "{item}" is not valid for this product.').format(item=p.item))
+
+        purchase_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + purchase_usages[m.pk] > max_usages:
+            raise ValidationError(_('The membership used for "{item}" has already been used the maximum number of '
+                                    'times.').format(item=p.item))
+
+        if not m.membership_type.allow_parallel_usage:
+            start = ev.date_from
+            if start in purchase_starts[m.pk]:
+                raise ValidationError(_('The membership used for "{item}" cannot be used for multiple events at the '
+                                        'same time.').format(item=p.item))
+            purchase_starts[m.pk].add(start)
+
+    for m in memberships.values():
+        if m.membership_type.allow_parallel_usage or not purchase_starts.get(m.pk):
+            continue
+        existing = OrderPosition.all.filter(
+            used_membership=m, canceled=False,
+        ).exclude(order__status=Order.STATUS_CANCELED).select_related('order__event', 'subevent')
+        if ignored_order:
+            existing = existing.exclude(order=ignored_order)
+        for op in existing:
+            if (op.subevent or op.order.event).date_from in purchase_starts[m.pk]:
+                raise ValidationError(_('The membership used for "{item}" cannot be used for multiple events at the '
+                                        'same time.').format(item=op.item))
