+@pytest.mark.django_db
+def test_validate_memberships_in_order_max_usages_within_cart(event, customer, membership, membership_type,
+                                                              requiring_ticket):
+    membership_type.max_usages = 1
+    membership_type.save()
+    cp1 = CartPosition(event=event, item=requiring_ticket, price=23, used_membership=membership)
+    cp2 = CartPosition(event=event, item=requiring_ticket, price=23, used_membership=membership)
+    validate_memberships_in_order(customer, [cp1], event)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [cp1, cp2], event)
