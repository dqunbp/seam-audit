+
+@pytest.mark.django_db
+def test_validate_memberships_in_order_expired(event, customer, membership, requiring_ticket):
+    membership.date_start -= timedelta(days=100)
+    membership.date_end -= timedelta(days=100)
+    membership.save()
+    cp = CartPosition(event=event, item=requiring_ticket, price=23, used_membership=membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [cp], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_in_order_not_yet_valid_with_start_not_chosen(event, customer, membership,
+                                                                           requiring_ticket):
+    membership.date_start = now() + timedelta(days=1)
+    membership.date_end = now() + timedelta(days=30)
+    membership.save()
+    cp = CartPosition(event=event, item=requiring_ticket, price=23, used_membership=membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [cp], event)
+    # The start date is not chosen yet, so only the membership not having ended counts at this step
+    validate_memberships_in_order(customer, [cp], event, valid_from_not_chosen=True)
+
+
