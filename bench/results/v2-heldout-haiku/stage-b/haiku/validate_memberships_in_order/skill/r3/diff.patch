 from datetime import timedelta
 from typing import List, Optional
 
@@ -83,3 +84,73 @@ def create_membership(customer: Customer, position: OrderPosition):
     )
 
 
+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that is valid for that
+    position and allows its item, and that the memberships are not used more often than their type allows.
+    Raises a ``ValidationError`` otherwise.
+
+    :param lock: Lock the customer's memberships so that concurrent purchases cannot exceed the usage limits.
+                 Must be called inside a database transaction.
+    :param ignored_order: Usages by this order are not counted, e.g. because it is being changed right now.
+    :param testmode: Only memberships in the given mode (test or live) are accepted.
+    :param valid_from_not_chosen: The start date of the products is not known yet, so only the end date of the
+                                  membership is checked.
+    """
+    if not any(p.used_membership_id or _requires_membership(p) for p in positions):
+        return
+
+    # Customer accounts may be disabled entirely, in which case no membership can be used. The customer's memberships
+    # are only read when there is something to check, so that a locked customer row is only needed when it matters.
+    memberships = {}
+    if customer is not None:
+        if lock:
+            # Locked before counting usages, so the count includes purchases committed in the meantime.
+            list(customer.memberships.select_for_update(of=OF_SELF).order_by('pk').values_list('pk', flat=True))
+
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order).filter(
+                canceled=False,
+                testmode=testmode,
+            ).select_related('membership_type')
+        }
+
+    # Usages by the positions in this cart or order that have not been counted in the database yet.
+    new_usages = Counter()
+    for p in positions:
+        if not _requires_membership(p):
+            if p.used_membership_id:
+                raise ValidationError(_('The product "{product}" cannot be used with a membership.').format(
+                    product=p.item.name,
+                ))
+            continue
+
+        m = memberships.get(p.used_membership_id)
+        if not m:
+            raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+
+        if p.variation and p.variation.require_membership:
+            types = p.variation.require_membership_types.all()
+        else:
+            types = p.item.require_membership_types.all()
+        if m.membership_type_id not in {t.pk for t in types}:
+            raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+
+        ev = p.subevent or event
+        if not m.is_valid(ev, p.valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+
+        new_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages and m.usages + new_usages[m.pk] > max_usages:
+            raise ValidationError(_('The membership "{name}" cannot be used for any more products.').format(
+                name=m.membership_type.name,
+            ))
+
+
