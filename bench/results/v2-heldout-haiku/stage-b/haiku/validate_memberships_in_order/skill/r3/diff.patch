+@pytest.mark.django_db
+def test_validate_memberships_in_order_no_membership_required(event, customer, membership):
+    ticket = Item.objects.create(event=event, name='Free', default_price=Decimal('0.00'), admission=True)
+    cp = CartPosition(event=event, item=ticket, price=0)
+    validate_memberships_in_order(None, [cp], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_in_order_valid(event, customer, membership, requiring_ticket):
+    cp = CartPosition(event=event, item=requiring_ticket, price=23, used_membership=membership)
+    validate_memberships_in_order(customer, [cp], event, lock=True, testmode=False)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_in_order_missing_membership(event, customer, membership, requiring_ticket):
+    cp = CartPosition(event=event, item=requiring_ticket, price=23)
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(customer, [cp], event)
+    assert 'membership' in str(excinfo.value.message)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_in_order_anonymous_customer(event, customer, membership, requiring_ticket):
+    cp = CartPosition(event=event, item=requiring_ticket, price=23, used_membership=membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(None, [cp], event)
+
+
