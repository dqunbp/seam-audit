@@ -83,3 +84,88 @@ def create_membership(customer: Customer, position: OrderPosition):
     )
 
 
+def _required_membership_types(position: AbstractPosition):
+    if position.variation and position.variation.require_membership:
+        return position.variation.require_membership_types.all()
+    return position.item.require_membership_types.all()
+
+
+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it. Raises a
+    ``ValidationError`` with a user-facing message otherwise.
+
+    :param lock: Lock the memberships involved, so that concurrent purchases cannot both use the last usage.
+    :param ignored_order: Usages by this order are not counted, e.g. when the order is being changed.
+    :param testmode: Only memberships in this mode are accepted.
+    :param valid_from_not_chosen: Only check that the membership has not ended, not that it covers the start of the
+                                  position. See ``Membership.is_valid``.
+    """
+    if not any(p.used_membership_id or _requires_membership(p) for p in positions):
+        return
+
+    if lock:
+        with transaction.atomic():
+            membership_ids = {p.used_membership_id for p in positions if p.used_membership_id}
+            list(Membership.objects.select_for_update(of=OF_SELF).filter(pk__in=membership_ids).order_by('pk'))
+            _check_memberships(customer, positions, event, ignored_order, testmode, valid_from_not_chosen)
+    else:
+        _check_memberships(customer, positions, event, ignored_order, testmode, valid_from_not_chosen)
+
+
+def _check_memberships(customer, positions, event, ignored_order, testmode, valid_from_not_chosen):
+    customer_pk = customer.pk if customer else None
+    used_in_batch = defaultdict(list)  # membership pk -> (membership, start of the event)
+
+    for p in positions:
+        if not _requires_membership(p):
+            # A membership must not be attached to a product that does not accept one
+            if p.used_membership_id:
+                raise ValidationError(_('The selected membership cannot be used for this product.'))
+            continue
+
+        if not p.used_membership_id:
+            raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+
+        m = p.used_membership
+        if m.customer_id != customer_pk or m.testmode != testmode:
+            raise ValidationError(_('The selected membership cannot be used for this purchase.'))
+
+        if m.membership_type_id not in {t.pk for t in _required_membership_types(p)}:
+            raise ValidationError(_('The selected membership cannot be used for this product.'))
+
+        ev = p.subevent or event
+        if not m.is_valid(ev, p.valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('The selected membership is not valid for this product.'))
+
+        used_in_batch[m.pk].append((m, ev.date_from))
+
+    for membership_pk, entries in used_in_batch.items():
+        m = entries[0][0]
+        existing = OrderPosition.all.filter(
+            used_membership_id=membership_pk,
+            canceled=False,
+        ).exclude(
+            order__status=Order.STATUS_CANCELED,
+        ).select_related('subevent', 'order__event')
+        if ignored_order:
+            existing = existing.exclude(order=ignored_order)
+        existing_starts = [(op.subevent or op.order.event).date_from for op in existing]
+        batch_starts = [start for _m, start in entries]
+
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and len(existing_starts) + len(batch_starts) > max_usages:
+            raise ValidationError(_('The selected membership has already been used the maximum number of times.'))
+
+        if not m.membership_type.allow_parallel_usage and (
+            len(set(batch_starts)) != len(batch_starts) or set(batch_starts) & set(existing_starts)
+        ):
+            raise ValidationError(_('The selected membership cannot be used for multiple products at the same time.'))
+
+
