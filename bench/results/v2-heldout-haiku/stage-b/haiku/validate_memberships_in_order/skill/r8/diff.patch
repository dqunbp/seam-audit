+
+def _membership_position(event, item, membership=None, **kwargs):
+    return CartPosition(event=event, item=item, price=Decimal('23.00'), used_membership=membership, **kwargs)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_not_required(event, customer):
+    item = Item.objects.create(event=event, name='Plain', default_price=Decimal('23.00'), admission=True)
+    validate_memberships_in_order(customer, [_membership_position(event, item)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_valid(event, customer, membership, requiring_ticket):
+    validate_memberships_in_order(customer, [_membership_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_missing(event, customer, requiring_ticket):
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(customer, [_membership_position(event, requiring_ticket)], event)
+    assert 'membership' in excinfo.value.message
+
+
+@pytest.mark.django_db
+def test_validate_memberships_no_customer(event, membership, requiring_ticket):
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(None, [_membership_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_other_customer(event, customer, membership, requiring_ticket):
+    other = event.organizer.customers.create(email="jane@example.org")
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(other, [_membership_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_type_not_allowed(event, customer, requiring_ticket):
+    other_type = event.organizer.membership_types.create(name="Other")
+    other_membership = customer.memberships.create(
+        membership_type=other_type,
+        date_start=datetime(2021, 4, 1, 0, 0, 0, 0, tzinfo=TZ),
+        date_end=datetime(2021, 4, 30, 23, 59, 59, 999999, tzinfo=TZ),
+    )
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_membership_position(event, requiring_ticket, other_membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_expired(event, customer, membership, requiring_ticket):
+    membership.date_end = datetime(2021, 4, 10, 23, 59, 59, 999999, tzinfo=TZ)
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_membership_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_valid_from_not_chosen(event, customer, membership, requiring_ticket):
+    # Starts in the future, so not valid for the event date, but it has not ended yet
+    membership.date_start = now() + timedelta(days=10)
+    membership.date_end = now() + timedelta(days=40)
+    membership.save()
+    p = _membership_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [p], event)
+    validate_memberships_in_order(customer, [p], event, valid_from_not_chosen=True)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_testmode(event, customer, membership, requiring_ticket):
+    membership.testmode = True
+    membership.save()
+    p = _membership_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [p], event, testmode=False)
+    validate_memberships_in_order(customer, [p], event, testmode=True)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_max_usages_in_same_purchase(event, customer, membership, requiring_ticket):
+    membership.membership_type.max_usages = 1
