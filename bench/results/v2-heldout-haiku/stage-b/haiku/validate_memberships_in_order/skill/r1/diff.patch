     )
 
 
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it for that
+    position and raises a ``ValidationError`` otherwise.
+
+    ``lock`` takes row locks on the memberships in use, so concurrent checkouts cannot exceed their usage limits.
+    ``ignored_order`` is excluded from existing usages (used when an order is changed). ``valid_from_not_chosen``
+    skips the date check against the position's validity, as the start date is not yet known in the membership step
+    of the checkout.
+    """
+    membership_ids = {p.used_membership_id for p in positions if p.used_membership_id}
+    if lock and membership_ids:
+        list(Membership.objects.select_for_update(of=OF_SELF).filter(pk__in=membership_ids))
+
+    memberships = {}
+    if customer and membership_ids:
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order).filter(
+                pk__in=membership_ids, canceled=False, testmode=testmode,
+            ).select_related('membership_type')
+        }
+
+    batch_usages = defaultdict(int)
+    batch_start_times = defaultdict(set)
+    for p in positions:
+        required = p.item.require_membership or bool(p.variation and p.variation.require_membership)
+        if p.variation and p.variation.require_membership:
+            allowed_types = p.variation.require_membership_types.all()
+        else:
+            allowed_types = p.item.require_membership_types.all()
+        ev = p.subevent or event
+
+        if not p.used_membership_id:
+            if required:
+                raise ValidationError(_('Your cart includes a product that requires an active membership to be selected.'))
+            continue
+        if not required:
+            # A membership may only be attached to products that grant access to something requiring one
+            raise ValidationError(_('The membership used for a product in your cart is not valid for this product.'))
+
+        m = memberships.get(p.used_membership_id)
+        if not m or m.membership_type not in allowed_types:
+            raise ValidationError(_('The membership used for a product in your cart is not valid for this product.'))
+        if not m.is_valid(ev=ev, ticket_valid_from=p.valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(_('The membership used for a product in your cart is not valid for the date of this product.'))
+
+        # Usages by other orders are counted in the query above, usages within this purchase are counted here
+        batch_usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and m.usages + batch_usages[m.pk] > max_usages:
+            raise ValidationError(_('The membership used for a product in your cart has already been used the maximum number of times.'))
+
+        # Without parallel usage, one membership may only be used for one event starting at a given time
+        if not m.membership_type.allow_parallel_usage:
+            if ev.date_from in batch_start_times[m.pk]:
+                raise ValidationError(_('The membership used for a product in your cart cannot be used for multiple events starting at the same time.'))
+            batch_start_times[m.pk].add(ev.date_from)
+
+
