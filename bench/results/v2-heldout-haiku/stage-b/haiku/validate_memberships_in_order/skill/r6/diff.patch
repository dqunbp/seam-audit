     assert m.date_end == datetime(2021, 4, 28, 10, 0, 0, 0, tzinfo=TZ)
+
+
+def _cart_position(event, item, membership=None, **kwargs):
+    return CartPosition(
+        event=event, item=item, price=23, expires=now() + timedelta(days=1), cart_id="123",
+        used_membership=membership, **kwargs
+    )
+
+
+def _order(event, customer, code):
+    return Order.objects.create(
+        event=event, email='dummy@example.org', status=Order.STATUS_PAID, datetime=now(), expires=now(),
+        total=Decimal('23.00'), code=code, customer=customer,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+
+
+@pytest.mark.django_db
+def test_validate_memberships_no_membership_required(event, customer, granting_ticket):
+    validate_memberships_in_order(customer, [_cart_position(event, granting_ticket)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_none_selected(event, customer, requiring_ticket):
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket)], event)
+    assert 'membership' in excinfo.value.message
+
+
+@pytest.mark.django_db
+def test_validate_memberships_no_customer(event, requiring_ticket):
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(None, [_cart_position(event, requiring_ticket)], event)
+    assert 'membership' in excinfo.value.message
+
+
+@pytest.mark.django_db
+def test_validate_memberships_valid(event, customer, membership, requiring_ticket):
+    validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_other_customer(event, customer, membership, requiring_ticket):
+    other = event.organizer.customers.create(email="jane@example.org")
+    other_membership = other.memberships.create(
+        membership_type=membership.membership_type,
+        date_start=membership.date_start,
+        date_end=membership.date_end,
+    )
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, other_membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_wrong_type(event, customer, membership, requiring_ticket):
+    membership.membership_type = event.organizer.membership_types.create(name="Week pass")
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_testmode_mismatch(event, customer, membership, requiring_ticket):
+    membership.testmode = True
+    membership.save()
+    p = _cart_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [p], event)
+    validate_memberships_in_order(customer, [p], event, testmode=True)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_expired(event, customer, membership, requiring_ticket):
+    membership.date_start -= timedelta(days=100)
+    membership.date_end -= timedelta(days=100)
+    membership.save()
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event)
+    assert 'membership' in excinfo.value.message
+
+
+@pytest.mark.django_db
+def test_validate_memberships_canceled(event, customer, membership, requiring_ticket):
+    membership.canceled = True
+    membership.save()
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [_cart_position(event, requiring_ticket, membership)], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_valid_from_not_chosen(event, customer, membership, requiring_ticket):
+    membership.date_start = datetime(2221, 5, 1, 0, 0, 0, 0, tzinfo=TZ)
+    membership.date_end = datetime(2221, 6, 1, 0, 0, 0, 0, tzinfo=TZ)
+    membership.save()
+    p = _cart_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [p], event)
+    validate_memberships_in_order(customer, [p], event, valid_from_not_chosen=True)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_max_usages_in_batch(event, customer, membership, requiring_ticket, membership_type):
+    membership_type.max_usages = 1
+    membership_type.save()
+    p1 = _cart_position(event, requiring_ticket, membership)
+    p2 = _cart_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError) as excinfo:
+        validate_memberships_in_order(customer, [p1, p2], event)
+    assert 'membership' in excinfo.value.message
+
+
+@pytest.mark.django_db
+def test_validate_memberships_max_usages_existing_order(event, customer, membership, requiring_ticket, membership_type):
+    membership_type.max_usages = 1
+    membership_type.save()
+    order = _order(event, customer, 'MEMB1')
+    OrderPosition.objects.create(
+        order=order, item=requiring_ticket, price=23, positionid=1, used_membership=membership,
+    )
+    p = _cart_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [p], event)
+    # The usage of the order being changed does not count against the membership
+    validate_memberships_in_order(customer, [p], event, ignored_order=order)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_parallel_usage_same_start(event, customer, membership, requiring_ticket):
+    p1 = _cart_position(event, requiring_ticket, membership)
+    p2 = _cart_position(event, requiring_ticket, membership)
+    with pytest.raises(ValidationError):
+        validate_memberships_in_order(customer, [p1, p2], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_parallel_usage_allowed(event, customer, membership, requiring_ticket, membership_type):
+    membership_type.allow_parallel_usage = True
+    membership_type.save()
+    p1 = _cart_position(event, requiring_ticket, membership)
+    p2 = _cart_position(event, requiring_ticket, membership)
+    validate_memberships_in_order(customer, [p1, p2], event)
+
+
+@pytest.mark.django_db
+def test_validate_memberships_parallel_usage_other_order_same_time(event, customer, membership, requiring_ticket):
+    order = _order(event, customer, 'MEMB2')
