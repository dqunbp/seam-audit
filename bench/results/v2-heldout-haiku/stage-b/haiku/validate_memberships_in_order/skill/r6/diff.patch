+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that allows it for this
+    purchase. Raises a ``ValidationError`` with a user-facing message otherwise.
+
+    ``positions`` may be cart positions or order positions. ``ignored_order`` is excluded from the usage counts and
+    the parallel usage check, which is needed when an existing order is being changed. ``lock`` locks the
+    customer's memberships and must be called within a database transaction. ``valid_from_not_chosen`` skips the
+    start date check, as the customer has not picked one yet.
+    """
+    # Positions requiring a membership must have one, and any position with a membership must be allowed to use it
+    relevant = [
+        p for p in positions
+        if p.used_membership_id or p.item.require_membership or (p.variation and p.variation.require_membership)
+    ]
+    if not relevant:
+        return
+
+    memberships = {}
+    if customer:
+        qs = customer.memberships.with_usages(ignored_order=ignored_order).select_related('membership_type')
+        if lock:
+            qs = qs.select_for_update(of=OF_SELF)
+        memberships = {m.pk: m for m in qs}
+
+    # Positions that are already stored as order positions are counted in the database usages already
+    persisted_pks = [p.pk for p in relevant if isinstance(p, OrderPosition)]
+    pending_usages = {}
+    batch_by_membership = {}
+
+    for p in relevant:
+        item_name = str(p.item.name)
+        if p.used_membership_id is None:
+            raise ValidationError(
+                _('The product "{item}" requires an active membership to be selected.').format(item=item_name)
+            )
+
+        m = memberships.get(p.used_membership_id)
+        if m is None:
+            raise ValidationError(
+                _('The membership selected for "{item}" cannot be used for this product.').format(item=item_name)
+            )
+
+        if p.variation and p.variation.require_membership:
+            allowed_types = p.variation.require_membership_types.all()
+        else:
+            allowed_types = p.item.require_membership_types.all()
+
+        if m.membership_type not in allowed_types or m.testmode != testmode:
+            raise ValidationError(
+                _('The membership selected for "{item}" cannot be used for this product.').format(item=item_name)
+            )
+
+        if not m.is_valid(p.subevent or event, p.valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(
+                _('The membership selected for "{item}" is not valid for this event (valid from {start} to {end}).').format(
+                    item=item_name,
+                    start=date_format(m.date_start, 'SHORT_DATE_FORMAT'),
+                    end=date_format(m.date_end, 'SHORT_DATE_FORMAT'),
+                )
+            )
+
+        if not isinstance(p, OrderPosition):
+            pending_usages[m.pk] = pending_usages.get(m.pk, 0) + 1
+        batch_by_membership.setdefault(m.pk, []).append(p)
+
+    for m_pk, count in pending_usages.items():
+        m = memberships[m_pk]
+        if m.membership_type.max_usages is not None and m.usages + count > m.membership_type.max_usages:
+            raise ValidationError(
+                _('The membership selected for "{item}" has no usages left.').format(
+                    item=str(batch_by_membership[m_pk][0].item.name),
+                )
+            )
+
+    for m_pk, batch in batch_by_membership.items():
+        m = memberships[m_pk]
+        if m.membership_type.allow_parallel_usage:
+            continue
+
+        # Start times of the events this membership is already used for by other orders, plus this purchase
+        existing = OrderPosition.all.filter(
+            used_membership_id=m_pk,
+            canceled=False,
+        ).exclude(
+            order__status=Order.STATUS_CANCELED,
+        ).exclude(
+            pk__in=persisted_pks,
+        ).select_related('subevent', 'order__event')
+        if ignored_order:
+            existing = existing.exclude(order__id=ignored_order.pk)
+
+        starts = [(op.subevent or op.order.event).date_from for op in existing]
+        starts += [(p.subevent or event).date_from for p in batch]
+        if len(starts) != len(set(starts)):
+            raise ValidationError(
+                _('The membership selected for "{item}" cannot be used for events taking place at the same time.').format(
+                    item=str(batch[0].item.name),
+                )
+            )
