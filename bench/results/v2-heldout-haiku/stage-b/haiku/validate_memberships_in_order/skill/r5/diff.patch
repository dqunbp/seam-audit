+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Raise a ``ValidationError`` unless no position without a membership requirement uses a membership, and every
+    position that requires a membership uses a membership of ``customer`` that allows it: not canceled, of the same
+    test mode, valid for the position (or, with ``valid_from_not_chosen``, not yet expired since the validity start is
+    still open), of an allowed membership type, within its usage limit, and not used for another event starting at the
+    same time unless the type allows parallel usage. Attendee names are not checked here, since checkout only asks for
+    them after the membership step.
+
+    Usages of ``ignored_order`` are not counted. With ``lock``, the customer row is locked so that two concurrent
+    purchases cannot both take the last free usage. This needs to run inside a database transaction.
+    """
+    for p in positions:
+        if p.used_membership_id and not _requires_membership(p):
+            raise ValidationError(
+                _('The product "{product}" can not be purchased with a membership.').format(product=str(p.item))
+            )
+
+    required = [p for p in positions if _requires_membership(p)]
+    if not required:
+        return
+
+    if customer and lock:
+        list(Customer.objects.select_for_update(of=OF_SELF).filter(pk=customer.pk))
+
+    if customer:
+        memberships = {
+            m.pk: m for m in customer.memberships.with_usages(ignored_order=ignored_order).filter(
+                canceled=False, testmode=testmode,
+            ).select_related('membership_type')
+        }
+    else:
+        memberships = {}
+
+    # Stored positions of other orders are already part of ``m.usages``, cart positions and the stored positions of
+    # ``ignored_order`` are not, so only the latter ones count as new usages below
+    def in_db(p):
+        return isinstance(p, OrderPosition) and p.pk and not (ignored_order and p.order_id == ignored_order.pk)
+
+    counted_in_db = {p.pk for p in required if in_db(p)}
+    new_usages = Counter()
+    batch_starts = Counter()
+    existing_starts = {}
+
+    for p in required:
+        product = str(p.item)
+        if not p.used_membership_id:
+            raise ValidationError(
+                _('You selected the product "{product}" which requires an active membership to be selected.').format(
+                    product=product
+                )
+            )
+
+        m = memberships.get(p.used_membership_id)
+        if m is None:
+            raise ValidationError(
+                _('The membership selected for the product "{product}" is not valid for this purchase.').format(
+                    product=product
+                )
+            )
+
+        ev = p.subevent or event
+        if not m.is_valid(
+            ev=ev,
+            ticket_valid_from=None if valid_from_not_chosen else p.valid_from,
+            valid_from_not_chosen=valid_from_not_chosen,
+        ):
+            raise ValidationError(
+                _('The membership selected for the product "{product}" is not valid for the selected date.').format(
+                    product=product
+                )
+            )
+
+        types = list(p.variation.require_membership_types.all()) if p.variation else []
+        if not types:
+            types = list(p.item.require_membership_types.all())
+        if types and m.membership_type_id not in {t.pk for t in types}:
+            raise ValidationError(
+                _('The membership selected for the product "{product}" is not of an allowed membership type.').format(
+                    product=product
+                )
+            )
+
+        if not in_db(p):
+            new_usages[m.pk] += 1
+            if m.membership_type.max_usages is not None and m.usages + new_usages[m.pk] > m.membership_type.max_usages:
+                raise ValidationError(
+                    _('The membership selected for the product "{product}" has no usages left.').format(
+                        product=product
+                    )
+                )
+
+        if not m.membership_type.allow_parallel_usage:
+            if m.pk not in existing_starts:
+                others = OrderPosition.all.filter(
+                    used_membership_id=m.pk, canceled=False,
+                ).exclude(
+                    order__status=Order.STATUS_CANCELED,
+                ).exclude(
+                    pk__in=counted_in_db,
+                ).select_related('subevent', 'order__event')
+                if ignored_order:
+                    others = others.exclude(order_id=ignored_order.pk)
+                existing_starts[m.pk] = {
+                    (op.subevent.date_from if op.subevent_id else op.order.event.date_from) for op in others
+                }
+            key = (m.pk, ev.date_from)
+            if ev.date_from in existing_starts[m.pk] or batch_starts[key]:
+                raise ValidationError(
+                    _('The membership selected for the product "{product}" can not be used for multiple events at '
+                      'the same time.').format(product=product)
+                )
+            batch_starts[key] += 1
+
+
