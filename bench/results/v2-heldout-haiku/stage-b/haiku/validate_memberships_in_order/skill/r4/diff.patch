+def test_membership_validation_not_required(event, customer):
+    item = Item.objects.create(event=event, name='Free entry', default_price=Decimal('23.00'))
+    validate_memberships_in_order(None, [_cart_position(event, item)], event)
+    validate_memberships_in_order(customer, [_cart_position(event, item)], event)
