+def _cart_position(event, item, membership=None, subevent=None):
+    return CartPosition(event=event, item=item, price=Decimal('23.00'), used_membership=membership, subevent=subevent)
+
+
+def _paid_order_with_position(event, item, membership, code='FOO', status=Order.STATUS_PAID, subevent=None):
+    order = Order.objects.create(
+        code=code, event=event, email='dummy@example.org',
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        status=status, datetime=now(), expires=now() + timedelta(days=10),
+        total=Decimal("23"), locale='en', testmode=membership.testmode,
+    )
+    op = OrderPosition.objects.create(
+        order=order, item=item, price=Decimal('23.00'), used_membership=membership, subevent=subevent,
+    )
+    return order, op
+
