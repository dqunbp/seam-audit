+def _requires_membership(position: AbstractPosition) -> bool:
+    return bool(position.item.require_membership or (position.variation and position.variation.require_membership))
+
+
+def _allowed_membership_type_ids(position: AbstractPosition) -> set:
+    # Mirrors the lookup in MembershipForm, so the checkout and the final validation agree
+    if position.variation and position.variation.require_membership:
+        types = position.variation.require_membership_types.all()
+    else:
+        types = position.item.require_membership_types.all()
+    return {t.pk for t in types}
+
+
+def validate_memberships_in_order(customer: Optional[Customer], positions: List[AbstractPosition], event: Event,
+                                  lock=False, ignored_order: Optional[Order] = None, testmode=False,
+                                  valid_from_not_chosen=False):
+    """
+    Checks that every position requiring a membership uses a membership of ``customer`` that permits it: it must
+    be of an allowed type, not canceled, in the same test mode, valid for the position, within its usage limit and
+    not used for another event at the same time (unless parallel usage is allowed). Raises a ``ValidationError``
+    otherwise.
+
+    ``lock`` locks the membership rows until the end of the transaction, so concurrent purchases cannot both use the
+    last remaining usage. Must then be called inside an atomic block.
+
+    ``ignored_order`` is not counted as an existing usage, e.g. when the order itself is being changed.
+
+    ``valid_from_not_chosen`` only checks that the membership has not ended yet, for checkout steps before the start
+    date of the product has been chosen.
+    """
+    required = []
+    for p in positions:
+        if _requires_membership(p):
+            required.append(p)
+        elif p.used_membership_id:
+            raise ValidationError(
+                _('The product "{item}" does not require a membership, so no membership can be used for it.').format(
+                    item=p.item,
+                )
+            )
+    if not required:
+        return
+
+    not_satisfied = _('Your cart includes a product that requires an active membership to be selected.')
+
+    memberships = {}
+    if customer:
+        membership_pks = {p.used_membership_id for p in required if p.used_membership_id}
+        if membership_pks:
+            qs = customer.memberships.filter(pk__in=membership_pks).select_related('membership_type')
+            if lock:
+                qs = qs.select_for_update(of=OF_SELF)
+            memberships = {m.pk: m for m in qs}
+
+    # Usages by other orders. We query the positions directly instead of using ``with_usages``, since that cannot
+    # exclude the positions of this very purchase when they are already saved as order positions.
+    own_position_pks = [p.pk for p in required if isinstance(p, OrderPosition) and p.pk]
+    usages = Counter()
+    taken = defaultdict(set)  # membership pk -> start dates of events it is already used for
+    if memberships:
+        existing = OrderPosition.all.filter(
+            used_membership_id__in=memberships.keys(),
+            canceled=False,
+        ).exclude(
+            order__status=Order.STATUS_CANCELED,
+        ).exclude(
+            pk__in=own_position_pks,
+        ).select_related('subevent', 'order__event')
+        if ignored_order:
+            existing = existing.exclude(order=ignored_order)
+        for op in existing:
+            usages[op.used_membership_id] += 1
+            taken[op.used_membership_id].add((op.subevent or op.order.event).date_from)
+
+    for p in required:
+        m = memberships.get(p.used_membership_id)
+        if not m or m.canceled or m.testmode != testmode or m.membership_type_id not in _allowed_membership_type_ids(p):
+            raise ValidationError(not_satisfied)
+
+        ev = p.subevent or event
+        if not m.is_valid(ev, p.valid_from, valid_from_not_chosen=valid_from_not_chosen):
+            raise ValidationError(
+                _('The membership "{membership}" is not valid for the product "{item}".').format(
+                    membership=m.membership_type, item=p.item,
+                )
+            )
+
+        usages[m.pk] += 1
+        max_usages = m.membership_type.max_usages
+        if max_usages is not None and usages[m.pk] > max_usages:
+            raise ValidationError(
+                _('The membership "{membership}" can not be used for any more purchases.').format(
+                    membership=m.membership_type,
+                )
+            )
+
+        if not m.membership_type.allow_parallel_usage:
+            if ev.date_from in taken[m.pk]:
+                raise ValidationError(
+                    _('The membership "{membership}" can not be used for more than one event at the same time.').format(
+                        membership=m.membership_type,
+                    )
+                )
+            taken[m.pk].add(ev.date_from)
+
+
