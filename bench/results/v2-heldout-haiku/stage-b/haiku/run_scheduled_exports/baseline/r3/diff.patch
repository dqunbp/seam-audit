+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_event_export(event, user):
+    s = _create_event_schedule(event, user, schedule_next_run=datetime(2023, 1, 18, 3, 0, tzinfo=timezone.utc))
+    with freeze_time("2023-01-18 03:00:30+00:00"), patch.object(scheduled_event_export, "apply_async") as apply:
+        run_scheduled_exports(None)
+    apply.assert_called_once_with(kwargs={"event": event.pk, "schedule": s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run == datetime(2023, 1, 19, 3, 0, tzinfo=timezone.utc)  # 04:00 Europe/Berlin
