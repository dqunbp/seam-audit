diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..9bfeb20 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,29 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # Claim all due schedules (event-level and organizer-level) and advance their next run before queueing anything.
+    # The claim happens inside a transaction with row locks, so overlapping runs of the periodic task never pick up the
+    # same schedule. Tasks are only queued after the transaction has been committed, so workers can see the new state.
+    to_dispatch = []
+    with transaction.atomic():
+        for model, task, parent in (
+            (ScheduledEventExport, scheduled_event_export, 'event'),
+            (ScheduledOrganizerExport, scheduled_organizer_export, 'organizer'),
+        ):
+            qs = model.objects.filter(
+                schedule_next_run__lte=now(),
+            ).select_related(parent).select_for_update(
+                of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+            )
+            for schedule in qs:
+                schedule.compute_next_run()
+                schedule.save(update_fields=['schedule_next_run'])
+                to_dispatch.append((task, {parent: getattr(schedule, f'{parent}_id'), 'schedule': schedule.pk}))
+
+    for task, kwargs in to_dispatch:
+        task.apply_async(kwargs=kwargs)
+
+
