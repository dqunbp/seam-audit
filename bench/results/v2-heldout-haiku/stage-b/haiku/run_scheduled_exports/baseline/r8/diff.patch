+@pytest.mark.django_db
+def test_run_scheduled_exports_advances_past_missed_runs(event, event_schedule, queued_tasks):
+    # Schedule was due a week ago (e.g. the periodic job was down); it runs once now and the next run is in
+    # the future, not one per missed day.
+    ScheduledEventExport.objects.filter(pk=event_schedule.pk).update(
+        schedule_next_run=now() - timedelta(days=7)
+    )
+
+    run_scheduled_exports(sender=None)
+
+    assert len(queued_tasks) == 1
+    event_schedule.refresh_from_db()
+    assert event_schedule.schedule_next_run > now()
