+@pytest.mark.django_db
+def test_run_scheduled_exports_not_due_yet(event, event_schedule, organizer_schedule, queued_tasks):
+    future = now() + timedelta(hours=3)
+    ScheduledEventExport.objects.filter(pk=event_schedule.pk).update(schedule_next_run=future)
+    ScheduledOrganizerExport.objects.filter(pk=organizer_schedule.pk).update(schedule_next_run=future)
+
+    run_scheduled_exports(sender=None)
+
+    assert queued_tasks == []
+    event_schedule.refresh_from_db()
+    organizer_schedule.refresh_from_db()
+    assert event_schedule.schedule_next_run == future
+    assert organizer_schedule.schedule_next_run == future
