+@pytest.fixture
+def queued_tasks(monkeypatch):
+    """
+    Records what run_scheduled_exports dispatches instead of running the export tasks.
+    """
+    calls = []
+
+    def fake_apply_async(task_name):
+        def _apply_async(kwargs=None, **kw):
+            calls.append((task_name, kwargs))
+        return _apply_async
+
+    monkeypatch.setattr(export_service.scheduled_event_export, 'apply_async', fake_apply_async('event'))
+    monkeypatch.setattr(export_service.scheduled_organizer_export, 'apply_async', fake_apply_async('organizer'))
+    return calls
+
