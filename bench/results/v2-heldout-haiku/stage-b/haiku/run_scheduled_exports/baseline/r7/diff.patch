+    ScheduledOrganizerExport.objects.filter(pk=scheduled_organizer_export.pk).update(schedule_next_run=next_run)
+    with freeze_time("2023-01-19 12:00:00"), \
+            patch.object(export_service.scheduled_event_export, 'apply_async') as m1, \
