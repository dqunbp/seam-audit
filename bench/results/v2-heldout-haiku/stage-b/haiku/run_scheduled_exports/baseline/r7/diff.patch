diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..fc10584 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,37 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Dispatch all scheduled exports (event-level and organizer-level) whose next run is due. The next run is
+    computed and stored before the export task is dispatched, so the same schedule is not picked up again by a
+    subsequent periodic run while the export is still being generated.
+    """
+    with transaction.atomic():
+        for schedule in ScheduledEventExport.objects.select_for_update(
+            of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+        ).filter(schedule_next_run__lte=now()):
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            scheduled_event_export.apply_async(
+                kwargs={
+                    'event': schedule.event_id,
+                    'schedule': schedule.pk,
+                },
+            )
+
+        for schedule in ScheduledOrganizerExport.objects.select_for_update(
+            of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+        ).filter(schedule_next_run__lte=now()):
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            scheduled_organizer_export.apply_async(
+                kwargs={
+                    'organizer': schedule.organizer_id,
+                    'schedule': schedule.pk,
+                },
+            )
+
+
