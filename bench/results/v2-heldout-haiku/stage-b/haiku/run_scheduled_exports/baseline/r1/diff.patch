diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..a8b329c 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,33 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Queue all scheduled exports (event-level and organizer-level) that are due. The next run is computed and
+    stored before queueing, so each occurrence is queued only once, and occurrences missed while the system was
+    down are skipped instead of being caught up on.
+    """
+    with transaction.atomic():
+        for s in ScheduledEventExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked):
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+            scheduled_event_export.apply_async(kwargs={
+                'event': s.event_id,
+                'schedule': s.pk,
+            })
+
+        for s in ScheduledOrganizerExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked):
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+            scheduled_organizer_export.apply_async(kwargs={
+                'organizer': s.organizer_id,
+                'schedule': s.pk,
+            })
+
+
