@@ -433,6 +433,47 @@ def _run_scheduled_export(schedule, context: Union[Event, Organizer], exporter,
             )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Dispatch all scheduled exports (event-level and organizer-level) that are due. Each due schedule is handed to
+    its respective celery task and its next run is computed right away, so it is not picked up again by the next
+    periodic run.
+    """
+    with transaction.atomic():
+        qs = ScheduledEventExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_related('event').select_for_update(
+            of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+        )
+        for schedule in qs:
+            scheduled_event_export.apply_async(
+                kwargs={
+                    'event': schedule.event_id,
+                    'schedule': schedule.pk,
+                },
+            )
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+
+    with transaction.atomic():
+        qs = ScheduledOrganizerExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_related('organizer').select_for_update(
+            of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+        )
+        for schedule in qs:
+            scheduled_organizer_export.apply_async(
+                kwargs={
+                    'organizer': schedule.organizer_id,
+                    'schedule': schedule.pk,
+                },
+            )
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+
+
 @app.task(base=OrganizerTask, bind=True, max_retries=5, default_retry_delay=120)
 def scheduled_organizer_export(self, organizer: Organizer, schedule: int) -> None:
     schedule = organizer.scheduled_exports.get(pk=schedule)
