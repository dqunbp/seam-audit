diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..5f3eeef 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,29 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(periodic_task, dispatch_uid="pretix_base_run_scheduled_exports")
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # The next run is advanced before the task is dispatched, so a due run is never dispatched twice, even if
+    # the periodic job runs again while the export is still waiting to start.
+    for schedule in ScheduledEventExport.objects.filter(schedule_next_run__lte=now()).select_related('event'):
+        schedule.compute_next_run()
+        schedule.save(update_fields=['schedule_next_run'])
+        scheduled_event_export.apply_async(
+            kwargs={
+                'event': schedule.event_id,
+                'schedule': schedule.pk,
+            },
+        )
+
+    for schedule in ScheduledOrganizerExport.objects.filter(schedule_next_run__lte=now()).select_related('organizer'):
+        schedule.compute_next_run()
+        schedule.save(update_fields=['schedule_next_run'])
+        scheduled_organizer_export.apply_async(
+            kwargs={
+                'organizer': schedule.organizer_id,
+                'schedule': schedule.pk,
+            },
+        )
+
+
