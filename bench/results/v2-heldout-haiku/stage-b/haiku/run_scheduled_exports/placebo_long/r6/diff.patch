+@pytest.mark.django_db
+@freeze_time("2023-01-19 07:00:00+01:00")
+def test_run_scheduled_exports_dispatches_due_event_export(event, user):
+    s = _event_schedule(event, user, schedule_next_run=now() - timedelta(minutes=1))
+
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+
+    apply_async.assert_called_once_with(kwargs={'event': event.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-19 07:00:00+01:00")
+def test_run_scheduled_exports_dispatches_due_organizer_export(event, user):
+    s = _organizer_schedule(event.organizer, user, schedule_next_run=now() - timedelta(minutes=1))
+
+    with mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+
+    apply_async.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-19 07:00:00+01:00")
+def test_run_scheduled_exports_skips_schedules_not_yet_due(event, user):
+    s = _event_schedule(event, user, schedule_next_run=now() + timedelta(hours=1))
+    o = _organizer_schedule(event.organizer, user, schedule_next_run=now() + timedelta(hours=1))
+    expected_event_next_run = s.schedule_next_run
+    expected_organizer_next_run = o.schedule_next_run
+
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as event_apply_async, \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as organizer_apply_async:
+        run_scheduled_exports(sender=None)
+
+    event_apply_async.assert_not_called()
+    organizer_apply_async.assert_not_called()
+    s.refresh_from_db()
+    o.refresh_from_db()
+    assert s.schedule_next_run == expected_event_next_run
+    assert o.schedule_next_run == expected_organizer_next_run
+
+
