+def _event_schedule(event, user, **kwargs):
+    return ScheduledEventExport.objects.create(
+        event=event,
+        owner=user,
+        export_identifier='orderlist',
+        locale='en',
+        mail_subject='Export',
+        mail_template='Here is your export.',
+        schedule_rrule=RRULE_DAILY,
+        schedule_rrule_time=time(6, 30, 0),
+        **kwargs,
+    )
+
+
+def _organizer_schedule(organizer, user, **kwargs):
+    return ScheduledOrganizerExport.objects.create(
+        organizer=organizer,
+        owner=user,
+        export_identifier='orderlist',
+        locale='en',
+        mail_subject='Export',
+        mail_template='Here is your export.',
+        schedule_rrule=RRULE_DAILY,
+        schedule_rrule_time=time(6, 30, 0),
+        timezone='Europe/Berlin',
+        **kwargs,
+    )
+
