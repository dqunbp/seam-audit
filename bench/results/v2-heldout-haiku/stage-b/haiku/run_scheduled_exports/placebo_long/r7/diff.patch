+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Queues all scheduled exports (event-level and organizer-level) that are due. Each due schedule is moved to its
+    next run time before its task is queued, so the same run is never queued twice.
+    """
+    due = []
+    with transaction.atomic():
+        for model in (ScheduledEventExport, ScheduledOrganizerExport):
+            qs = model.objects.filter(
+                schedule_next_run__lte=now(),
+            ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked)
+            for schedule in qs:
+                schedule.compute_next_run()
+                schedule.save(update_fields=['schedule_next_run'])
+                due.append(schedule)
+
+    for schedule in due:
+        if isinstance(schedule, ScheduledEventExport):
+            scheduled_event_export.apply_async(kwargs={
+                'event': schedule.event_id,
+                'schedule': schedule.pk,
+            })
+        else:
+            scheduled_organizer_export.apply_async(kwargs={
+                'organizer': schedule.organizer_id,
+                'schedule': schedule.pk,
+            })
+
+
 @app.task(base=EventTask, bind=True, max_retries=5, default_retry_delay=120)
 def scheduled_event_export(self, event: Event, schedule: int) -> None:
     schedule = event.scheduled_exports.get(pk=schedule)
