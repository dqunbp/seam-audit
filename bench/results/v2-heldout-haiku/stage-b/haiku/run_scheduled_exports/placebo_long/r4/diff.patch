diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..5ed7330 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,38 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Queue all scheduled exports (event-level and organizer-level) that are due. The next run is moved forward in the
+    same transaction, so a schedule is never queued twice for the same occurrence.
+    """
+    with transaction.atomic():
+        for s in ScheduledEventExport.objects.select_for_update(
+            skip_locked=connection.features.has_select_for_update_skip_locked,
+            of=OF_SELF
+        ).filter(schedule_next_run__lte=now()):
+            scheduled_event_export.apply_async(
+                kwargs={
+                    'event': s.event_id,
+                    'schedule': s.pk,
+                },
+            )
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+
+        for s in ScheduledOrganizerExport.objects.select_for_update(
+            skip_locked=connection.features.has_select_for_update_skip_locked,
+            of=OF_SELF
+        ).filter(schedule_next_run__lte=now()):
+            scheduled_organizer_export.apply_async(
+                kwargs={
+                    'organizer': s.organizer_id,
+                    'schedule': s.pk,
+                },
+            )
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+
+
