+# Tests using these fixtures run under freeze_time("2023-01-20 12:00:00"), so the schedules are due one minute earlier
+DUE_AT = datetime(2023, 1, 20, 11, 59, 0, tzinfo=timezone.utc)
+
+
+@pytest.fixture
+def event_schedule(event, user):
+    return ScheduledEventExport.objects.create(
+        event=event,
+        owner=user,
+        export_identifier="dummy_orders",
+        export_form_data={},
+        locale="en",
+        mail_subject="Test",
+        mail_template="Test",
+        schedule_rrule="DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO",
+        schedule_rrule_time=time(3, 30, 0),
+        schedule_next_run=DUE_AT,
+    )
+
+
+@pytest.fixture
+def organizer_schedule(event, user):
+    return ScheduledOrganizerExport.objects.create(
+        organizer=event.organizer,
+        owner=user,
+        export_identifier="giftcardlist",
+        export_form_data={},
+        locale="en",
+        mail_subject="Test",
+        mail_template="Test",
+        timezone="Europe/Berlin",
+        schedule_rrule="DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO",
+        schedule_rrule_time=time(3, 30, 0),
+        schedule_next_run=DUE_AT,
+    )
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_scheduled_event_export_is_queued_when_due(event, event_schedule):
+    with mock.patch("pretix.base.services.export.scheduled_event_export.apply_async") as apply:
+        run_scheduled_exports(sender=None)
+
+    apply.assert_called_once_with(kwargs={"event": event.pk, "schedule": event_schedule.pk})
+    event_schedule.refresh_from_db()
+    assert event_schedule.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_scheduled_organizer_export_is_queued_when_due(event, organizer_schedule):
+    with mock.patch("pretix.base.services.export.scheduled_organizer_export.apply_async") as apply:
+        run_scheduled_exports(sender=None)
+
+    apply.assert_called_once_with(kwargs={"organizer": event.organizer.pk, "schedule": organizer_schedule.pk})
+    organizer_schedule.refresh_from_db()
+    assert organizer_schedule.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_scheduled_export_is_not_queued_before_it_is_due(event, event_schedule, organizer_schedule):
+    next_run = now() + timedelta(hours=1)
+    event_schedule.schedule_next_run = next_run
+    event_schedule.save()
+    organizer_schedule.schedule_next_run = next_run
+    organizer_schedule.save()
+
+    with mock.patch("pretix.base.services.export.scheduled_event_export.apply_async") as event_apply, \
+            mock.patch("pretix.base.services.export.scheduled_organizer_export.apply_async") as organizer_apply:
+        run_scheduled_exports(sender=None)
+
+    event_apply.assert_not_called()
+    organizer_apply.assert_not_called()
+    event_schedule.refresh_from_db()
+    organizer_schedule.refresh_from_db()
+    assert event_schedule.schedule_next_run == next_run
+    assert organizer_schedule.schedule_next_run == next_run
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
