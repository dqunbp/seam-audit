+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_event_export(event, scheduled_event_export):
+    due = scheduled_event_export.schedule_next_run
+    with patch.object(export_service.scheduled_event_export, 'apply_async') as apply_async:
+        with freeze_time(due):
+            export_service.run_scheduled_exports(sender=None)
