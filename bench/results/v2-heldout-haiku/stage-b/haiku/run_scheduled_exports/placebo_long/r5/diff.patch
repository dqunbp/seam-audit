diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..f9429c3 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,40 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _claim_due_scheduled_exports(model):
+    # Advance the next run of all due schedules before anything is dispatched, so that a run is never dispatched
+    # twice, even if the periodic task is executed again before the export has finished.
+    with transaction.atomic():
+        due = list(
+            model.objects.filter(
+                schedule_next_run__lte=now(),
+            ).select_for_update(
+                of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+            )
+        )
+        for schedule in due:
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+    return due
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    for schedule in _claim_due_scheduled_exports(ScheduledEventExport):
+        scheduled_event_export.apply_async(
+            kwargs={
+                'event': schedule.event_id,
+                'schedule': schedule.pk,
+            },
+        )
+
+    for schedule in _claim_due_scheduled_exports(ScheduledOrganizerExport):
+        scheduled_organizer_export.apply_async(
+            kwargs={
+                'organizer': schedule.organizer_id,
+                'schedule': schedule.pk,
+            },
+        )
+
+
