diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..237b5d5 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,29 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # Each due schedule is advanced before its task is dispatched, so it is not picked up again by the next run of
+    # this periodic job. Schedules without any further occurrence get schedule_next_run=None and stop firing.
+    for schedule in ScheduledEventExport.objects.filter(schedule_next_run__lte=now()):
+        schedule.compute_next_run()
+        schedule.save(update_fields=['schedule_next_run'])
+        scheduled_event_export.apply_async(
+            kwargs={
+                'event': schedule.event_id,
+                'schedule': schedule.pk,
+            },
+        )
+
+    for schedule in ScheduledOrganizerExport.objects.filter(schedule_next_run__lte=now()):
+        schedule.compute_next_run()
+        schedule.save(update_fields=['schedule_next_run'])
+        scheduled_organizer_export.apply_async(
+            kwargs={
+                'organizer': schedule.organizer_id,
+                'schedule': schedule.pk,
+            },
+        )
+
+
