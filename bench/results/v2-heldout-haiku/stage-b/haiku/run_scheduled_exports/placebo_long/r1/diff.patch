diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..1a3d4db 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,38 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Queue all event-level and organizer-level scheduled exports that are due and compute their next run.
+    The next run is stored before the task is queued, so the same schedule is never queued twice.
+    """
+    skip_locked = connection.features.has_select_for_update_skip_locked
+
+    with transaction.atomic():
+        for schedule in ScheduledEventExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=skip_locked):
+            schedule.compute_next_run()
+            schedule.save(update_fields=["schedule_next_run"])
+            scheduled_event_export.apply_async(
+                kwargs={
+                    'event': schedule.event_id,
+                    'schedule': schedule.pk,
+                },
+            )
+
+        for schedule in ScheduledOrganizerExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=skip_locked):
+            schedule.compute_next_run()
+            schedule.save(update_fields=["schedule_next_run"])
+            scheduled_organizer_export.apply_async(
+                kwargs={
+                    'organizer': schedule.organizer_id,
+                    'schedule': schedule.pk,
+                },
+            )
+
+
