diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..28154f6 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,31 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+SCHEDULED_EXPORT_BATCH_SIZE = 100
+
+
+def _dispatch_due_scheduled_exports(model, task, context_field):
+    # The schedule is moved to its next run before the export task is dispatched, so the same occurrence is not
+    # picked up again by the next periodic run. Failures of the export itself are handled by the task.
+    with transaction.atomic():
+        qs = model.objects.select_related(context_field).filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked)
+        for schedule in qs[:SCHEDULED_EXPORT_BATCH_SIZE]:
+            schedule.compute_next_run()
+            schedule.save(update_fields=["schedule_next_run"])
+            task.apply_async(
+                kwargs={
+                    context_field: getattr(schedule, f"{context_field}_id"),
+                    'schedule': schedule.pk,
+                },
+            )
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    _dispatch_due_scheduled_exports(ScheduledEventExport, scheduled_event_export, 'event')
+    _dispatch_due_scheduled_exports(ScheduledOrganizerExport, scheduled_organizer_export, 'organizer')
+
+
