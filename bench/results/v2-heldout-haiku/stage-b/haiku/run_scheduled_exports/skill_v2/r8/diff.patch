+def _event_schedule(event, owner, **kwargs):
+    return ScheduledEventExport.objects.create(
+        event=event,
+        owner=owner,
+        export_identifier='dummy_orders',
+        export_form_data={},
+        mail_subject='Test',
+        mail_template='Test',
+        locale='en',
+        schedule_rrule='DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO',
+        schedule_rrule_time=time(2, 30, 0),
+        **kwargs,
+    )
+
+
+def _organizer_schedule(organizer, owner, **kwargs):
+    return ScheduledOrganizerExport.objects.create(
+        organizer=organizer,
+        owner=owner,
+        export_identifier='dummy_orders',
+        export_form_data={'all_events': True, 'events': []},
+        mail_subject='Test',
+        mail_template='Test',
+        locale='en',
+        schedule_rrule='DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO',
+        schedule_rrule_time=time(2, 30, 0),
+        timezone='Europe/Berlin',
+        **kwargs,
+    )
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_event_export(event, user):
+    s = _event_schedule(event, user, schedule_next_run=now() - timedelta(minutes=5))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply_async:
+        run_scheduled_exports(None)
+    apply_async.assert_called_once_with(kwargs={'event': event.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_organizer_export(event, user):
+    s = _organizer_schedule(event.organizer, user, schedule_next_run=now() - timedelta(minutes=5))
+    with mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as apply_async:
+        run_scheduled_exports(None)
+    apply_async.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_each_occurrence_once(event, user):
+    _event_schedule(event, user, schedule_next_run=now() - timedelta(minutes=5))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply_async:
+        run_scheduled_exports(None)
+        run_scheduled_exports(None)
+    assert apply_async.call_count == 1
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_skips_schedules_not_due(event, user):
+    _event_schedule(event, user, schedule_next_run=now() + timedelta(hours=1))
+    _organizer_schedule(event.organizer, user, schedule_next_run=now() + timedelta(hours=1))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as ev_apply, \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as org_apply:
+        run_scheduled_exports(None)
+    assert not ev_apply.called
+    assert not org_apply.called
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_skips_schedules_without_next_run(event, user):
+    _event_schedule(event, user, schedule_next_run=None)
+    _organizer_schedule(event.organizer, user, schedule_next_run=None)
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as ev_apply, \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as org_apply:
+        run_scheduled_exports(None)
+    assert not ev_apply.called
+    assert not org_apply.called
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_skips_schedules_after_too_many_errors(event, user):
+    failed = _event_schedule(event, user, schedule_next_run=now() - timedelta(minutes=5), error_counter=5)
+    ok = _event_schedule(event, user, schedule_next_run=now() - timedelta(minutes=5), error_counter=4)
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply_async:
+        run_scheduled_exports(None)
+    apply_async.assert_called_once_with(kwargs={'event': event.pk, 'schedule': ok.pk})
+    failed.refresh_from_db()
+    assert failed.schedule_next_run < now()
+
