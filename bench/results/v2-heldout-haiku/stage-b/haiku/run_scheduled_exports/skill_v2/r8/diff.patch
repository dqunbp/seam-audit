diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..3c16153 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -55,6 +55,9 @@ from pretix.helpers.urls import mainreverse_absolute
 
 logger = logging.getLogger(__name__)
 
+# Number of consecutive failures after which a scheduled export is no longer executed (see API documentation)
+SCHEDULED_EXPORT_MAX_ERRORS = 5
+
 
 class ExportError(LazyLocaleException):
     pass
@@ -494,3 +497,42 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Dispatch all scheduled exports (event-level and organizer-level) that are due. The next run is computed and
+    stored before the task is dispatched, so one occurrence is never dispatched twice. Schedules that failed too
+    often are skipped.
+    """
+    skip_locked = connection.features.has_select_for_update_skip_locked
+
+    with transaction.atomic():
+        for schedule in ScheduledEventExport.objects.select_related('event').filter(
+            schedule_next_run__lte=now(),
+            error_counter__lt=SCHEDULED_EXPORT_MAX_ERRORS,
+        ).select_for_update(of=OF_SELF, skip_locked=skip_locked):
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            scheduled_event_export.apply_async(
+                kwargs={
+                    'event': schedule.event_id,
+                    'schedule': schedule.pk,
+                },
+            )
+
+    with transaction.atomic():
+        for schedule in ScheduledOrganizerExport.objects.filter(
+            schedule_next_run__lte=now(),
+            error_counter__lt=SCHEDULED_EXPORT_MAX_ERRORS,
+        ).select_for_update(of=OF_SELF, skip_locked=skip_locked):
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            scheduled_organizer_export.apply_async(
+                kwargs={
+                    'organizer': schedule.organizer_id,
+                    'schedule': schedule.pk,
+                },
+            )
+
+
