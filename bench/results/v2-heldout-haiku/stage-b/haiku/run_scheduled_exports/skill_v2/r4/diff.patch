+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # Claim every due schedule and advance its next run time while holding the row lock, so that concurrent
+    # sweeps never enqueue the same run twice. The actual export is queued only after the claim has committed.
+    with transaction.atomic():
+        due_event_exports = ScheduledEventExport.objects.select_for_update(
+            skip_locked=connection.features.has_select_for_update_skip_locked,
+            of=OF_SELF,
+        ).select_related('event').filter(schedule_next_run__lte=now())
+        for s in due_event_exports:
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+            transaction.on_commit(partial(
+                scheduled_event_export.apply_async,
+                kwargs={
+                    'event': s.event_id,
+                    'schedule': s.pk,
+                },
+            ))
+
+        due_organizer_exports = ScheduledOrganizerExport.objects.select_for_update(
+            skip_locked=connection.features.has_select_for_update_skip_locked,
+            of=OF_SELF,
+        ).filter(schedule_next_run__lte=now())
+        for s in due_organizer_exports:
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+            transaction.on_commit(partial(
+                scheduled_organizer_export.apply_async,
+                kwargs={
+                    'organizer': s.organizer_id,
+                    'schedule': s.pk,
+                },
+            ))
+
