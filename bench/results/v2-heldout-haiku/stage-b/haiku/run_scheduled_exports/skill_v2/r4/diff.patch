+DAILY_RRULE = "DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO"
+ONCE_RRULE = "DTSTART:20230118T000000\nRRULE:FREQ=DAILY;COUNT=1;WKST=MO"
+
+
+def _event_schedule(event, user, schedule_next_run, rrule=DAILY_RRULE):
+    return ScheduledEventExport.objects.create(
+        event=event, owner=user, export_identifier='orderlist', locale='en',
+        mail_subject='Export', mail_template='Here is your export.',
+        schedule_rrule=rrule, schedule_rrule_time=time(6, 30, 0),
+        schedule_next_run=schedule_next_run,
+    )
+
+
+def _organizer_schedule(organizer, user, schedule_next_run, rrule=DAILY_RRULE):
+    return ScheduledOrganizerExport.objects.create(
+        organizer=organizer, owner=user, export_identifier='eventdata', locale='en',
+        mail_subject='Export', mail_template='Here is your export.', timezone='Europe/Berlin',
+        schedule_rrule=rrule, schedule_rrule_time=time(6, 30, 0),
+        schedule_next_run=schedule_next_run,
+    )
+
+
+# 06:30:30 in Berlin, i.e. 30 seconds after the daily 06:30 run of 2023-01-19
+DUE_AT = datetime(2023, 1, 19, 5, 30, 30, tzinfo=timezone.utc)
+MISSED_AT = datetime(2023, 1, 19, 5, 30, 0, tzinfo=timezone.utc)  # the 06:30 Berlin run, already due
+NOT_YET_AT = datetime(2023, 1, 19, 5, 31, 0, tzinfo=timezone.utc)
+NEXT_RUN_BERLIN = datetime(2023, 1, 20, 6, 30, 0, tzinfo=ZoneInfo("Europe/Berlin"))
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_queues_due_event_export_and_reschedules(event, user, django_capture_on_commit_callbacks):
+    s = _event_schedule(event, user, schedule_next_run=MISSED_AT)
+    with freeze_time(DUE_AT), \
+            mock.patch.object(scheduled_event_export, 'apply_async') as apply_async, \
+            django_capture_on_commit_callbacks(execute=True):
+        run_scheduled_exports(None)
+    apply_async.assert_called_once_with(kwargs={'event': event.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run == NEXT_RUN_BERLIN
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_queues_due_organizer_export_and_reschedules(event, user, django_capture_on_commit_callbacks):
+    s = _organizer_schedule(event.organizer, user, schedule_next_run=MISSED_AT)
+    with freeze_time(DUE_AT), \
+            mock.patch.object(scheduled_organizer_export, 'apply_async') as apply_async, \
+            django_capture_on_commit_callbacks(execute=True):
+        run_scheduled_exports(None)
+    apply_async.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run == NEXT_RUN_BERLIN
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_skips_exports_not_due(event, user, django_capture_on_commit_callbacks):
+    es = _event_schedule(event, user, schedule_next_run=NOT_YET_AT)
+    es_unscheduled = _event_schedule(event, user, schedule_next_run=None)
+    os = _organizer_schedule(event.organizer, user, schedule_next_run=NOT_YET_AT)
+    os_unscheduled = _organizer_schedule(event.organizer, user, schedule_next_run=None)
+    with freeze_time(DUE_AT), \
+            mock.patch.object(scheduled_event_export, 'apply_async') as event_apply_async, \
+            mock.patch.object(scheduled_organizer_export, 'apply_async') as organizer_apply_async, \
+            django_capture_on_commit_callbacks(execute=True):
+        run_scheduled_exports(None)
+    event_apply_async.assert_not_called()
+    organizer_apply_async.assert_not_called()
+    for s, expected in ((es, NOT_YET_AT), (os, NOT_YET_AT), (es_unscheduled, None), (os_unscheduled, None)):
+        s.refresh_from_db()
+        assert s.schedule_next_run == expected
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_queues_each_run_once_across_sweeps(event, user, django_capture_on_commit_callbacks):
