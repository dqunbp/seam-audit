+@pytest.mark.django_db
+def test_run_scheduled_exports_enqueues_only_after_commit(event, user, django_capture_on_commit_callbacks):
+    s = _event_schedule(event, user, schedule_next_run=MISSED_AT)
+    with freeze_time(DUE_AT), mock.patch.object(scheduled_event_export, 'apply_async') as apply_async:
