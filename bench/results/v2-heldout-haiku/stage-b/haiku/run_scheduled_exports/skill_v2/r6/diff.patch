diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..c3aac8e 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -21,6 +21,7 @@
 #
 import logging
 from datetime import timedelta
+from functools import partial
 from typing import Any, Dict, Union
 
 from celery.exceptions import MaxRetriesExceededError
@@ -494,3 +495,30 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # Runs all due scheduled exports, both event-level and organizer-level. The next run is stored before the task
+    # is published, so repeated or overlapping periodic runs do not start the same export twice. Publishing happens
+    # on commit, so a rolled-back batch does not leave orphaned tasks behind.
+    for model, task, scope_key in (
+        (ScheduledEventExport, scheduled_event_export, 'event'),
+        (ScheduledOrganizerExport, scheduled_organizer_export, 'organizer'),
+    ):
+        with transaction.atomic():
+            due = model.objects.select_for_update(
+                skip_locked=connection.features.has_select_for_update_skip_locked,
+                of=OF_SELF,
+            ).filter(schedule_next_run__lte=now())
+            for schedule in due:
+                schedule.compute_next_run()
+                schedule.save(update_fields=['schedule_next_run'])
+                transaction.on_commit(partial(
+                    task.apply_async,
+                    kwargs={
+                        scope_key: getattr(schedule, f'{scope_key}_id'),
+                        'schedule': schedule.pk,
+                    },
+                ))
+
+
