+@freeze_time("2023-01-18 07:00:00")
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_event_export(event_schedule):
+    with mock.patch.object(scheduled_event_export, 'apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+    apply_async.assert_called_once_with(kwargs={'event': event_schedule.event_id, 'schedule': event_schedule.pk})
+    event_schedule.refresh_from_db()
+    # 07:00 UTC is 08:00 in Berlin, so the next occurrence is tomorrow at the requested 06:30 local time
+    assert event_schedule.schedule_next_run == datetime(2023, 1, 19, 6, 30, 0, tzinfo=zoneinfo.ZoneInfo("Europe/Berlin"))
