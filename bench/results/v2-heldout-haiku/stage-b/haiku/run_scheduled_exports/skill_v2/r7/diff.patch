diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..68a279c 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,38 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # Claim all due schedules and advance their next run while holding the row lock, so that overlapping sweeps
+    # never dispatch the same occurrence twice. The actual exports are dispatched only after the transaction
+    # has committed, so the per-schedule tasks always see the updated schedule.
+    to_dispatch = []
+    with transaction.atomic():
+        due_event_exports = ScheduledEventExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_related('event', 'event__organizer').select_for_update(
+            of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+        )
+        for s in due_event_exports:
+            # compute_next_run() schedules from the current time, so an occurrence that was missed while the
+            # sweep was not running is skipped instead of being replayed.
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+            to_dispatch.append((scheduled_event_export, {'event': s.event_id, 'schedule': s.pk}))
+
+        due_organizer_exports = ScheduledOrganizerExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_related('organizer').select_for_update(
+            of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+        )
+        for s in due_organizer_exports:
+            s.compute_next_run()
+            s.save(update_fields=['schedule_next_run'])
+            to_dispatch.append((scheduled_organizer_export, {'organizer': s.organizer_id, 'schedule': s.pk}))
+
+    for task, task_kwargs in to_dispatch:
+        # Routed to the background queue by the task routes in settings.py
+        task.apply_async(kwargs=task_kwargs)
+
+
