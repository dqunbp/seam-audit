+@pytest.mark.django_db(transaction=True)
+def test_run_scheduled_exports_runs_dispatched_tasks(event, event_schedule, organizer_schedule, user):
+    # The owner is inactive, so the export itself is refused without rendering anything and the failure is logged
+    # and reported to the owner by the existing task. This verifies the dispatched kwargs resolve in the real tasks.
