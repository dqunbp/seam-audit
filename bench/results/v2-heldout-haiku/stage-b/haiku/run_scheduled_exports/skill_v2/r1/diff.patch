+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_schedules(event, event_schedule, organizer_schedule):
+    with mock.patch.object(scheduled_event_export, 'apply_async') as event_dispatch, \
+            mock.patch.object(scheduled_organizer_export, 'apply_async') as organizer_dispatch:
+        run_scheduled_exports(sender=None)
+
+    event_dispatch.assert_called_once_with(kwargs={'event': event.pk, 'schedule': event_schedule.pk})
+    organizer_dispatch.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': organizer_schedule.pk})
+
+    event_schedule.refresh_from_db()
+    organizer_schedule.refresh_from_db()
+    assert event_schedule.schedule_next_run > now()
+    assert organizer_schedule.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_skips_schedules_not_due(event, event_schedule, organizer_schedule):
+    later = now() + timedelta(hours=1)
+    event_schedule.schedule_next_run = later
+    event_schedule.save()
+    organizer_schedule.schedule_next_run = None
+    organizer_schedule.save()
+
+    with mock.patch.object(scheduled_event_export, 'apply_async') as event_dispatch, \
+            mock.patch.object(scheduled_organizer_export, 'apply_async') as organizer_dispatch:
+        run_scheduled_exports(sender=None)
+
+    event_dispatch.assert_not_called()
+    organizer_dispatch.assert_not_called()
+    event_schedule.refresh_from_db()
+    assert event_schedule.schedule_next_run == later
+
+
