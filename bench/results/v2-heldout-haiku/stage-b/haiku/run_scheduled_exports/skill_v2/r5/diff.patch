+from datetime import datetime, time, timezone
+from unittest import mock
+
+import pytest
+from django_scopes import scope
+from freezegun import freeze_time
+
+from pretix.base.models import (
+    Event, Organizer, ScheduledEventExport, ScheduledOrganizerExport, User,
+)
+from pretix.base.services.export import run_scheduled_exports
+
+RRULE = "DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO"
+
+
+@pytest.fixture(scope='function')
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=datetime(2023, 1, 19, 2, 30, 0, tzinfo=timezone.utc),
+        plugins='pretix.plugins.banktransfer'
+    )
+    o.settings.timezone = "Europe/Berlin"
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def user(event):
+    user = User.objects.create_user('dummy@dummy.dummy', 'dummy')
+    event.organizer.teams.create(all_events=True, all_event_permissions=True).members.add(user)
+    return user
+
+
+def _event_schedule(event, user, next_run, mail_subject='EVENT'):
+    s = ScheduledEventExport(event=event, owner=user, mail_subject=mail_subject)
+    s.schedule_rrule = RRULE
+    s.schedule_rrule_time = time(2, 30, 0)
+    s.schedule_next_run = next_run
+    s.save()
+    return s
+
+
+def _organizer_schedule(organizer, user, next_run, mail_subject='ORGANIZER'):
+    s = ScheduledOrganizerExport(organizer=organizer, owner=user, mail_subject=mail_subject)
+    s.schedule_rrule = RRULE
+    s.schedule_rrule_time = time(2, 30, 0)
+    s.schedule_next_run = next_run
+    s.save()
+    return s
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_due_event_schedule_is_dispatched_and_advanced(event, user):
+    s = _event_schedule(event, user, datetime(2023, 1, 20, 11, 0, tzinfo=timezone.utc))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply_async, \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as org_apply_async:
+        run_scheduled_exports(sender=None)
+
+    apply_async.assert_called_once_with(kwargs={'event': event.pk, 'schedule': s.pk})
+    org_apply_async.assert_not_called()
+    s.refresh_from_db()
+    assert s.schedule_next_run > datetime(2023, 1, 20, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_due_organizer_schedule_is_dispatched_and_advanced(event, user):
+    s = _organizer_schedule(event.organizer, user, datetime(2023, 1, 20, 11, 0, tzinfo=timezone.utc))
+    with mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as apply_async, \
+            mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as event_apply_async:
+        run_scheduled_exports(sender=None)
+
+    apply_async.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': s.pk})
+    event_apply_async.assert_not_called()
+    s.refresh_from_db()
+    assert s.schedule_next_run > datetime(2023, 1, 20, 12, 0, tzinfo=timezone.utc)
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_not_yet_due_schedules_are_skipped(event, user):
+    future = datetime(2023, 1, 20, 13, 0, tzinfo=timezone.utc)
+    es = _event_schedule(event, user, future)
+    os_ = _organizer_schedule(event.organizer, user, future)
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as ev, \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as org:
+        run_scheduled_exports(sender=None)
+
+    ev.assert_not_called()
+    org.assert_not_called()
+    es.refresh_from_db()
+    os_.refresh_from_db()
+    assert es.schedule_next_run == future
+    assert os_.schedule_next_run == future
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_schedule_without_next_run_is_skipped(event, user):
+    s = _event_schedule(event, user, None)
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+
+    apply_async.assert_not_called()
+    s.refresh_from_db()
+    assert s.schedule_next_run is None
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_running_twice_dispatches_once(event, user):
+    _event_schedule(event, user, datetime(2023, 1, 20, 11, 0, tzinfo=timezone.utc))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+        run_scheduled_exports(sender=None)
+
+    assert apply_async.call_count == 1
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-20 12:00:00")
+def test_failing_dispatch_does_not_block_other_schedules(event, user):
+    failing = _event_schedule(event, user, datetime(2023, 1, 20, 11, 0, tzinfo=timezone.utc), 'FAILING')
+    ok = _organizer_schedule(event.organizer, user, datetime(2023, 1, 20, 11, 0, tzinfo=timezone.utc))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async',
+                    side_effect=ConnectionError('broker down')), \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as org_apply_async:
+        run_scheduled_exports(sender=None)
+
+    org_apply_async.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': ok.pk})
+    failing.refresh_from_db()
+    # The failed dispatch was rolled back, so the occurrence stays due and is retried on the next run
+    assert failing.schedule_next_run == datetime(2023, 1, 20, 11, 0, tzinfo=timezone.utc)
