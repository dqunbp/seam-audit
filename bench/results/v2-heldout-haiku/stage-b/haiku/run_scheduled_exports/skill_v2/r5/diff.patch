index 493bf71..1bd1663 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,40 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _dispatch_due_scheduled_exports(model, task, parent_field):
+    """
+    Dispatch all schedules of ``model`` whose next run is due. The next run time is advanced in the same
+    transaction that dispatches the task, under a row lock, so an occurrence is never dispatched twice even if
+    several workers run the periodic job concurrently. A failing schedule is rolled back (and thus retried on
+    the next periodic run) without blocking the other schedules.
+    """
+    due_ids = list(model.objects.filter(schedule_next_run__lte=now()).values_list('pk', flat=True))
+    for pk in due_ids:
+        try:
+            with transaction.atomic():
+                s = model.objects.select_for_update(
+                    of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+                ).filter(pk=pk, schedule_next_run__lte=now()).first()
+                if s is None:
+                    # Locked by another worker, or already dispatched by another worker
+                    continue
+                s.compute_next_run()
+                s.save(update_fields=['schedule_next_run'])
+                task.apply_async(kwargs={
+                    parent_field: getattr(s, f'{parent_field}_id'),
+                    'schedule': s.pk,
+                })
+        except Exception:
+            logger.exception(f"Could not dispatch scheduled export {pk} of {model.__name__}.")
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Dispatch event-level and organizer-level scheduled exports that are due.
+    """
+    _dispatch_due_scheduled_exports(ScheduledEventExport, scheduled_event_export, 'event')
+    _dispatch_due_scheduled_exports(ScheduledOrganizerExport, scheduled_organizer_export, 'organizer')
+
+
