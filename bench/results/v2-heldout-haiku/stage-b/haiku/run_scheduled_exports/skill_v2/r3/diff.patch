+def test_schedule_without_further_runs_is_dispatched_once_then_cleared(event, user, django_capture_on_commit_callbacks):
+    s = _event_schedule(event, user, next_run=datetime(2023, 1, 19, 6, 30, tzinfo=BERLIN))
