diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..528f55c 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,40 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+SCHEDULED_EXPORT_MAX_ERRORS = 5
+
+
+def _dispatch_due_scheduled_exports(qs, task, parent_field):
+    with transaction.atomic():
+        due = qs.filter(
+            schedule_next_run__lte=now(),
+            error_counter__lt=SCHEDULED_EXPORT_MAX_ERRORS,
+        ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked)
+
+        for schedule in due:
+            # Advance the schedule in the same transaction that selected it, so that a repeated or concurrent run of
+            # the periodic task does not dispatch it again. The export is started only once this commits.
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            kwargs = {
+                parent_field: getattr(schedule, f'{parent_field}_id'),
+                'schedule': schedule.pk,
+            }
+            transaction.on_commit(lambda task=task, kwargs=kwargs: task.apply_async(kwargs=kwargs))
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    _dispatch_due_scheduled_exports(
+        ScheduledEventExport.objects.select_related('event'),
+        scheduled_event_export,
+        'event',
+    )
+    _dispatch_due_scheduled_exports(
+        ScheduledOrganizerExport.objects.all(),
+        scheduled_organizer_export,
+        'organizer',
+    )
+
+
