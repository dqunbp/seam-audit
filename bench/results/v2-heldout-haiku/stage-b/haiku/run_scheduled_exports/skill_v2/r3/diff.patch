+BERLIN = zoneinfo.ZoneInfo("Europe/Berlin")
+DAILY_RRULE = "DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO"
+
+
+def _event_schedule(event, user, next_run=datetime(2023, 1, 19, 6, 30, tzinfo=BERLIN), **kwargs):
+    s = ScheduledEventExport(
+        event=event, owner=user, export_identifier='orderlist', locale='en',
+        schedule_rrule=DAILY_RRULE, schedule_rrule_time=time(6, 30, 0),
+        schedule_next_run=next_run, mail_subject='Export', mail_template='Hello', **kwargs,
+    )
+    s.save()
+    return s
+
+
+def _organizer_schedule(organizer, user, next_run=datetime(2023, 1, 19, 6, 30, tzinfo=BERLIN), **kwargs):
+    s = ScheduledOrganizerExport(
+        organizer=organizer, owner=user, export_identifier='orderlist', locale='en', timezone='Europe/Berlin',
+        schedule_rrule=DAILY_RRULE, schedule_rrule_time=time(6, 30, 0),
+        schedule_next_run=next_run, mail_subject='Export', mail_template='Hello', **kwargs,
+    )
+    s.save()
+    return s
+
+
+@pytest.mark.django_db
+def test_scheduled_event_export_due_is_dispatched_and_advanced(event, user, django_capture_on_commit_callbacks):
+    s = _event_schedule(event, user)
+    with freeze_time("2023-01-19 06:31:00+01:00"), mock.patch.object(scheduled_event_export, 'apply_async') as apply:
+        with django_capture_on_commit_callbacks(execute=True):
+            run_scheduled_exports(sender=None)
+        apply.assert_called_once_with(kwargs={'event': event.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run == datetime(2023, 1, 20, 6, 30, tzinfo=BERLIN)
+
+
+@pytest.mark.django_db
+def test_scheduled_organizer_export_due_is_dispatched_and_advanced(event, user, django_capture_on_commit_callbacks):
+    s = _organizer_schedule(event.organizer, user)
+    with freeze_time("2023-01-19 06:31:00+01:00"), \
