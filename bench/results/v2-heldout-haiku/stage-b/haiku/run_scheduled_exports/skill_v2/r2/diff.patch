--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,30 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _queue_due_schedule(schedule, task, context_kwarg, context_id):
+    # Advance the schedule before dispatching, so that the next periodic run does not queue it a second time.
+    # The export is only dispatched once the transaction has been committed, so a rollback doesn't leave an
+    # export queued for a schedule whose next run was never persisted.
+    schedule.compute_next_run()
+    schedule.save(update_fields=['schedule_next_run'])
+    transaction.on_commit(
+        lambda: task.apply_async(kwargs={context_kwarg: context_id, 'schedule': schedule.pk})
+    )
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    with transaction.atomic():
+        # skip_locked: if another worker is already processing a due schedule, leave it to that worker.
+        for s in ScheduledEventExport.objects.select_for_update(skip_locked=True, of=OF_SELF).select_related(
+            'event'
+        ).filter(schedule_next_run__lte=now()):
+            _queue_due_schedule(s, scheduled_event_export, 'event', s.event_id)
+
+        for s in ScheduledOrganizerExport.objects.select_for_update(skip_locked=True, of=OF_SELF).filter(
+            schedule_next_run__lte=now()
+        ):
+            _queue_due_schedule(s, scheduled_organizer_export, 'organizer', s.organizer_id)
+
+
