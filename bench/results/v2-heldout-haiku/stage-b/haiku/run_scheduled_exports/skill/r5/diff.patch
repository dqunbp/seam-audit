diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..54c570c 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,44 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _dispatch_due_scheduled_exports(model, task, parent_field):
+    """
+    Advances ``schedule_next_run`` of all due schedules of ``model`` and queues ``task`` for each of them. The
+    schedule is advanced while its row is locked, so concurrent or repeated runs of the periodic task never
+    dispatch the same occurrence twice.
+    """
+    dispatch = []
+    with transaction.atomic():
+        due = model.objects.select_for_update(
+            skip_locked=connection.features.has_select_for_update_skip_locked,
+            of=OF_SELF,
+        ).filter(schedule_next_run__lte=now())
+        for schedule in due:
+            try:
+                with transaction.atomic():
+                    schedule.compute_next_run()
+                    schedule.save(update_fields=['schedule_next_run'])
+            except Exception:
+                logger.exception(f"Could not advance scheduled export {schedule.pk}.")
+                continue
+            dispatch.append(schedule)
+
+    # Queued only after the transaction has committed, so the task always sees the advanced schedule.
+    for schedule in dispatch:
+        try:
+            task.apply_async(kwargs={
+                parent_field: getattr(schedule, f'{parent_field}_id'),
+                'schedule': schedule.pk,
+            })
+        except Exception:
+            # The occurrence is considered consumed; a failed enqueue means this run is skipped, not repeated.
+            logger.exception(f"Could not queue scheduled export {schedule.pk}.")
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    _dispatch_due_scheduled_exports(ScheduledEventExport, scheduled_event_export, 'event')
+    _dispatch_due_scheduled_exports(ScheduledOrganizerExport, scheduled_organizer_export, 'organizer')
+
+
