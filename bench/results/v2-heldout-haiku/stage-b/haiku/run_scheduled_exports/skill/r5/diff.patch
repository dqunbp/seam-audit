+from pretix.base.services.export import run_scheduled_exports
 
 
 @pytest.fixture(scope='function')
@@ -57,3 +59,96 @@ def user(team):
     return user
 
 
+SCHEDULE_RRULE = "DTSTART:20230119T000000\nRRULE:FREQ=DAILY"
+
+
+def _schedule_kwargs(user, **kwargs):
+    defaults = dict(
+        owner=user,
+        export_identifier='orderlist',
+        export_form_data={},
+        locale='en',
+        mail_subject='Export',
+        mail_template='Body',
+        schedule_rrule=SCHEDULE_RRULE,
+        schedule_rrule_time=time(3, 30),
+        schedule_next_run=now() - timedelta(minutes=5),
+    )
+    defaults.update(kwargs)
+    return defaults
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_event_export(event, user):
+    s = event.scheduled_exports.create(**_schedule_kwargs(user))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+    apply.assert_called_once_with(kwargs={'event': event.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_organizer_export(event, user):
+    s = ScheduledOrganizerExport.objects.create(
+        organizer=event.organizer, timezone='Europe/Berlin', **_schedule_kwargs(user)
+    )
+    with mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+    apply.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_skips_schedules_not_yet_due(event, user):
+    event.scheduled_exports.create(**_schedule_kwargs(user, schedule_next_run=now() + timedelta(hours=1)))
+    ScheduledOrganizerExport.objects.create(
+        organizer=event.organizer, timezone='UTC', **_schedule_kwargs(user, schedule_next_run=None)
+    )
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as event_apply, \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as organizer_apply:
+        run_scheduled_exports(sender=None)
+    event_apply.assert_not_called()
+    organizer_apply.assert_not_called()
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_does_not_dispatch_same_occurrence_twice(event, user):
+    event.scheduled_exports.create(**_schedule_kwargs(user))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+        run_scheduled_exports(sender=None)
+    assert apply.call_count == 1
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_finished_rrule_is_not_dispatched_again(event, user):
+    s = event.scheduled_exports.create(**_schedule_kwargs(
+        user, schedule_rrule="DTSTART:20230119T000000\nRRULE:FREQ=DAILY;COUNT=1"
+    ))
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+        run_scheduled_exports(sender=None)
+    apply.assert_called_once()
+    s.refresh_from_db()
+    assert s.schedule_next_run is None
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_failed_enqueue_does_not_block_other_schedules(event, user):
+    es = event.scheduled_exports.create(**_schedule_kwargs(user))
+    os_ = ScheduledOrganizerExport.objects.create(
+        organizer=event.organizer, timezone='UTC', **_schedule_kwargs(user)
+    )
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async',
+                    side_effect=Exception('broker down')), \
+            mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as organizer_apply:
+        run_scheduled_exports(sender=None)
+    organizer_apply.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': os_.pk})
+    es.refresh_from_db()
+    os_.refresh_from_db()
+    assert es.schedule_next_run > now()
+    assert os_.schedule_next_run > now()
+
