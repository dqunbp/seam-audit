diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..b7030ed 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,33 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _dispatch_due_scheduled_exports(model, owner_field, task):
+    for pk in model.objects.filter(schedule_next_run__lte=now()).values_list('pk', flat=True):
+        try:
+            with transaction.atomic():
+                # Re-check under the row lock: another worker may have claimed this run in the meantime.
+                s = model.objects.select_for_update(
+                    skip_locked=connection.features.has_select_for_update_skip_locked,
+                ).filter(pk=pk, schedule_next_run__lte=now()).first()
+                if s is None:
+                    continue
+
+                # Advance the schedule before dispatching. If dispatching fails, the transaction is rolled back
+                # and the run stays due for the next periodic tick.
+                s.compute_next_run()
+                s.save(update_fields=['schedule_next_run'])
+                task.apply_async(kwargs={
+                    owner_field: getattr(s, f'{owner_field}_id'),
+                    'schedule': s.pk,
+                })
+        except Exception:
+            logger.exception("Could not dispatch scheduled export %s (%s).", pk, model.__name__)
+
+
+@receiver(periodic_task, dispatch_uid="export_run_scheduled_exports")
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    _dispatch_due_scheduled_exports(ScheduledEventExport, 'event', scheduled_event_export)
+    _dispatch_due_scheduled_exports(ScheduledOrganizerExport, 'organizer', scheduled_organizer_export)
+
+
