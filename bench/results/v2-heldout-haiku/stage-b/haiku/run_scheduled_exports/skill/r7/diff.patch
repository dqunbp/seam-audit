diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..2f69924 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,35 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # This may run more often than schedules are due, and several workers may run it at once. We therefore claim all
+    # due schedules and move them to their next occurrence in one transaction, so each occurrence is dispatched at
+    # most once. The exports are only queued after that transaction has committed.
+    claimed = []
+    with transaction.atomic():
+        for model in (ScheduledEventExport, ScheduledOrganizerExport):
+            qs = model.objects.select_for_update(
+                of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+            ).filter(schedule_next_run__lte=now())
+            for schedule in qs:
+                schedule.compute_next_run()
+                schedule.save(update_fields=['schedule_next_run'])
+                claimed.append(schedule)
+
+    for schedule in claimed:
+        try:
+            if isinstance(schedule, ScheduledEventExport):
+                scheduled_event_export.apply_async(
+                    kwargs={'event': schedule.event_id, 'schedule': schedule.pk},
+                )
+            else:
+                scheduled_organizer_export.apply_async(
+                    kwargs={'organizer': schedule.organizer_id, 'schedule': schedule.pk},
+                )
+        except Exception:
+            # The occurrence has already been advanced, so this run is skipped. Log it and continue with the others.
+            logger.exception('Could not queue scheduled export %s.', schedule.pk)
+
+
