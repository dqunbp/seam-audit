 @pytest.fixture(scope='function')
@@ -57,3 +59,83 @@ def user(team):
     return user
 
 
+def _schedule_fields(owner, next_run):
+    return dict(
+        export_identifier='orderlist',
+        export_form_data={},
+        owner=owner,
+        locale='en',
+        mail_subject='Export',
+        mail_template='Hello',
+        schedule_rrule="DTSTART:20230118T000000\nRRULE:FREQ=DAILY;INTERVAL=1;WKST=MO",
+        schedule_rrule_time=time(6, 30, 0),
+        schedule_next_run=next_run,
+    )
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_event_export(event, user):
+    due = ScheduledEventExport.objects.create(event=event, **_schedule_fields(user, now() - timedelta(minutes=1)))
+    later = now() + timedelta(hours=1)
+    not_due = ScheduledEventExport.objects.create(event=event, **_schedule_fields(user, later))
+
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+
+    apply.assert_called_once_with(kwargs={'event': event.pk, 'schedule': due.pk})
+    due.refresh_from_db()
+    assert due.schedule_next_run > now()
+    not_due.refresh_from_db()
+    assert not_due.schedule_next_run == later
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_dispatches_due_organizer_export(event, user):
+    organizer = event.organizer
+    due = ScheduledOrganizerExport.objects.create(
+        organizer=organizer, timezone='Europe/Berlin', **_schedule_fields(user, now() - timedelta(minutes=1))
+    )
+    later = now() + timedelta(hours=1)
+    not_due = ScheduledOrganizerExport.objects.create(
+        organizer=organizer, timezone='Europe/Berlin', **_schedule_fields(user, later)
+    )
+
+    with mock.patch('pretix.base.services.export.scheduled_organizer_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+
+    apply.assert_called_once_with(kwargs={'organizer': organizer.pk, 'schedule': due.pk})
+    due.refresh_from_db()
+    assert due.schedule_next_run > now()
+    not_due.refresh_from_db()
+    assert not_due.schedule_next_run == later
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_does_not_dispatch_twice(event, user):
+    ScheduledEventExport.objects.create(event=event, **_schedule_fields(user, now() - timedelta(minutes=1)))
+
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+        run_scheduled_exports(sender=None)
+
+    assert apply.call_count == 1
+
+
+@pytest.mark.django_db
+def test_run_scheduled_exports_runs_once_when_rule_is_exhausted(event, user):
+    schedule = ScheduledEventExport.objects.create(
+        event=event,
+        **_schedule_fields(user, now() - timedelta(minutes=1)),
+    )
+    schedule.schedule_rrule = "DTSTART:20230118T000000\nRRULE:FREQ=DAILY;COUNT=1;INTERVAL=1;WKST=MO"
+    schedule.save(update_fields=['schedule_rrule'])
+
+    with mock.patch('pretix.base.services.export.scheduled_event_export.apply_async') as apply:
+        run_scheduled_exports(sender=None)
+        run_scheduled_exports(sender=None)
+
+    apply.assert_called_once_with(kwargs={'event': event.pk, 'schedule': schedule.pk})
+    schedule.refresh_from_db()
+    assert schedule.schedule_next_run is None
+
