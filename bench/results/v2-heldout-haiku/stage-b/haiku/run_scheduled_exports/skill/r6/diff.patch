diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..3e8a0c9 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,38 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Find all scheduled exports (event-level and organizer-level) that are due, advance their next run time and
+    enqueue the task that actually executes them. The next run time is advanced in the same transaction that
+    locks the row, so a schedule can't be dispatched twice by concurrent runs of this job.
+    """
+    dispatch = []
+    with transaction.atomic():
+        for schedule in ScheduledEventExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked):
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            dispatch.append((scheduled_event_export, {'event': schedule.event_id, 'schedule': schedule.pk}))
+
+        for schedule in ScheduledOrganizerExport.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked):
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            dispatch.append((scheduled_organizer_export, {
+                'organizer': schedule.organizer_id,
+                'schedule': schedule.pk,
+            }))
+
+    # Enqueue only after commit, so the task never runs before the advanced schedule is visible.
+    for task, kwargs in dispatch:
+        try:
+            task.apply_async(kwargs=kwargs)
+        except Exception:
+            logger.exception(f"Could not enqueue scheduled export {kwargs}.")
+
+
