     )
 
 
+def _claim_due_scheduled_exports(model, select_related=None):
+    # Advance every due schedule to its next occurrence inside one transaction. Once this is committed, a repeated
+    # or concurrent run of the periodic job will no longer see the occurrence as due, so it is dispatched at most once.
+    claimed = []
+    with transaction.atomic():
+        qs = model.objects.filter(
+            schedule_rrule__isnull=False,
+            schedule_next_run__isnull=False,
+            schedule_next_run__lte=now(),
+        )
+        if select_related:
+            qs = qs.select_related(select_related)
+        qs = qs.select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked)
+        for schedule in qs:
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            claimed.append(schedule)
+    return claimed
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    for schedule in _claim_due_scheduled_exports(ScheduledEventExport, select_related='event'):
+        try:
+            scheduled_event_export.apply_async(
+                kwargs={
+                    'event': schedule.event_id,
+                    'schedule': schedule.pk,
+                },
+            )
+        except Exception:
+            # The occurrence has already been advanced, so it is not retried. Log it and carry on with the others.
+            logger.exception(f"Could not dispatch scheduled event export {schedule.pk}.")
+
+    for schedule in _claim_due_scheduled_exports(ScheduledOrganizerExport):
+        try:
+            scheduled_organizer_export.apply_async(
+                kwargs={
+                    'organizer': schedule.organizer_id,
+                    'schedule': schedule.pk,
+                },
+            )
+        except Exception:
+            logger.exception(f"Could not dispatch scheduled organizer export {schedule.pk}.")
+
+
