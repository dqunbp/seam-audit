diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..2645051 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,46 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Dispatches all scheduled exports (event-level and organizer-level) whose next run is due. The next run is
+    advanced before dispatching, within a row lock, so that overlapping periodic runs never dispatch the same
+    occurrence twice. The export itself runs asynchronously in the per-schedule tasks.
+    """
+    dispatch = []
+    with transaction.atomic():
+        for model, task in (
+            (ScheduledEventExport, scheduled_event_export),
+            (ScheduledOrganizerExport, scheduled_organizer_export),
+        ):
+            qs = model.objects.filter(
+                schedule_next_run__lte=now(),
+            ).select_for_update(
+                of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked
+            )
+            for schedule in qs:
+                try:
+                    schedule.compute_next_run()
+                    schedule.save(update_fields=['schedule_next_run'])
+                except Exception:
+                    # Leave the schedule due, so it is retried on the next periodic run. Other schedules must not
+                    # be blocked by this one.
+                    logger.exception(f"Could not advance scheduled export {schedule.pk}.")
+                    continue
+                dispatch.append((task, schedule))
+
+    # Dispatch only after the transaction has committed, so that the advanced next run is visible to the worker.
+    for task, schedule in dispatch:
+        if isinstance(schedule, ScheduledEventExport):
+            kwargs = {'event': schedule.event_id, 'schedule': schedule.pk}
+        else:
+            kwargs = {'organizer': schedule.organizer_id, 'schedule': schedule.pk}
+        try:
+            task.apply_async(kwargs=kwargs)
+        except Exception:
+            # The occurrence is considered consumed at this point. Log loudly, so it can be noticed and re-run.
+            logger.exception(f"Could not dispatch scheduled export {schedule.pk}.")
+
+
