+@pytest.mark.django_db
+@freeze_time("2023-01-19 12:00:00")
+def test_run_scheduled_exports_continues_after_dispatch_failure(event, user):
+    s1 = _event_schedule(event, user, next_run=now() - timedelta(minutes=1))
+    s2 = _event_schedule(event, user, next_run=now() - timedelta(minutes=2))
+    with mock.patch.object(scheduled_event_export, 'apply_async') as apply_async:
+        apply_async.side_effect = [Exception('broker down'), None]
+        run_scheduled_exports(sender=None)
+    assert apply_async.call_count == 2
+    assert {c.kwargs['kwargs']['schedule'] for c in apply_async.call_args_list} == {s1.pk, s2.pk}
+    s1.refresh_from_db()
+    s2.refresh_from_db()
+    assert s1.schedule_next_run > now()
+    assert s2.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-19 12:00:00")
+def test_run_scheduled_exports_skips_schedule_that_cannot_be_advanced(event, user):
+    due = now() - timedelta(minutes=1)
+    s = _event_schedule(event, user, next_run=due)
+    with mock.patch.object(ScheduledEventExport, 'compute_next_run', side_effect=Exception('bad rrule')), \
+            mock.patch.object(scheduled_event_export, 'apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+    apply_async.assert_not_called()
+    s.refresh_from_db()
+    assert s.schedule_next_run == due
