+def _event_schedule(event, user, next_run):
+    return ScheduledEventExport.objects.create(
+        event=event, owner=user, export_identifier='eventdata', export_form_data={}, locale='en',
+        schedule_rrule='FREQ=DAILY', schedule_rrule_time=time(6, 30), schedule_next_run=next_run,
+        mail_subject='Export', mail_template='Your export',
+    )
+
+
+def _organizer_schedule(organizer, user, next_run):
+    return ScheduledOrganizerExport.objects.create(
+        organizer=organizer, owner=user, export_identifier='eventdata', export_form_data={}, locale='en',
+        schedule_rrule='FREQ=DAILY', schedule_rrule_time=time(6, 30), schedule_next_run=next_run,
+        mail_subject='Export', mail_template='Your export', timezone='Europe/Berlin',
+    )
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-19 12:00:00")
+def test_run_scheduled_exports_queues_due_event_schedule(event, user):
+    s = _event_schedule(event, user, next_run=now() - timedelta(minutes=1))
+    with mock.patch.object(scheduled_event_export, 'apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+    apply_async.assert_called_once_with(kwargs={'event': event.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-19 12:00:00")
+def test_run_scheduled_exports_queues_due_organizer_schedule(event, user):
+    s = _organizer_schedule(event.organizer, user, next_run=now() - timedelta(minutes=1))
+    with mock.patch.object(scheduled_organizer_export, 'apply_async') as apply_async:
+        run_scheduled_exports(sender=None)
+    apply_async.assert_called_once_with(kwargs={'organizer': event.organizer.pk, 'schedule': s.pk})
+    s.refresh_from_db()
+    assert s.schedule_next_run > now()
+
+
+@pytest.mark.django_db
+@freeze_time("2023-01-19 12:00:00")
+def test_run_scheduled_exports_ignores_schedules_not_due(event, user):
+    next_run = now() + timedelta(hours=1)
+    s = _event_schedule(event, user, next_run=next_run)
+    o = _organizer_schedule(event.organizer, user, next_run=None)
+    with mock.patch.object(scheduled_event_export, 'apply_async') as event_apply_async, \
+            mock.patch.object(scheduled_organizer_export, 'apply_async') as organizer_apply_async:
+        run_scheduled_exports(sender=None)
+    event_apply_async.assert_not_called()
+    organizer_apply_async.assert_not_called()
+    s.refresh_from_db()
+    o.refresh_from_db()
+    assert s.schedule_next_run == next_run
+    assert o.schedule_next_run is None
+    assert len(djmail.outbox) == 0
+
+
