diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..c8c3c99 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,54 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _claim_due_schedules(model):
+    """
+    Selects all schedules of ``model`` that are due, advances their ``schedule_next_run`` to the next
+    occurrence and returns them. This happens in one transaction with row locks, so concurrent periodic
+    runs never claim the same schedule and a schedule is never run twice for the same occurrence.
+    """
+    claimed = []
+    with transaction.atomic():
+        due = model.objects.select_for_update(
+            skip_locked=connection.features.has_select_for_update_skip_locked,
+            of=OF_SELF,
+        ).filter(schedule_next_run__lte=now())
+        for schedule in due:
+            try:
+                schedule.compute_next_run()
+                schedule.save(update_fields=['schedule_next_run'])
+            except Exception:
+                logger.exception(f"Could not compute next run of scheduled export {schedule.pk}.")
+                continue
+            claimed.append(schedule)
+    return claimed
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    # Claiming happens before dispatching, so a schedule is only queued once per occurrence. A failing
+    # dispatch is logged and skipped for that occurrence instead of blocking the remaining schedules.
+    for schedule in _claim_due_schedules(ScheduledEventExport):
+        try:
+            scheduled_event_export.apply_async(
+                kwargs={
+                    'event': schedule.event_id,
+                    'schedule': schedule.pk,
+                },
+            )
+        except Exception:
+            logger.exception(f"Could not queue scheduled event export {schedule.pk}.")
+
+    for schedule in _claim_due_schedules(ScheduledOrganizerExport):
+        try:
+            scheduled_organizer_export.apply_async(
+                kwargs={
+                    'organizer': schedule.organizer_id,
+                    'schedule': schedule.pk,
+                },
+            )
+        except Exception:
+            logger.exception(f"Could not queue scheduled organizer export {schedule.pk}.")
+
+
