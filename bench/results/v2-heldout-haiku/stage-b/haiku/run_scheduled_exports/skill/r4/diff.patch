diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..1e4dd38 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,46 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _dispatch_due_scheduled_exports(queryset, task, context_kwarg):
+    # Advancing schedule_next_run and dispatching happen in the same savepoint, so a failed dispatch leaves the
+    # schedule due and the next periodic run retries it. The row lock keeps concurrent periodic runs from
+    # dispatching the same schedule twice.
+    with transaction.atomic():
+        due = queryset.select_for_update(
+            skip_locked=connection.features.has_select_for_update_skip_locked,
+            of=OF_SELF,
+        ).filter(
+            schedule_next_run__lte=now(),
+            schedule_rrule__isnull=False,
+        )
+        for schedule in due:
+            try:
+                with transaction.atomic():
+                    schedule.compute_next_run()
+                    schedule.save(update_fields=['schedule_next_run'])
+                    # Routed to the "background" queue via settings.CELERY_TASK_ROUTES
+                    task.apply_async(
+                        kwargs={
+                            context_kwarg: getattr(schedule, f'{context_kwarg}_id'),
+                            'schedule': schedule.pk,
+                        },
+                    )
+            except Exception:
+                logger.exception(f"Could not dispatch scheduled export {schedule.pk}.")
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    _dispatch_due_scheduled_exports(
+        ScheduledEventExport.objects.select_related('event'),
+        scheduled_event_export,
+        'event',
+    )
+    _dispatch_due_scheduled_exports(
+        ScheduledOrganizerExport.objects.select_related('organizer'),
+        scheduled_organizer_export,
+        'organizer',
+    )
+
+
