+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    """
+    Sends a warning to customers with an unpaid order shortly before their payment deadline. The number of days
+    is configured per event in ``mail_days_order_expire_warning``, a value of 0 disables the warning.
+    """
+    events = Event.objects.filter(
+        Exists(
+            Order.objects.filter(
+                event_id=OuterRef('id'),
+                status=Order.STATUS_PENDING,
+                valid_if_pending=False,
+                require_approval=False,
+                expiry_reminder_sent=False,
+            )
+        )
+    ).order_by()
+
+    for event in events.iterator(chunk_size=10_000):
+        days = event.settings.get('mail_days_order_expire_warning', as_type=int)
+        if not days or not event.settings.get('payment_term_expire_automatically', as_type=bool):
+            continue
+
+        qs = event.orders.filter(
+            status=Order.STATUS_PENDING,
+            valid_if_pending=False,
+            require_approval=False,
+            expiry_reminder_sent=False,
+            # The payment deadline is never earlier than ``expires``, so this is a superset of the orders in the window
+            expires__lte=now() + timedelta(days=days),
+        ).exclude(
+            Exists(
+                OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+            )
+        ).prefetch_related('event').order_by()
+
+        for o in qs:
+            if not _is_in_expiry_warning_window(o, days):
+                continue
+
+            with transaction.atomic():
+                o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.expiry_reminder_sent:
+                    # Race condition
+                    continue
+                if o.status != Order.STATUS_PENDING or not _is_in_expiry_warning_window(o, days):
+                    continue
+
+                with language(o.locale, event.settings.region):
+                    o.expiry_reminder_sent = True
+                    o.save(update_fields=['expiry_reminder_sent'])
+                    o.send_mail(
+                        event.settings.mail_subject_order_expire_warning,
+                        event.settings.mail_text_order_expire_warning,
+                        get_email_context(event=event, order=o),
+                        'pretix.event.order.email.expire_warning_sent',
+                    )
+
+
+def _is_in_expiry_warning_window(order: Order, days: int) -> bool:
+    deadline = order.payment_term_expire_date
+    # Once the deadline has passed, ``expire_orders`` takes over and the warning would be misleading
+    return now() < deadline and now() >= deadline - timedelta(days=days)
+
+
