+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.mail_days_order_expire_warning = 3
+            self.event.settings.payment_term_expire_automatically = True
+            self.event.settings.payment_term_expire_delay_days = 0
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now() - timedelta(days=4),
+                expires=now() + timedelta(days=2),
+                total=Decimal('46.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            djmail.outbox = []
+
+    def _sent_warnings(self):
+        return self.order.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent')
+
+    @classscope(attr='o')
+    def test_sends_warning_inside_window(self):
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert self._sent_warnings().count() == 1
+
+    @classscope(attr='o')
+    def test_not_sent_outside_window(self):
+        self.order.expires = now() + timedelta(days=10)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_disabled_when_days_is_zero(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_twice(self):
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert self._sent_warnings().count() == 1
+
+    @classscope(attr='o')
+    def test_not_sent_after_deadline_has_passed(self):
+        self.order.expires = now() - timedelta(hours=1)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_paid_order(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_expired_order(self):
+        self.order.status = Order.STATUS_EXPIRED
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_valid_if_pending_order(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_order_requiring_approval(self):
+        self.order.require_approval = True
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_when_orders_do_not_expire_automatically(self):
+        self.event.settings.payment_term_expire_automatically = False
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_window_uses_payment_deadline_not_expires(self):
+        # expires is in 2 days, but the payment deadline is 10 days later
+        self.event.settings.payment_term_expire_delay_days = 10
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+        self.event.settings.payment_term_expire_delay_days = 0
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_extended_order_gets_new_warning(self):
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+        extend_order(self.order, new_date=now() + timedelta(days=2, hours=1), force=True)
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 2
+
+    @classscope(attr='o')
+    def test_cancellation_fee_order_skipped(self):
+        self.order.fees.create(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+
