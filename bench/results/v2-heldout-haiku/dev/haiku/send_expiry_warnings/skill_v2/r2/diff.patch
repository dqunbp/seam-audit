+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.mail_days_order_expire_warning = 3
+            self.event.settings.payment_term_expire_automatically = True
+            djmail.outbox = []
+
+    def _order(self, code='FOO', expires_in=timedelta(days=2), placed=timedelta(days=-4), **kwargs):
+        kwargs.setdefault('status', Order.STATUS_PENDING)
+        return Order.objects.create(
+            code=code, event=self.event, email='dummy@dummy.test', locale='en',
+            datetime=now() + placed,
+            expires=now() + expires_in,
+            total=Decimal('46.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            **kwargs
+        )
+
+    @classscope(attr='o')
+    def test_sent_inside_window(self):
+        o = self._order()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        o.refresh_from_db()
+        assert o.expiry_reminder_sent
+        assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+    @classscope(attr='o')
+    def test_sent_only_once(self):
+        self._order()
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_sent_before_window(self):
+        o = self._order(expires_in=timedelta(days=10))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        o.refresh_from_db()
+        assert not o.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_not_sent_after_deadline(self):
+        self._order(expires_in=timedelta(hours=-1))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_if_disabled(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        self._order()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_if_deadline_not_enforced(self):
+        self.event.settings.payment_term_expire_automatically = False
+        self._order()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_if_placed_inside_window(self):
+        self._order(placed=timedelta(hours=-1))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_paid_order(self):
+        self._order(status=Order.STATUS_PAID)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_valid_if_pending(self):
+        self._order(valid_if_pending=True)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_approval_pending(self):
+        self._order(require_approval=True)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_with_cancellation_fee(self):
+        o = self._order()
+        OrderFee.objects.create(order=o, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+
