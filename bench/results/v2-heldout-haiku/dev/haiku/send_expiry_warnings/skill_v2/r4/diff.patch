+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    for event in Event.objects.all().order_by():
+        days = event.settings.get('mail_days_order_expire_warning', as_type=int)
+        if not days:
+            # 0 means that the warning is disabled
+            continue
+        if not event.settings.get('payment_term_expire_automatically', as_type=bool):
+            # Orders of this event are not expired automatically, so a warning about expiry would be misleading
+            continue
+
+        delay = event.settings.get('payment_term_expire_delay_days', as_type=int)
+        # The payment deadline is never earlier than ``expires`` and at most ``delay`` days (plus up to two days
+        # for weekend handling) later, so this query range covers every order whose deadline is within the window.
+        # The exact check is done per order below.
+        cur_now = now()
+        qs = event.orders.filter(
+            status=Order.STATUS_PENDING,
+            valid_if_pending=False,
+            require_approval=False,
+            expiry_reminder_sent=False,
+            expires__gt=cur_now - timedelta(days=delay + 2),
+            expires__lte=cur_now + timedelta(days=days),
+        ).exclude(
+            Exists(
+                OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+            )
+        ).order_by()
+
+        for o in qs:
+            if not (cur_now < o.payment_term_expire_date <= cur_now + timedelta(days=days)):
+                continue
+
+            with transaction.atomic():
+                o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.expiry_reminder_sent:
+                    # Race condition
+                    continue
+                if o.status != Order.STATUS_PENDING:
+                    continue
+
+                with language(o.locale, event.settings.region):
+                    o.expiry_reminder_sent = True
+                    o.save(update_fields=['expiry_reminder_sent'])
+                    email_template = event.settings.mail_text_order_expire_warning
+                    email_subject = event.settings.mail_subject_order_expire_warning
+                    email_context = get_email_context(event=event, order=o)
+                    o.send_mail(
+                        email_subject, email_template, email_context,
+                        'pretix.event.order.email.expire_warning_sent',
+                    )
+
+
