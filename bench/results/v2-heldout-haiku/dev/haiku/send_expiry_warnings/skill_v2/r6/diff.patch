+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.payment_term_expire_automatically = True
+            self.event.settings.mail_days_order_expire_warning = 3
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now() - timedelta(days=4),
+                expires=now() + timedelta(days=2),
+                total=Decimal('46.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            djmail.outbox = []
+
+    def _reminder_sent_count(self):
+        return self.order.all_logentries().filter(
+            action_type='pretix.event.order.email.expire_warning_sent'
+        ).count()
+
+    @classscope(attr='o')
+    def test_sent_once_inside_window(self):
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        assert self._reminder_sent_count() == 1
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+        assert self._reminder_sent_count() == 1
+
+    @classscope(attr='o')
+    def test_not_sent_before_window(self):
+        self.order.expires = now() + timedelta(days=10)
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_sent_when_window_opens(self):
+        self.order.expires = now() + timedelta(days=10)
+        self.order.save()
+        with freeze_time(now() + timedelta(days=7, hours=1)):
+            send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_disabled_when_days_is_zero(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_if_orders_do_not_expire_automatically(self):
+        self.event.settings.payment_term_expire_automatically = False
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_paid_order(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_order_pending_approval(self):
+        self.order.require_approval = True
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_valid_if_pending_order(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_order_with_cancellation_fee(self):
+        OrderFee.objects.create(
+            order=self.order, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'),
+        )
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_after_deadline_has_passed(self):
+        self.order.expires = now() - timedelta(hours=1)
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_deadline_uses_payment_grace_period(self):
+        # The order expired two days ago, but the grace period moves the real deadline into the window
+        self.order.expires = now() - timedelta(days=2)
+        self.order.save()
+        self.event.settings.payment_term_expire_delay_days = 3
+        self.event.settings.payment_term_weekdays = False  # keep the deadline independent of the weekday
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_grace_period_pushes_deadline_out_of_window(self):
+        # The order expires inside the window, but the grace period moves the real deadline beyond it
+        self.event.settings.payment_term_expire_delay_days = 10
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_to_order_created_inside_window(self):
+        self.order.datetime = now()
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_custom_subject_and_text_are_used(self):
+        self.event.settings.mail_subject_order_expire_warning = 'Expiring {code} soon'
+        send_expiry_warnings(sender=None)
+        assert djmail.outbox[0].subject == 'Expiring FOO soon'
+
+
