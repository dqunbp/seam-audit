+from datetime import datetime, timedelta
+from decimal import Decimal
+from zoneinfo import ZoneInfo
+
+from django.core import mail as djmail
+from django.test import TestCase
+from django.utils.timezone import now
+from django_scopes import scope
+from freezegun import freeze_time
+
+from pretix.base.models import Event, Order, OrderFee, Organizer
+from pretix.base.services.orders import send_expiry_warnings
+
+FROZEN = datetime(2026, 10, 1, 12, 0, tzinfo=ZoneInfo('UTC'))
+
+
+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.mail_days_order_expire_warning = 3
+            self.event.settings.payment_term_expire_automatically = True
+            self.event.settings.mail_subject_order_expire_warning = 'Expiry warning {code}'
+            self.event.settings.mail_text_order_expire_warning = 'Please pay for {code}.'
+            with freeze_time(FROZEN):
+                self.order = self._create_order()
+            djmail.outbox = []
+
+    def _create_order(self, **kwargs):
+        params = dict(
+            code='FOO', event=self.event, email='dummy@dummy.test',
+            status=Order.STATUS_PENDING, locale='en',
+            datetime=FROZEN,
+            expires=FROZEN + timedelta(days=5),
+            total=Decimal('46.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+        )
+        params.update(kwargs)
+        return Order.objects.create(**params)
+
+    def _run_at(self, when):
+        with freeze_time(when):
+            send_expiry_warnings(sender=self.event)
+
+    def _expiry_mails(self):
+        return [m for m in djmail.outbox if m.subject.startswith('Expiry warning')]
+
+    def test_not_sent_before_window(self):
+        # Order expires in 5 days, warning is due 3 days before that, i.e. after 2 days.
+        self._run_at(FROZEN + timedelta(days=1, hours=23))
+        assert len(self._expiry_mails()) == 0
+
+    def test_sent_inside_window(self):
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        assert len(self._expiry_mails()) == 1
+        mail = self._expiry_mails()[0]
+        assert mail.subject == 'Expiry warning FOO'
+        assert mail.to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert self.order.all_logentries().filter(
+            action_type='pretix.event.order.email.expire_warning_sent'
+        ).exists()
+
+    def test_sent_only_once(self):
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        self._run_at(FROZEN + timedelta(days=2, hours=2))
+        self._run_at(FROZEN + timedelta(days=4))
+        assert len(self._expiry_mails()) == 1
+
+    def test_not_sent_after_deadline(self):
+        self._run_at(FROZEN + timedelta(days=5, hours=1))
+        assert len(self._expiry_mails()) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    def test_disabled_with_zero_days(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        assert len(self._expiry_mails()) == 0
+
+    def test_skipped_if_order_does_not_expire_automatically(self):
+        self.event.settings.payment_term_expire_automatically = False
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        assert len(self._expiry_mails()) == 0
+
+    def test_skipped_for_paid_order(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        assert len(self._expiry_mails()) == 0
+
+    def test_skipped_for_valid_if_pending_order(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        assert len(self._expiry_mails()) == 0
+
+    def test_skipped_for_order_requiring_approval(self):
+        self.order.require_approval = True
+        self.order.save()
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        assert len(self._expiry_mails()) == 0
+
+    def test_skipped_with_cancellation_fee(self):
+        with scope(organizer=self.o):
+            OrderFee.objects.create(
+                order=self.order, fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                value=Decimal('5.00'), tax_rate=Decimal('0.00'), tax_value=Decimal('0.00'),
+                tax_rule=None,
+            )
+        self._run_at(FROZEN + timedelta(days=2, hours=1))
+        assert len(self._expiry_mails()) == 0
+
+    def test_uses_payment_term_deadline(self):
+        # With a payment term delay, the real deadline is later than ``expires``,
+        # so the warning must follow the deadline, not the raw ``expires`` timestamp.
+        self.event.settings.payment_term_expire_delay_days = 10
+        self._run_at(FROZEN + timedelta(days=5, hours=1))
+        assert len(self._expiry_mails()) == 0
+        self._run_at(FROZEN + timedelta(days=14))
+        assert len(self._expiry_mails()) == 1
