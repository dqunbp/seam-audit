+def _expiry_warning_order(event, code, expires, status=Order.STATUS_PENDING, **kwargs):
+    o = Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=expires,
+        total=Decimal('12.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+    OrderPosition.objects.create(
+        order=o, item=Item.objects.get_or_create(event=event, name='Ticket', defaults={
+            'default_price': Decimal('12.00'), 'admission': True,
+        })[0], variation=None,
+        price=Decimal("12.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+    )
+    return o
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _expiry_warning_order(event, 'EW1', now() + timedelta(days=2))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is True
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_outside_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _expiry_warning_order(event, 'EW2', now() + timedelta(days=10))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is False
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_when_disabled(event):
+    event.settings.mail_days_order_expire_warning = 0
+    _expiry_warning_order(event, 'EW3', now() + timedelta(hours=1))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_only_once(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _expiry_warning_order(event, 'EW4', now() + timedelta(days=2))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_skips_non_pending_and_expired(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _expiry_warning_order(event, 'EW5', now() + timedelta(days=2), status=Order.STATUS_PAID)
+    _expiry_warning_order(event, 'EW6', now() - timedelta(hours=1))
+    _expiry_warning_order(event, 'EW7', now() + timedelta(days=2), valid_if_pending=True)
+    _expiry_warning_order(event, 'EW8', now() + timedelta(days=2), require_approval=True)
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
