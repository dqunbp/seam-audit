+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    events = Event.objects.filter(
+        Exists(
+            Order.objects.filter(
+                event_id=OuterRef('pk'),
+                status=Order.STATUS_PENDING,
+                expiry_reminder_sent=False,
+            )
+        )
+    ).order_by()
+
+    for event in events.iterator(chunk_size=10_000):
+        days = event.settings.get('mail_days_order_expire_warning', as_type=int)
+        # 0 means the warning is never sent. Orders that do not expire automatically have no deadline to warn about.
+        if not days or not event.settings.get('payment_term_expire_automatically', as_type=bool):
+            continue
+
+        qs = event.orders.filter(
+            status=Order.STATUS_PENDING,
+            valid_if_pending=False,
+            require_approval=False,
+            expiry_reminder_sent=False,
+            # The payment deadline is at most about a day earlier than ``expires`` (timezone rounding), so
+            # orders expiring after this point cannot be inside the warning window yet.
+            expires__lte=now() + timedelta(days=days + 2),
+        ).exclude(
+            Exists(
+                OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+            )
+        ).order_by()
+
+        for o in qs:
+            deadline = o.payment_term_expire_date
+            if not (deadline - timedelta(days=days) <= now() < deadline):
+                continue
+
+            with transaction.atomic():
+                o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.expiry_reminder_sent or o.status != Order.STATUS_PENDING:
+                    # Race condition
+                    continue
+
+                with language(o.locale, event.settings.region):
+                    o.expiry_reminder_sent = True
+                    o.save(update_fields=['expiry_reminder_sent'])
+                    email_template = event.settings.mail_text_order_expire_warning
+                    email_subject = event.settings.mail_subject_order_expire_warning
+                    email_context = get_email_context(event=event, order=o, pending_sum=o.pending_sum)
+                    o.send_mail(
+                        email_subject, email_template, email_context,
+                        'pretix.event.order.email.expire_warning_sent',
+                    )
+
+
