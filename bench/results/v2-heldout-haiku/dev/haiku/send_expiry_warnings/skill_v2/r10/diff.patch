+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, Item, Order, OrderFee, OrderPosition, Organizer,
+)
+from pretix.base.services.orders import send_expiry_warnings
+
+
+@pytest.fixture
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now(),
+        plugins='pretix.plugins.banktransfer'
+    )
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def order(event):
+    o = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING, locale='en',
+        datetime=now() - timedelta(days=5), expires=now() + timedelta(days=2),
+        total=Decimal('23.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    ticket = Item.objects.create(event=event, name='Early-bird ticket',
+                                 default_price=Decimal('23.00'), admission=True)
+    OrderPosition.objects.create(
+        order=o, item=ticket, variation=None,
+        price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+    )
+    event.settings.mail_days_order_expire_warning = 3
+    djmail.outbox = []
+    return o
+
+
+def _warning_logs(order):
+    return order.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent')
+
+
+@pytest.mark.django_db
+def test_sent_once_within_window(event, order):
+    send_expiry_warnings(sender=event)
+    order.refresh_from_db()
+    assert order.expiry_reminder_sent is True
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert _warning_logs(order).count() == 1
+
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+    assert _warning_logs(order).count() == 1
+
+
+@pytest.mark.django_db
+def test_not_sent_before_window(event, order):
+    order.expires = now() + timedelta(days=10)
+    order.save()
+    send_expiry_warnings(sender=event)
+    order.refresh_from_db()
+    assert order.expiry_reminder_sent is False
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_disabled_if_zero_days(event, order):
+    event.settings.mail_days_order_expire_warning = 0
+    send_expiry_warnings(sender=event)
+    order.refresh_from_db()
+    assert order.expiry_reminder_sent is False
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_not_sent_after_deadline(event, order):
+    order.expires = now() - timedelta(hours=1)
+    order.save()
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_not_sent_if_order_placed_inside_window(event, order):
+    # Same rule as the download reminder: an order placed after the reminder date gets no reminder
+    order.datetime = now() - timedelta(hours=1)
+    order.save()
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_not_sent_if_paid(event, order):
+    order.status = Order.STATUS_PAID
+    order.save()
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_not_sent_if_valid_if_pending(event, order):
+    order.valid_if_pending = True
+    order.save()
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_not_sent_if_approval_pending(event, order):
+    order.require_approval = True
+    order.save()
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_not_sent_if_canceled_with_fee(event, order):
+    OrderFee.objects.create(order=order, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'))
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_respects_payment_term_delay(event, order):
+    # The deadline is ``payment_term_expire_date``, which is 10 days after ``expires`` here, so the
+    # 3-day window does not open yet.
+    event.settings.payment_term_expire_delay_days = 10
+    send_expiry_warnings(sender=event)
+    order.refresh_from_db()
+    assert order.expiry_reminder_sent is False
+    assert len(djmail.outbox) == 0
