+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    """
+    Send each unpaid order a reminder ``mail_days_order_expire_warning`` days before its payment deadline.
+    A value of 0 disables the reminder. Orders that will not expire automatically (valid if pending,
+    awaiting approval, or with a cancellation fee) are skipped, just like in ``expire_orders``.
+    """
+    events = Event.objects.filter(
+        Exists(
+            Order.objects.filter(
+                event_id=OuterRef('pk'),
+                status=Order.STATUS_PENDING,
+                valid_if_pending=False,
+                require_approval=False,
+                expiry_reminder_sent=False,
+            )
+        )
+    ).order_by()
+
+    for event in events.iterator(chunk_size=10_000):
+        reminder_days = event.settings.get('mail_days_order_expire_warning', as_type=int)
+        if not reminder_days:
+            continue
+
+        # ``expires`` is never later than the payment term deadline, so this is a superset of the orders
+        # that are due, and the exact check is done per order below.
+        qs = event.orders.filter(
+            status=Order.STATUS_PENDING,
+            valid_if_pending=False,
+            require_approval=False,
+            expiry_reminder_sent=False,
+            expires__lte=now() + timedelta(days=reminder_days),
+        ).exclude(
+            Exists(
+                OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+            )
+        ).order_by()
+
+        for o in qs:
+            reminder_date = o.payment_term_expire_date - timedelta(days=reminder_days)
+            if now() < reminder_date or now() >= o.payment_term_expire_date or o.datetime > reminder_date:
+                continue
+
+            with transaction.atomic():
+                o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.expiry_reminder_sent or o.status != Order.STATUS_PENDING:
+                    # Race condition, e.g. the order was paid or expired in the meantime
+                    continue
+
+                with language(o.locale, event.settings.region):
+                    o.expiry_reminder_sent = True
+                    o.save(update_fields=['expiry_reminder_sent'])
+                    email_template = event.settings.mail_text_order_expire_warning
+                    email_subject = event.settings.mail_subject_order_expire_warning
+                    email_context = get_email_context(event=event, order=o)
+                    o.send_mail(
+                        email_subject, email_template, email_context,
+                        'pretix.event.order.email.expire_warning_sent',
+                    )
+
+
 def notify_user_changed_order(order, user=None, auth=None, invoices=[]):
     with language(order.locale, order.event.settings.region):
