+def _download_reminder_start(event, order):
+    """
+    Returns the start of the event the order is for. For event series, this is the earliest subevent
+    the order has a position for, the same way ``Order.ticket_download_date`` determines it.
+    """
+    if not event.has_subevents:
+        return event.date_from
+    return min(
+        event.subevents.filter(
+            id__in=order.positions.values_list('subevent', flat=True)
+        ).values_list('date_from', flat=True),
+        default=None,
+    )
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    # Only events that have not ended yet can have pending reminders. Series events are always included
+    # because their end is only known per subevent.
+    for event in Event.objects.filter(Q(has_subevents=True) | Q(date_from__gt=now()) | Q(date_to__gt=now())):
+        days = event.settings.get('mail_days_download_reminder', as_type=int)
+        if days is None or not event.settings.ticket_download:
+            continue
+
+        for o in Order.objects.filter(
+            event=event,
+            status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+            download_reminder_sent=False,
+        ).select_related('event', 'sales_channel'):
+            if o.sales_channel.identifier not in event.settings.mail_sales_channel_download_reminder:
+                continue
+
+            start = _download_reminder_start(event, o)
+            if start is None or start <= now():
+                continue
+            reminder_date = (start - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+            if reminder_date > now() or not o.ticket_download_available:
+                continue
+
+            with transaction.atomic():
+                o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.download_reminder_sent or not o.ticket_download_available:
+                    # Race condition
+                    continue
+
+                with language(o.locale, event.settings.region):
+                    email_context = get_email_context(event=event, order=o)
+                    o.send_mail(
+                        event.settings.mail_subject_download_reminder,
+                        event.settings.mail_text_download_reminder,
+                        email_context,
+                        'pretix.event.order.email.download_reminder_sent',
+                    )
+
+                    if event.settings.mail_send_download_reminder_attendee:
+                        for p in o.positions.all():
+                            if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                                email_context = get_email_context(event=event, order=o, position=p)
+                                p.send_mail(
+                                    event.settings.mail_subject_download_reminder_attendee,
+                                    event.settings.mail_text_download_reminder_attendee,
+                                    email_context,
+                                    'pretix.event.order.email.download_reminder_sent',
+                                )
+
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+
+
