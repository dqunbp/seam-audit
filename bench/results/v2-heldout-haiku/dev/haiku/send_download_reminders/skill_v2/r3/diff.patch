+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    settings = None
+    reminder_date = None
+    event_id = None
+
+    for o in Order.objects.filter(
+            status=Order.STATUS_PAID, download_reminder_sent=False, event__date_from__gt=now(),
+    ).select_related('event', 'sales_channel').order_by('event_id'):
+
+        if event_id != o.event_id:
+            settings = o.event.settings
+            event_id = o.event_id
+            reminder_date = None
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            # Same rule as the timeline entry in pretix.base.timeline
+            if days is not None and not o.event.has_subevents and settings.ticket_download:
+                reminder_date = (o.event.date_from - timedelta(days=days)).replace(
+                    hour=0, minute=0, second=0, microsecond=0
+                )
+
+        if reminder_date is None or now() < reminder_date:
+            continue
+        if o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder:
+            continue
+        if not o.ticket_download_available:
+            # Tickets not downloadable yet (or not anymore); leave the order for a later run
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                # Race condition
+                continue
+
+            with language(o.locale, settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    settings.mail_subject_download_reminder, settings.mail_text_download_reminder, email_context,
+                    'pretix.event.order.email.download_reminder_sent'
+                )
+
+                if settings.mail_send_download_reminder_attendee:
+                    for position in o.positions.all():
+                        email_context = get_email_context(event=o.event, order=o, position=position)
+                        position.send_mail(
+                            settings.mail_subject_download_reminder_attendee,
+                            settings.mail_text_download_reminder_attendee,
+                            email_context,
+                            'pretix.event.order.email.download_reminder_sent',
+                        )
+
+
