+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+
+    @classscope(attr='o')
+    def test_attendee_with_order_email_and_addon_not_mailed_twice(self):
+        self.event.settings.mail_days_download_reminder = 2
+        self.event.settings.mail_send_download_reminder_attendee = True
+        self.op1.attendee_email = 'dummy@dummy.test'
+        self.op1.save()
+        OrderPosition.objects.create(
+            order=self.order, item=self.ticket, variation=None, addon_to=self.op1,
+            price=Decimal("0.00"), attendee_name_parts={'full_name': "Addon"}, positionid=2,
+            attendee_email='addon@dummy.test',
+        )
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+
+    @classscope(attr='o')
+    def test_subevent_date_decides(self):
+        with scope(organizer=self.o):
+            event = Event.objects.create(
+                organizer=self.o, name='Series', slug='series', has_subevents=True,
+                date_from=now() + timedelta(days=2),
+            )
+            event.settings.ticket_download = True
+            event.settings.mail_days_download_reminder = 2
+            item = Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+            se_far = SubEvent.objects.create(event=event, name='Far', date_from=now() + timedelta(days=10), active=True)
+            se_near = SubEvent.objects.create(event=event, name='Near', date_from=now() + timedelta(days=2), active=True)
+
+            far_order = self._create_order('FAR', event=event)
+            OrderPosition.objects.create(
+                order=far_order, item=item, variation=None, subevent=se_far,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Far"}, positionid=1,
+            )
+            near_order = self._create_order('NEAR', event=event)
+            OrderPosition.objects.create(
+                order=near_order, item=item, variation=None, subevent=se_near,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Near"}, positionid=1,
+            )
+
+            send_download_reminders(sender=event)
+            far_order.refresh_from_db()
+            near_order.refresh_from_db()
+            assert not far_order.download_reminder_sent
+            assert near_order.download_reminder_sent
+            assert len(djmail.outbox) == 1
+
+
