+def _download_reminder_due(order: Order, days: int) -> bool:
+    # Mirrors the reminder date shown in the event timeline: days before the start of the event, or of the
+    # earliest subevent the order has positions for (like ``Order.ticket_download_date``).
+    if order.event.has_subevents:
+        starts = list(order.positions.filter(subevent__isnull=False).values_list('subevent__date_from', flat=True))
+        event_start = min(starts) if starts else None
+    else:
+        event_start = order.event.date_from
+
+    if event_start is None or event_start <= now():
+        # Never send reminders for events that already started
+        return False
+
+    tz = order.event.timezone
+    return now().astimezone(tz).date() >= event_start.astimezone(tz).date() - timedelta(days=days)
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    days = None
+    settings = None
+    event_id = None
+
+    for o in Order.objects.filter(
+            status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+            download_reminder_sent=False,
+    ).select_related('event', 'sales_channel').order_by('event_id'):
+
+        if event_id != o.event_id:
+            settings = o.event.settings
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None or not o.ticket_download_available:
+            continue
+        if o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder:
+            continue
+        if not _download_reminder_due(o, days):
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status not in (Order.STATUS_PAID, Order.STATUS_PENDING) or o.download_reminder_sent:
+                # Race condition
+                continue
+            if not o.ticket_download_available:
+                continue
+
+            with language(o.locale, settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    settings.mail_subject_download_reminder, settings.mail_text_download_reminder, email_context,
+                    'pretix.event.order.email.download_reminder_sent',
+                    attach_tickets=True,
+                )
+
+                if settings.mail_send_download_reminder_attendee:
+                    for p in o.positions.all():
+                        if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                            email_context = get_email_context(event=o.event, order=o, position=p)
+                            p.send_mail(
+                                settings.mail_subject_download_reminder_attendee,
+                                settings.mail_text_download_reminder_attendee,
+                                email_context,
+                                'pretix.event.order.email.download_reminder_sent',
+                                attach_tickets=True,
+                            )
+
