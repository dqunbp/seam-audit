+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    event_id = None
+    settings = None
+    days = None
+
+    # Same window as the download reminder on the event timeline: only events without subevents, as the timeline
+    # does not show a reminder date for them either.
+    qs = Order.objects.filter(
+        download_reminder_sent=False,
+        status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+        event__has_subevents=False,
+        event__date_from__gt=now(),
+    ).select_related('event', 'sales_channel').order_by('event_id')
+
+    for o in qs:
+        if event_id != o.event_id:
+            settings = o.event.settings
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None or not settings.ticket_download:
+            continue
+
+        reminder_date = (o.event.date_from - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_date:
+            continue
+
+        if o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder:
+            continue
+
+        if not o.ticket_download_available:
+            # e.g. ticket_download_date is still in the future or the order is not in a downloadable state yet;
+            # we'll check again on the next run
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.download_reminder_sent or not o.ticket_download_available:
+                    # Race condition
+                    continue
+
+                with language(o.locale, settings.region):
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+
+                    email_context = get_email_context(event=o.event, order=o)
+                    o.send_mail(
+                        settings.mail_subject_download_reminder, settings.mail_text_download_reminder,
+                        email_context, 'pretix.event.order.email.download_reminder_sent',
+                    )
+
+                    if settings.mail_send_download_reminder_attendee:
+                        for p in o.positions.all():
+                            if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                                email_attendee_context = get_email_context(event=o.event, order=o, position=p)
+                                o.send_mail(
+                                    settings.mail_subject_download_reminder_attendee,
+                                    settings.mail_text_download_reminder_attendee,
+                                    email_attendee_context, 'pretix.event.order.email.download_reminder_sent',
+                                    position=p,
+                                )
+        except Exception:
+            # Don't let one broken order block the reminders of all other orders; it is retried on the next run,
+            # because the flag was rolled back together with the failed mail.
+            logger.exception('Error while sending download reminder for order %s', o.code)
+
+
