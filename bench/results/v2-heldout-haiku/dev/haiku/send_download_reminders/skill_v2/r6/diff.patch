+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    # Mirrors the reminder date shown in the timeline (base/timeline.py): midnight of the day
+    # that is ``mail_days_download_reminder`` days before the event start. Subevent events are
+    # skipped, as they are in the timeline.
+    for event in Event.objects.filter(date_from__gte=now(), has_subevents=False).order_by('pk'):
+        settings = event.settings
+        days = settings.get('mail_days_download_reminder', as_type=int)
+        if days is None or not settings.ticket_download:
+            continue
+        reminder_date = (event.date_from - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_date:
+            continue
+
+        order_ids = Order.objects.filter(
+            event=event,
+            status=Order.STATUS_PAID,
+            download_reminder_sent=False,
+            require_approval=False,
+            sales_channel__identifier__in=settings.mail_sales_channel_download_reminder,
+        ).values_list('pk', flat=True)
+        for order_id in order_ids:
+            with transaction.atomic():
+                o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=order_id)
+                if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                    # Race condition
+                    continue
+                if not o.ticket_download_available:
+                    # Download not open yet (ticket_download_date); try again on a later run
+                    continue
+
+                with language(o.locale, settings.region):
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+                    email_context = get_email_context(event=o.event, order=o)
+                    o.send_mail(
+                        settings.mail_subject_download_reminder,
+                        settings.mail_text_download_reminder,
+                        email_context,
+                        'pretix.event.order.email.download_reminder_sent',
+                    )
+
+
