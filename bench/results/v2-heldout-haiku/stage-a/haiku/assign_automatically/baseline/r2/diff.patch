+@app.task(base=EventTask)
+def assign_automatically(event: Event, user_id: int=None, subevent_id: int=None) -> int:
+    """
+    Creates vouchers for the entries on the waiting list of ``event`` and sends them out by email, in the
+    waiting list's priority order, as long as there is availability for the requested product. If ``subevent_id``
+    is given, only entries for that date are considered. Returns the number of vouchers created.
+    """
+    user = User.objects.get(pk=user_id) if user_id else None
+    qs = WaitingListEntry.objects.filter(
+        event=event,
+        voucher__isnull=True,
+    ).select_related('item', 'variation', 'subevent')
+    if subevent_id:
+        qs = qs.filter(subevent_id=subevent_id)
+
+    num = 0
+    for wle in qs:
+        # Once the waiting list has been disabled for this date, nobody gets vouchers any more (see quotas.py)
+        auto_disable = wle.event.settings.waiting_list_auto_disable
+        if auto_disable and auto_disable.datetime(wle.subevent or wle.event) <= now():
+            continue
+        try:
+            # We deliberately do not pass a quota cache here: every voucher we create reduces the availability
+            # for the entries after it, so cached availability would be stale.
+            wle.send_voucher(user=user)
+        except WaitingListException:
+            # Not available (any more), anonymized entry, or someone else already got a voucher in the meantime.
+            continue
+        num += 1
+    return num
