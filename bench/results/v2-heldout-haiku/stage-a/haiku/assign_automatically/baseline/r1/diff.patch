+
+@app.task(base=EventTask)
+def assign_automatically(event: Event, user_id: int=None, subevent_id: int=None):
+    """
+    Sends out vouchers to waiting list entries of ``event`` (optionally restricted to one date ``subevent_id``)
+    in priority order, as long as there is quota available for them. Returns the number of vouchers created.
+
+    Runs without a ``user_id`` are automatic runs and stop once the ``waiting_list_auto_disable`` date has passed.
+    """
+    user = User.objects.get(pk=user_id) if user_id else None
+    subevent = event.subevents.get(pk=subevent_id) if subevent_id else None
+    auto_disable = event.settings.waiting_list_auto_disable
+
+    qs = WaitingListEntry.objects.filter(event=event, voucher__isnull=True)
+    if subevent:
+        qs = qs.filter(subevent=subevent)
+
+    assigned = 0
+    for wle in qs.select_related('item', 'variation', 'subevent'):
+        if user is None and auto_disable and auto_disable.datetime(wle.subevent or event) <= now():
+            continue
+        try:
+            with transaction.atomic():
+                # No quota cache is shared between entries, as vouchers created earlier change availability
+                lock_objects([event])
+                wle.send_voucher(user=user)
+        except (WaitingListException, LockTimeoutException):
+            continue
+        assigned += 1
+    return assigned
