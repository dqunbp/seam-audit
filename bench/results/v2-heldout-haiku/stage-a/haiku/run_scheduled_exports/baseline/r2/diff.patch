diff --git a/src/pretix/base/services/export.py b/src/pretix/base/services/export.py
index 493bf71..366f3f8 100644
--- a/src/pretix/base/services/export.py
+++ b/src/pretix/base/services/export.py
@@ -494,3 +494,32 @@ def scheduled_event_export(self, event: Event, schedule: int) -> None:
     )
 
 
+def _dispatch_due_scheduled_exports(model, parent_field, task):
+    with transaction.atomic():
+        qs = model.objects.filter(
+            schedule_next_run__lte=now(),
+        ).select_for_update(of=OF_SELF, skip_locked=connection.features.has_select_for_update_skip_locked)
+        for schedule in qs[:5000]:
+            # Advance the schedule before dispatching, so that it is not picked up again by the next run of
+            # the periodic task while the export is still being generated.
+            schedule.compute_next_run()
+            schedule.save(update_fields=['schedule_next_run'])
+            task.apply_async(
+                kwargs={
+                    parent_field: getattr(schedule, f'{parent_field}_id'),
+                    'schedule': schedule.pk,
+                },
+            )
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def run_scheduled_exports(sender, **kwargs):
+    """
+    Queue all event-level and organizer-level scheduled exports that are due. The export itself, and sending
+    the result by email, is performed by the respective celery task.
+    """
+    _dispatch_due_scheduled_exports(ScheduledEventExport, 'event', scheduled_event_export)
+    _dispatch_due_scheduled_exports(ScheduledOrganizerExport, 'organizer', scheduled_organizer_export)
+
+
