+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    current = now()
+    # Same day boundary as the timeline entry in ``pretix.base.timeline``: the reminder is due once midnight
+    # ``mail_days_download_reminder`` days before the event start has passed.
+    today = current.replace(hour=0, minute=0, second=0, microsecond=0)
+
+    for event in Event.objects.filter(Q(has_subevents=True) | Q(date_from__gt=current)):
+        days = event.settings.get('mail_days_download_reminder', as_type=int)
+        if days is None or not event.settings.ticket_download:
+            continue
+        cutoff = today + timedelta(days=days + 1)
+
+        qs = event.orders.filter(
+            status=Order.STATUS_PAID,
+            download_reminder_sent=False,
+            sales_channel__identifier__in=event.settings.mail_sales_channel_download_reminder,
+        )
+        if event.has_subevents:
+            qs = qs.filter(Exists(
+                OrderPosition.objects.filter(
+                    order_id=OuterRef('pk'),
+                    canceled=False,
+                    subevent__date_from__gt=current,
+                    subevent__date_from__lt=cutoff,
+                )
+            ))
+        elif not current < event.date_from < cutoff:
+            continue
+
+        for o in qs.order_by('pk'):
+            if not o.ticket_download_available:
+                continue
+
+            with transaction.atomic():
+                o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                    # Race condition
+                    continue
+
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                with language(o.locale, event.settings.region):
+                    email_context = get_email_context(event=event, order=o)
+                    o.send_mail(
+                        event.settings.mail_subject_download_reminder,
+                        event.settings.mail_text_download_reminder,
+                        email_context,
+                        'pretix.event.order.email.download_reminder_sent',
+                    )
+
+                    if event.settings.mail_send_download_reminder_attendee:
+                        for p in o.positions.all():
+                            if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                                position_context = get_email_context(event=event, order=o, position=p)
+                                p.send_mail(
+                                    event.settings.mail_subject_download_reminder_attendee,
+                                    event.settings.mail_text_download_reminder_attendee,
+                                    position_context,
+                                    'pretix.event.order.email.download_reminder_sent',
+                                )
+
+
