+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    for o in Order.objects.filter(
+            Q(event__has_subevents=True) | Q(event__date_from__gt=now()),
+            status=Order.STATUS_PAID,
+            download_reminder_sent=False,
+    ).select_related('event', 'sales_channel').order_by('event_id'):
+        settings = o.event.settings
+        days = settings.get('mail_days_download_reminder', as_type=int)
+        if days is None or not settings.ticket_download:
+            continue
+        if o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder:
+            continue
+
+        if o.event.has_subevents:
+            start = min(o.positions.values_list('subevent__date_from', flat=True), default=None)
+        else:
+            start = o.event.date_from
+        if start is None or start <= now():
+            continue
+
+        # Same day boundary as the reminder shown in the event timeline
+        reminder_date = (start.astimezone(o.event.timezone) - timedelta(days=days)).replace(
+            hour=0, minute=0, second=0, microsecond=0
+        )
+        if now() < reminder_date or not o.ticket_download_available:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                # Race condition
+                continue
+
+            with language(o.locale, o.event.settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    o.event.settings.mail_subject_download_reminder,
+                    o.event.settings.mail_text_download_reminder,
+                    email_context,
+                    'pretix.event.order.email.download_reminder_sent',
+                )
+
+                if o.event.settings.mail_send_download_reminder_attendee:
+                    for p in o.positions.all():
+                        if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                            email_attendee_context = get_email_context(event=o.event, order=o, position=p)
+                            p.send_mail(
+                                o.event.settings.mail_subject_download_reminder_attendee,
+                                o.event.settings.mail_text_download_reminder_attendee,
+                                email_attendee_context,
+                                'pretix.event.order.email.download_reminder_sent',
+                            )
+
+
