+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    days = None
+    settings = None
+    event_id = None
+    tz = None
+    channels = None
+    send_to_attendees = None
+
+    for o in Order.objects.filter(
+            status=Order.STATUS_PAID, download_reminder_sent=False,
+            event__date_from__gt=now(), event__has_subevents=False,
+    ).select_related('event', 'sales_channel').order_by('event_id'):
+        if event_id != o.event_id:
+            settings = o.event.settings
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            if days is not None and not settings.ticket_download:
+                days = None
+            channels = settings.mail_sales_channel_download_reminder
+            send_to_attendees = settings.mail_send_download_reminder_attendee
+            tz = o.event.timezone
+            event_id = o.event_id
+
+        if days is None or o.sales_channel.identifier not in channels:
+            continue
+
+        # The reminder is due on the local calendar day that is ``days`` before the event starts,
+        # matching the date shown in the event timeline.
+        if (o.event.date_from.astimezone(tz).date() - now().astimezone(tz).date()).days > days:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                # Race condition
+                continue
+
+            with language(o.locale, settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    settings.mail_subject_download_reminder,
+                    settings.mail_text_download_reminder,
+                    email_context,
+                    'pretix.event.order.email.download_reminder_sent',
+                )
+
+                if send_to_attendees:
+                    for p in o.positions.all():
+                        if not p.attendee_email or p.attendee_email == o.email:
+                            continue
+                        p.send_mail(
+                            settings.mail_subject_download_reminder_attendee,
+                            settings.mail_text_download_reminder_attendee,
+                            get_email_context(event=o.event, order=o, position=p),
+                            'pretix.event.order.email.download_reminder_sent',
+                        )
+
+
