+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    days = None
+    channels = None
+    settings = None
+    event_id = None
+
+    # The start of an order is the start of its earliest non-canceled subevent, or the event start for
+    # events without date series. Orders for events that started more than a day ago are skipped, so that
+    # enabling the reminder for an old event does not send mails for long finished events.
+    qs = Order.objects.filter(
+        status=Order.STATUS_PAID,
+        download_reminder_sent=False,
+    ).annotate(
+        first_date=Coalesce(
+            Min('all_positions__subevent__date_from', filter=Q(all_positions__canceled=False)),
+            F('event__date_from'),
+        )
+    ).filter(
+        first_date__gte=now() - timedelta(days=1),
+    ).select_related('event', 'sales_channel').order_by('event_id')
+
+    for o in qs:
+        if event_id != o.event_id:
+            settings = o.event.settings
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            channels = settings.get('mail_sales_channel_download_reminder', as_type=list)
+            event_id = o.event_id
+
+        if days is None or o.sales_channel.identifier not in channels:
+            continue
+
+        if now() + timedelta(days=days) < o.first_date:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                # Race condition
+                continue
+
+            with language(o.locale, settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    settings.mail_subject_download_reminder, settings.mail_text_download_reminder, email_context,
+                    'pretix.event.order.email.download_reminder_sent', attach_tickets=True,
+                )
+
+
