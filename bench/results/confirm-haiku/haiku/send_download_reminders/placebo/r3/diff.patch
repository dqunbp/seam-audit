+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    """
+    Sends the reminder that tickets are ready for download, ``mail_days_download_reminder`` days before the event.
+    Like the timeline, this only considers events without subevents.
+    """
+    event_settings = None
+    days = None
+    event_id = None
+
+    for o in Order.objects.filter(
+            status=Order.STATUS_PAID,
+            download_reminder_sent=False,
+            event__has_subevents=False,
+            event__date_from__gt=now(),
+    ).select_related('event', 'sales_channel').order_by('event_id'):
+        if event_id != o.event_id:
+            event_settings = o.event.settings
+            days = event_settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None:
+            continue
+        reminder_date = (o.event.date_from - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_date:
+            continue
+        if o.sales_channel.identifier not in event_settings.mail_sales_channel_download_reminder:
+            continue
+        if not o.ticket_download_available:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.download_reminder_sent or not o.ticket_download_available:
+                # Race condition
+                continue
+
+            with language(o.locale, event_settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                o.send_mail(
+                    event_settings.mail_subject_download_reminder,
+                    event_settings.mail_text_download_reminder,
+                    get_email_context(event=o.event, order=o),
+                    'pretix.event.order.email.download_reminder_sent',
+                )
+
+                if event_settings.mail_send_download_reminder_attendee:
+                    for p in o.positions.all():
+                        if p.attendee_email:
+                            p.send_mail(
+                                event_settings.mail_subject_download_reminder_attendee,
+                                event_settings.mail_text_download_reminder_attendee,
+                                get_email_context(event=o.event, order=o, position=p),
+                                'pretix.event.order.email.download_reminder_sent',
+                            )
+
+
