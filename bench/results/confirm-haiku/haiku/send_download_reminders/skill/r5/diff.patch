+class DownloadReminderTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        # Fixed time, so the reminder day boundaries (midnight) are deterministic.
+        self.now = make_aware(datetime(2030, 6, 15, 12, 0), ZoneInfo('UTC'))
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=self.now + timedelta(days=2),
+                plugins='pretix.plugins.banktransfer'
+            )
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PAID, locale='en',
+                datetime=self.now - timedelta(days=10),
+                expires=self.now + timedelta(days=10),
+                total=Decimal('23.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Early-bird ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.op1 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            self.event.settings.ticket_download = True
+            djmail.outbox = []
+
+    def _run(self):
+        with freeze_time(self.now):
+            send_download_reminders(sender=self.event)
+
+    @classscope(attr='o')
+    def test_disabled(self):
+        self._run()
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+    @classscope(attr='o')
+    def test_sent_once(self):
+        self.event.settings.mail_days_download_reminder = 5
+        self._run()
+        self._run()
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.download_reminder_sent
+        assert LogEntry.objects.filter(
+            object_id=self.order.pk, action_type='pretix.event.order.email.download_reminder_sent'
+        ).count() == 1
+
+    @classscope(attr='o')
+    def test_not_yet(self):
+        # Reminder day is midnight of (event start - 1 day), which is still in the future.
+        self.event.settings.mail_days_download_reminder = 1
+        self._run()
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_zero_days_sent_on_event_day(self):
+        self.event.date_from = self.now + timedelta(hours=2)
+        self.event.save()
+        self.event.settings.mail_days_download_reminder = 0
+        self._run()
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_downloadable_is_retried_after_payment(self):
+        self.event.settings.mail_days_download_reminder = 5
+        self.order.status = Order.STATUS_PENDING
+        self.order.save()
+        self._run()
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        self._run()
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_sales_channel_not_enabled(self):
+        self.event.settings.mail_days_download_reminder = 5
+        self.event.settings.mail_sales_channel_download_reminder = []
+        self._run()
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+    @classscope(attr='o')
+    def test_ordered_after_reminder_day(self):
+        self.event.settings.mail_days_download_reminder = 5
+        self.order.datetime = self.now
+        self.order.save()
+        self._run()
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_attendee_mails(self):
+        self.event.settings.mail_days_download_reminder = 5
+        self.event.settings.mail_send_download_reminder_attendee = True
+        self.op1.attendee_email = 'peter@dummy.test'
+        self.op1.save()
+        self._run()
+        assert len(djmail.outbox) == 2
+        assert {m.to[0] for m in djmail.outbox} == {'dummy@dummy.test', 'peter@dummy.test'}
+
+    @classscope(attr='o')
+    def test_attendee_mail_not_sent_if_same_as_order_email(self):
+        self.event.settings.mail_days_download_reminder = 5
+        self.event.settings.mail_send_download_reminder_attendee = True
+        self.op1.attendee_email = 'dummy@dummy.test'
+        self.op1.save()
+        self._run()
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_mail_failure_rolls_back_and_retries(self):
+        self.event.settings.mail_days_download_reminder = 5
+        with mock.patch.object(Order, 'send_mail', side_effect=Exception('boom')):
+            self._run()
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+        self._run()
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_series_uses_earliest_subevent(self):
+        self.event.settings.mail_days_download_reminder = 5
+        self.event.has_subevents = True
+        self.event.save()
+        se_late = SubEvent.objects.create(event=self.event, name='Late', date_from=self.now + timedelta(days=10),
+                                          active=True)
+        se_early = SubEvent.objects.create(event=self.event, name='Early', date_from=self.now + timedelta(days=2),
+                                           active=True)
+        self.op1.subevent = se_late
+        self.op1.save()
+        self._run()
+        assert len(djmail.outbox) == 0
+
+        self.op1.subevent = se_early
+        self.op1.save()
+        self._run()
+        assert len(djmail.outbox) == 1
+
+
