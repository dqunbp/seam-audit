+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    event_id = None
+    event_settings = None
+    days = None
+
+    qs = Order.objects.filter(
+        download_reminder_sent=False,
+        status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+    ).filter(
+        Q(event__has_subevents=True) | Q(event__date_from__gt=now())
+    ).select_related('event', 'sales_channel').order_by('event_id')
+
+    for o in qs:
+        if event_id != o.event_id:
+            event_settings = o.event.settings
+            days = event_settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        # ``None`` means the reminder is disabled, ``0`` is a valid value (send on the day of the event).
+        if days is None or not event_settings.ticket_download:
+            continue
+
+        if o.event.has_subevents:
+            start = o.positions.aggregate(d=Min('subevent__date_from'))['d']
+        else:
+            start = o.event.date_from
+        if not start:
+            continue
+
+        # Same date as the entry in the event timeline (see pretix.base.timeline), so admins see when mails go out.
+        reminder_dt = (start - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_dt or o.datetime >= reminder_dt:
+            # Orders placed on or after the reminder day already received their tickets with the order mail.
+            continue
+
+        if o.sales_channel.identifier not in event_settings.mail_sales_channel_download_reminder:
+            continue
+
+        if not o.ticket_download_available:
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_related('event', 'sales_channel').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.download_reminder_sent or not o.ticket_download_available:
+                    # Race condition
+                    continue
+
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+
+                with language(o.locale, event_settings.region):
+                    email_context = get_email_context(event=o.event, order=o)
+                    o.send_mail(
+                        event_settings.mail_subject_download_reminder,
+                        event_settings.mail_text_download_reminder,
+                        email_context,
+                        'pretix.event.order.email.download_reminder_sent',
+                    )
+
+                    if event_settings.mail_send_download_reminder_attendee:
+                        for p in o.positions.all():
+                            if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                                email_attendee_context = get_email_context(event=o.event, order=o, position=p)
+                                p.send_mail(
+                                    event_settings.mail_subject_download_reminder_attendee,
+                                    event_settings.mail_text_download_reminder_attendee,
+                                    email_attendee_context,
+                                    'pretix.event.order.email.download_reminder_sent',
+                                )
+        except Exception:
+            # The transaction was rolled back, so the order is picked up again on the next run.
+            logger.exception('Could not send download reminder for order %s', o.code)
+
+
