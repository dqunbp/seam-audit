+class DownloadReminderTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=5),
+                plugins='pretix.plugins.banktransfer'
+            )
+            self.event.settings.ticket_download = True
+            self.event.settings.mail_days_download_reminder = 7
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PAID, locale='en',
+                datetime=now() - timedelta(days=1),
+                expires=now() + timedelta(days=10),
+                total=Decimal('23.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.op1 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            djmail.outbox = []
+
+    @classscope(attr='o')
+    def test_disabled_without_days(self):
+        self.event.settings.delete('mail_days_download_reminder')
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_yet_in_window(self):
+        self.event.settings.mail_days_download_reminder = 3
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+    @classscope(attr='o')
+    def test_sent_once(self):
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.download_reminder_sent
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.email.download_reminder_sent').exists()
+
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_only_paid_orders(self):
+        self.order.status = Order.STATUS_PENDING
+        self.order.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_canceled_order(self):
+        self.order.status = Order.STATUS_CANCELED
+        self.order.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sales_channel_not_selected(self):
+        self.event.settings.mail_sales_channel_download_reminder = ['foo']
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_ticket_download_disabled(self):
+        self.event.settings.ticket_download = False
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_ticket_download_date_not_reached(self):
+        self.event.settings.set('ticket_download_date', now() + timedelta(days=1))
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+    @classscope(attr='o')
+    def test_past_event(self):
+        self.event.date_from = now() - timedelta(days=1)
+        self.event.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_series_event_skipped(self):
+        self.event.has_subevents = True
+        self.event.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_attendee_mails(self):
+        self.event.settings.mail_send_download_reminder_attendee = True
+        op2 = OrderPosition.objects.create(
+            order=self.order, item=self.ticket, variation=None,
+            price=Decimal("0.00"), attendee_name_parts={'full_name': "Paul"}, positionid=2,
+            attendee_email='paul@dummy.test',
+        )
+        OrderPosition.objects.create(
+            order=self.order, item=self.ticket, variation=None,
+            price=Decimal("0.00"), attendee_name_parts={'full_name': "Mary"}, positionid=3,
+            attendee_email='dummy@dummy.test',
+        )
+        OrderPosition.objects.create(
+            order=self.order, item=self.ticket, variation=None, addon_to=op2,
+            price=Decimal("0.00"), attendee_name_parts={'full_name': "Addon"}, positionid=4,
+            attendee_email='addon@dummy.test',
+        )
+        send_download_reminders(sender=self.event)
+        assert sorted(m.to[0] for m in djmail.outbox) == ['dummy@dummy.test', 'paul@dummy.test']
+
+    @classscope(attr='o')
+    def test_attendee_mails_disabled(self):
+        OrderPosition.objects.create(
+            order=self.order, item=self.ticket, variation=None,
+            price=Decimal("0.00"), attendee_name_parts={'full_name': "Paul"}, positionid=2,
+            attendee_email='paul@dummy.test',
+        )
+        send_download_reminders(sender=self.event)
+        assert [m.to[0] for m in djmail.outbox] == ['dummy@dummy.test']
+
+    @classscope(attr='o')
+    def test_mail_failure_rolls_back_flag(self):
+        with mock.patch.object(Order, 'send_mail', side_effect=Exception('SMTP down')):
+            with pytest.raises(Exception, match='SMTP down'):
+                send_download_reminders(sender=self.event)
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+
