+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    # Mirrors the reminder date shown in the event timeline (see ``pretix.base.timeline``). Series events are
+    # skipped there as well, so they are skipped here.
+    events = Event.objects.filter(has_subevents=False, date_from__gt=now()).order_by('pk')
+    for event in events:
+        days = event.settings.get('mail_days_download_reminder', as_type=int)
+        if days is None or not event.settings.ticket_download:
+            continue
+
+        reminder_date = (event.date_from - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_date:
+            continue
+
+        order_pks = Order.objects.filter(
+            event=event,
+            status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+            download_reminder_sent=False,
+            sales_channel__identifier__in=event.settings.mail_sales_channel_download_reminder,
+        ).order_by('pk').values_list('pk', flat=True)
+
+        for order_pk in order_pks:
+            try:
+                with transaction.atomic():
+                    o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=order_pk)
+                    if o.download_reminder_sent or not o.ticket_download_available:
+                        # Race condition, or tickets are not downloadable yet. The latter is retried on the next run.
+                        continue
+
+                    with language(o.locale, event.settings.region):
+                        o.send_mail(
+                            event.settings.mail_subject_download_reminder,
+                            event.settings.mail_text_download_reminder,
+                            get_email_context(event=event, order=o),
+                            'pretix.event.order.email.download_reminder_sent',
+                        )
+                        if event.settings.mail_send_download_reminder_attendee:
+                            for position in o.positions.all():
+                                position.send_mail(
+                                    event.settings.mail_subject_download_reminder_attendee,
+                                    event.settings.mail_text_download_reminder_attendee,
+                                    get_email_context(event=event, order=o, position=position),
+                                    'pretix.event.order.position.email.download_reminder_sent',
+                                )
+
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+            except Exception:
+                # One broken order must not block the reminders for all other orders. It is retried on the next run.
+                logger.exception('Error while sending download reminder for order %s', order_pk)
+
+
