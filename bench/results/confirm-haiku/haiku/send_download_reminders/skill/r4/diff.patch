+class DownloadReminderTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=2),
+            )
+            self.event.settings.ticket_download = True
+            self.event.settings.mail_days_download_reminder = 3
+            self.order = self._create_order('FOO', Order.STATUS_PAID)
+            djmail.outbox = []
+
+    def _create_order(self, code, status):
+        order = Order.objects.create(
+            code=code, event=self.event, email='dummy@dummy.test',
+            status=status, locale='en',
+            datetime=now() - timedelta(hours=4),
+            expires=now() + timedelta(days=10),
+            total=Decimal('23.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+        )
+        item = Item.objects.create(event=self.event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+        OrderPosition.objects.create(
+            order=order, item=item, variation=None, price=Decimal("23.00"),
+            attendee_name_parts={'full_name': "Peter"}, attendee_email='attendee@dummy.test', positionid=1,
+        )
+        return order
+
+    @classscope(attr='o')
+    def test_disabled(self):
+        self.event.settings.delete('mail_days_download_reminder')
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sent_once(self):
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.download_reminder_sent
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.email.download_reminder_sent').exists()
+
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_before_window(self):
+        self.event.settings.mail_days_download_reminder = 1
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_event_started(self):
+        self.event.date_from = now() - timedelta(hours=1)
+        self.event.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_ticket_download_disabled(self):
+        self.event.settings.ticket_download = False
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sales_channel_not_selected(self):
+        self.event.settings.mail_sales_channel_download_reminder = []
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_pending_order_not_downloadable(self):
+        self.order.status = Order.STATUS_PENDING
+        self.order.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+    @classscope(attr='o')
+    def test_canceled_order(self):
+        self.order.status = Order.STATUS_CANCELED
+        self.order.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_already_sent(self):
+        self.order.download_reminder_sent = True
+        self.order.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_attendee_mail(self):
+        self.event.settings.mail_send_download_reminder_attendee = True
+        send_download_reminders(sender=self.event)
+        assert [m.to for m in djmail.outbox] == [['dummy@dummy.test'], ['attendee@dummy.test']]
+        assert self.order.all_logentries().filter(
+            action_type='pretix.event.order.position.email.download_reminder_sent'
+        ).exists()
+
+    @classscope(attr='o')
+    def test_failing_order_does_not_block_others(self):
+        with scope(organizer=self.o):
+            other = self._create_order('BAR', Order.STATUS_PAID)
+        original = Order.send_mail
+        calls = []
+
+        def flaky_send_mail(order, *args, **kwargs):
+            calls.append(order.code)
+            if order.code == 'FOO':
+                raise Exception('SMTP is down')
+            return original(order, *args, **kwargs)
+
+        with mock.patch.object(Order, 'send_mail', flaky_send_mail):
+            send_download_reminders(sender=self.event)
+        assert calls == ['FOO', 'BAR']
+        assert len(djmail.outbox) == 1
+        self.order.refresh_from_db()
+        other.refresh_from_db()
+        assert not self.order.download_reminder_sent
+        assert other.download_reminder_sent
+
+
