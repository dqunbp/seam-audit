+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    event_id = None
+    settings = None
+    days = None
+
+    # Only events that have not started yet. Subevent events are excluded, matching the
+    # timeline entry for the reminder date, which is only computed for non-subevent events.
+    qs = Order.objects.filter(
+        download_reminder_sent=False,
+        status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+        event__has_subevents=False,
+        event__date_from__gte=now(),
+    ).select_related('event', 'sales_channel').order_by('event_id')
+
+    for o in qs:
+        if event_id != o.event_id:
+            settings = o.event.settings
+            # None means the reminder is disabled for this event
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None:
+            continue
+
+        reminder_date = (o.event.date_from - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_date:
+            continue
+
+        # Isolate failures per order, so one broken order does not block the reminders of all others.
+        # The flag is set in the same transaction as the mail is queued, so a failure rolls back both.
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_related('event', 'sales_channel').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if (
+                    o.download_reminder_sent or
+                    not o.ticket_download_available or
+                    o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder
+                ):
+                    continue
+
+                with language(o.locale, settings.region):
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+                    email_context = get_email_context(event=o.event, order=o)
+                    o.send_mail(
+                        settings.mail_subject_download_reminder,
+                        settings.mail_text_download_reminder,
+                        email_context,
+                        'pretix.event.order.email.download_reminder_sent',
+                        attach_tickets=True,
+                    )
+
+                    if settings.mail_send_download_reminder_attendee:
+                        for p in o.positions.all():
+                            if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                                p_context = get_email_context(event=o.event, order=o, position=p)
+                                p.send_mail(
+                                    settings.mail_subject_download_reminder_attendee,
+                                    settings.mail_text_download_reminder_attendee,
+                                    p_context,
+                                    'pretix.event.order.email.download_reminder_sent',
+                                    attach_tickets=True,
+                                )
+        except Exception:
+            logger.exception('Could not send download reminder for order %s', o.code)
+
+
