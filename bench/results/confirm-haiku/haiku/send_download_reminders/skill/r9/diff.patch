+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    # The default of ``mail_days_download_reminder`` is None (never send), so events without a value are skipped.
+    # Like the timeline (see ``pretix.base.timeline``), this only covers events without subevents.
+    current = now()
+    for ev in Event.objects.filter(date_from__gt=current, has_subevents=False).order_by('pk'):
+        if not ev.settings.ticket_download:
+            continue
+        days = ev.settings.get('mail_days_download_reminder', as_type=int)
+        if days is None:
+            continue
+        reminder_date = (ev.date_from - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if current < reminder_date:
+            continue
+
+        for order in Order.objects.filter(
+            event=ev, download_reminder_sent=False, status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+        ).select_related('event', 'sales_channel').order_by('pk'):
+            if not order.ticket_download_available:
+                # Retried on the next run, once the tickets can be downloaded.
+                continue
+            if order.sales_channel.identifier not in ev.settings.mail_sales_channel_download_reminder:
+                continue
+
+            try:
+                with transaction.atomic():
+                    order = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=order.pk)
+                    if order.download_reminder_sent or order.status not in (Order.STATUS_PAID, Order.STATUS_PENDING):
+                        # Race condition
+                        continue
+                    if not order.ticket_download_available:
+                        continue
+
+                    order.download_reminder_sent = True
+                    order.save(update_fields=['download_reminder_sent'])
+
+                    with language(order.locale, ev.settings.region):
+                        order.send_mail(
+                            ev.settings.mail_subject_download_reminder,
+                            ev.settings.mail_text_download_reminder,
+                            get_email_context(event=ev, order=order),
+                            'pretix.event.order.email.download_reminder_sent',
+                            attach_tickets=True,
+                        )
+
+                        if ev.settings.mail_send_download_reminder_attendee:
+                            for p in order.positions.all():
+                                if p.addon_to_id is None and p.attendee_email and p.attendee_email != order.email:
+                                    p.send_mail(
+                                        ev.settings.mail_subject_download_reminder_attendee,
+                                        ev.settings.mail_text_download_reminder_attendee,
+                                        get_email_context(event=ev, order=order, position=p),
+                                        'pretix.event.order.email.download_reminder_sent',
+                                        attach_tickets=True,
+                                    )
+            except Exception:
+                # The flag is rolled back together with the failed send, so the next run retries this order.
+                logger.exception('Could not send download reminder for order %s', order.code)
+
+
