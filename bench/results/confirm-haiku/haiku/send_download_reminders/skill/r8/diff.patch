+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    """
+    Sends the ticket download reminder for paid orders once the date configured with
+    ``mail_days_download_reminder`` has been reached. Orders placed after that date are only marked as
+    reminded, since their buyers received the tickets with the order confirmation already.
+    """
+    event_id = None
+    settings = None
+    reminder_date = None
+    days_setting_applies = False
+
+    for o in Order.objects.filter(
+            status=Order.STATUS_PAID, download_reminder_sent=False, event__date_from__gt=now(),
+    ).select_related('event', 'sales_channel').order_by('event_id'):
+        if o.event_id != event_id:
+            event_id = o.event_id
+            settings = o.event.settings
+            # Mirrors the timeline: reminders are only planned for events without date series
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            days_setting_applies = (
+                days is not None and settings.ticket_download and not o.event.has_subevents
+            )
+            if days_setting_applies:
+                reminder_date = (o.event.date_from - timedelta(days=days)).replace(
+                    hour=0, minute=0, second=0, microsecond=0
+                )
+
+        if not days_setting_applies or now() < reminder_date:
+            continue
+        if o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder:
+            continue
+
+        if o.datetime >= reminder_date:
+            Order.objects.filter(pk=o.pk).update(download_reminder_sent=True)
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PAID or o.download_reminder_sent or not o.ticket_download_available:
+                # Race condition, or tickets are not downloadable yet (e.g. ticket_download_date in the future)
+                continue
+
+            with language(o.locale, settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    settings.mail_subject_download_reminder, settings.mail_text_download_reminder, email_context,
+                    'pretix.event.order.email.download_reminder_sent', attach_tickets=True,
+                )
+
+                if settings.mail_send_download_reminder_attendee:
+                    for p in o.positions.all():
+                        if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                            p.send_mail(
+                                settings.mail_subject_download_reminder_attendee,
+                                settings.mail_text_download_reminder_attendee,
+                                get_email_context(event=o.event, order=o, position=p),
+                                'pretix.event.order.email.download_reminder_sent', attach_tickets=True,
+                            )
+
+
