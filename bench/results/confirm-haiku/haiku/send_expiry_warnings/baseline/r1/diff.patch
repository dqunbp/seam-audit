+@pytest.mark.django_db
+def test_expiry_warning_uses_delayed_payment_deadline(event):
+    # The order expired yesterday, but the payment deadline was delayed by 5 days, so it is still open
+    event.settings.set('payment_term_expire_delay_days', 5)
+    event.settings.set('mail_days_order_expire_warning', 3)
+    o = _create_pending_order(event, expires=now() - timedelta(days=1))
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+
+    event.settings.set('mail_days_order_expire_warning', 5)
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 1
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is True
+
