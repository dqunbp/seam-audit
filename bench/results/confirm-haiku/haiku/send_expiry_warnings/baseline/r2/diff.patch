+@pytest.mark.django_db
+def test_expiry_warning_skips_non_pending_and_approval_orders(event):
+    event.settings.mail_days_order_expire_warning = 3
+    djmail.outbox = []
+    _create_pending_order(event, now() + timedelta(days=2), code='EXP2', status=Order.STATUS_PAID)
+    _create_pending_order(event, now() + timedelta(days=2), code='EXP3', require_approval=True)
