+def _pending_order(event, code, expires, **kwargs):
+    return Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING, locale='en',
+        datetime=now(), expires=expires, total=12,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_once_within_window(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    o = _pending_order(event, 'EW1', now() + timedelta(days=2))
+
+    send_expiry_warnings(None)
+    send_expiry_warnings(None)
+
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').count() == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_before_window(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    o = _pending_order(event, 'EW2', now() + timedelta(days=10))
+
+    send_expiry_warnings(None)
+
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_disabled_when_zero(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 0
+    o = _pending_order(event, 'EW3', now() + timedelta(hours=1))
+
+    send_expiry_warnings(None)
+
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_skips_non_pending_and_expired_orders(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    paid = _pending_order(event, 'EW4', now() + timedelta(days=1))
+    paid.status = Order.STATUS_PAID
+    paid.save()
+    expired = _pending_order(event, 'EW5', now() - timedelta(days=1))
+    valid_if_pending = _pending_order(event, 'EW6', now() + timedelta(days=1), valid_if_pending=True)
+    needs_approval = _pending_order(event, 'EW7', now() + timedelta(days=1), require_approval=True)
+
+    send_expiry_warnings(None)
+
+    for o in (paid, expired, valid_if_pending, needs_approval):
+        o.refresh_from_db()
+        assert not o.expiry_reminder_sent
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_uses_per_event_setting(event):
+    djmail.outbox = []
+    other = Event.objects.create(
+        organizer=event.organizer, name='Other', slug='other',
+        date_from=now(), plugins='pretix.plugins.banktransfer',
+    )
+    event.settings.mail_days_order_expire_warning = 3
+    other.settings.mail_days_order_expire_warning = 0
+    o1 = _pending_order(event, 'EW8', now() + timedelta(days=2))
+    o2 = _pending_order(other, 'EW9', now() + timedelta(days=2))
+
+    send_expiry_warnings(None)
+
+    o1.refresh_from_db()
+    o2.refresh_from_db()
+    assert o1.expiry_reminder_sent
+    assert not o2.expiry_reminder_sent
+    assert len(djmail.outbox) == 1
