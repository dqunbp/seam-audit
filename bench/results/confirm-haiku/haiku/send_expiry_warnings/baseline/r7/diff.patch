+def _create_pending_order(event, code, expires, **kwargs):
+    return Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=kwargs.pop('status', Order.STATUS_PENDING), locale='en',
+        datetime=now(), expires=expires,
+        total=Decimal('12.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs,
+    )
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    djmail.outbox = []
+    o = _create_pending_order(event, 'FO1', now() + timedelta(days=2))
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_only_once(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    djmail.outbox = []
+    _create_pending_order(event, 'FO1', now() + timedelta(days=2))
+    send_expiry_warnings(None)
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_before_window(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    djmail.outbox = []
+    o = _create_pending_order(event, 'FO1', now() + timedelta(days=10))
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_after_deadline(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    djmail.outbox = []
+    _create_pending_order(event, 'FO1', now() - timedelta(days=1))
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_disabled_with_zero(event):
+    event.settings.set('mail_days_order_expire_warning', 0)
+    djmail.outbox = []
+    _create_pending_order(event, 'FO1', now() + timedelta(days=1))
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_skips_orders_that_cannot_expire(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    djmail.outbox = []
+    _create_pending_order(event, 'PAID', now() + timedelta(days=1), status=Order.STATUS_PAID)
+    _create_pending_order(event, 'VALID', now() + timedelta(days=1), valid_if_pending=True)
+    _create_pending_order(event, 'APPR', now() + timedelta(days=1), require_approval=True)
+    canceled = _create_pending_order(event, 'CFEE', now() + timedelta(days=1))
+    canceled.fees.create(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=12)
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+
+
