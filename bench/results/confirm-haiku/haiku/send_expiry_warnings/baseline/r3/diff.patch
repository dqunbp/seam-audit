+def _create_pending_order(event, expires, **kwargs):
+    return Order.objects.create(
+        code=kwargs.pop('code', 'FOO'), event=event, email='dummy@dummy.test',
+        status=kwargs.pop('status', Order.STATUS_PENDING), locale='en',
+        datetime=now(), expires=expires,
+        total=12,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    o = _create_pending_order(event, now() + timedelta(days=2))
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert 'about to expire' in djmail.outbox[0].subject
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is True
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_only_once(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    _create_pending_order(event, now() + timedelta(days=2))
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_before_window(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    o = _create_pending_order(event, now() + timedelta(days=10))
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is False
+
+
+@pytest.mark.django_db
+def test_expiry_warning_disabled_if_zero(event):
+    event.settings.set('mail_days_order_expire_warning', 0)
+    o = _create_pending_order(event, now() + timedelta(hours=2))
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is False
+
+
+@pytest.mark.django_db
+def test_expiry_warning_uses_event_setting(event):
+    event.settings.set('mail_days_order_expire_warning', 1)
+    _create_pending_order(event, now() + timedelta(days=2), code='FOO')
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 0
+
+    event.settings.set('mail_days_order_expire_warning', 5)
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_skips_non_pending_and_expired(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    paid = _create_pending_order(event, now() + timedelta(days=1), code='PAID', status=Order.STATUS_PAID)
+    expired = _create_pending_order(event, now() - timedelta(days=1), code='OLD')
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 0
+    paid.refresh_from_db()
+    assert paid.expiry_reminder_sent is False
+    expired.refresh_from_db()
+    assert expired.expiry_reminder_sent is False
+
+
+@pytest.mark.django_db
+def test_expiry_warning_skips_valid_if_pending_and_approval(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    _create_pending_order(event, now() + timedelta(days=1), code='VIP', valid_if_pending=True)
+    _create_pending_order(event, now() + timedelta(days=1), code='APP', require_approval=True)
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 0
+
