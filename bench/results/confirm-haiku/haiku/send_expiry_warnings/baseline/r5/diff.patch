+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    """
+    Sends a warning to customers with an unpaid order shortly before their payment deadline. How many days
+    before the deadline the mail is sent is configured per event, a value of 0 disables the mail. Every
+    order receives the warning at most once.
+    """
+    qs = Order.objects.filter(
+        status=Order.STATUS_PENDING,
+        expires__gt=now(),
+        valid_if_pending=False,
+        require_approval=False,
+    ).exclude(
+        Exists(
+            OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        )
+    ).annotate(
+        warning_sent=Exists(
+            LogEntry.objects.filter(
+                content_type=ContentType.objects.get_for_model(Order),
+                object_id=OuterRef('pk'),
+                action_type='pretix.event.order.email.expire_warning_sent',
+            )
+        )
+    ).filter(
+        warning_sent=False,
+    ).select_related('event').order_by('event_id')
+
+    event_id = None
+    days = None
+    for o in qs:
+        if o.event_id != event_id:
+            days = o.event.settings.get('mail_days_order_expire_warning', as_type=int)
+            event_id = o.event_id
+        if not days or now() < o.payment_term_expire_date - timedelta(days=days):
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PENDING or o.all_logentries().filter(
+                action_type='pretix.event.order.email.expire_warning_sent',
+            ).exists():
+                # Race condition
+                continue
+
+            with language(o.locale, o.event.settings.region):
+                email_template = o.event.settings.mail_text_order_expire_warning
+                email_subject = o.event.settings.mail_subject_order_expire_warning
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    email_subject, email_template, email_context,
+                    'pretix.event.order.email.expire_warning_sent',
+                )
+
+
