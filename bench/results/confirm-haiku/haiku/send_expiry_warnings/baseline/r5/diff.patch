+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import Event, Order, Organizer
+from pretix.base.services.orders import send_expiry_warnings
+from pretix.base.signals import periodic_task
+
+
+@pytest.fixture
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now() + timedelta(days=30),
+        plugins='pretix.plugins.banktransfer'
+    )
+    with scope(organizer=o):
+        event.settings.mail_days_order_expire_warning = 3
+        djmail.outbox = []
+        yield event
+
+
+def _create_order(event, expires, status=Order.STATUS_PENDING, **kwargs):
+    return Order.objects.create(
+        code='FOO%d' % Order.objects.count(), event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now() - timedelta(days=1),
+        expires=expires,
+        total=Decimal('46.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+
+
+@pytest.mark.django_db
+def test_sent_within_window(event):
+    o = _create_order(event, expires=now() + timedelta(days=2))
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_sent_only_once(event):
+    _create_order(event, expires=now() + timedelta(days=2))
+    send_expiry_warnings(sender=None)
+    send_expiry_warnings(sender=None)
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_not_sent_before_window(event):
+    _create_order(event, expires=now() + timedelta(days=5))
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_sent_when_deadline_is_delayed_by_payment_term(event):
+    # The payment deadline is expires + payment_term_expire_delay_days, so an order expiring in 2 days with a
+    # 4 day delay has its deadline in about 6 days and is outside the 3 day window.
+    event.settings.payment_term_expire_delay_days = 4
+    _create_order(event, expires=now() + timedelta(days=2))
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 0
+
+    event.settings.payment_term_expire_delay_days = 0
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_disabled_with_zero_days(event):
+    event.settings.mail_days_order_expire_warning = 0
+    _create_order(event, expires=now() + timedelta(days=1))
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_paid_order_not_sent(event):
+    _create_order(event, expires=now() + timedelta(days=2), status=Order.STATUS_PAID)
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_canceled_order_not_sent(event):
+    _create_order(event, expires=now() + timedelta(days=2), status=Order.STATUS_CANCELED)
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_already_expired_order_not_sent(event):
+    _create_order(event, expires=now() - timedelta(hours=1))
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_order_requiring_approval_not_sent(event):
+    _create_order(event, expires=now() + timedelta(days=2), require_approval=True)
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_each_event_uses_its_own_setting(event):
+    event2 = Event.objects.create(
+        organizer=event.organizer, name='Other', slug='other',
+        date_from=now() + timedelta(days=30),
+    )
+    event2.settings.mail_days_order_expire_warning = 0
+    _create_order(event, expires=now() + timedelta(days=2))
+    with scope(organizer=event.organizer):
+        _create_order(event2, expires=now() + timedelta(days=2))
+    send_expiry_warnings(sender=None)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_runs_as_periodic_task(event):
+    _create_order(event, expires=now() + timedelta(days=2))
+    periodic_task.send(sender=None)
+    assert len(djmail.outbox) == 1
