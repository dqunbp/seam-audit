+@pytest.mark.django_db
+def test_expiry_warning_skips_paid_valid_if_pending_and_approval(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _pending_order(event, 'EW1', now() + timedelta(days=2), valid_if_pending=True)
+    _pending_order(event, 'EW2', now() + timedelta(days=2), require_approval=True)
+    paid = _pending_order(event, 'EW3', now() + timedelta(days=2))
+    paid.status = Order.STATUS_PAID
+    paid.save()
+    djmail.outbox = []
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+
