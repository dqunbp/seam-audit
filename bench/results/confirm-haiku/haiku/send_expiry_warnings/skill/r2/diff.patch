+@pytest.mark.django_db
+def test_expiry_warning_uses_payment_term_expire_date(event):
+    # The deadline is the payment term (expires + delay), not the raw expires date
+    event.settings.mail_days_order_expire_warning = 3
+    event.settings.payment_term_expire_delay_days = 4
+    event.settings.payment_term_weekdays = False
+    early = _pending_order(event, 'EW1', now() - timedelta(days=2))  # deadline ~ now + 2 days
+    late = _pending_order(event, 'EW2', now() + timedelta(days=1))  # deadline ~ now + 5 days
+    djmail.outbox = []
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 1
+    early.refresh_from_db()
+    late.refresh_from_db()
+    assert early.expiry_reminder_sent is True
+    assert late.expiry_reminder_sent is False
+
