+@pytest.mark.django_db
+def test_expiry_warning_skips_expired_paid_and_unexpirable_orders(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _pending_order(event, code='EXP', expires=now() - timedelta(hours=1))
+    _pending_order(event, code='PAI', status=Order.STATUS_PAID)
+    _pending_order(event, code='VIP', valid_if_pending=True)
+    _pending_order(event, code='APP', require_approval=True)
+    djmail.outbox = []
+
+    send_expiry_warnings(None)
+
+    assert len(djmail.outbox) == 0
+
