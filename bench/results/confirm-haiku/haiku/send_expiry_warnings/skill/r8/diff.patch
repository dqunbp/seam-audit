+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.mail_days_order_expire_warning = 3
+            djmail.outbox = []
+
+    def _create_order(self, code, expires, **kwargs):
+        return Order.objects.create(
+            code=code, event=self.event, email='dummy@dummy.test',
+            status=kwargs.pop('status', Order.STATUS_PENDING), locale='en',
+            datetime=now() - timedelta(days=4),
+            expires=expires,
+            total=Decimal('46.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            **kwargs,
+        )
+
+    @classscope(attr='o')
+    def test_sent_within_window(self):
+        o = self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert 'FOO' in djmail.outbox[0].subject
+        o.refresh_from_db()
+        assert o.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_not_sent_before_window(self):
+        o = self._create_order('FOO', now() + timedelta(days=10))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        o.refresh_from_db()
+        assert not o.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_not_sent_when_days_is_zero(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_twice(self):
+        self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_sent_for_paid_order(self):
+        self._create_order('FOO', now() + timedelta(days=2), status=Order.STATUS_PAID)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_valid_if_pending_order(self):
+        self._create_order('FOO', now() + timedelta(days=2), valid_if_pending=True)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_when_auto_expire_is_disabled(self):
+        self.event.settings.payment_term_expire_automatically = False
+        self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_after_deadline_has_passed(self):
+        self._create_order('FOO', now() - timedelta(days=1))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_failed_send_does_not_block_other_orders(self):
+        with mocker_context() as mocker:
+            send_mail = mocker.patch(
+                'pretix.base.models.orders.Order.send_mail',
+                side_effect=[Exception('smtp down'), None],
+            )
+            self._create_order('FOO', now() + timedelta(days=2))
+            self._create_order('BAR', now() + timedelta(days=2))
+            send_expiry_warnings(sender=self.event)
+            assert send_mail.call_count == 2
+            # The order whose send failed keeps its flag unset so that a later run retries it
+            assert Order.objects.filter(expiry_reminder_sent=True).count() == 1
+
+
