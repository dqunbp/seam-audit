+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.item = Item.objects.create(event=self.event, name='Ticket',
+                                            default_price=Decimal('23.00'), admission=True)
+            self.order = self._create_order()
+            djmail.outbox = []
+
+    def _create_order(self, **kwargs):
+        defaults = dict(
+            code='FOO', event=self.event, email='dummy@dummy.test',
+            status=Order.STATUS_PENDING, locale='en',
+            datetime=now() - timedelta(days=4),
+            expires=now() + timedelta(days=2),
+            total=Decimal('23.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+        )
+        defaults.update(kwargs)
+        return Order.objects.create(**defaults)
+
+    @classscope(attr='o')
+    def test_sends_warning_inside_window_and_sets_flag(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert self.order.all_logentries().filter(
+            action_type='pretix.event.order.email.expire_warning_sent'
+        ).exists()
+
+    @classscope(attr='o')
+    def test_sent_only_once(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_before_window(self):
+        self.event.settings.mail_days_order_expire_warning = 1
+        self.order.expires = now() + timedelta(days=5)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_default_days_apply_without_stored_setting(self):
+        # No explicit value stored: the global default ('3' days) must still apply.
+        self.order.expires = now() + timedelta(days=2)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_disabled_with_zero_days(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_skipped_if_auto_expiry_disabled(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self.event.settings.payment_term_expire_automatically = False
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_uses_payment_deadline_not_expires(self):
+        # The deadline is pushed out by the payment term delay, so the warning must wait for it.
+        self.event.settings.mail_days_order_expire_warning = 3
+        self.event.settings.payment_term_expire_delay_days = 10
+        self.order.expires = now() + timedelta(days=2)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+        self.order.expires = now() - timedelta(days=9)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_skips_already_expired_deadline(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self.order.expires = now() - timedelta(days=1)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_skips_excluded_orders(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        other = self._create_order(code='BAR', valid_if_pending=True)
+        approval = self._create_order(code='BAZ', require_approval=True)
+        fee_order = self._create_order(code='QUX')
+        OrderFee.objects.create(order=fee_order, fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                                value=Decimal('1.00'))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        for o in (other, approval, fee_order):
+            o.refresh_from_db()
+            assert not o.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_no_email_does_not_mark_sent(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self.order.email = None
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_failure_rolls_back_flag_for_retry(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        with mock.patch('pretix.base.models.orders.Order.send_mail', side_effect=RuntimeError('boom')):
+            with pytest.raises(RuntimeError):
+                send_expiry_warnings(sender=self.event)
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+
