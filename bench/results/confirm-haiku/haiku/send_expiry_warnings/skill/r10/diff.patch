+from datetime import timedelta
+from decimal import Decimal
+from unittest import mock
+
+from django.core import mail as djmail
+from django.test import TestCase
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, Item, Order, OrderPosition, Organizer,
+)
+from pretix.base.services.orders import send_expiry_warnings
+from pretix.testutils.scope import classscope
+
+
+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.event.settings.mail_days_order_expire_warning = 3
+            self.order = self._create_order('FOO', expires=now() + timedelta(days=2))
+            djmail.outbox = []
+
+    def _create_order(self, code, expires, **kwargs):
+        defaults = dict(
+            code=code, event=self.event, email='dummy@dummy.test',
+            status=Order.STATUS_PENDING, locale='en',
+            datetime=now() - timedelta(days=4),
+            expires=expires,
+            total=Decimal('23.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+        )
+        defaults.update(kwargs)
+        order = Order.objects.create(**defaults)
+        OrderPosition.objects.create(
+            order=order, item=self.ticket, variation=None,
+            price=Decimal("23.00"), attendee_name_parts={"full_name": "Peter"}, positionid=1
+        )
+        return order
+
+    @classscope(attr='o')
+    def test_sent_inside_window(self):
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert self.order.all_logentries().filter(
+            action_type='pretix.event.order.email.expire_warning_sent'
+        ).exists()
+
+    @classscope(attr='o')
+    def test_not_sent_before_window(self):
+        self.order.expires = now() + timedelta(days=10)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_disabled_with_zero_days(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_after_deadline(self):
+        self.order.expires = now() - timedelta(hours=1)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sent_once(self):
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_uses_payment_deadline_with_delay_days(self):
+        # ``expires`` lies in the past, but the payment deadline is 10 days later because of the delay setting.
+        # With a 10-day window only the deadline (not ``expires``) makes the warning due.
+        self.event.settings.payment_term_weekdays = False
+        self.event.settings.payment_term_expire_delay_days = 10
+        self.event.settings.mail_days_order_expire_warning = 10
+        self.order.expires = now() - timedelta(days=1)
+        self.order.save()
+        assert self.order.payment_term_expire_date > now()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_paid_order_not_sent(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_valid_if_pending_not_sent(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_failed_send_is_retried_and_does_not_block_others(self):
+        other = self._create_order('BAR', expires=now() + timedelta(days=2), email='other@dummy.test')
+        with mock.patch.object(Order, 'send_mail', side_effect=[Exception('smtp down'), None]):
+            send_expiry_warnings(sender=self.event)
+        self.order.refresh_from_db()
+        other.refresh_from_db()
+        # The failing order is released for the next run, the other one is still claimed.
+        assert not self.order.expiry_reminder_sent
+        assert other.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_already_claimed_order_is_skipped(self):
+        Order.objects.filter(pk=self.order.pk).update(expiry_reminder_sent=True)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
