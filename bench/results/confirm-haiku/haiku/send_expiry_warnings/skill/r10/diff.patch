+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    event_id = None
+    days = None
+
+    # Filter on the payment deadline, not on ``expires``: with ``payment_term_expire_delay_days``
+    # the deadline is later than ``expires``, so the SQL prefilter would miss orders.
+    qs = _pending_orders_awaiting_payment().filter(
+        expiry_reminder_sent=False,
+    ).prefetch_related('event').order_by('event_id')
+    for o in qs:
+        if o.event_id != event_id:
+            days = o.event.settings.get('mail_days_order_expire_warning', as_type=int)
+            event_id = o.event_id
+        if not days:  # 0 means the warning is disabled
+            continue
+
+        deadline = o.payment_term_expire_date
+        if deadline <= now() or now() < deadline - timedelta(days=days):
+            continue
+
+        # Claim the order before sending so that overlapping runs cannot send the warning twice.
+        if not Order.objects.filter(pk=o.pk, expiry_reminder_sent=False).update(expiry_reminder_sent=True):
+            continue
+
+        try:
+            with language(o.locale, o.event.settings.region):
+                o.send_mail(
+                    o.event.settings.mail_subject_order_expire_warning,
+                    o.event.settings.mail_text_order_expire_warning,
+                    get_email_context(event=o.event, order=o),
+                    'pretix.event.order.email.expire_warning_sent',
+                )
+        except Exception:
+            # Release the claim so the next run retries this order; keep going with the others.
+            Order.objects.filter(pk=o.pk).update(expiry_reminder_sent=False)
+            logger.exception('Could not send expiry warning for order %s', o.code)
+
