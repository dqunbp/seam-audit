+@pytest.mark.django_db
+def test_expiry_warning_skips_ineligible_orders(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _make_pending_order(event, 'PAID', expires_in_days=1, status=Order.STATUS_PAID)
+    _make_pending_order(event, 'EXPD', expires_in_days=1, status=Order.STATUS_EXPIRED)
+    _make_pending_order(event, 'PAST', expires_in_days=-1)
+    _make_pending_order(event, 'VIFP', expires_in_days=1, valid_if_pending=True)
+    _make_pending_order(event, 'APPR', expires_in_days=1, require_approval=True)
+    o_fee = _make_pending_order(event, 'CFEE', expires_in_days=1)
+    o_fee.fees.create(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=12)
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+    assert not Order.objects.filter(expiry_reminder_sent=True).exists()
+
