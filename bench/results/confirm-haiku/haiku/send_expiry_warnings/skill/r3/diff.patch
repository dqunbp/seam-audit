+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    # Warn customers with an unpaid order shortly before the payment deadline. The deadline is ``order.expires``,
+    # since that is the date shown to the customer in the e-mail. The eligibility filter mirrors ``expire_orders``.
+    events = Event.objects.filter(
+        Exists(Order.objects.filter(event_id=OuterRef('pk'), status=Order.STATUS_PENDING, expires__gt=now()))
+    ).order_by()
+
+    for event in events.iterator(chunk_size=10_000):
+        days = event.settings.get('mail_days_order_expire_warning', as_type=int)
+        if not days:
+            continue
+
+        order_pks = list(
+            event.orders.filter(
+                status=Order.STATUS_PENDING,
+                valid_if_pending=False,
+                require_approval=False,
+                expiry_reminder_sent=False,
+                expires__gt=now(),
+                expires__lte=now() + timedelta(days=days),
+            ).exclude(
+                Exists(OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION))
+            ).order_by().values_list('pk', flat=True)
+        )
+
+        for order_pk in order_pks:
+            try:
+                with transaction.atomic():
+                    o = Order.objects.select_for_update(of=OF_SELF).get(pk=order_pk)
+                    if o.expiry_reminder_sent or o.status != Order.STATUS_PENDING or o.expires <= now():
+                        # Race condition or the order changed since the query above
+                        continue
+
+                    # Flag and mail share one transaction: if sending fails, the flag rolls back and the
+                    # warning is retried on the next run.
+                    o.expiry_reminder_sent = True
+                    o.save(update_fields=['expiry_reminder_sent'])
+                    with language(o.locale, event.settings.region):
+                        email_template = event.settings.mail_text_order_expire_warning
+                        email_subject = event.settings.mail_subject_order_expire_warning
+                        email_context = get_email_context(event=event, order=o)
+                        o.send_mail(
+                            email_subject, email_template, email_context,
+                            'pretix.event.order.email.expire_warning_sent'
+                        )
+            except Exception:
+                # Keep going so one bad order does not block the warnings for all others.
+                logger.exception('Could not send expiry warning for order %s', order_pk)
+
+
