+@pytest.mark.django_db
+def test_expiry_warning_failure_is_retried_next_run(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o1 = _make_pending_order(event, 'FO1', expires_in_days=2)
+    o2 = _make_pending_order(event, 'FO2', expires_in_days=2)
+
+    real_send_mail = Order.send_mail
+    failed = []
+
+    def flaky_send_mail(self, *args, **kwargs):
+        if not failed:
+            failed.append(self.pk)
+            raise Exception('SMTP down')
+        return real_send_mail(self, *args, **kwargs)
+
+    with patch.object(Order, 'send_mail', flaky_send_mail):
+        send_expiry_warnings(None)
+
+    assert len(failed) == 1
+    failed_order, other_order = (o1, o2) if failed[0] == o1.pk else (o2, o1)
+    failed_order.refresh_from_db()
+    other_order.refresh_from_db()
+    assert not failed_order.expiry_reminder_sent
+    assert other_order.expiry_reminder_sent
+    assert len(djmail.outbox) == 1
+
+    send_expiry_warnings(None)
+    failed_order.refresh_from_db()
+    assert failed_order.expiry_reminder_sent
+    assert len(djmail.outbox) == 2
