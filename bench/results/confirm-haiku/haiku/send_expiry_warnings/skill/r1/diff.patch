+def _make_pending_order(event, code, expires, status=Order.STATUS_PENDING, **kwargs):
+    return Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=expires,
+        total=12,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _make_pending_order(event, 'FO1', now() + timedelta(days=2))
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is True
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_before_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _make_pending_order(event, 'FO1', now() + timedelta(days=5))
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent is False
+
+
+@pytest.mark.django_db
+def test_expiry_warning_only_once(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _make_pending_order(event, 'FO1', now() + timedelta(days=2))
+    send_expiry_warnings(None)
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 1
+
+
