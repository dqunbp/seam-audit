+@pytest.mark.django_db
+def test_expiry_warning_uses_payment_term_expire_date(event):
+    # The payment deadline is pushed out by the delay setting, so the warning window
+    # must be computed from it, not from ``expires``.
+    event.settings.mail_days_order_expire_warning = 3
+    event.settings.payment_term_expire_delay_days = 10
