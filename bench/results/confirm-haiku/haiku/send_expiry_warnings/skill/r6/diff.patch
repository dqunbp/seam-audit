+def _create_pending_order(event, expires, **kwargs):
+    order = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING, locale='en',
+        datetime=now(), expires=expires,
+        total=Decimal('23.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+    ticket = Item.objects.create(event=event, name='Ticket',
+                                 default_price=Decimal('23.00'), admission=True)
+    OrderPosition.objects.create(
+        order=order, item=ticket, variation=None,
+        price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+    )
+    return order
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_inside_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    order = _create_pending_order(event, now() + timedelta(days=2))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+    order.refresh_from_db()
+    assert order.expiry_reminder_sent
+    assert order.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_only_once(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _create_pending_order(event, now() + timedelta(days=2))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_before_window(event):
+    event.settings.mail_days_order_expire_warning = 3
