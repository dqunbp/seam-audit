+def _make_expiry_order(event, expires, status=Order.STATUS_PENDING, **kwargs):
+    order = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=expires,
+        total=Decimal('23.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+    ticket = Item.objects.create(event=event, name='Early-bird ticket',
+                                 default_price=Decimal('23.00'), admission=True)
+    OrderPosition.objects.create(
+        order=order, item=ticket, variation=None,
+        price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+    )
+    return order
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _make_expiry_order(event, expires=now() + timedelta(days=2))
+    send_expiry_warnings(None)
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent
+    assert len(djmail.outbox) == 1
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
