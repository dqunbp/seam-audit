+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    """
+    Remind the customer of an unpaid order shortly before its payment deadline, as configured by the
+    ``mail_days_order_expire_warning`` event setting. Each order is reminded at most once.
+    """
+    event_id = None
+    warning_days = None
+
+    qs = Order.objects.filter(
+        status=Order.STATUS_PENDING,
+        valid_if_pending=False,
+        require_approval=False,
+        expiry_reminder_sent=False,
+    ).exclude(
+        Exists(
+            OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        )
+    ).prefetch_related('event').order_by('event_id')
+    for o in qs:
+        if o.event_id != event_id:
+            warning_days = o.event.settings.get('mail_days_order_expire_warning', as_type=int)
+            event_id = o.event_id
+        if not warning_days or not now() < o.payment_term_expire_date <= now() + timedelta(days=warning_days):
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.expiry_reminder_sent or o.status != Order.STATUS_PENDING:
+                # Race condition
+                continue
+
+            with language(o.locale, o.event.settings.region):
+                o.expiry_reminder_sent = True
+                o.save(update_fields=['expiry_reminder_sent'])
+                email_template = o.event.settings.mail_text_order_expire_warning
+                email_subject = o.event.settings.mail_subject_order_expire_warning
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    email_subject, email_template, email_context,
+                    'pretix.event.order.email.expire_warning_sent'
+                )
+
+
