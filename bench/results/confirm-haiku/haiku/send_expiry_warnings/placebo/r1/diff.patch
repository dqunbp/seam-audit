+def _create_pending_order(event, code, expires, status=Order.STATUS_PENDING, **kwargs):
+    return Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=expires, total=Decimal('12.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    o = _create_pending_order(event, 'FOO', now() + timedelta(days=2))
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert 'FOO' in djmail.outbox[0].subject
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_outside_window(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    o = _create_pending_order(event, 'FOO', now() + timedelta(days=10))
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+
+
+@pytest.mark.django_db
+def test_expiry_warning_disabled_if_zero(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 0
+    _create_pending_order(event, 'FOO', now() + timedelta(days=1))
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_only_once(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    _create_pending_order(event, 'FOO', now() + timedelta(days=2))
+    send_expiry_warnings(sender=event)
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_after_deadline(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    _create_pending_order(event, 'FOO', now() - timedelta(hours=1))
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_uses_payment_term_expire_date(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    event.settings.set('payment_term_expire_delay_days', 10)
+    # The order expires in one day, but the payment deadline is extended to about 11 days from now
+    o = _create_pending_order(event, 'FOO', now() + timedelta(days=1))
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_for_paid_order(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    _create_pending_order(event, 'FOO', now() + timedelta(days=2), status=Order.STATUS_PAID)
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_skips_orders_that_do_not_expire(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    _create_pending_order(event, 'VIP', now() + timedelta(days=2), valid_if_pending=True)
+    _create_pending_order(event, 'APP', now() + timedelta(days=2), require_approval=True)
+    fee_order = _create_pending_order(event, 'FEE', now() + timedelta(days=2))
+    fee_order.fees.create(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=12)
+    _create_pending_order(event, 'FOO', now() + timedelta(days=2))
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+    assert 'FOO' in djmail.outbox[0].subject
+
