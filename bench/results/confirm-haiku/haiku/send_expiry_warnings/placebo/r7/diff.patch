+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            djmail.outbox = []
+
+    def _create_order(self, expires, **kwargs):
+        with scope(organizer=self.o):
+            return Order.objects.create(
+                code=kwargs.pop('code', 'FOO'), event=self.event, email='dummy@dummy.test',
+                status=kwargs.pop('status', Order.STATUS_PENDING), locale='en',
+                datetime=now() - timedelta(days=1),
+                expires=expires,
+                total=Decimal('46.00'),
+                sales_channel=self.o.sales_channels.get(identifier="web"),
+                **kwargs
+            )
+
+    @classscope(attr='o')
+    def test_sent_within_window(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        o = self._create_order(expires=now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        o.refresh_from_db()
+        assert o.expiry_reminder_sent
+        assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+    @classscope(attr='o')
+    def test_not_sent_before_window(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self._create_order(expires=now() + timedelta(days=10))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_when_disabled(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        self._create_order(expires=now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sent_only_once(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self._create_order(expires=now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_sent_for_paid_order(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self._create_order(expires=now() + timedelta(days=2), status=Order.STATUS_PAID)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_after_deadline(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self._create_order(expires=now() - timedelta(days=1))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_if_order_cannot_expire(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self._create_order(expires=now() + timedelta(days=2), require_approval=True)
+        self._create_order(expires=now() + timedelta(days=2), valid_if_pending=True, code='BAR')
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_order_with_cancellation_fee(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        o = self._create_order(expires=now() + timedelta(days=2))
+        OrderFee.objects.create(order=o, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('1.00'))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_window_measured_from_payment_term_expire_date(self):
+        self.event.settings.mail_days_order_expire_warning = 3
+        self.event.settings.payment_term_expire_delay_days = 10
+        # Order expires in 2 days, but the payment deadline is 12 days away: outside the window.
+        self._create_order(expires=now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+        # Order expired 9 days ago, but the payment deadline is 1 day away: inside the window.
+        o = self._create_order(expires=now() - timedelta(days=9), code='BAR')
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        o.refresh_from_db()
+        assert o.expiry_reminder_sent
+
