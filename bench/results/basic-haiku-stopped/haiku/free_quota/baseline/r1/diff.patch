diff --git a/tests/test_generate.py b/tests/test_generate.py
index c260c2f..dc0fe9b 100644
--- a/tests/test_generate.py
+++ b/tests/test_generate.py
@@ -1,8 +1,12 @@
+from datetime import datetime, timezone
+
 from lumen_sdk import LumenAPIError, LumenRateLimited
 
+from pixforge import clock, quota
 from pixforge.billing import get_balance
 from pixforge.features.generate import generate_image
 from pixforge.images import list_images
+from pixforge.users import create_user
 
 
 def test_generates_and_charges(conn, lumen, user_id):
@@ -57,3 +61,72 @@ def test_insufficient_credits_does_not_call_provider(conn, lumen):
     assert response["error_code"] == "insufficient_credits"
     assert "2" in response["message"]
     assert lumen.calls == []
+
+
+def test_free_daily_image_limit(conn, lumen, user_id):
+    for i in range(5):
+        assert generate_image(conn, lumen, user_id, "a cat", f"req-{i}")["ok"]
+    calls_before = len(lumen.calls)
+    sixth = generate_image(conn, lumen, user_id, "a cat", "req-6")
+    assert not sixth["ok"]
+    assert sixth["error_code"] == "daily_image_limit"
+    assert sixth["job_id"] is None
+    assert "5" in sixth["message"]
+    assert "per day" in sixth["message"]
+    assert len(lumen.calls) == calls_before
+    assert get_balance(conn, user_id) == 90
+    assert quota.used(conn, user_id, "image") == 5
+
+
+def test_daily_image_limit_message_is_localized(conn, lumen, user_id):
+    for i in range(5):
+        generate_image(conn, lumen, user_id, "a cat", f"req-{i}")
+    sixth = generate_image(conn, lumen, user_id, "a cat", "req-6", locale="ru")
+    assert sixth["error_code"] == "daily_image_limit"
+    assert sixth["message"].startswith("Вы исчерпали лимит бесплатного тарифа на изображения")
+    assert "5" in sixth["message"]
+
+
+def test_retry_at_limit_returns_original_result(conn, lumen, user_id):
+    for i in range(4):
+        generate_image(conn, lumen, user_id, "a cat", f"req-{i}")
+    first = generate_image(conn, lumen, user_id, "a cat", "req-last")
+    assert first["ok"]
+    retry = generate_image(conn, lumen, user_id, "a cat", "req-last")
+    assert retry == first
+    assert quota.used(conn, user_id, "image") == 5
+
+
+def test_pro_user_is_not_limited(conn, lumen, pro_user_id):
+    for i in range(7):
+        assert generate_image(conn, lumen, pro_user_id, "a cat", f"req-{i}")["ok"]
+    assert len(lumen.calls) == 7
+    assert quota.used(conn, pro_user_id, "image") == 0
+
+
+def test_image_limit_resets_on_next_utc_day(conn, lumen, user_id):
+    clock.set_now(datetime(2026, 3, 1, 23, 59, tzinfo=timezone.utc))
+    for i in range(5):
+        assert generate_image(conn, lumen, user_id, "a cat", f"req-{i}")["ok"]
+    assert generate_image(conn, lumen, user_id, "a cat", "req-5")["error_code"] == "daily_image_limit"
+
+    clock.set_now(datetime(2026, 3, 2, 0, 1, tzinfo=timezone.utc))
+    assert generate_image(conn, lumen, user_id, "a cat", "req-6")["ok"]
+
+
+def test_provider_error_releases_image_quota(conn, lumen, user_id):
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    assert generate_image(conn, lumen, user_id, "a cat", "req-1")["error_code"] == "provider_failed"
+    assert quota.used(conn, user_id, "image") == 0
+
+
+def test_filtered_image_releases_quota(conn, lumen, user_id):
+    lumen.filter_next = True
+    assert generate_image(conn, lumen, user_id, "a cat", "req-1")["error_code"] == "content_filtered"
+    assert quota.used(conn, user_id, "image") == 0
+
+
+def test_insufficient_credits_releases_image_quota(conn, lumen):
+    poor = create_user(conn, "poor@example.com", plan="free", balance=1)
+    assert generate_image(conn, lumen, poor, "a cat", "req-1")["error_code"] == "insufficient_credits"
+    assert quota.used(conn, poor, "image") == 0
