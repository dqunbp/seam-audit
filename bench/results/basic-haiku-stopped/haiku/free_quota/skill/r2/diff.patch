         return response_for(jobs.get_job(conn, job_id), locale)
 
     output = result.images[0]
     save_image(conn, user_id, output.url, output.width, output.height)
     jobs.transition(conn, job_id, {JobStatus.PENDING}, JobStatus.SUCCEEDED, output_url=output.url)
     return response_for(jobs.get_job(conn, job_id), locale)
+
+
+def _fail(conn, job_id: int, error_code: str, *, refund: bool, user_id: int, limit: int | None, day: str) -> None:
+    """Fail the job, and give back its free-plan quota unit if this call moved it to failed."""
+    if fail_job(conn, job_id, error_code, refund=refund) and limit is not None:
+        quota.release(conn, user_id, "image", day)
