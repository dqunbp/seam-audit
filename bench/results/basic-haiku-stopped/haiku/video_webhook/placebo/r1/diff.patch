diff --git a/pixforge/webhooks/lumen.py b/pixforge/webhooks/lumen.py
new file mode 100644
index 0000000..653caf7
--- /dev/null
+++ b/pixforge/webhooks/lumen.py
@@ -0,0 +1,60 @@
+"""Lumen webhook: completion and failure of asynchronous video jobs."""
+import json
+import logging
+
+from ..db import transaction
+from ..features.common import fail_job
+from ..jobs import JobStatus, get_job_by_provider_id, transition
+from .dedup import mark_processed
+from .signing import verify_signature
+
+log = logging.getLogger(__name__)
+
+SIGNATURE_HEADER = "Lumen-Signature"
+
+
+def handle_lumen_webhook(conn, raw_body: bytes, headers: dict, secret: str) -> tuple[int, dict]:
+    """Returns (HTTP status, JSON body). Lumen retries any non-2xx delivery for 24 hours."""
+    if not verify_signature(secret, raw_body, headers.get(SIGNATURE_HEADER)):
+        return 400, {"error": "invalid signature"}
+
+    try:
+        event = json.loads(raw_body)
+        event_type = event["type"]
+        data = event["data"]
+        job_id = data["job_id"]
+    except (ValueError, KeyError, TypeError):
+        return 400, {"error": "malformed event"}
+
+    if event_type not in ("video.completed", "video.failed"):
+        # Progress updates and unknown types are acknowledged without changing state.
+        return 200, {"ignored": event_type}
+
+    job = get_job_by_provider_id(conn, job_id)
+    if job is None:
+        log.warning("lumen event %s for unknown job %s", event["id"], job_id)
+        return 200, {"ignored": "unknown_job"}
+
+    with transaction(conn):
+        if not mark_processed(conn, "lumen", event["id"]):
+            return 200, {"duplicate": True}
+        if event_type == "video.failed":
+            fail_job(conn, job["id"], "provider_failed", refund=True)
+        else:
+            _complete_job(conn, job["id"], data)
+    return 200, {"ok": True}
+
+
+def _complete_job(conn, job_id: int, data: dict) -> None:
+    videos = data.get("videos") or []
+    if not videos:
+        # Moderation removed the output after rendering. Lumen does not bill for it, so we refund.
+        fail_job(conn, job_id, "content_filtered", refund=True)
+        return
+    transition(
+        conn,
+        job_id,
+        {JobStatus.PENDING, JobStatus.PROCESSING},
+        JobStatus.SUCCEEDED,
+        output_url=videos[0]["url"],
+    )
diff --git a/tests/test_lumen_webhook.py b/tests/test_lumen_webhook.py
new file mode 100644
index 0000000..41fc9e7
--- /dev/null
+++ b/tests/test_lumen_webhook.py
@@ -0,0 +1,165 @@
+import json
+from datetime import timedelta
+
+from pixforge import clock
+from pixforge.billing import get_balance
+from pixforge.features.video import start_video
+from pixforge.jobs import get_job
+from pixforge.webhooks.lumen import handle_lumen_webhook
+from pixforge.webhooks.signing import sign
+
+SECRET = "whsec_lumen"
+CALLBACK = "https://pixforge.test/hooks/lumen"
+VIDEO_URL = "https://cdn.lumen.test/vid_1.mp4"
+
+
+def _deliver(conn, event: dict, secret: str = SECRET, timestamp: int | None = None):
+    body = json.dumps(event).encode()
+    ts = int(clock.now().timestamp()) if timestamp is None else timestamp
+    headers = {"Lumen-Signature": sign(secret, body, ts)}
+    return handle_lumen_webhook(conn, body, headers, SECRET)
+
+
+def _event(event_type: str, data: dict, event_id: str = "evt_1") -> dict:
+    return {"id": event_id, "type": event_type, "created": 1772366400, "data": data}
+
+
+def _completed(job_id: str = "vid_1", event_id: str = "evt_1") -> dict:
+    return _event(
+        "video.completed",
+        {"job_id": job_id, "videos": [{"url": VIDEO_URL, "duration_s": 5}], "moderation": None},
+        event_id,
+    )
+
+
+def _failed(job_id: str = "vid_1", event_id: str = "evt_2") -> dict:
+    return _event(
+        "video.failed",
+        {"job_id": job_id, "error": {"code": "render_error", "message": "boom"}},
+        event_id,
+    )
+
+
+def _start(conn, lumen, user_id, request_id="req-1") -> int:
+    response = start_video(conn, lumen, user_id, "a cat surfing", request_id, CALLBACK)
+    assert response["status"] == "processing"
+    return response["job_id"]
+
+
+def test_completed_marks_job_succeeded_with_video_url(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+
+    status, body = _deliver(conn, _completed())
+
+    assert (status, body) == (200, {"ok": True})
+    job = get_job(conn, job_id)
+    assert job["status"] == "succeeded"
+    assert job["output_url"] == VIDEO_URL
+    assert get_balance(conn, user_id) == 80
+
+
+def test_duplicate_completed_delivery_is_applied_once(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+    _deliver(conn, _completed())
+
+    status, body = _deliver(conn, _completed())
+
+    assert (status, body) == (200, {"duplicate": True})
+    assert get_job(conn, job_id)["status"] == "succeeded"
+
+
+def test_failed_marks_job_failed_and_refunds(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+    assert get_balance(conn, user_id) == 80
+
+    status, body = _deliver(conn, _failed())
+
+    assert (status, body) == (200, {"ok": True})
+    job = get_job(conn, job_id)
+    assert job["status"] == "failed"
+    assert job["error"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_failed_after_completed_does_not_refund(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+    _deliver(conn, _completed(event_id="evt_1"))
+
+    status, _ = _deliver(conn, _failed(event_id="evt_2"))
+
+    assert status == 200
+    assert get_job(conn, job_id)["status"] == "succeeded"
+    assert get_balance(conn, user_id) == 80
+
+
+def test_completed_without_videos_is_filtered_and_refunded(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+    event = _event(
+        "video.completed", {"job_id": "vid_1", "videos": [], "moderation": {"reason": "policy"}}
+    )
+
+    status, _ = _deliver(conn, event)
+
+    assert status == 200
+    job = get_job(conn, job_id)
+    assert job["status"] == "failed"
+    assert job["error"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_progress_is_acknowledged_without_changing_job(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+    event = _event("video.progress", {"job_id": "vid_1", "progress": 0.4})
+
+    status, body = _deliver(conn, event)
+
+    assert (status, body) == (200, {"ignored": "video.progress"})
+    assert get_job(conn, job_id)["status"] == "processing"
+
+
+def test_unknown_job_is_acknowledged_and_ignored(conn, lumen, user_id):
+    _start(conn, lumen, user_id)
+
+    status, body = _deliver(conn, _completed(job_id="vid_unknown"))
+
+    assert (status, body) == (200, {"ignored": "unknown_job"})
+    assert get_balance(conn, user_id) == 80
+
+
+def test_bad_signature_is_rejected(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+
+    status, _ = _deliver(conn, _completed(), secret="wrong")
+
+    assert status == 400
+    assert get_job(conn, job_id)["status"] == "processing"
+
+
+def test_stale_signature_is_rejected(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+    stale = int((clock.now() - timedelta(minutes=10)).timestamp())
+
+    status, _ = _deliver(conn, _completed(), timestamp=stale)
+
+    assert status == 400
+    assert get_job(conn, job_id)["status"] == "processing"
+
+
+def test_missing_signature_is_rejected(conn, lumen, user_id):
+    _start(conn, lumen, user_id)
+    body = json.dumps(_completed()).encode()
+
+    status, _ = handle_lumen_webhook(conn, body, {}, SECRET)
+
+    assert status == 400
+
+
+def test_malformed_event_with_valid_signature_is_rejected(conn, lumen, user_id):
+    job_id = _start(conn, lumen, user_id)
+    body = b"{not json"
+    headers = {"Lumen-Signature": sign(SECRET, body, int(clock.now().timestamp()))}
+
+    status, _ = handle_lumen_webhook(conn, body, headers, SECRET)
+
+    assert status == 400
+    assert get_job(conn, job_id)["status"] == "processing"
