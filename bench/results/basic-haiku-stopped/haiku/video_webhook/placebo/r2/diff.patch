+++ b/pixforge/webhooks/lumen.py
@@ -0,0 +1,52 @@
+"""Lumen webhook: completion and failure of asynchronous video jobs."""
+import json
+import logging
+
+from ..db import transaction
+from ..features.common import fail_job
+from ..jobs import JobStatus, get_job_by_provider_id, transition
+from .dedup import mark_processed
+from .signing import verify_signature
+
+log = logging.getLogger(__name__)
+
+# Error keys (see locales) used when Lumen reports a job as not delivered.
+MODERATED_ERROR = "content_filtered"
+RENDER_FAILED_ERROR = "provider_failed"
+HANDLED_EVENTS = ("video.completed", "video.failed")
+
+
+def handle_lumen_webhook(conn, raw_body: bytes, headers: dict, secret: str) -> tuple[int, dict]:
+    """Returns (HTTP status, JSON body). Non-2xx responses make Lumen retry the delivery."""
+    if not verify_signature(secret, raw_body, headers.get("Lumen-Signature")):
+        return 400, {"error": "invalid signature"}
+
+    event = json.loads(raw_body)
+    if event["type"] not in HANDLED_EVENTS:
+        # Progress updates and unknown types need no change to the job.
+        return 200, {"ignored": event["type"]}
+
+    job = get_job_by_provider_id(conn, event["data"]["job_id"])
+    if job is None:
+        # Usually means the completion beat start_video committing provider_job_id.
+        # Not recorded as processed, so the retry Lumen sends for this 404 is applied.
+        return 404, {"error": "unknown job"}
+
+    with transaction(conn):
+        if not mark_processed(conn, "lumen", event["id"]):
+            return 200, {"duplicate": True}
+        if event["type"] == "video.failed":
+            fail_job(conn, job["id"], RENDER_FAILED_ERROR, refund=True)
+        else:
+            _complete(conn, job["id"], event["data"]["videos"])
+    return 200, {"ok": True}
+
+
+def _complete(conn, job_id: int, videos: list) -> None:
+    if not videos:
+        # Moderation removed the output. Nothing was delivered, so the user is refunded.
+        fail_job(conn, job_id, MODERATED_ERROR, refund=True)
+        return
+    # A job already terminal (e.g. timed out by the sweeper) keeps its outcome.
+    if not transition(conn, job_id, {JobStatus.PROCESSING}, JobStatus.SUCCEEDED, output_url=videos[0]["url"]):
+        log.info("ignored completion for job %s: already terminal", job_id)
diff --git a/tests/test_lumen_webhook.py b/tests/test_lumen_webhook.py
new file mode 100644
index 0000000..8a8c5d4
--- /dev/null
+++ b/tests/test_lumen_webhook.py
@@ -0,0 +1,162 @@
+import json
+
+from pixforge import clock
+from pixforge.billing import get_balance
+from pixforge.features.video import start_video
+from pixforge.jobs import get_job
+from pixforge.webhooks.lumen import handle_lumen_webhook
+from pixforge.webhooks.signing import sign
+
+SECRET = "whsec_lumen"
+CALLBACK = "https://pixforge.test/hooks/lumen"
+
+
+def _deliver(conn, event: dict, secret: str = SECRET, timestamp: int | None = None):
+    body = json.dumps(event).encode()
+    stamp = int(clock.now().timestamp()) if timestamp is None else timestamp
+    headers = {"Lumen-Signature": sign(secret, body, stamp)}
+    return handle_lumen_webhook(conn, body, headers, SECRET)
+
+
+def _start(conn, lumen, user_id, request_id="req-1"):
+    """Start a video job and return (job_id, lumen job id)."""
+    response = start_video(conn, lumen, user_id, "a cat surfing", request_id, CALLBACK)
+    return response["job_id"], get_job(conn, response["job_id"])["provider_job_id"]
+
+
+def _completed(vid, event_id="evt_done", url="https://cdn.lumen.test/77a.mp4"):
+    return {
+        "id": event_id,
+        "type": "video.completed",
+        "created": 1772366400,
+        "data": {"job_id": vid, "videos": [{"url": url, "duration_s": 5}], "moderation": None},
+    }
+
+
+def _failed(vid, event_id="evt_failed"):
+    return {
+        "id": event_id,
+        "type": "video.failed",
+        "created": 1772366400,
+        "data": {"job_id": vid, "error": {"code": "render_error", "message": "boom"}},
+    }
+
+
+def test_completed_marks_job_succeeded_with_url(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+
+    status, body = _deliver(conn, _completed(vid))
+
+    assert status == 200
+    assert body == {"ok": True}
+    job = get_job(conn, job_id)
+    assert job["status"] == "succeeded"
+    assert job["output_url"] == "https://cdn.lumen.test/77a.mp4"
+    assert get_balance(conn, user_id) == 80
+
+
+def test_failed_marks_job_failed_and_refunds(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+
+    status, _ = _deliver(conn, _failed(vid))
+
+    assert status == 200
+    job = get_job(conn, job_id)
+    assert job["status"] == "failed"
+    assert job["error"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_moderated_completion_fails_and_refunds(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+    event = _completed(vid)
+    event["data"] = {"job_id": vid, "videos": [], "moderation": {"reason": "policy"}}
+
+    status, _ = _deliver(conn, event)
+
+    assert status == 200
+    job = get_job(conn, job_id)
+    assert job["status"] == "failed"
+    assert job["error"] == "content_filtered"
+    assert job["output_url"] is None
+    assert get_balance(conn, user_id) == 100
+
+
+def test_progress_is_ignored(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+    event = {"id": "evt_p", "type": "video.progress", "data": {"job_id": vid, "progress": 0.4}}
+
+    status, body = _deliver(conn, event)
+
+    assert status == 200
+    assert body == {"ignored": "video.progress"}
+    assert get_job(conn, job_id)["status"] == "processing"
+
+
+def test_duplicate_delivery_is_applied_once(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+    _deliver(conn, _failed(vid))
+
+    status, body = _deliver(conn, _failed(vid))
+
+    assert status == 200
+    assert body == {"duplicate": True}
+    assert get_job(conn, job_id)["status"] == "failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_out_of_order_completion_after_failure_changes_nothing(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+    _deliver(conn, _failed(vid, event_id="evt_1"))
+
+    status, _ = _deliver(conn, _completed(vid, event_id="evt_2"))
+
+    assert status == 200
+    job = get_job(conn, job_id)
+    assert job["status"] == "failed"
+    assert job["output_url"] is None
+    assert get_balance(conn, user_id) == 100
+
+
+def test_unknown_job_returns_404_and_is_retried_in_full(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+    event = _completed("vid_not_yet_stored")
+
+    status, body = _deliver(conn, event)
+    assert status == 404
+    assert body == {"error": "unknown job"}
+
+    # Once the job's provider id is stored, Lumen's retry of the same event is applied.
+    status, _ = _deliver(conn, {**event, "data": {**event["data"], "job_id": vid}})
+    assert status == 200
+    assert get_job(conn, job_id)["status"] == "succeeded"
+
+
+def test_bad_signature_is_rejected(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+
+    status, _ = _deliver(conn, _completed(vid), secret="wrong")
+
+    assert status == 400
+    assert get_job(conn, job_id)["status"] == "processing"
+
+
+def test_stale_signature_is_rejected(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+    stale = int(clock.now().timestamp()) - 301
+
+    status, _ = _deliver(conn, _failed(vid), timestamp=stale)
+
+    assert status == 400
+    assert get_job(conn, job_id)["status"] == "processing"
+    assert get_balance(conn, user_id) == 80
+
+
+def test_missing_signature_header_is_rejected(conn, lumen, user_id):
+    job_id, vid = _start(conn, lumen, user_id)
+    body = json.dumps(_failed(vid)).encode()
+
+    status, _ = handle_lumen_webhook(conn, body, {}, SECRET)
+
+    assert status == 400
+    assert get_job(conn, job_id)["status"] == "processing"
