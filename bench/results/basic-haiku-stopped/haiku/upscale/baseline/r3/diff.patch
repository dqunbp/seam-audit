@@ -37,6 +39,26 @@ class FakeLumenClient:
             images=[OutputImage(url=f"https://cdn.lumen.test/{result_id}.png", width=width, height=height)],
         )
 
+    def upscale(self, image_url: str, factor: int = 2) -> UpscaleResult:
+        self.calls.append(("upscale", image_url, factor))
+        self._maybe_fail()
+        result_id = self._next_id("ups")
+        if self.filter_next:
+            self.filter_next = False
+            return UpscaleResult(id=result_id, status="filtered", image=None, reason="policy")
+        if self.reject_next is not None:
+            reason, self.reject_next = self.reject_next, None
+            # Like Lumen, a rejected upscale echoes the original input image.
+            return UpscaleResult(
+                id=result_id, status="rejected", image=OutputImage(url=image_url, width=512, height=512), reason=reason
+            )
+        size = 1024 * factor
+        return UpscaleResult(
+            id=result_id,
+            status="succeeded",
+            image=OutputImage(url=f"https://cdn.lumen.test/{result_id}.png", width=size, height=size),
+        )
+
     def create_video(self, prompt: str, callback_url: str, duration_s: int = 5) -> VideoJob:
