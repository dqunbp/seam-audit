diff --git a/tests/test_upscale.py b/tests/test_upscale.py
new file mode 100644
index 0000000..6634fab
--- /dev/null
+++ b/tests/test_upscale.py
@@ -0,0 +1,121 @@
+import pytest
+from lumen_sdk import LumenAPIError, LumenRateLimited
+
+from pixforge import jobs
+from pixforge.billing import get_balance
+from pixforge.features.upscale import upscale_image
+from pixforge.images import list_images, save_image
+from pixforge.users import create_user
+
+SOURCE_URL = "https://cdn.lumen.test/source.png"
+
+
+@pytest.fixture
+def source_id(conn, user_id):
+    return save_image(conn, user_id, SOURCE_URL, 1024, 1024)
+
+
+def test_upscales_charges_and_saves_to_library(conn, lumen, user_id, source_id):
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["ok"]
+    assert response["status"] == "succeeded"
+    assert response["url"].startswith("https://")
+    assert get_balance(conn, user_id) == 96
+    assert lumen.calls == [("upscale", SOURCE_URL, 2)]
+    images = list_images(conn, user_id)
+    assert len(images) == 2
+    assert images[0]["id"] == source_id
+
+
+def test_job_records_source_image(conn, lumen, user_id, source_id):
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert jobs.get_job(conn, response["job_id"])["source_image_id"] == source_id
+
+
+def test_pro_pays_half(conn, lumen, source_id):
+    pro = create_user(conn, "pro@example.com", plan="pro", balance=100)
+    pro_image = save_image(conn, pro, SOURCE_URL, 1024, 1024)
+    upscale_image(conn, lumen, pro, pro_image, "req-1")
+    assert get_balance(conn, pro) == 98
+
+
+def test_retry_with_same_request_id_is_not_charged_twice(conn, lumen, user_id, source_id):
+    first = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    second = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert second == first
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+    assert len(list_images(conn, user_id)) == 2
+
+
+def test_filtered_result_is_refunded_and_not_saved(conn, lumen, user_id, source_id):
+    lumen.filter_next = True
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+@pytest.mark.parametrize("reason", ["input_too_large", "unsupported_format"])
+def test_rejected_input_is_refunded_and_echo_is_not_saved(conn, lumen, user_id, source_id, reason):
+    lumen.reject_next = reason
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == reason
+    assert get_balance(conn, user_id) == 100
+    assert [image["url"] for image in list_images(conn, user_id)] == [SOURCE_URL]
+
+
+def test_rejected_with_unknown_reason_is_a_provider_failure(conn, lumen, user_id, source_id):
+    lumen.reject_next = "something_new"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_provider_error_is_refunded(conn, lumen, user_id, source_id):
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_rate_limited_is_refunded(conn, lumen, user_id, source_id):
+    lumen.fail_with = LumenRateLimited(5)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "rate_limited"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_insufficient_credits_does_not_call_provider(conn, lumen, source_id):
+    poor = create_user(conn, "poor@example.com", balance=1)
+    poor_image = save_image(conn, poor, SOURCE_URL, 1024, 1024)
+    response = upscale_image(conn, lumen, poor, poor_image, "req-1", locale="ru")
+    assert response["error_code"] == "insufficient_credits"
+    assert "4" in response["message"]
+    assert lumen.calls == []
+
+
+def test_another_users_image_is_not_found(conn, lumen, user_id, source_id):
+    other = create_user(conn, "other@example.com", balance=100)
+    response = upscale_image(conn, lumen, other, source_id, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "not_found"
+    assert get_balance(conn, other) == 100
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+
+
+def test_unknown_image_is_not_found(conn, lumen, user_id):
+    response = upscale_image(conn, lumen, user_id, 9999, "req-1")
+    assert response["error_code"] == "not_found"
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+
+
+def test_rejection_message_is_localized(conn, lumen, user_id, source_id):
+    lumen.reject_next = "input_too_large"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1", locale="ru")
+    assert "Кредиты возвращены" in response["message"]
