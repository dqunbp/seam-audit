diff --git a/tests/test_migrations.py b/tests/test_migrations.py
new file mode 100644
index 0000000..e7f9809
--- /dev/null
+++ b/tests/test_migrations.py
@@ -0,0 +1,24 @@
+from pathlib import Path
+
+from pixforge import db
+
+MIGRATIONS_DIR = Path(db.__file__).parent / "migrations"
+
+
+def test_source_image_migration_upgrades_an_existing_database():
+    # A production database that already ran the earlier migrations, with a job in it.
+    conn = db.connect()
+    conn.execute("CREATE TABLE schema_migrations (name TEXT PRIMARY KEY)")
+    for name in ["001_init.sql", "002_quota.sql"]:
+        conn.executescript((MIGRATIONS_DIR / name).read_text(encoding="utf-8"))
+        conn.execute("INSERT INTO schema_migrations (name) VALUES (?)", (name,))
+    conn.execute("INSERT INTO users (email) VALUES ('old@example.com')")
+    conn.execute(
+        "INSERT INTO jobs (user_id, kind, status, request_id, cost, created_at, updated_at)"
+        " VALUES (1, 'image', 'succeeded', 'old-req', 2, 'now', 'now')"
+    )
+
+    assert db.migrate(conn) == ["003_jobs_source_image.sql"]
+    row = conn.execute("SELECT source_image_id FROM jobs WHERE request_id = 'old-req'").fetchone()
+    assert row["source_image_id"] is None
+    conn.close()
diff --git a/tests/test_upscale.py b/tests/test_upscale.py
new file mode 100644
index 0000000..decd349
--- /dev/null
+++ b/tests/test_upscale.py
@@ -0,0 +1,125 @@
+from lumen_sdk import LumenAPIError, LumenRateLimited
+
+from pixforge.billing import get_balance
+from pixforge.features.generate import generate_image
+from pixforge.features.upscale import upscale_image
+from pixforge.images import list_images, save_image
+from pixforge.jobs import get_job
+from pixforge.users import create_user
+
+
+def _source(conn, user_id, url="https://cdn.example.test/src.png"):
+    return save_image(conn, user_id, url, 1024, 1024)
+
+
+def test_upscales_and_charges(conn, lumen, user_id):
+    source_id = _source(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["ok"]
+    assert response["status"] == "succeeded"
+    assert response["url"].startswith("https://")
+    assert get_balance(conn, user_id) == 96
+    assert lumen.calls == [("upscale", "https://cdn.example.test/src.png")]
+
+
+def test_response_has_the_same_shape_as_generate(conn, lumen, user_id):
+    generated = generate_image(conn, lumen, user_id, "a cat", "req-gen")
+    upscaled = upscale_image(conn, lumen, user_id, _source(conn, user_id), "req-up")
+    assert set(upscaled) == set(generated) == {"ok", "job_id", "status", "url"}
+
+
+def test_output_is_added_to_library(conn, lumen, user_id):
+    source_id = _source(conn, user_id)
+    upscale_image(conn, lumen, user_id, source_id, "req-1")
+    library = list_images(conn, user_id)
+    assert len(library) == 2
+    assert (library[1]["width"], library[1]["height"]) == (2048, 2048)
+
+
+def test_job_records_source_image(conn, lumen, user_id):
+    source_id = _source(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    job = get_job(conn, response["job_id"])
+    assert job["kind"] == "upscale"
+    assert job["source_image_id"] == source_id
+    assert job["output_url"] == response["url"]
+
+
+def test_pro_pays_half(conn, lumen, pro_user_id):
+    upscale_image(conn, lumen, pro_user_id, _source(conn, pro_user_id), "req-1")
+    assert get_balance(conn, pro_user_id) == 98
+
+
+def test_retry_with_same_request_id_is_not_charged_twice(conn, lumen, user_id):
+    source_id = _source(conn, user_id)
+    first = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    second = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert second == first
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+
+
+def test_another_users_image_is_not_found(conn, lumen, user_id):
+    other = create_user(conn, "other@example.com", balance=100)
+    their_image = _source(conn, other)
+    response = upscale_image(conn, lumen, user_id, their_image, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "not_found"
+    assert response["job_id"] is None
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+
+
+def test_missing_image_is_not_found(conn, lumen, user_id):
+    response = upscale_image(conn, lumen, user_id, 9999, "req-1")
+    assert response["error_code"] == "not_found"
+    assert lumen.calls == []
+
+
+def test_insufficient_credits_does_not_call_provider(conn, lumen):
+    poor = create_user(conn, "poor@example.com", balance=3)
+    source_id = _source(conn, poor)
+    response = upscale_image(conn, lumen, poor, source_id, "req-1", locale="ru")
+    assert response["error_code"] == "insufficient_credits"
+    assert "4" in response["message"]
+    assert lumen.calls == []
+
+
+def test_filtered_result_is_refunded(conn, lumen, user_id):
+    lumen.filter_next = True
+    response = upscale_image(conn, lumen, user_id, _source(conn, user_id), "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_rejected_input_is_refunded_and_not_saved(conn, lumen, user_id):
+    lumen.reject_next = "input_too_large"
+    response = upscale_image(conn, lumen, user_id, _source(conn, user_id), "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "input_too_large"
+    assert get_balance(conn, user_id) == 100
+    # The echoed original must not appear as a new library image.
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_unknown_rejection_reason_is_a_provider_failure(conn, lumen, user_id):
+    lumen.reject_next = "something_new"
+    response = upscale_image(conn, lumen, user_id, _source(conn, user_id), "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_provider_error_is_refunded(conn, lumen, user_id):
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    response = upscale_image(conn, lumen, user_id, _source(conn, user_id), "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_rate_limited_is_refunded(conn, lumen, user_id):
+    lumen.fail_with = LumenRateLimited(5)
+    response = upscale_image(conn, lumen, user_id, _source(conn, user_id), "req-1")
+    assert response["error_code"] == "rate_limited"
+    assert get_balance(conn, user_id) == 100
