+    def upscale(self, image_url: str, factor: int = 2) -> UpscaleResult:
+        self.calls.append(("upscale", image_url))
+        self._maybe_fail()
+        result_id = self._next_id("ups")
+        if self.filter_next:
+            self.filter_next = False
+            return UpscaleResult(id=result_id, status="filtered", image=None, reason="policy")
+        if self.reject_next is not None:
+            reason, self.reject_next = self.reject_next, None
+            # Lumen echoes the original input back unchanged when it rejects.
+            return UpscaleResult(
+                id=result_id, status="rejected", image=OutputImage(url=image_url, width=0, height=0), reason=reason
+            )
+        return UpscaleResult(
+            id=result_id,
+            status="succeeded",
+            image=OutputImage(url=f"https://cdn.lumen.test/{result_id}.png", width=2048, height=2048),
+        )
