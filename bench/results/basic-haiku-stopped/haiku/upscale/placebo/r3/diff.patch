diff --git a/tests/test_upscale.py b/tests/test_upscale.py
new file mode 100644
index 0000000..06d2b7c
--- /dev/null
+++ b/tests/test_upscale.py
@@ -0,0 +1,136 @@
+import pytest
+from lumen_sdk import LumenAPIError, LumenRateLimited, OutputImage, UpscaleResult
+
+from pixforge.billing import get_balance
+from pixforge.features.generate import generate_image
+from pixforge.features.upscale import upscale_image
+from pixforge.images import list_images, save_image
+from pixforge.jobs import get_job_by_request
+from pixforge.users import create_user
+
+
+@pytest.fixture
+def source_id(conn, user_id):
+    return save_image(conn, user_id, "https://cdn.lumen.test/source.png", 512, 512)
+
+
+def test_upscales_and_charges(conn, lumen, user_id, source_id):
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["ok"]
+    assert response["status"] == "succeeded"
+    assert response["url"].startswith("https://cdn.lumen.test/")
+    assert get_balance(conn, user_id) == 96
+
+
+def test_result_is_added_to_library_with_its_dimensions(conn, lumen, user_id, source_id):
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    latest = list_images(conn, user_id)[-1]
+    assert latest["url"] == response["url"]
+    assert (latest["width"], latest["height"]) == (2048, 2048)
+
+
+def test_job_records_source_image(conn, lumen, user_id, source_id):
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    job = get_job_by_request(conn, "req-1")
+    assert job["id"] == response["job_id"]
+    assert job["kind"] == "upscale"
+    assert job["source_image_id"] == source_id
+
+
+def test_generated_images_have_no_source_image(conn, lumen, user_id):
+    response = generate_image(conn, lumen, user_id, "a cat", "req-1")
+    assert get_job_by_request(conn, "req-1")["source_image_id"] is None
+    assert response["ok"]
+
+
+def test_sends_source_url_to_lumen(conn, lumen, user_id, source_id):
+    upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert lumen.calls == [("upscale", "https://cdn.lumen.test/source.png")]
+
+
+def test_pro_pays_half(conn, lumen, pro_user_id):
+    source = save_image(conn, pro_user_id, "https://cdn.lumen.test/source.png", 512, 512)
+    upscale_image(conn, lumen, pro_user_id, source, "req-1")
+    assert get_balance(conn, pro_user_id) == 98
+
+
+def test_retry_with_same_request_id_is_not_charged_twice(conn, lumen, user_id, source_id):
+    first = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    second = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert second == first
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+    assert len(list_images(conn, user_id)) == 2
+
+
+def test_insufficient_credits_does_not_call_provider(conn, lumen):
+    poor = create_user(conn, "poor@example.com", balance=1)
+    source = save_image(conn, poor, "https://cdn.lumen.test/source.png", 512, 512)
+    response = upscale_image(conn, lumen, poor, source, "req-1", locale="ru")
+    assert response["error_code"] == "insufficient_credits"
+    assert "4" in response["message"]
+    assert lumen.calls == []
+    assert get_balance(conn, poor) == 1
+
+
+@pytest.mark.parametrize("reason", ["input_too_large", "unsupported_format"])
+def test_rejected_input_is_refunded_and_echo_is_not_saved(conn, lumen, user_id, source_id, reason):
+    # Lumen echoes the original image back on rejection; it must not become a library image.
+    lumen.upscale_next = UpscaleResult(
+        id="ups_x",
+        status="rejected",
+        image=OutputImage(url="https://cdn.lumen.test/source.png", width=512, height=512),
+        reason=reason,
+    )
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == reason
+    assert get_balance(conn, user_id) == 100
+    assert [img["id"] for img in list_images(conn, user_id)] == [source_id]
+
+
+def test_rejection_without_known_reason_is_provider_failure(conn, lumen, user_id, source_id):
+    lumen.upscale_next = UpscaleResult(id="ups_x", status="rejected", image=None, reason="mystery")
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_filtered_result_is_refunded(conn, lumen, user_id, source_id):
+    lumen.upscale_next = UpscaleResult(id="ups_x", status="filtered", image=None, reason="policy")
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_provider_error_is_refunded(conn, lumen, user_id, source_id):
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_rate_limited_is_refunded(conn, lumen, user_id, source_id):
+    lumen.fail_with = LumenRateLimited(5)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "rate_limited"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_unknown_image_is_not_found_and_not_charged(conn, lumen, user_id):
+    response = upscale_image(conn, lumen, user_id, 999, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "not_found"
+    assert response["job_id"] is None
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+
+
+def test_other_users_image_is_not_found_and_not_charged(conn, lumen, user_id):
+    other = create_user(conn, "other@example.com", balance=100)
+    their_image = save_image(conn, other, "https://cdn.lumen.test/theirs.png", 512, 512)
+    response = upscale_image(conn, lumen, user_id, their_image, "req-1")
+    assert response["error_code"] == "not_found"
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
