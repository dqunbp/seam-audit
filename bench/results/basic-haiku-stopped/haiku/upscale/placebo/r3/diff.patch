+"""2x upscaling of one of the user's own images."""
+import logging
+
+from lumen_sdk import LumenClient, LumenError, LumenRateLimited
+
+from .. import jobs
+from ..billing import InsufficientCredits, charge_credits
+from ..i18n import t
+from ..images import get_image, save_image
+from ..jobs import JobStatus
+from ..pricing import price_for
+from ..users import get_user
+from .common import fail_job, response_for
+
+log = logging.getLogger(__name__)
+
+UPSCALE_FACTOR = 2
+
+# Lumen answers a rejected upscale with HTTP 200 and `status: "rejected"`; map its reasons to our error keys.
+REJECTION_ERRORS = {"input_too_large": "input_too_large", "unsupported_format": "unsupported_format"}
+
+
+def upscale_image(
+    conn, client: LumenClient, user_id: int, image_id: int, request_id: str, locale: str = "en"
+) -> dict:
+    """Upscale one of the user's images by 2x and add the result to their library.
+
+    `request_id` has the same retry semantics as `generate_image`. The new job
+    records `source_image_id`, so the history page can link the two images.
+
+    Returns the same shape as `generate_image`.
+    """
+    existing = jobs.get_job_by_request(conn, request_id)
+    if existing is not None:
+        return response_for(existing, locale)
+
+    source = get_image(conn, image_id)
+    if source is None or source["user_id"] != user_id:
+        return {
+            "ok": False,
+            "job_id": None,
+            "status": None,
+            "error_code": "not_found",
+            "message": t("errors.not_found", locale),
+        }
+
+    user = get_user(conn, user_id)
+    cost = price_for("upscale", user["plan"])
+    job_id = jobs.create_job(conn, user_id, "upscale", request_id, cost, source_image_id=image_id)
+
+    try:
+        charge_credits(conn, user_id, cost, "upscale", f"charge:upscale:{request_id}")
+    except InsufficientCredits:
+        fail_job(conn, job_id, "insufficient_credits", refund=False)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    try:
+        result = client.upscale(source["url"], factor=UPSCALE_FACTOR)
+    except LumenRateLimited:
+        fail_job(conn, job_id, "rate_limited", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+    except LumenError:
+        log.exception("lumen upscale failed for job %s", job_id)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    # A rejected result echoes the input image back, so it must never be saved or marked succeeded.
+    if result.status == "rejected":
+        error = REJECTION_ERRORS.get(result.reason, "provider_failed")
+        log.info("lumen rejected upscale for job %s: %s", job_id, result.reason)
+        fail_job(conn, job_id, error, refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    if result.status == "filtered":
+        log.info("lumen filtered upscale for job %s: %s", job_id, result.reason)
+        fail_job(conn, job_id, "content_filtered", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    if result.status != "succeeded" or result.image is None:
+        log.error("lumen upscale for job %s returned %s without an image", job_id, result.status)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    output = result.image
+    save_image(conn, user_id, output.url, output.width, output.height)
+    jobs.transition(conn, job_id, {JobStatus.PENDING}, JobStatus.SUCCEEDED, output_url=output.url)
+    return response_for(jobs.get_job(conn, job_id), locale)
