@@ -0,0 +1,90 @@
+"""Paid 2x upscaling of one of the user's images."""
+import logging
+
+from lumen_sdk import LumenClient, LumenError, LumenRateLimited, UpscaleResult
+
+from .. import jobs
+from ..billing import InsufficientCredits, charge_credits
+from ..db import transaction
+from ..i18n import t
+from ..images import get_image, save_image
+from ..jobs import JobStatus
+from ..pricing import price_for
+from ..users import get_user
+from .common import fail_job, response_for
+
+log = logging.getLogger(__name__)
+
+UPSCALE_FACTOR = 2
+# Lumen's input limit: the longest side of the source image, in pixels.
+MAX_INPUT_SIDE_PX = 2048
+# Lumen reports these when it does not accept the input. Other reasons are provider failures.
+REJECTION_CODES = frozenset({"input_too_large", "unsupported_format"})
+
+
+def upscale_image(conn, client: LumenClient, user_id: int, image_id: int, request_id: str, locale: str = "en") -> dict:
+    """Upscale one of the user's images 2x and add the result to their library.
+
+    The job records `source_image_id`, so the history page can link the two images.
+    `request_id` has the same retry semantics as in `generate_image`.
+
+    Returns the same shape as `generate_image`.
+    """
+    existing = jobs.get_job_by_request(conn, request_id)
+    if existing is not None:
+        return response_for(existing, locale)
+
+    source = get_image(conn, image_id)
+    if source is None or source["user_id"] != user_id:
+        return {
+            "ok": False,
+            "job_id": None,
+            "status": None,
+            "error_code": "not_found",
+            "message": t("errors.not_found", locale),
+        }
+
+    user = get_user(conn, user_id)
+    cost = price_for("upscale", user["plan"])
+    job_id = jobs.create_job(conn, user_id, "upscale", request_id, cost, source_image_id=image_id)
+
+    # Refuse oversized sources before charging: Lumen would reject them anyway.
+    if max(source["width"], source["height"]) > MAX_INPUT_SIDE_PX:
+        fail_job(conn, job_id, "input_too_large", refund=False)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    try:
+        charge_credits(conn, user_id, cost, "upscale", f"charge:upscale:{request_id}")
+    except InsufficientCredits:
+        fail_job(conn, job_id, "insufficient_credits", refund=False)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    try:
+        result = client.upscale(source["url"], factor=UPSCALE_FACTOR)
+    except LumenRateLimited:
+        fail_job(conn, job_id, "rate_limited", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+    except LumenError:
+        log.exception("lumen upscale failed for job %s", job_id)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    # A "rejected" result echoes the original image back. It must never be saved as the upscale.
+    if result.status != "succeeded" or result.image is None:
+        log.info("lumen did not upscale job %s: %s %s", job_id, result.status, result.reason)
+        fail_job(conn, job_id, _failure_code(result), refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    output = result.image
+    with transaction(conn):
+        save_image(conn, user_id, output.url, output.width, output.height)
+        jobs.transition(conn, job_id, {JobStatus.PENDING}, JobStatus.SUCCEEDED, output_url=output.url)
+    return response_for(jobs.get_job(conn, job_id), locale)
+
+
+def _failure_code(result: UpscaleResult) -> str:
+    if result.status == "filtered":
+        return "content_filtered"
+    if result.status == "rejected" and result.reason in REJECTION_CODES:
+        return result.reason
+    return "provider_failed"
