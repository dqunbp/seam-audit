@@ -37,6 +40,20 @@ class FakeLumenClient:
             images=[OutputImage(url=f"https://cdn.lumen.test/{result_id}.png", width=width, height=height)],
         )
 
+    def upscale(self, image_url: str, factor: int = 2) -> UpscaleResult:
+        self.calls.append(("upscale", image_url))
+        self._maybe_fail()
+        result_id = self._next_id("ups")
+        status, self.upscale_status = self.upscale_status, "succeeded"
+        if status == "rejected":
+            # Lumen echoes the original input back when it rejects it.
+            original = OutputImage(url=image_url, width=1024, height=1024)
+            return UpscaleResult(id=result_id, status="rejected", image=original, reason="input_too_large")
+        if status == "filtered":
+            return UpscaleResult(id=result_id, status="filtered", image=None, reason="policy")
+        upscaled = OutputImage(url=f"https://cdn.lumen.test/{result_id}.png", width=2048, height=2048)
+        return UpscaleResult(id=result_id, status="succeeded", image=upscaled)
+
     def create_video(self, prompt: str, callback_url: str, duration_s: int = 5) -> VideoJob:
         self.calls.append(("create_video", prompt))
         self._maybe_fail()
diff --git a/tests/test_upscale.py b/tests/test_upscale.py
new file mode 100644
index 0000000..bd461e3
--- /dev/null
+++ b/tests/test_upscale.py
@@ -0,0 +1,125 @@
+from lumen_sdk import LumenAPIError, LumenRateLimited
+
+from pixforge import jobs
+from pixforge.billing import get_balance
+from pixforge.features.upscale import upscale_image
+from pixforge.images import list_images, save_image
+from pixforge.users import create_user
+
+SOURCE_URL = "https://cdn.lumen.test/source.png"
+
+
+def add_source_image(conn, user_id):
+    return save_image(conn, user_id, SOURCE_URL, 1024, 1024)
+
+
+def test_upscales_and_charges(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["ok"]
+    assert response["status"] == "succeeded"
+    assert response["url"].startswith("https://cdn.lumen.test/ups_")
+    assert get_balance(conn, user_id) == 96
+    assert lumen.calls == [("upscale", SOURCE_URL)]
+
+
+def test_result_is_added_to_library_and_job_records_source(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    library = list_images(conn, user_id)
+    assert [image["url"] for image in library] == [SOURCE_URL, response["url"]]
+    assert (library[1]["width"], library[1]["height"]) == (2048, 2048)
+    job = jobs.get_job(conn, response["job_id"])
+    assert job["kind"] == "upscale"
+    assert job["source_image_id"] == source_id
+
+
+def test_pro_pays_half(conn, lumen, pro_user_id):
+    source_id = add_source_image(conn, pro_user_id)
+    upscale_image(conn, lumen, pro_user_id, source_id, "req-1")
+    assert get_balance(conn, pro_user_id) == 98
+
+
+def test_retry_with_same_request_id_is_not_charged_twice(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    first = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    second = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert second == first
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+    assert len(list_images(conn, user_id)) == 2
+
+
+def test_unknown_image_is_not_found_and_free(conn, lumen, user_id):
+    response = upscale_image(conn, lumen, user_id, 9999, "req-1")
+    assert response == {
+        "ok": False,
+        "job_id": None,
+        "status": None,
+        "error_code": "not_found",
+        "message": "Not found.",
+    }
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+    assert jobs.get_job_by_request(conn, "req-1") is None
+
+
+def test_another_users_image_is_not_found(conn, lumen, user_id):
+    other = create_user(conn, "other@example.com", balance=100)
+    other_source_id = add_source_image(conn, other)
+    response = upscale_image(conn, lumen, user_id, other_source_id, "req-1")
+    assert response["error_code"] == "not_found"
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+
+
+def test_insufficient_credits_does_not_call_provider(conn, lumen):
+    poor = create_user(conn, "poor@example.com", balance=3)
+    source_id = add_source_image(conn, poor)
+    response = upscale_image(conn, lumen, poor, source_id, "req-1", locale="ru")
+    assert response["error_code"] == "insufficient_credits"
+    assert "4" in response["message"]
+    assert lumen.calls == []
+
+
+def test_rejected_upscale_is_refunded_and_original_not_saved(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    lumen.upscale_status = "rejected"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "upscale_rejected"
+    assert get_balance(conn, user_id) == 100
+    # Lumen echoes the input back on rejection; it must not appear as an upscale.
+    assert [image["url"] for image in list_images(conn, user_id)] == [SOURCE_URL]
+
+
+def test_filtered_upscale_is_refunded(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    lumen.upscale_status = "filtered"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_rate_limited_is_refunded(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    lumen.fail_with = LumenRateLimited(5)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "rate_limited"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_provider_error_is_refunded(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_rejected_message_is_localised(conn, lumen, user_id):
+    source_id = add_source_image(conn, user_id)
+    lumen.upscale_status = "rejected"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1", locale="ru")
+    assert response["message"].startswith("Не удалось увеличить")
