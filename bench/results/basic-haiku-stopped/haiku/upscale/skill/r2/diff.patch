+    def upscale(self, image_url: str, factor: int = 2) -> UpscaleResult:
+        self.calls.append(("upscale", image_url, factor))
+        self._maybe_fail()
+        result_id = self._next_id("ups")
+        if self.reject_next_upscale is not None:
+            reason, self.reject_next_upscale = self.reject_next_upscale, None
+            # Lumen echoes the original input back on rejection.
+            return UpscaleResult(id=result_id, status="rejected", image=OutputImage(url=image_url, width=0, height=0), reason=reason)
+        return UpscaleResult(
+            id=result_id,
+            status="succeeded",
+            image=OutputImage(url=f"https://cdn.lumen.test/{result_id}.png", width=2048, height=2048),
+        )
+
