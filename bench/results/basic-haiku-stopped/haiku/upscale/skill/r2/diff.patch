@@ -0,0 +1,116 @@
+"""Paid 2x upscaling of one of the user's images."""
+import logging
+import sqlite3
+
+from lumen_sdk import LumenClient, LumenError, LumenRateLimited
+
+from .. import jobs
+from ..billing import InsufficientCredits, charge_credits
+from ..db import transaction
+from ..i18n import t
+from ..images import get_image, save_image
+from ..jobs import JobStatus
+from ..pricing import price_for
+from ..users import get_user
+from .common import fail_job, response_for
+
+log = logging.getLogger(__name__)
+
+# Lumen `rejected` reasons with their own user-facing message; any other reason is a provider failure.
+REJECTION_CODES = {"input_too_large", "unsupported_format"}
+
+
+def upscale_image(
+    conn,
+    client: LumenClient,
+    user_id: int,
+    image_id: int,
+    request_id: str,
+    locale: str = "en",
+) -> dict:
+    """Upscale `image_id` 2x and add the result to the user's library.
+
+    Same `request_id` and response contract as `generate_image`: a repeated
+    request_id returns the original job's result without charging again.
+    The job records `source_image_id` so the history page can link the two images.
+
+    Returns {"ok": True, "job_id", "status", "url"} or
+            {"ok": False, "job_id", "status", "error_code", "message"}.
+    An image that is missing or belongs to another user returns error_code
+    "not_found" before any job is created or any credits are charged.
+    """
+    replay = _replay(conn, request_id, locale)
+    if replay is not None:
+        return replay
+
+    source = get_image(conn, image_id)
+    if source is None or source["user_id"] != user_id:
+        return {
+            "ok": False,
+            "job_id": None,
+            "status": None,
+            "error_code": "not_found",
+            "message": t("errors.not_found", locale),
+        }
+
+    user = get_user(conn, user_id)
+    cost = price_for("upscale", user["plan"])
+    try:
+        job_id = jobs.create_job(conn, user_id, "upscale", request_id, cost, source_image_id=image_id)
+    except sqlite3.IntegrityError:
+        # A concurrent request with the same request_id inserted first. Nothing is charged yet.
+        replay = _replay(conn, request_id, locale)
+        if replay is None:
+            raise
+        return replay
+
+    try:
+        charge_credits(conn, user_id, cost, "upscale", f"charge:upscale:{request_id}")
+    except InsufficientCredits:
+        fail_job(conn, job_id, "insufficient_credits", refund=False)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    try:
+        result = client.upscale(source["url"], factor=2)
+    except LumenRateLimited:
+        fail_job(conn, job_id, "rate_limited", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+    except LumenError:
+        log.exception("lumen upscale failed for job %s", job_id)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    # Lumen answers HTTP 200 for these. On `rejected`, `image` is the original input
+    # echoed back, so it must never be saved as the result.
+    if result.status == "filtered":
+        log.info("lumen filtered upscale job %s: %s", job_id, result.reason)
+        fail_job(conn, job_id, "content_filtered", refund=True)
+    elif result.status == "rejected":
+        log.info("lumen rejected upscale job %s: %s", job_id, result.reason)
+        code = result.reason if result.reason in REJECTION_CODES else "provider_failed"
+        fail_job(conn, job_id, code, refund=True)
+    elif result.status == "succeeded" and result.image is not None:
+        output = result.image
+        # Save to the library and complete the job together, so a crash cannot leave
+        # an orphan library image behind a job that is still pending.
+        with transaction(conn):
+            save_image(conn, user_id, output.url, output.width, output.height)
+            moved = jobs.transition(
+                conn, job_id, {JobStatus.PENDING}, JobStatus.SUCCEEDED, output_url=output.url
+            )
+            if not moved:
+                raise RuntimeError(f"upscale job {job_id} was not pending when completing it")
+    else:
+        log.error("lumen upscale job %s returned unusable result: status=%s", job_id, result.status)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+    return response_for(jobs.get_job(conn, job_id), locale)
+
+
+def _replay(conn, request_id: str, locale: str):
+    """Response for a request_id that already has a job, or None if it is new."""
+    existing = jobs.get_job_by_request(conn, request_id)
+    if existing is None:
+        return None
+    if existing["kind"] != "upscale":
+        raise ValueError(f"request_id {request_id} was already used for a {existing['kind']} job")
+    return response_for(existing, locale)
