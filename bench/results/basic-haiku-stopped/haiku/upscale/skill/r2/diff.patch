diff --git a/tests/test_upscale.py b/tests/test_upscale.py
new file mode 100644
index 0000000..9e178a8
--- /dev/null
+++ b/tests/test_upscale.py
@@ -0,0 +1,189 @@
+import sqlite3
+
+import pytest
+from lumen_sdk import LumenAPIError, LumenRateLimited, LumenTimeout, OutputImage, UpscaleResult
+
+from pixforge import jobs
+from pixforge.billing import get_balance
+from pixforge.features.generate import generate_image
+from pixforge.features.upscale import upscale_image
+from pixforge.images import list_images, save_image
+from pixforge.jobs import get_job
+from pixforge.users import create_user
+
+SOURCE_URL = "https://cdn.lumen.test/src.png"
+
+
+@pytest.fixture
+def source_id(conn, user_id):
+    return save_image(conn, user_id, SOURCE_URL, 1024, 1024)
+
+
+def test_upscales_charges_and_saves_to_library(conn, lumen, user_id, source_id):
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["ok"]
+    assert response["status"] == "succeeded"
+    assert response["url"].startswith("https://cdn.lumen.test/")
+    assert get_balance(conn, user_id) == 96
+    assert [img["url"] for img in list_images(conn, user_id)] == [SOURCE_URL, response["url"]]
+    assert lumen.calls == [("upscale", SOURCE_URL, 2)]
+
+
+def test_job_records_source_image(conn, lumen, user_id, source_id):
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    job = get_job(conn, response["job_id"])
+    assert job["kind"] == "upscale"
+    assert job["source_image_id"] == source_id
+
+
+def test_generate_job_has_no_source_image(conn, lumen, user_id):
+    response = generate_image(conn, lumen, user_id, "a cat", "req-1")
+    assert get_job(conn, response["job_id"])["source_image_id"] is None
+
+
+def test_pro_pays_half(conn, lumen, source_id):
+    pro = create_user(conn, "pro@example.com", plan="pro", balance=100)
+    source = save_image(conn, pro, SOURCE_URL, 512, 512)
+    upscale_image(conn, lumen, pro, source, "req-1")
+    assert get_balance(conn, pro) == 98
+
+
+def test_retry_with_same_request_id_is_not_charged_twice(conn, lumen, user_id, source_id):
+    first = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    second = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert second == first
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+    assert len(list_images(conn, user_id)) == 2
+
+
+def test_concurrent_duplicate_request_returns_the_winner(conn, lumen, user_id, source_id, monkeypatch):
+    winner = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    # The second worker's first lookup misses (it read before the winner committed),
+    # so its insert hits the UNIQUE(request_id) constraint. The retry lookup then finds the winner.
+    real_lookup = jobs.get_job_by_request
+    calls = {"n": 0}
+
+    def stale_then_real(c, request_id):
+        calls["n"] += 1
+        return None if calls["n"] == 1 else real_lookup(c, request_id)
+
+    monkeypatch.setattr(jobs, "get_job_by_request", stale_then_real)
+    second = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert second == winner
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+
+
+def test_request_id_used_by_another_kind_is_an_error(conn, lumen, user_id, source_id):
+    generate_image(conn, lumen, user_id, "a cat", "req-1")
+    with pytest.raises(ValueError):
+        upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert get_balance(conn, user_id) == 98
+    assert [call[0] for call in lumen.calls] == ["generate_image"]
+
+
+def test_other_users_image_is_not_found_and_nothing_is_charged(conn, lumen, user_id, source_id):
+    stranger = create_user(conn, "stranger@example.com", balance=100)
+    response = upscale_image(conn, lumen, stranger, source_id, "req-1")
+    assert response == {
+        "ok": False,
+        "job_id": None,
+        "status": None,
+        "error_code": "not_found",
+        "message": "Not found.",
+    }
+    assert get_balance(conn, stranger) == 100
+    assert lumen.calls == []
+
+
+def test_missing_image_is_not_found(conn, lumen, user_id):
+    response = upscale_image(conn, lumen, user_id, 9999, "req-1", locale="ru")
+    assert response["error_code"] == "not_found"
+    assert response["message"] == "Не найдено."
+    assert lumen.calls == []
+
+
+def test_insufficient_credits_does_not_call_provider(conn, lumen, source_id):
+    poor = create_user(conn, "poor@example.com", balance=1)
+    source = save_image(conn, poor, SOURCE_URL, 512, 512)
+    response = upscale_image(conn, lumen, poor, source, "req-1", locale="ru")
+    assert response["error_code"] == "insufficient_credits"
+    assert "4" in response["message"]
+    assert lumen.calls == []
+
+
+def test_rejected_input_is_refunded_and_original_is_not_saved(conn, lumen, user_id, source_id):
+    lumen.reject_next_upscale = "input_too_large"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "input_too_large"
+    assert get_balance(conn, user_id) == 100
+    # Only the original image is in the library; the echoed input is not a new result.
+    assert [img["url"] for img in list_images(conn, user_id)] == [SOURCE_URL]
+
+
+def test_unsupported_format_is_refunded(conn, lumen, user_id, source_id):
+    lumen.reject_next_upscale = "unsupported_format"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1", locale="ru")
+    assert response["error_code"] == "unsupported_format"
+    assert "не поддерживается" in response["message"]
+    assert get_balance(conn, user_id) == 100
+
+
+def test_unknown_rejection_reason_is_a_provider_failure(conn, lumen, user_id, source_id):
+    lumen.reject_next_upscale = "something_new"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_filtered_output_is_refunded(conn, lumen, user_id, source_id, monkeypatch):
+    filtered = UpscaleResult(id="ups_x", status="filtered", image=None, reason="policy")
+    monkeypatch.setattr(lumen, "upscale", lambda url, factor=2: filtered)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_succeeded_without_image_is_a_refunded_provider_failure(conn, lumen, user_id, source_id, monkeypatch):
+    broken = UpscaleResult(id="ups_x", status="succeeded", image=None)
+    monkeypatch.setattr(lumen, "upscale", lambda url, factor=2: broken)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+@pytest.mark.parametrize(
+    "error, code",
+    [
+        (LumenRateLimited(5), "rate_limited"),
+        (LumenAPIError(500, "internal", "boom"), "provider_failed"),
+        (LumenTimeout("read timed out"), "provider_failed"),
+    ],
+)
+def test_provider_errors_are_refunded(conn, lumen, user_id, source_id, error, code):
+    lumen.fail_with = error
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == code
+    assert get_balance(conn, user_id) == 100
+    assert list_images(conn, user_id)[-1]["url"] == SOURCE_URL
+
+
+def test_failed_job_is_not_refunded_twice_on_retry(conn, lumen, user_id, source_id):
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    upscale_image(conn, lumen, user_id, source_id, "req-1")
+    upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert get_balance(conn, user_id) == 100
+
+
+def test_save_and_complete_are_atomic(conn, lumen, user_id, source_id, monkeypatch):
+    def explode(*args, **kwargs):
+        raise sqlite3.OperationalError("disk I/O error")
+
+    monkeypatch.setattr("pixforge.features.upscale.jobs.transition", explode)
+    with pytest.raises(sqlite3.OperationalError):
+        upscale_image(conn, lumen, user_id, source_id, "req-1")
+    # The library image written just before the failure was rolled back.
+    assert [img["url"] for img in list_images(conn, user_id)] == [SOURCE_URL]
