+def get_user_image(conn, user_id: int, image_id: int):
+    """Like `get_image`, but only returns the image if it belongs to `user_id`."""
+    return conn.execute(
+        "SELECT * FROM images WHERE id = ? AND user_id = ?", (image_id, user_id)
+    ).fetchone()
