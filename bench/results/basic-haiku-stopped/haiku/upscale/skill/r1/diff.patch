index 0000000..f55f7b1
--- /dev/null
+++ b/pixforge/features/upscale.py
@@ -0,0 +1,96 @@
+"""2x upscaling of one of the user's images."""
+import logging
+
+from lumen_sdk import LumenClient, LumenError, LumenRateLimited
+
+from .. import jobs
+from ..billing import InsufficientCredits, charge_credits
+from ..db import transaction
+from ..images import get_user_image, save_image
+from ..i18n import t
+from ..jobs import JobStatus
+from ..pricing import price_for
+from ..users import get_user
+from .common import fail_job, response_for
+
+log = logging.getLogger(__name__)
+
+# Lumen's `rejected` reasons shown to the user as-is. Any other reason is a provider failure.
+REJECTION_CODES = {"input_too_large", "unsupported_format"}
+
+
+def upscale_image(
+    conn,
+    client: LumenClient,
+    user_id: int,
+    image_id: int,
+    request_id: str,
+    locale: str = "en",
+) -> dict:
+    """Upscale `image_id` 2x and add the result to the user's library.
+
+    The job records `source_image_id`, so history can link the two images.
+    `request_id` works as in `generate_image`: a repeat returns the original job
+    without charging again.
+
+    Returns the same shape as `generate_image`. An image the user doesn't own
+    returns `not_found` without creating a job or charging.
+    """
+    existing = jobs.get_job_by_request(conn, request_id)
+    if existing is not None:
+        return response_for(existing, locale)
+
+    source = get_user_image(conn, user_id, image_id)
+    if source is None:
+        return {
+            "ok": False,
+            "job_id": None,
+            "status": None,
+            "error_code": "not_found",
+            "message": t("errors.not_found", locale),
+        }
+
+    user = get_user(conn, user_id)
+    cost = price_for("upscale", user["plan"])
+    job_id = jobs.create_job(conn, user_id, "upscale", request_id, cost, source_image_id=image_id)
+
+    try:
+        charge_credits(conn, user_id, cost, "upscale", f"charge:upscale:{request_id}")
+    except InsufficientCredits:
+        fail_job(conn, job_id, "insufficient_credits", refund=False)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    try:
+        result = client.upscale(source["url"], factor=2)
+    except LumenRateLimited:
+        fail_job(conn, job_id, "rate_limited", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+    except LumenError:
+        log.exception("lumen upscale failed for job %s", job_id)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    # "rejected" is an HTTP 200, and its `image` is the original input, unchanged.
+    # Only "succeeded" is an upscale, so nothing else may be saved from this result.
+    if result.status == "rejected":
+        log.info("lumen rejected upscale for job %s: %s", job_id, result.reason)
+        error = result.reason if result.reason in REJECTION_CODES else "provider_failed"
+        fail_job(conn, job_id, error, refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    if result.status == "filtered":
+        log.info("lumen filtered upscale for job %s: %s", job_id, result.reason)
+        fail_job(conn, job_id, "content_filtered", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    if result.status != "succeeded" or result.image is None:
+        log.error("unexpected lumen upscale result for job %s: %s", job_id, result.status)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    output = result.image
+    # One transaction: the library entry and the job's success appear together or not at all.
+    with transaction(conn):
+        save_image(conn, user_id, output.url, output.width, output.height)
+        jobs.transition(conn, job_id, {JobStatus.PENDING}, JobStatus.SUCCEEDED, output_url=output.url)
+    return response_for(jobs.get_job(conn, job_id), locale)
