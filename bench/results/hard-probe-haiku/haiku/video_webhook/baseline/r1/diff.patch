+"""Lumen webhook: completion and failure of asynchronous video jobs."""
+import json
+import logging
+
+from .. import storage
+from ..db import transaction
+from ..features.common import fail_job
+from ..jobs import JobStatus, get_job_by_provider_id, transition
+from .dedup import mark_processed
+from .signing import verify_signature
+
+log = logging.getLogger(__name__)
+
+
+def handle_lumen_webhook(conn, raw_body: bytes, headers: dict, secret: str) -> tuple[int, dict]:
+    """Returns (HTTP status, JSON body). Lumen retries any non-2xx delivery for up to 24 hours."""
+    if not verify_signature(secret, raw_body, headers.get("Lumen-Signature")):
+        return 400, {"error": "invalid signature"}
+
+    event = json.loads(raw_body)
+    if event["type"] not in ("video.completed", "video.failed"):
+        return 200, {"ignored": event["type"]}
+
+    data = event["data"]
+    job = get_job_by_provider_id(conn, data["job_id"])
+    if job is None:
+        # Lumen can deliver before POST /v2/videos has returned and stored the provider id.
+        # A non-2xx response makes Lumen retry later, once the job is recorded.
+        return 404, {"error": "unknown job"}
+
+    # Copy the file before opening the transaction: the copy can be slow, and Lumen's CDN
+    # deletes the file after 24 hours. Re-copying on a redelivery is harmless (the key is
+    # derived from the URL).
+    key = None
+    if event["type"] == "video.completed" and data["videos"]:
+        key = storage.import_remote(data["videos"][0]["url"])
+
+    with transaction(conn):
+        if not mark_processed(conn, "lumen", event["id"]):
+            return 200, {"duplicate": True}
+        if event["type"] == "video.failed":
+            fail_job(conn, job["id"], "provider_failed", refund=True)
+        elif key is not None:
+            if not transition(
+                conn, job["id"], {JobStatus.PENDING, JobStatus.PROCESSING}, JobStatus.SUCCEEDED, output_key=key
+            ):
+                # The sweeper already timed the job out and refunded it; leave it terminal.
+                log.info("lumen video %s completed for job %s in a terminal state", data["job_id"], job["id"])
+        else:
+            # Moderation removed the output after rendering. Lumen does not bill it, so we refund.
+            fail_job(conn, job["id"], "content_filtered", refund=True)
+    return 200, {"ok": True}
diff --git a/tests/test_lumen_webhook.py b/tests/test_lumen_webhook.py
new file mode 100644
index 0000000..bd62570
--- /dev/null
+++ b/tests/test_lumen_webhook.py
@@ -0,0 +1,169 @@
+import json
+from datetime import timedelta
+
+from pixforge import clock, jobs, storage
+from pixforge.billing import get_balance
+from pixforge.features.video import start_video
+from pixforge.jobs import JobStatus, get_job
+from pixforge.sweeper import expire_stale_jobs
+from pixforge.webhooks.lumen import handle_lumen_webhook
+from pixforge.webhooks.signing import sign
+
+CALLBACK = "https://pixforge.test/hooks/lumen"
+SECRET = "whsec_lumen"
+VIDEO_URL = "https://cdn.lumen.test/o/vid_1.mp4"
+
+
+def _start(conn, lumen, user_id):
+    """Start a video job through the real feature. Returns (job_id, provider job id)."""
+    job_id = start_video(conn, lumen, user_id, "a cat surfing", "req-1", CALLBACK)["job_id"]
+    return job_id, get_job(conn, job_id)["provider_job_id"]
+
+
+def _event(event_type, provider_job_id, event_id="evt_1", **data):
+    return {
+        "id": event_id,
+        "type": event_type,
+        "created": int(clock.now().timestamp()),
+        "data": {"job_id": provider_job_id, **data},
+    }
+
+
+def _completed(provider_job_id, event_id="evt_1", url=VIDEO_URL):
+    return _event("video.completed", provider_job_id, event_id, videos=[{"url": url, "duration_s": 5}], moderation=None)
+
+
+def _failed(provider_job_id, event_id="evt_1"):
+    return _event("video.failed", provider_job_id, event_id, error={"code": "render_error", "message": "boom"})
+
+
+def _deliver(conn, event, *, secret=SECRET, timestamp=None):
+    body = json.dumps(event).encode()
+    ts = int(clock.now().timestamp()) if timestamp is None else timestamp
+    headers = {"Lumen-Signature": sign(secret, body, ts)}
+    return handle_lumen_webhook(conn, body, headers, SECRET)
+
+
+def test_completed_marks_succeeded_and_attaches_video(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+
+    status, body = _deliver(conn, _completed(provider_id))
+
+    assert (status, body) == (200, {"ok": True})
+    job = get_job(conn, job_id)
+    assert job["status"] == JobStatus.SUCCEEDED
+    assert job["output_key"] == storage.import_remote(VIDEO_URL)
+    assert job["output_key"].endswith(".mp4")
+    assert storage.backend.exists(job["output_key"])
+    assert get_balance(conn, user_id) == 80
+
+
+def test_failed_marks_failed_and_refunds(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+    assert get_balance(conn, user_id) == 80
+
+    status, body = _deliver(conn, _failed(provider_id))
+
+    assert (status, body) == (200, {"ok": True})
+    job = get_job(conn, job_id)
+    assert job["status"] == JobStatus.FAILED
+    assert job["error"] == "provider_failed"
+    assert job["output_key"] is None
+    assert get_balance(conn, user_id) == 100
+
+
+def test_moderated_completion_fails_and_refunds(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+    event = _event("video.completed", provider_id, videos=[], moderation={"reason": "policy"})
+
+    status, _ = _deliver(conn, event)
+
+    assert status == 200
+    job = get_job(conn, job_id)
+    assert job["status"] == JobStatus.FAILED
+    assert job["error"] == "content_filtered"
+    assert job["output_key"] is None
+    assert get_balance(conn, user_id) == 100
+
+
+def test_progress_is_acknowledged_and_ignored(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+    event = _event("video.progress", provider_id, progress=0.4)
+
+    status, body = _deliver(conn, event)
+
+    assert (status, body) == (200, {"ignored": "video.progress"})
+    assert get_job(conn, job_id)["status"] == JobStatus.PROCESSING
+
+
+def test_duplicate_delivery_is_applied_once(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+    _deliver(conn, _failed(provider_id, event_id="evt_dup"))
+
+    status, body = _deliver(conn, _failed(provider_id, event_id="evt_dup"))
+
+    assert (status, body) == (200, {"duplicate": True})
+    assert get_job(conn, job_id)["status"] == JobStatus.FAILED
+    assert get_balance(conn, user_id) == 100
+
+
+def test_failure_after_success_does_not_refund(conn, lumen, user_id):
+    # Lumen does not guarantee ordering, so a late video.failed must not undo a success.
+    job_id, provider_id = _start(conn, lumen, user_id)
+    _deliver(conn, _completed(provider_id, event_id="evt_1"))
+
+    status, _ = _deliver(conn, _failed(provider_id, event_id="evt_2"))
+
+    assert status == 200
+    assert get_job(conn, job_id)["status"] == JobStatus.SUCCEEDED
+    assert get_balance(conn, user_id) == 80
+
+
+def test_completion_after_timeout_does_not_resurrect_job(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+    clock.set_now(clock.now() + timedelta(minutes=31))
+    assert expire_stale_jobs(conn) == 1
+
+    status, _ = _deliver(conn, _completed(provider_id))
+
+    assert status == 200
+    job = get_job(conn, job_id)
+    assert job["status"] == JobStatus.TIMED_OUT
+    assert job["output_key"] is None
+    assert get_balance(conn, user_id) == 100
+
+
+def test_event_before_provider_id_is_retried(conn, user_id):
+    # The webhook can beat start_video to the point where it records provider_job_id.
+    job_id = jobs.create_job(conn, user_id, "video", "req-race", 20)
+
+    status, body = _deliver(conn, _completed("vid_race"))
+    assert (status, body) == (404, {"error": "unknown job"})
+    assert get_job(conn, job_id)["status"] == JobStatus.PENDING
+
+    jobs.transition(conn, job_id, {JobStatus.PENDING}, JobStatus.PROCESSING, provider_job_id="vid_race")
+    status, body = _deliver(conn, _completed("vid_race"))
+
+    assert (status, body) == (200, {"ok": True})
+    assert get_job(conn, job_id)["status"] == JobStatus.SUCCEEDED
+
+
+def test_bad_signature_is_rejected(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+
+    status, body = _deliver(conn, _failed(provider_id), secret="wrong")
+
+    assert (status, body) == (400, {"error": "invalid signature"})
+    assert get_job(conn, job_id)["status"] == JobStatus.PROCESSING
+    assert get_balance(conn, user_id) == 80
+
+
+def test_stale_signature_is_rejected(conn, lumen, user_id):
+    job_id, provider_id = _start(conn, lumen, user_id)
+    ten_minutes_ago = int((clock.now() - timedelta(minutes=10)).timestamp())
+
+    status, _ = _deliver(conn, _failed(provider_id), timestamp=ten_minutes_ago)
+
+    assert status == 400
+    assert get_job(conn, job_id)["status"] == JobStatus.PROCESSING
+    assert get_balance(conn, user_id) == 80
