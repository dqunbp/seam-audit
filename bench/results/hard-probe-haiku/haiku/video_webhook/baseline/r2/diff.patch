diff --git a/pixforge/webhooks/lumen.py b/pixforge/webhooks/lumen.py
new file mode 100644
index 0000000..14abc86
--- /dev/null
+++ b/pixforge/webhooks/lumen.py
@@ -0,0 +1,73 @@
+"""Lumen webhook: finishes the asynchronous video jobs started by `start_video`."""
+import json
+import logging
+
+from .. import jobs, storage
+from ..db import transaction
+from ..features.common import fail_job
+from ..jobs import JobStatus
+from .dedup import mark_processed
+from .signing import verify_signature
+
+log = logging.getLogger(__name__)
+
+SOURCE = "lumen"
+
+
+def handle_lumen_webhook(conn, raw_body: bytes, headers: dict, secret: str) -> tuple[int, dict]:
+    """Returns (HTTP status, JSON body). Lumen retries any non-2xx delivery for up to 24 hours."""
+    if not verify_signature(secret, raw_body, _header(headers, "Lumen-Signature")):
+        return 400, {"error": "invalid signature"}
+
+    try:
+        event = json.loads(raw_body)
+        event_id, event_type = event["id"], event["type"]
+        data = event["data"]
+        provider_job_id = data["job_id"]
+    except (ValueError, KeyError, TypeError):
+        return 400, {"error": "malformed event"}
+
+    if event_type not in ("video.completed", "video.failed"):
+        # video.progress and unknown types don't change any job.
+        return 200, {"ignored": event_type}
+
+    job = jobs.get_job_by_provider_id(conn, provider_job_id)
+    if job is None:
+        # Lumen can deliver before start_video has stored provider_job_id. A non-2xx makes it retry.
+        return 503, {"error": "job not registered yet"}
+
+    videos = []
+    if event_type == "video.completed":
+        videos = data.get("videos") or []
+    output_key = None
+    if videos and job["status"] == JobStatus.PROCESSING:
+        # Lumen deletes its copy after 24 hours, so keep our own. This runs before the write
+        # transaction; the key is derived from the URL, so a retry after a failed write is harmless.
+        output_key = storage.import_remote(videos[0]["url"])
+
+    with transaction(conn):
+        if not mark_processed(conn, SOURCE, event_id):
+            return 200, {"duplicate": True}
+        if event_type == "video.failed":
+            moved = fail_job(conn, job["id"], "provider_failed", refund=True)
+        elif not videos:
+            # Moderation removed the output after rendering. Lumen does not bill for it, so we refund.
+            moved = fail_job(conn, job["id"], "content_filtered", refund=True)
+        else:
+            moved = jobs.transition(
+                conn, job["id"], {JobStatus.PROCESSING}, JobStatus.SUCCEEDED, output_key=output_key
+            )
+
+    if not moved:
+        # Late or out-of-order event: the job already reached a terminal state (e.g. timed out and refunded).
+        log.warning("lumen %s for job %s not applied: job is %s", event_type, job["id"], job["status"])
+    return 200, {"ok": True}
+
+
+def _header(headers: dict, name: str) -> str | None:
+    """Header names are case-insensitive, and frameworks disagree on their casing."""
+    wanted = name.lower()
+    for key, value in headers.items():
+        if key.lower() == wanted:
+            return value
+    return None
diff --git a/tests/test_lumen_webhook.py b/tests/test_lumen_webhook.py
new file mode 100644
index 0000000..83123a0
--- /dev/null
+++ b/tests/test_lumen_webhook.py
@@ -0,0 +1,195 @@
+import json
+from datetime import timedelta
+
+import pytest
+
+from pixforge import clock, storage
+from pixforge.billing import get_balance
+from pixforge.features.common import response_for
+from pixforge.features.video import start_video
+from pixforge.jobs import get_job, get_job_by_provider_id
+from pixforge.sweeper import expire_stale_jobs
+from pixforge.webhooks.lumen import handle_lumen_webhook
+from pixforge.webhooks.signing import sign
+
+SECRET = "whsec_lumen"
+CALLBACK = "https://pixforge.test/hooks/lumen"
+CDN_URL = "https://cdn.lumen.ai/o/77a.mp4"
+
+
+@pytest.fixture
+def provider_id(conn, lumen, user_id):
+    """The Lumen id of a video job that start_video has left rendering."""
+    job_id = start_video(conn, lumen, user_id, "a cat surfing", "req-1", CALLBACK)["job_id"]
+    return get_job(conn, job_id)["provider_job_id"]
+
+
+def _event(event_type: str, data: dict, event_id: str = "evt_1") -> dict:
+    return {"id": event_id, "type": event_type, "created": 1772366400, "data": data}
+
+
+def _completed(provider_id: str, event_id: str = "evt_1") -> dict:
+    return _event(
+        "video.completed",
+        {"job_id": provider_id, "videos": [{"url": CDN_URL, "duration_s": 5}], "moderation": None},
+        event_id,
+    )
+
+
+def _failed(provider_id: str, event_id: str = "evt_1") -> dict:
+    return _event("video.failed", {"job_id": provider_id, "error": {"code": "render_error", "message": "x"}}, event_id)
+
+
+def _deliver(conn, event: dict, *, secret: str = SECRET, timestamp: int | None = None):
+    body = json.dumps(event).encode()
+    ts = int(clock.now().timestamp()) if timestamp is None else timestamp
+    return handle_lumen_webhook(conn, body, {"Lumen-Signature": sign(secret, body, ts)}, SECRET)
+
+
+def _job(conn, provider_id):
+    return get_job_by_provider_id(conn, provider_id)
+
+
+def _processed_count(conn) -> int:
+    return conn.execute("SELECT COUNT(*) FROM processed_events").fetchone()[0]
+
+
+def test_completed_attaches_the_video_to_the_job(conn, user_id, provider_id):
+    status, body = _deliver(conn, _completed(provider_id))
+
+    assert (status, body) == (200, {"ok": True})
+    job = _job(conn, provider_id)
+    assert job["status"] == "succeeded"
+    assert job["output_key"].endswith(".mp4")
+    assert storage.backend.objects[job["output_key"]] == CDN_URL
+    assert response_for(job, "en")["url"] == storage.public_url(job["output_key"])
+    assert get_balance(conn, user_id) == 80
+
+
+def test_failed_marks_the_job_failed_and_refunds(conn, user_id, provider_id):
+    status, body = _deliver(conn, _failed(provider_id))
+
+    assert (status, body) == (200, {"ok": True})
+    job = _job(conn, provider_id)
+    assert job["status"] == "failed"
+    assert job["error"] == "provider_failed"
+    assert job["output_key"] is None
+    assert get_balance(conn, user_id) == 100
+
+
+def test_moderated_output_is_failed_and_refunded(conn, user_id, provider_id):
+    event = _event("video.completed", {"job_id": provider_id, "videos": [], "moderation": {"reason": "policy"}})
+
+    status, _ = _deliver(conn, event)
+
+    assert status == 200
+    job = _job(conn, provider_id)
+    assert job["status"] == "failed"
+    assert job["error"] == "content_filtered"
+    assert storage.backend.objects == {}
+    assert get_balance(conn, user_id) == 100
+
+
+def test_duplicate_completed_is_applied_once(conn, provider_id):
+    _deliver(conn, _completed(provider_id))
+    first_key = _job(conn, provider_id)["output_key"]
+
+    status, body = _deliver(conn, _completed(provider_id))
+
+    assert (status, body) == (200, {"duplicate": True})
+    assert _job(conn, provider_id)["output_key"] == first_key
+
+
+def test_duplicate_failed_refunds_only_once(conn, user_id, provider_id):
+    _deliver(conn, _failed(provider_id))
+
+    status, body = _deliver(conn, _failed(provider_id))
+
+    assert (status, body) == (200, {"duplicate": True})
+    assert get_balance(conn, user_id) == 100
+
+
+def test_failure_after_success_does_not_refund(conn, user_id, provider_id):
+    _deliver(conn, _completed(provider_id, event_id="evt_1"))
+
+    status, _ = _deliver(conn, _failed(provider_id, event_id="evt_2"))
+
+    assert status == 200
+    assert _job(conn, provider_id)["status"] == "succeeded"
+    assert get_balance(conn, user_id) == 80
+
+
+def test_progress_changes_nothing(conn, user_id, provider_id):
+    status, body = _deliver(conn, _event("video.progress", {"job_id": provider_id, "progress": 0.4}))
+
+    assert (status, body) == (200, {"ignored": "video.progress"})
+    assert _job(conn, provider_id)["status"] == "processing"
+    assert get_balance(conn, user_id) == 80
+
+
+def test_unknown_event_type_is_ignored(conn, provider_id):
+    status, body = _deliver(conn, _event("video.something_new", {"job_id": provider_id}))
+
+    assert (status, body) == (200, {"ignored": "video.something_new"})
+
+
+def test_event_before_job_is_registered_asks_for_retry(conn, provider_id):
+    status, _ = _deliver(conn, _completed("vid_not_yet_stored"))
+
+    assert status == 503
+    assert _processed_count(conn) == 0
+
+
+def test_late_completion_after_timeout_is_not_delivered(conn, user_id, provider_id):
+    clock.set_now(clock.now() + timedelta(minutes=31))
+    assert expire_stale_jobs(conn) == 1
+
+    status, _ = _deliver(conn, _completed(provider_id))
+
+    assert status == 200
+    job = _job(conn, provider_id)
+    assert job["status"] == "timed_out"
+    assert job["output_key"] is None
+    assert storage.backend.objects == {}
+    assert get_balance(conn, user_id) == 100
+
+
+def test_bad_signature_is_rejected(conn, user_id, provider_id):
+    status, body = _deliver(conn, _completed(provider_id), secret="wrong")
+
+    assert (status, body) == (400, {"error": "invalid signature"})
+    assert _job(conn, provider_id)["status"] == "processing"
+
+
+def test_stale_timestamp_is_rejected(conn, provider_id):
+    status, _ = _deliver(conn, _completed(provider_id), timestamp=int(clock.now().timestamp()) - 301)
+
+    assert status == 400
+    assert _job(conn, provider_id)["status"] == "processing"
+
+
+def test_missing_signature_is_rejected(conn, provider_id):
+    body = json.dumps(_completed(provider_id)).encode()
+
+    status, _ = handle_lumen_webhook(conn, body, {}, SECRET)
+
+    assert status == 400
+
+
+def test_signature_header_name_is_case_insensitive(conn, provider_id):
+    body = json.dumps(_completed(provider_id)).encode()
+    ts = int(clock.now().timestamp())
+
+    status, _ = handle_lumen_webhook(conn, body, {"lumen-signature": sign(SECRET, body, ts)}, SECRET)
+
+    assert status == 200
+    assert _job(conn, provider_id)["status"] == "succeeded"
+
+
+def test_malformed_body_with_valid_signature_is_rejected(conn, provider_id):
+    body = b"not json"
+    ts = int(clock.now().timestamp())
+
+    status, body_out = handle_lumen_webhook(conn, body, {"Lumen-Signature": sign(SECRET, body, ts)}, SECRET)
+
+    assert (status, body_out) == (400, {"error": "malformed event"})
