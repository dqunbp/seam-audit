diff --git a/tests/test_upscale.py b/tests/test_upscale.py
new file mode 100644
index 0000000..d5042d0
--- /dev/null
+++ b/tests/test_upscale.py
@@ -0,0 +1,125 @@
+from lumen_sdk import LumenAPIError, LumenRateLimited
+
+from pixforge.billing import get_balance
+from pixforge.features.upscale import upscale_image
+from pixforge.images import list_images, save_image
+from pixforge.jobs import get_job
+from pixforge.pricing import price_for
+from pixforge.users import create_user
+
+
+def _source_image(conn, user_id, storage_key="media/source.png"):
+    return save_image(conn, user_id, storage_key, 1024, 1024)
+
+
+def test_upscales_charges_and_adds_to_library(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["ok"]
+    assert response["status"] == "succeeded"
+    assert response["url"].startswith("https://media.pixforge.test/")
+    assert get_balance(conn, user_id) == 96
+    images = list_images(conn, user_id)
+    assert len(images) == 2
+    assert (images[1]["width"], images[1]["height"]) == (2048, 2048)
+
+
+def test_job_records_source_image(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    job = get_job(conn, response["job_id"])
+    assert job["kind"] == "upscale"
+    assert job["source_image_id"] == source_id
+    assert job["cost"] == 4
+
+
+def test_sends_source_image_url_to_lumen(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id, storage_key="media/source.png")
+    upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert len(lumen.calls) == 1
+    assert lumen.calls[0][0] == "upscale"
+    assert lumen.calls[0][1].startswith("https://media.pixforge.test/media/source.png?")
+
+
+def test_pro_pays_half(conn, lumen, pro_user_id):
+    source_id = _source_image(conn, pro_user_id)
+    upscale_image(conn, lumen, pro_user_id, source_id, "req-1")
+    assert get_balance(conn, pro_user_id) == 98
+
+
+def test_price_follows_standard_rules():
+    assert price_for("upscale", "free") == 4
+    assert price_for("upscale", "pro") == 2
+
+
+def test_retry_with_same_request_id_is_not_charged_twice(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id)
+    first = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    second = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert second == first
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+    assert len(list_images(conn, user_id)) == 2
+
+
+def test_rejected_input_is_refunded_and_not_added_to_library(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id)
+    lumen.upscale_next_status = "rejected"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "upscale_rejected"
+    assert get_balance(conn, user_id) == 100
+    # Lumen echoes the input back on rejection; it must not become a new library image.
+    assert [img["id"] for img in list_images(conn, user_id)] == [source_id]
+
+
+def test_filtered_result_is_refunded(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id)
+    lumen.upscale_next_status = "filtered"
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_provider_error_is_refunded(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id)
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_rate_limited_is_refunded(conn, lumen, user_id):
+    source_id = _source_image(conn, user_id)
+    lumen.fail_with = LumenRateLimited(5)
+    response = upscale_image(conn, lumen, user_id, source_id, "req-1")
+    assert response["error_code"] == "rate_limited"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_insufficient_credits_does_not_call_provider(conn, lumen):
+    poor = create_user(conn, "poor@example.com", balance=1)
+    source_id = _source_image(conn, poor)
+    response = upscale_image(conn, lumen, poor, source_id, "req-1", locale="ru")
+    assert response["error_code"] == "insufficient_credits"
+    assert "4" in response["message"]
+    assert lumen.calls == []
+
+
+def test_cannot_upscale_another_users_image(conn, lumen, user_id):
+    owner_image = _source_image(conn, user_id)
+    other = create_user(conn, "other@example.com", balance=100)
+    response = upscale_image(conn, lumen, other, owner_image, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "not_found"
+    assert response["job_id"] is None
+    assert lumen.calls == []
+    assert get_balance(conn, other) == 100
+
+
+def test_unknown_image_is_not_found(conn, lumen, user_id):
+    response = upscale_image(conn, lumen, user_id, 999, "req-1")
+    assert response["error_code"] == "not_found"
+    assert lumen.calls == []
+    assert get_balance(conn, user_id) == 100
