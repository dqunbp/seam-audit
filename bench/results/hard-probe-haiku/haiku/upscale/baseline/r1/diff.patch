+    def upscale(self, image_url: str, factor: int = 2) -> UpscaleResult:
+        self.calls.append(("upscale", image_url))
+        self._maybe_fail()
+        result_id = self._next_id("ups")
+        # The fake assumes a 1024x1024 input, so the output is 2048x2048.
+        input_image = OutputImage(url=image_url, width=1024, height=1024)
+        status, self.upscale_next_status = self.upscale_next_status or "succeeded", None
+        if status == "rejected":
+            return UpscaleResult(id=result_id, status="rejected", image=input_image, reason="input_too_large")
+        if status == "filtered":
+            return UpscaleResult(id=result_id, status="filtered", image=None, reason="policy")
+        output_url = f"https://cdn.lumen.test/{result_id}.png"
+        return UpscaleResult(
+            id=result_id,
+            status="succeeded",
+            image=OutputImage(url=output_url, width=1024 * factor, height=1024 * factor),
