+    def upscale(self, image_url: str, factor: int = 2) -> UpscaleResult:
+        self.calls.append(("upscale", image_url, factor))
+        self._maybe_fail()
+        result_id = self._next_id("ups")
+        if self.reject_next_with is not None:
+            reason, self.reject_next_with = self.reject_next_with, None
+            # Lumen echoes the original input when it rejects it.
+            return UpscaleResult(
+                id=result_id,
+                status="rejected",
+                image=OutputImage(url=image_url, width=0, height=0),
+                reason=reason,
+            )
+        if self.filter_next:
+            self.filter_next = False
+            return UpscaleResult(id=result_id, status="filtered", image=None, reason="policy")
+        return UpscaleResult(
+            id=result_id,
+            status="succeeded",
+            image=OutputImage(url=f"https://cdn.lumen.test/{result_id}.png", width=2048, height=2048),
+        )
