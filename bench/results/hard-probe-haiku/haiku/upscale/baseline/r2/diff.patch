@@ -0,0 +1,95 @@
+"""2x image upscaling."""
+import logging
+
+from lumen_sdk import LumenClient, LumenError, LumenRateLimited
+
+from .. import jobs, storage
+from ..billing import InsufficientCredits, charge_credits
+from ..i18n import t
+from ..images import get_image, save_image
+from ..jobs import JobStatus
+from ..pricing import price_for
+from ..storage import StorageError
+from ..users import get_user
+from .common import fail_job, response_for
+
+log = logging.getLogger(__name__)
+
+FACTOR = 2
+# Lumen does not accept inputs whose longest side is larger than this (docs/lumen_api.md).
+MAX_INPUT_PX = 2048
+# Lumen `rejected` reasons that we show to the user. Any other reason is a provider failure.
+REJECTION_CODES = frozenset({"input_too_large", "unsupported_format"})
+
+
+def upscale_image(conn, client: LumenClient, user_id: int, image_id: int, request_id: str, locale: str = "en") -> dict:
+    """Upscale one of the user's images 2x and add the result to their library.
+
+    Returns the same shape as generate_image.
+    """
+    existing = jobs.get_job_by_request(conn, request_id)
+    if existing is not None:
+        return response_for(existing, locale)
+
+    source = get_image(conn, image_id)
+    # Another user's image is reported as missing, so image ids cannot be probed.
+    if source is None or source["user_id"] != user_id:
+        return _error("not_found", locale)
+    if max(source["width"], source["height"]) > MAX_INPUT_PX:
+        return _error("input_too_large", locale)
+
+    user = get_user(conn, user_id)
+    cost = price_for("upscale", user["plan"])
+    job_id = jobs.create_job(conn, user_id, "upscale", request_id, cost, source_image_id=image_id)
+
+    try:
+        charge_credits(conn, user_id, cost, "upscale", f"charge:upscale:{request_id}")
+    except InsufficientCredits:
+        fail_job(conn, job_id, "insufficient_credits", refund=False)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    try:
+        result = client.upscale(storage.public_url(source["storage_key"]), factor=FACTOR)
+    except LumenRateLimited:
+        fail_job(conn, job_id, "rate_limited", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+    except LumenError:
+        log.exception("lumen upscale failed for job %s", job_id)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    if result.status == "rejected":
+        # `result.image` echoes the original input here, so it must not be saved as the result.
+        log.info("lumen rejected upscale job %s: %s", job_id, result.reason)
+        code = result.reason if result.reason in REJECTION_CODES else "provider_failed"
+        fail_job(conn, job_id, code, refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    if result.status != "succeeded" or result.image is None:
+        log.info("lumen filtered upscale job %s: %s", job_id, result.reason)
+        fail_job(conn, job_id, "content_filtered", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    output = result.image
+    try:
+        key = storage.import_remote(output.url)
+    except StorageError:
+        # Lumen deletes its copy after 24 hours, so a failed copy cannot be retried later.
+        log.exception("could not copy upscale output for job %s", job_id)
+        fail_job(conn, job_id, "provider_failed", refund=True)
+        return response_for(jobs.get_job(conn, job_id), locale)
+
+    save_image(conn, user_id, key, output.width, output.height)
+    jobs.transition(conn, job_id, {JobStatus.PENDING}, JobStatus.SUCCEEDED, output_key=key)
+    return response_for(jobs.get_job(conn, job_id), locale)
+
+
+def _error(code: str, locale: str) -> dict:
+    """An error that happens before any job is created, shaped like generate_image's errors."""
+    return {
+        "ok": False,
+        "job_id": None,
+        "status": None,
+        "error_code": code,
+        "message": t(f"errors.{code}", locale),
+    }
