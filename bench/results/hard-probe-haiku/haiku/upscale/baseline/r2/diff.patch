diff --git a/tests/test_upscale.py b/tests/test_upscale.py
new file mode 100644
index 0000000..28d2746
--- /dev/null
+++ b/tests/test_upscale.py
@@ -0,0 +1,167 @@
+from lumen_sdk import LumenAPIError, LumenRateLimited
+
+from pixforge import storage
+from pixforge.billing import get_balance
+from pixforge.features.upscale import upscale_image
+from pixforge.images import list_images, save_image
+from pixforge.storage import StorageError
+from pixforge.users import create_user
+
+
+def _source(conn, user_id, width=1024, height=1024):
+    return save_image(conn, user_id, "media/source.png", width, height)
+
+
+def _job(conn, request_id):
+    return conn.execute("SELECT * FROM jobs WHERE request_id = ?", (request_id,)).fetchone()
+
+
+def test_upscales_and_charges(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert response["ok"]
+    assert response["status"] == "succeeded"
+    assert response["url"].startswith("https://media.pixforge.test/")
+    assert get_balance(conn, user_id) == 96
+    assert len(list_images(conn, user_id)) == 2
+
+
+def test_result_is_added_to_library_at_2048(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    upscale_image(conn, lumen, user_id, source, "req-1")
+    result = list_images(conn, user_id)[-1]
+    assert (result["width"], result["height"]) == (2048, 2048)
+    assert result["storage_key"] != "media/source.png"
+
+
+def test_job_records_source_image(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    job = _job(conn, "req-1")
+    assert job["kind"] == "upscale"
+    assert job["source_image_id"] == source
+    assert job["cost"] == 4
+    assert response["job_id"] == job["id"]
+
+
+def test_provider_gets_signed_url_of_source(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    upscale_image(conn, lumen, user_id, source, "req-1")
+    assert lumen.calls == [("upscale", storage.public_url("media/source.png"), 2)]
+
+
+def test_pro_pays_half(conn, lumen, pro_user_id):
+    source = _source(conn, pro_user_id)
+    upscale_image(conn, lumen, pro_user_id, source, "req-1")
+    assert get_balance(conn, pro_user_id) == 98
+
+
+def test_retry_with_same_request_id_is_not_charged_twice(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    first = upscale_image(conn, lumen, user_id, source, "req-1")
+    second = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert second == first
+    assert get_balance(conn, user_id) == 96
+    assert len(lumen.calls) == 1
+    assert len(list_images(conn, user_id)) == 2
+
+
+def test_filtered_result_is_refunded(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    lumen.filter_next = True
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "content_filtered"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_rejected_input_is_refunded_and_echo_is_not_saved(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    lumen.reject_next_with = "unsupported_format"
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "unsupported_format"
+    assert response["message"] == "This image format cannot be upscaled."
+    assert get_balance(conn, user_id) == 100
+    # Only the original image is in the library: the echoed input was not saved.
+    assert [row["id"] for row in list_images(conn, user_id)] == [source]
+
+
+def test_unknown_rejection_reason_is_a_provider_failure(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    lumen.reject_next_with = "something_new"
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_provider_error_is_refunded(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    lumen.fail_with = LumenAPIError(500, "internal", "boom")
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_rate_limited_is_refunded(conn, lumen, user_id):
+    source = _source(conn, user_id)
+    lumen.fail_with = LumenRateLimited(5)
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert response["error_code"] == "rate_limited"
+    assert get_balance(conn, user_id) == 100
+
+
+def test_failed_copy_of_output_is_refunded(conn, lumen, user_id, monkeypatch):
+    source = _source(conn, user_id)
+
+    def refuse(url, prefix="media"):
+        raise StorageError("refusing to import")
+
+    monkeypatch.setattr(storage, "import_remote", refuse)
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert response["error_code"] == "provider_failed"
+    assert get_balance(conn, user_id) == 100
+    assert len(list_images(conn, user_id)) == 1
+
+
+def test_source_larger_than_2048_is_rejected_without_charge(conn, lumen, user_id):
+    source = _source(conn, user_id, width=4096, height=1024)
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "input_too_large"
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+    assert _job(conn, "req-1") is None
+
+
+def test_source_of_exactly_2048_is_accepted(conn, lumen, user_id):
+    source = _source(conn, user_id, width=2048, height=2048)
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert response["ok"]
+
+
+def test_other_users_image_is_not_found(conn, lumen, user_id):
+    other = create_user(conn, "other@example.com", balance=100)
+    source = _source(conn, other)
+    response = upscale_image(conn, lumen, user_id, source, "req-1")
+    assert not response["ok"]
+    assert response["error_code"] == "not_found"
+    assert get_balance(conn, user_id) == 100
+    assert lumen.calls == []
+
+
+def test_missing_image_is_not_found(conn, lumen, user_id):
+    response = upscale_image(conn, lumen, user_id, 999, "req-1")
+    assert response["error_code"] == "not_found"
+    assert response["message"] == "Not found."
+    assert lumen.calls == []
+
+
+def test_insufficient_credits_does_not_call_provider(conn, lumen):
+    poor = create_user(conn, "poor@example.com", balance=3)
+    source = _source(conn, poor)
+    response = upscale_image(conn, lumen, poor, source, "req-1", locale="ru")
+    assert response["error_code"] == "insufficient_credits"
+    assert "4" in response["message"]
+    assert lumen.calls == []
