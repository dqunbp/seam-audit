+def extend_order(order: Order, new_date: datetime, force: bool=False, valid_if_pending: bool=None, user: User=None,
+                 auth=None):
+    """
+    Extends the payment deadline of a pending order to ``new_date``. If the order has already expired, it is
+    set back to pending, which fails if there is not enough quota unless ``force`` is set to ``True``.
+    :param new_date: The new payment deadline, which needs to be in the future
+    :param force: Extend the order even if this leads to an overbooked quota
+    :param valid_if_pending: Whether the order should be treated as confirmed regardless of payment. If ``None``,
+                             the current setting is kept.
+    :param user: The user that performed the change
+    """
+    if new_date < now():
+        raise OrderError(_('The new expiry date needs to be in the future.'))
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order.pk)
+        if order.status not in (Order.STATUS_PENDING, Order.STATUS_EXPIRED):
+            raise OrderError(_('This action is only allowed for pending orders.'))
+
+        was_expired = order.status == Order.STATUS_EXPIRED
+        if was_expired:
+            is_available = order._is_still_available(now(), count_waitinglist=False, check_voucher_usage=True,
+                                                     check_memberships=True, lock=True, force=force)
+            if is_available is not True:
+                raise OrderError(is_available)
+            order.status = Order.STATUS_PENDING
+
+        order.expires = new_date
+        if valid_if_pending is not None:
+            order.valid_if_pending = valid_if_pending
+        order.save(update_fields=['expires', 'status', 'valid_if_pending'])
+        order.log_action(
+            'pretix.event.order.expirychanged',
+            user=user,
+            auth=auth,
+            data={
+                'expires': order.expires,
+                'valid_if_pending': order.valid_if_pending,
+            }
+        )
+        order.create_transactions()
+
+    if was_expired:
+        order_reactivated.send(order.event, order=order)
+
+        num_invoices = order.invoices.filter(is_cancellation=False).count()
+        if num_invoices > 0 and order.invoices.filter(is_cancellation=True).count() >= num_invoices and invoice_qualified(order):
+            try:
+                generate_invoice(order)
+            except Exception as e:
+                logger.exception("Could not generate invoice.")
+                order.log_action("pretix.event.order.invoice.failed", data={
+                    "exception": str(e)
+                })
+
+    return order
+
+
