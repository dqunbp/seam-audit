+class OrderExtendTest(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(organizer=self.o, name='Dummy', slug='dummy', date_from=now(),
+                                              plugins='tests.testdummy')
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now(), expires=now() + timedelta(days=1),
+                total=Decimal('23.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Early-bird ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            self.quota = self.event.quotas.create(name='Test', size=None)
+            self.quota.items.add(self.ticket)
+            generate_invoice(self.order)
+            self.order.create_transactions()
+            djmail.outbox = []
+
+    @classscope(attr='o')
+    def test_extend_pending(self):
+        new_date = now() + timedelta(days=10)
+        extend_order(self.order, new_date=new_date)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.expires == new_date
+        assert self.order.all_logentries().first().action_type == 'pretix.event.order.expirychanged'
+        assert self.order.invoices.count() == 1
+
+    @classscope(attr='o')
+    def test_extend_pending_keeps_valid_if_pending_by_default(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        extend_order(self.order, new_date=now() + timedelta(days=10))
+        self.order.refresh_from_db()
+        assert self.order.valid_if_pending is True
+
+    @classscope(attr='o')
+    def test_set_valid_if_pending(self):
+        extend_order(self.order, new_date=now() + timedelta(days=10), valid_if_pending=True)
+        self.order.refresh_from_db()
+        assert self.order.valid_if_pending is True
+        extend_order(self.order, new_date=now() + timedelta(days=10), valid_if_pending=False)
+        self.order.refresh_from_db()
+        assert self.order.valid_if_pending is False
+
+    @classscope(attr='o')
+    def test_extend_expired_makes_pending(self):
+        mark_order_expired(self.order)
+        new_date = now() + timedelta(days=10)
+        extend_order(self.order, new_date=new_date)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.expires == new_date
+        assert self.order.all_logentries().first().action_type == 'pretix.event.order.expirychanged'
+        assert self.order.invoices.count() == 3
+
+    @classscope(attr='o')
+    def test_extend_expired_sold_out(self):
+        mark_order_expired(self.order)
+        self.quota.size = 0
+        self.quota.save()
+        with pytest.raises(OrderError):
+            extend_order(self.order, new_date=now() + timedelta(days=10))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_EXPIRED
+
+    @classscope(attr='o')
+    def test_extend_expired_sold_out_force(self):
+        mark_order_expired(self.order)
+        self.quota.size = 0
+        self.quota.save()
+        extend_order(self.order, new_date=now() + timedelta(days=10), force=True)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_extend_paid_fails(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        with pytest.raises(OrderError):
+            extend_order(self.order, new_date=now() + timedelta(days=10))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+
+    @classscope(attr='o')
+    def test_extend_to_past_date_fails(self):
+        old_expires = self.order.expires
+        with pytest.raises(OrderError):
+            extend_order(self.order, new_date=now() - timedelta(days=1))
+        self.order.refresh_from_db()
+        assert self.order.expires == old_expires
+
