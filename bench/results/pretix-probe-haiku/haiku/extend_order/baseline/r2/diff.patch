+class OrderExtendTest(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(organizer=self.o, name='Dummy', slug='dummy', date_from=now(),
+                                              plugins='tests.testdummy')
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now(), expires=now() + timedelta(days=1),
+                total=Decimal('23.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Early-bird ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.op1 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            self.quota = self.event.quotas.create(name='Test', size=None)
+            self.quota.items.add(self.ticket)
+            self.new_date = now() + timedelta(days=10)
+            djmail.outbox = []
+
+    @classscope(attr='o')
+    def test_pending(self):
+        extend_order(self.order, new_date=self.new_date)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.expires == self.new_date
+        assert self.order.all_logentries().first().action_type == 'pretix.event.order.expirychanged'
+
+    @classscope(attr='o')
+    def test_pending_ignores_quota(self):
+        self.quota.size = 0
+        self.quota.save()
+        extend_order(self.order, new_date=self.new_date)
+        self.order.refresh_from_db()
+        assert self.order.expires == self.new_date
+
+    @classscope(attr='o')
+    def test_paid(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        with pytest.raises(OrderError):
+            extend_order(self.order, new_date=self.new_date)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+
+    @classscope(attr='o')
+    def test_canceled(self):
+        self.order.status = Order.STATUS_CANCELED
+        self.order.save()
+        with pytest.raises(OrderError):
+            extend_order(self.order, new_date=self.new_date)
+
+    @classscope(attr='o')
+    def test_date_in_past(self):
+        with pytest.raises(OrderError):
+            extend_order(self.order, new_date=now() - timedelta(days=1))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_expired_reactivates(self):
+        self.order.status = Order.STATUS_EXPIRED
+        self.order.save()
+        extend_order(self.order, new_date=self.new_date)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.expires == self.new_date
+        assert self.order.all_logentries().first().action_type == 'pretix.event.order.reactivated'
+
+    @classscope(attr='o')
+    def test_expired_sold_out(self):
+        self.order.status = Order.STATUS_EXPIRED
+        self.order.save()
+        self.quota.size = 0
+        self.quota.save()
+        with pytest.raises(OrderError):
+            extend_order(self.order, new_date=self.new_date)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_EXPIRED
+
+    @classscope(attr='o')
+    def test_expired_sold_out_force(self):
+        self.order.status = Order.STATUS_EXPIRED
+        self.order.save()
+        self.quota.size = 0
+        self.quota.save()
