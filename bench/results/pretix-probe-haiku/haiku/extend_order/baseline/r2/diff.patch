+        assert self.order.expires == self.new_date
+
+    @classscope(attr='o')
+    def test_expired_regenerates_invoice(self):
+        generate_invoice(self.order)
+        mark_order_expired(self.order)
+        assert self.order.invoices.count() == 2
+        extend_order(self.order, new_date=self.new_date)
