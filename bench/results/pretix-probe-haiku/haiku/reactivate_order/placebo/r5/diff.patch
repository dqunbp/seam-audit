+def reactivate_order(order: Order, force: bool=False, user: User=None, auth=None):
+    """
+    Reverses the cancellation of a canceled order. The order is set back to pending, or to paid if its
+    payments already cover the total. Unless ``force`` is set to ``True``, the ordered products have to
+    be still available.
+    """
+    with transaction.atomic():
+        if isinstance(order, int):
+            order = Order.objects.select_for_update(of=OF_SELF).get(pk=order)
+        if isinstance(user, int):
+            user = User.objects.get(pk=user)
+        if order.status != Order.STATUS_CANCELED:
+            raise OrderError(_('This order is not canceled.'))
+
+        if not force:
+            is_available = order._is_still_available(now(), count_waitinglist=False, lock=True, check_voucher_usage=True)
+            if is_available is not True:
+                raise OrderError(is_available)
+
+        for position in order.positions.all():
+            for gc in position.issued_gift_cards.all():
+                gc = GiftCard.objects.select_for_update(of=OF_SELF).get(pk=gc.pk)
+                gc.transactions.create(value=position.price, order=order, acceptor=order.event.organizer)
+                gc.log_action(
+                    action='pretix.giftcards.transaction.manual',
+                    user=user,
+                    data={
+                        'value': position.price,
+                        'acceptor_id': order.event.organizer.id,
+                        'acceptor_slug': order.event.organizer.slug
+                    }
+                )
+
+            for m in position.granted_memberships.all():
+                m.canceled = False
+                m.save()
+
+            if position.voucher:
+                Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=F('redeemed') + 1)
+
+        order.cancellation_date = None
+        update_fields = ['status', 'cancellation_date']
+        if order.payment_refund_sum >= order.total:
+            order.status = Order.STATUS_PAID
+        else:
+            order.status = Order.STATUS_PENDING
+            order.set_expires(now(), order.event.subevents.filter(id__in=[p.subevent_id for p in order.positions.all()]))
+            update_fields.append('expires')
+        order.save(update_fields=update_fields)
+
+        num_invoices = order.invoices.filter(is_cancellation=False).count()
+        if num_invoices > 0 and order.invoices.filter(is_cancellation=True).count() >= num_invoices and invoice_qualified(order):
+            try:
+                generate_invoice(order)
+            except Exception as e:
+                logger.exception("Could not generate invoice.")
+                order.log_action("pretix.event.order.invoice.failed", data={
+                    "exception": str(e)
+                })
+
+        order.log_action('pretix.event.order.reactivated', user=user, auth=auth)
+        order.create_transactions()
+
+    order_reactivated.send(order.event, order=order)
+    return order.pk
+
+
