+def _make_order_with_quota(event, quota_size=10):
+    ticket = Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+    quota = event.quotas.create(name='Tickets', size=quota_size)
+    quota.items.add(ticket)
+    order = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=Decimal('23.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    op = OrderPosition.objects.create(
+        order=order, item=ticket, variation=None,
+        price=Decimal('23.00'), attendee_name_parts={'full_name': 'Peter'}, positionid=1
+    )
+    order.create_transactions()
+    return order, op, quota
+
+
+@pytest.mark.django_db
+def test_reactivate_canceled_unpaid_order(event):
+    order, op, quota = _make_order_with_quota(event)
+    cancel_order(order.pk, send_mail=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+
+    reactivate_order(order, user=None)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.cancellation_date is None
+    assert order.expires > now()
+    assert order.all_logentries().filter(action_type='pretix.event.order.reactivated').exists()
+
+    # Transactions must already be in sync with the order, so re-running the reconciliation changes nothing
+    n = order.transactions.count()
+    order.create_transactions()
+    assert order.transactions.count() == n
+
+
+@pytest.mark.django_db
+def test_reactivate_canceled_paid_order(event):
+    order, op, quota = _make_order_with_quota(event)
+    order.status = Order.STATUS_PAID
+    order.save()
+    order.payments.create(state=OrderPayment.PAYMENT_STATE_CONFIRMED, amount=Decimal('23.00'))
+    cancel_order(order.pk, send_mail=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+
+    reactivate_order(order)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PAID
+    assert order.cancellation_date is None
+
+
+@pytest.mark.django_db
+def test_reactivate_requires_canceled_order(event):
+    order, op, quota = _make_order_with_quota(event)
+    with pytest.raises(OrderError):
+        reactivate_order(order)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+
+
+@pytest.mark.django_db
+def test_reactivate_unavailable_product(event):
+    order, op, quota = _make_order_with_quota(event)
+    cancel_order(order.pk, send_mail=False)
+    quota.size = 0
+    quota.save()
+
+    with pytest.raises(OrderError):
+        reactivate_order(order)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+
+
+@pytest.mark.django_db
+def test_reactivate_unavailable_product_forced(event):
+    order, op, quota = _make_order_with_quota(event)
+    cancel_order(order.pk, send_mail=False)
+    quota.size = 0
+    quota.save()
+
+    reactivate_order(order, force=True)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+
+
+@pytest.mark.django_db
+def test_reactivate_restores_voucher_redemption(event):
+    order, op, quota = _make_order_with_quota(event)
+    voucher = event.vouchers.create(item=op.item, max_usages=1, redeemed=1)
+    op.voucher = voucher
+    op.save()
+
+    cancel_order(order.pk, send_mail=False)
+    voucher.refresh_from_db()
+    assert voucher.redeemed == 0
+
+    reactivate_order(order)
+    voucher.refresh_from_db()
+    assert voucher.redeemed == 1
+
+
+@pytest.mark.django_db
+def test_reactivate_restores_issued_gift_card(event):
+    order, op, quota = _make_order_with_quota(event)
+    gc = event.organizer.issued_gift_cards.create(currency="EUR", issued_in=op)
+    gc.transactions.create(value=Decimal('23.00'), order=order, acceptor=event.organizer)
+    assert gc.value == Decimal('23.00')
+
+    cancel_order(order.pk, send_mail=False)
+    gc.refresh_from_db()
+    assert gc.value == Decimal('0.00')
+
+    reactivate_order(order)
+    gc.refresh_from_db()
+    assert gc.value == Decimal('23.00')
+
