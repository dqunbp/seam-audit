+def _download_order(event, status=Order.STATUS_PAID, attendee_email=None, subevent=None, code='DL1'):
+    order = Order.objects.create(
+        code=code, event=event, email='customer@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=Decimal('23.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    item = Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+    OrderPosition.objects.create(
+        order=order, item=item, variation=None, price=Decimal('23.00'),
+        attendee_name_parts={'full_name': 'Peter'}, positionid=1,
+        attendee_email=attendee_email, subevent=subevent,
+    )
+    return order
+
+
+@pytest.mark.django_db
+def test_download_reminder_disabled(download_event):
+    o = _download_order(download_event)
+    send_download_reminders(sender=download_event)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert not o.download_reminder_sent
+
