+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    event_id = None
+    days = None
+    settings = None
+
+    qs = Order.objects.filter(
+        download_reminder_sent=False,
+        status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+    ).filter(
+        Q(event__has_subevents=False, event__date_from__gt=now()) |
+        Q(event__has_subevents=True, all_positions__subevent__date_from__gt=now())
+    ).select_related('event', 'sales_channel').distinct().order_by('event_id')
+
+    for o in qs:
+        if event_id != o.event_id:
+            settings = o.event.settings
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None or o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder:
+            continue
+
+        if not o.ticket_download_available:
+            continue
+
+        # The reminder is sent on the day that is ``days`` before the start of the (first) event date of this order,
+        # as seen in the event's timezone, and only as long as the event has not started yet.
+        if o.event.has_subevents:
+            start = o.positions.aggregate(d=Min('subevent__date_from'))['d']
+        else:
+            start = o.event.date_from
+        if start is None or start <= now():
+            continue
+
+        tz = o.event.timezone
+        if now().astimezone(tz).date() < start.astimezone(tz).date() - timedelta(days=days):
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.download_reminder_sent or not o.ticket_download_available:
+                # Race condition
+                continue
+
+            with language(o.locale, settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    settings.mail_subject_download_reminder, settings.mail_text_download_reminder, email_context,
+                    'pretix.event.order.email.download_reminder_sent',
+                )
+
+                if settings.mail_send_download_reminder_attendee:
+                    for op in o.positions.all():
+                        if not op.attendee_email or op.attendee_email == o.email:
+                            continue
+                        email_context = get_email_context(event=o.event, order=o, position=op)
+                        o.send_mail(
+                            settings.mail_subject_download_reminder_attendee,
+                            settings.mail_text_download_reminder_attendee, email_context,
+                            'pretix.event.order.email.download_reminder_sent', position=op,
+                        )
+
+
