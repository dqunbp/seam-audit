+@pytest.mark.django_db
+def test_series_event_uses_subevent_date(event, order):
+    event.has_subevents = True
+    event.save()
+    se = SubEvent.objects.create(
+        event=event, name='Date', active=True,
+        date_from=now() + timedelta(days=1),
+    )
+    OrderPosition.objects.filter(order=order).update(subevent=se)
+    event.settings.mail_days_download_reminder = 2
+    send_download_reminders(sender=event)
+    order.refresh_from_db()
+    assert len(djmail.outbox) == 1
+    assert order.download_reminder_sent
