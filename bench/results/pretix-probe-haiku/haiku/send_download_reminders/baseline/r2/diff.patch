+def _download_reminder_date(order: Order, days: int):
+    if order.event.has_subevents:
+        event_start = order.event.subevents.filter(
+            id__in=order.positions.values_list('subevent', flat=True)
+        ).aggregate(d=Min('date_from'))['d']
+    else:
+        event_start = order.event.date_from
+    if event_start is None:
+        return None
+    tz = order.event.timezone
+    return make_aware(datetime.combine(localtime(event_start, tz).date() - timedelta(days=days), time.min), tz)
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    event_id = None
+    event_settings = None
+    days = None
+
+    # Only consider events that have not ended yet. Otherwise, orders of past events that never received a
+    # reminder (e.g. because the setting was empty) would be checked over and over again.
+    upcoming_subevent = SubEvent.objects.filter(event_id=OuterRef('event_id')).filter(
+        Q(date_to__gte=now()) | Q(date_from__gte=now())
+    )
+    qs = Order.objects.filter(
+        status=Order.STATUS_PAID, download_reminder_sent=False,
+    ).filter(
+        Q(event__date_to__gte=now()) | Q(event__date_from__gte=now()) | Exists(upcoming_subevent)
+    ).select_related('event', 'sales_channel').order_by('event_id')
+
+    for o in qs:
+        if event_id != o.event_id:
+            event_settings = o.event.settings
+            days = event_settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None:
+            continue
+        if o.sales_channel.identifier not in event_settings.mail_sales_channel_download_reminder:
+            continue
+        reminder_date = _download_reminder_date(o, days)
+        if reminder_date is None or now() < reminder_date:
+            continue
+        if not o.ticket_download_available:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                # Race condition
+                continue
+
+            with language(o.locale, event_settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    event_settings.mail_subject_download_reminder,
+                    event_settings.mail_text_download_reminder,
+                    email_context,
+                    'pretix.event.order.email.download_reminder_sent'
+                )
+
+                if event_settings.mail_send_download_reminder_attendee:
+                    for p in o.positions.all():
+                        if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                            p.send_mail(
+                                event_settings.mail_subject_download_reminder_attendee,
+                                event_settings.mail_text_download_reminder_attendee,
+                                get_email_context(event=o.event, order=o, position=p),
+                                'pretix.event.order.email.download_reminder_sent'
+                            )
+
+
