+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import Event, Item, Order, OrderPosition, Organizer
+from pretix.base.models.event import SubEvent
+from pretix.base.services.orders import send_download_reminders
+
+
+@pytest.fixture
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now() + timedelta(days=1),
+        plugins='pretix.plugins.banktransfer'
+    )
+    event.settings.ticket_download = True
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def order(event):
+    with scope(organizer=event.organizer):
+        o = Order.objects.create(
+            code='FOO', event=event, email='dummy@dummy.test',
+            status=Order.STATUS_PAID, locale='en',
+            datetime=now(), expires=now() + timedelta(days=10),
+            total=Decimal('23.00'),
+            sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        )
+        item = Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+        OrderPosition.objects.create(
+            order=o, item=item, variation=None, price=Decimal("23.00"),
+            attendee_name_parts={'full_name': "Peter"}, positionid=1
+        )
+        return o
+
+
+@pytest.fixture(autouse=True)
+def clear_outbox():
+    djmail.outbox = []
+
+
+@pytest.mark.django_db
+def test_disabled_by_default(event, order):
+    send_download_reminders(sender=event)
+    order.refresh_from_db()
+    assert len(djmail.outbox) == 0
+    assert not order.download_reminder_sent
+
+
+@pytest.mark.django_db
+def test_sent_once(event, order):
+    event.settings.mail_days_download_reminder = 2
+    send_download_reminders(sender=event)
+    order.refresh_from_db()
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert order.download_reminder_sent
+
+    send_download_reminders(sender=event)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_not_before_reminder_date(event, order):
+    event.date_from = now() + timedelta(days=30)
+    event.save()
+    event.settings.mail_days_download_reminder = 2
+    send_download_reminders(sender=event)
+    order.refresh_from_db()
+    assert len(djmail.outbox) == 0
+    assert not order.download_reminder_sent
+
+
+@pytest.mark.django_db
+def test_skip_unpaid_order(event, order):
+    event.settings.mail_days_download_reminder = 2
+    order.status = Order.STATUS_PENDING
+    order.save()
+    send_download_reminders(sender=event)
+    order.refresh_from_db()
+    assert len(djmail.outbox) == 0
+    assert not order.download_reminder_sent
+
+
