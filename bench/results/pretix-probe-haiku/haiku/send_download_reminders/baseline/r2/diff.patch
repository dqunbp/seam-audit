+@pytest.mark.django_db
+def test_attendees_sent(event, order):
+    event.settings.mail_days_download_reminder = 2
+    event.settings.mail_send_download_reminder_attendee = True
+    OrderPosition.objects.filter(order=order).update(attendee_email='attendee@dummy.test')
+    send_download_reminders(sender=event)
+    assert len(djmail.outbox) == 2
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert djmail.outbox[1].to == ['attendee@dummy.test']
+
+
+@pytest.mark.django_db
+def test_attendee_same_as_order_email_not_sent_twice(event, order):
+    event.settings.mail_days_download_reminder = 2
+    event.settings.mail_send_download_reminder_attendee = True
+    OrderPosition.objects.filter(order=order).update(attendee_email='dummy@dummy.test')
+    send_download_reminders(sender=event)
+    assert len(djmail.outbox) == 1
+
