+@pytest.mark.django_db
+def test_skip_ended_event(event, order):
+    event.date_from = now() - timedelta(days=3)
+    event.date_to = now() - timedelta(days=2)
+    event.save()
+    event.settings.mail_days_download_reminder = 5
+    send_download_reminders(sender=event)
+    order.refresh_from_db()
+    assert len(djmail.outbox) == 0
+    assert not order.download_reminder_sent
