+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    event_id = None
+    event_settings = None
+    days = None
+    channels = None
+
+    for o in Order.objects.filter(
+            status=Order.STATUS_PAID, download_reminder_sent=False,
+    ).select_related('event', 'sales_channel').order_by('event_id'):
+
+        if event_id != o.event_id:
+            event_settings = o.event.settings
+            days = event_settings.get('mail_days_download_reminder', as_type=int)
+            channels = event_settings.mail_sales_channel_download_reminder
+            event_id = o.event_id
+
+        if days is None or o.sales_channel.identifier not in channels or not o.ticket_download_available:
+            continue
+
+        if o.event.has_subevents:
+            event_start = min(
+                (se.date_from for se in o.event.subevents.filter(
+                    id__in=o.positions.values_list('subevent', flat=True))),
+                default=None,
+            )
+        else:
+            event_start = o.event.date_from
+        if event_start is None or event_start < now():
+            continue
+
+        reminder_date = (event_start - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_date:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event', 'sales_channel').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PAID or o.download_reminder_sent:
+                # Race condition
+                continue
+
+            with language(o.locale, event_settings.region):
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+                email_context = get_email_context(event=o.event, order=o)
+                o.send_mail(
+                    event_settings.mail_subject_download_reminder, event_settings.mail_text_download_reminder,
+                    email_context, 'pretix.event.order.email.download_reminder_sent',
+                )
+
+                if event_settings.mail_send_download_reminder_attendee:
+                    for p in o.positions.all():
+                        if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                            email_attendee_context = get_email_context(event=o.event, order=o, position=p)
+                            p.send_mail(
+                                event_settings.mail_subject_download_reminder_attendee,
+                                event_settings.mail_text_download_reminder_attendee,
+                                email_attendee_context, 'pretix.event.order.email.download_reminder_sent',
+                            )
+
+
