+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    qs = Order.objects.annotate(
+        has_upcoming_subevent=Exists(
+            OrderPosition.objects.filter(order_id=OuterRef('pk'), subevent__date_from__gt=now())
+        )
+    ).filter(
+        Q(event__has_subevents=False, event__date_from__gt=now()) | Q(event__has_subevents=True, has_upcoming_subevent=True),
+        download_reminder_sent=False,
+        status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+    ).select_related('event', 'sales_channel').order_by('event_id')
+
+    event_id = None
+    days = None
+    settings = None
+
+    for o in qs:
+        if event_id != o.event_id:
+            settings = o.event.settings
+            days = settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None or o.sales_channel.identifier not in settings.mail_sales_channel_download_reminder:
+            continue
+
+        if o.event.has_subevents:
+            event_dates = [
+                p.subevent.date_from for p in o.positions.select_related('subevent')
+                if p.subevent_id and p.subevent.date_from > now()
+            ]
+        else:
+            event_dates = [o.event.date_from]
+        if not event_dates:
+            continue
+
+        # Same reminder date as shown in the event timeline
+        reminder_date = (min(event_dates) - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+        if now() < reminder_date:
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_related('event', 'sales_channel').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.download_reminder_sent or not o.ticket_download_available:
+                    continue
+
+                o.download_reminder_sent = True
+                o.save(update_fields=['download_reminder_sent'])
+
+                with language(o.locale, settings.region):
+                    email_context = get_email_context(event=o.event, order=o)
+                    o.send_mail(
+                        settings.mail_subject_download_reminder, settings.mail_text_download_reminder, email_context,
+                        'pretix.event.order.email.download_reminder_sent', attach_tickets=True,
+                    )
+
+                    if settings.mail_send_download_reminder_attendee:
+                        for p in o.positions.all():
+                            if p.addon_to_id is None and p.attendee_email and p.attendee_email != o.email:
+                                email_attendee_context = get_email_context(event=o.event, order=o, position=p)
+                                p.send_mail(
+                                    settings.mail_subject_download_reminder_attendee,
+                                    settings.mail_text_download_reminder_attendee,
+                                    email_attendee_context,
+                                    'pretix.event.order.email.download_reminder_sent', attach_tickets=True,
+                                )
+        except Exception:
+            # The flag was rolled back together with the failed send, so the order is retried on the next run
+            logger.exception('Could not send download reminder for order %s', o.code)
+
+
