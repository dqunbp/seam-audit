+class DownloadReminderTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        cache.clear()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=2),
+            )
+            self.event.settings.ticket_download = True
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PAID, locale='en',
+                datetime=now() - timedelta(days=10),
+                expires=now() + timedelta(days=10),
+                total=Decimal('23.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.op1 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            djmail.outbox = []
+
+    @classscope(attr='o')
+    def test_disabled(self):
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sent_once(self):
+        self.event.settings.mail_days_download_reminder = 3
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+        self.order.refresh_from_db()
+        assert self.order.download_reminder_sent
+
+        cache.clear()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_yet_due(self):
+        self.event.settings.mail_days_download_reminder = 1
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+    @classscope(attr='o')
+    def test_ticket_download_disabled(self):
+        self.event.settings.mail_days_download_reminder = 3
+        self.event.settings.ticket_download = False
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sales_channel_not_selected(self):
+        self.event.settings.mail_days_download_reminder = 3
+        self.event.settings.mail_sales_channel_download_reminder = []
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_unpaid_order_sent_after_payment(self):
+        self.event.settings.mail_days_download_reminder = 3
+        self.order.status = Order.STATUS_PENDING
+        self.order.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.download_reminder_sent
+
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        cache.clear()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_attendees(self):
+        self.event.settings.mail_days_download_reminder = 3
+        self.event.settings.mail_send_download_reminder_attendee = True
+        self.op1.attendee_email = 'peter@example.org'
+        self.op1.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 2
+        assert {m.to[0] for m in djmail.outbox} == {'dummy@dummy.test', 'peter@example.org'}
+
+    @classscope(attr='o')
+    def test_event_in_past(self):
+        self.event.settings.mail_days_download_reminder = 3
+        self.event.date_from = now() - timedelta(days=1)
+        self.event.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_order_placed_after_reminder_date(self):
+        self.event.settings.mail_days_download_reminder = 3
+        self.order.datetime = now()
+        self.order.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_subevent_upcoming_only(self):
+        self.event.settings.mail_days_download_reminder = 3
+        self.event.has_subevents = True
+        self.event.save()
+        past = self.event.subevents.create(name="Past", date_from=now() - timedelta(days=1))
+        future = self.event.subevents.create(name="Future", date_from=now() + timedelta(days=2))
+        self.op1.subevent = past
+        self.op1.save()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+        self.op1.subevent = future
+        self.op1.save()
+        cache.clear()
+        send_download_reminders(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+
