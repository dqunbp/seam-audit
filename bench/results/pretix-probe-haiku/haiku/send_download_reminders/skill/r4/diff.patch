+def _download_reminder_date(order, days):
+    if order.event.has_subevents:
+        dates = list(
+            order.positions.filter(subevent__date_from__gt=now()).values_list('subevent__date_from', flat=True)
+        )
+        if not dates:
+            return None
+        event_date = min(dates)
+    else:
+        event_date = order.event.date_from
+    return (event_date - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    """
+    Sends the ticket download reminder ``mail_days_download_reminder`` days before the event. Each order is
+    reminded at most once, tracked via ``Order.download_reminder_sent``.
+    """
+    qs = Order.objects.filter(
+        download_reminder_sent=False,
+        status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+    ).filter(
+        Q(event__has_subevents=False, event__date_from__gt=now()) |
+        Q(event__has_subevents=True) & Q(Exists(
+            OrderPosition.objects.filter(
+                order_id=OuterRef('pk'), canceled=False, subevent__date_from__gt=now(),
+            )
+        ))
+    ).select_related('event', 'sales_channel').order_by('event_id')
+    days = None
+    event_id = None
+
+    for o in qs:
+        if event_id != o.event_id:
+            days = o.event.settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+        if days is None:
+            continue
+        if o.sales_channel.identifier not in o.event.settings.mail_sales_channel_download_reminder:
+            continue
+
+        reminder_date = _download_reminder_date(o, days)
+        # Orders placed on or after the reminder date already received their tickets with the order confirmation.
+        if reminder_date is None or now() < reminder_date or o.datetime >= reminder_date:
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_related('event', 'sales_channel').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.download_reminder_sent or not o.ticket_download_available:
+                    # Race condition, or tickets not (yet) downloadable, e.g. order still unpaid
+                    continue
+
+                with language(o.locale, o.event.settings.region):
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+                    o.send_mail(
+                        o.event.settings.mail_subject_download_reminder,
+                        o.event.settings.mail_text_download_reminder,
+                        get_email_context(event=o.event, order=o),
+                        'pretix.event.order.email.download_reminder_sent',
+                        attach_tickets=True,
+                    )
+                    if o.event.settings.mail_send_download_reminder_attendee:
+                        for p in o.positions.all():
+                            p.send_mail(
+                                o.event.settings.mail_subject_download_reminder_attendee,
+                                o.event.settings.mail_text_download_reminder_attendee,
+                                get_email_context(event=o.event, order=o, position=p),
+                                'pretix.event.order.email.download_reminder_sent',
+                                attach_tickets=True,
+                            )
+        except Exception:
+            # The flag is rolled back together with the failed transaction, so the order is retried on the next run
+            logger.exception('Could not send download reminder for order %s', o.pk)
+
+
