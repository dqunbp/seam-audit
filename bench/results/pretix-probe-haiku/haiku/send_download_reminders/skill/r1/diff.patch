+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=60)
+def send_download_reminders(sender, **kwargs):
+    now_dt = now()
+    days = None
+    event_settings = None
+    event_id = None
+
+    for o in Order.objects.filter(
+            Q(event__date_from__gte=now_dt) | Q(event__has_subevents=True),
+            status__in=[Order.STATUS_PAID, Order.STATUS_PENDING],
+            download_reminder_sent=False,
+    ).select_related('event').order_by('event_id'):
+
+        if event_id != o.event_id:
+            event_settings = o.event.settings
+            days = event_settings.get('mail_days_download_reminder', as_type=int)
+            event_id = o.event_id
+
+        if days is None or not event_settings.ticket_download:
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if o.status not in (Order.STATUS_PAID, Order.STATUS_PENDING) or o.download_reminder_sent:
+                    # Race condition
+                    continue
+
+                # Same date logic as the timeline entry in pretix.base.timeline, so the reminder goes out on the
+                # day the timeline shows
+                if o.event.has_subevents:
+                    event_start = o.event.subevents.filter(
+                        id__in=o.positions.values_list('subevent', flat=True)
+                    ).aggregate(m=Min('date_from'))['m']
+                else:
+                    event_start = o.event.date_from
+                if not event_start or event_start <= now_dt:
+                    continue
+                reminder_date = (event_start - timedelta(days=days)).replace(hour=0, minute=0, second=0, microsecond=0)
+                if now_dt < reminder_date:
+                    continue
+
+                if o.sales_channel.identifier not in o.event.settings.mail_sales_channel_download_reminder:
+                    # Not wanted for this channel, so do not look at this order again
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+                    continue
+
+                # The link in the mail would not work yet, so leave the order for a later run
+                if not o.ticket_download_available:
+                    continue
+                # positions_with_tickets can be a generator, which is always truthy, so materialize it first
+                positions = list(o.positions_with_tickets)
+                if not positions:
+                    continue
+
+                with language(o.locale, o.event.settings.region):
+                    o.download_reminder_sent = True
+                    o.save(update_fields=['download_reminder_sent'])
+                    email_context = get_email_context(event=o.event, order=o)
+                    o.send_mail(
+                        o.event.settings.mail_subject_download_reminder,
+                        o.event.settings.mail_text_download_reminder,
+                        email_context,
+                        'pretix.event.order.email.download_reminder_sent',
+                    )
+
+                    if o.event.settings.mail_send_download_reminder_attendee:
+                        for p in positions:
+                            if not p.attendee_email:
+                                continue
+                            email_attendee_context = get_email_context(event=o.event, order=o, position=p)
+                            p.send_mail(
+                                o.event.settings.mail_subject_download_reminder_attendee,
+                                o.event.settings.mail_text_download_reminder_attendee,
+                                email_attendee_context,
+                                'pretix.event.order.email.download_reminder_sent',
+                            )
+        except Exception:
+            # Rolls back this order only, so one broken order does not block the others; it is retried next run
+            logger.exception('Could not send download reminder for order %s', o.code)
+
+
 def notify_user_changed_order(order, user=None, auth=None, invoices=[]):
