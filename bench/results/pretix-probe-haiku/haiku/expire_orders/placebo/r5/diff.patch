+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    """
+    Marks pending orders as expired once their payment deadline (including the configured
+    payment term delay) has passed, provided the event has automatic expiry enabled.
+    """
+    for o in Order.objects.filter(
+            status=Order.STATUS_PENDING, expires__lt=now(),
+            require_approval=False, valid_if_pending=False,
+    ).select_related('event').order_by('event_id'):
+        if not o.event.settings.payment_term_expire_automatically:
+            continue
+        if o.payment_term_expire_date > now():
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PENDING or o.payment_term_expire_date > now():
+                # Race condition
+                continue
+
+            mark_order_expired(o)
+
+
