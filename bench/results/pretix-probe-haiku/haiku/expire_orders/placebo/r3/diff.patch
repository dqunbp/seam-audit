+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    """
+    Marks pending orders whose payment deadline has passed as expired. Only events with automatic
+    expiry enabled are affected, and the same orders are exempt as in ``send_expiry_warnings``:
+    orders that are valid while pending, orders awaiting approval and orders with a cancellation fee.
+    """
+    for o in Order.objects.filter(
+            expires__lt=now(), status=Order.STATUS_PENDING, require_approval=False, valid_if_pending=False,
+    ).select_related('event').order_by('event_id'):
+        if not o.event.settings.get('payment_term_expire_automatically', as_type=bool):
+            continue
+        if o.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists():
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PENDING or o.expires >= now():
+                # Race condition: the order was paid, canceled or its deadline was extended in the meantime
+                continue
+            mark_order_expired(o)
+
