+class ExpireOrdersTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=2),
+                plugins='pretix.plugins.banktransfer'
+            )
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now() - timedelta(days=10),
+                expires=now() - timedelta(days=1),
+                total=Decimal('46.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Early-bird ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+
+    def _refresh(self):
+        with scope(organizer=self.o):
+            self.order.refresh_from_db()
+            return self.order
+
+    @classscope(attr='o')
+    def test_expires_overdue_pending_order(self):
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_EXPIRED
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.expired').exists()
+
+    @classscope(attr='o')
+    def test_order_before_deadline_stays_pending(self):
+        self.order.expires = now() + timedelta(days=1)
+        self.order.save()
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_disabled_in_event_settings(self):
+        self.event.settings.payment_term_expire_automatically = False
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_enabled_in_event_settings_per_event(self):
+        with scope(organizer=self.o):
+            other = Event.objects.create(
+                organizer=self.o, name='Other', slug='other',
+                date_from=now() + timedelta(days=2),
+                plugins='pretix.plugins.banktransfer'
+            )
+            other.settings.payment_term_expire_automatically = False
+            other_order = Order.objects.create(
+                code='BAR', event=other, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now() - timedelta(days=10),
+                expires=now() - timedelta(days=1),
+                total=Decimal('46.00'),
+                sales_channel=other.organizer.sales_channels.get(identifier="web"),
+            )
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_EXPIRED
+        with scope(organizer=self.o):
+            other_order.refresh_from_db()
+        assert other_order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_require_approval_not_expired(self):
+        self.order.require_approval = True
+        self.order.save()
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_valid_if_pending_not_expired(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_cancellation_fee_not_expired(self):
+        OrderFee.objects.create(
+            order=self.order, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'),
+        )
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_paid_order_not_touched(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        expire_orders(sender=self.event)
+        assert self._refresh().status == Order.STATUS_PAID
+
+
