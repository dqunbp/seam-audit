+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    qs = Order.objects.filter(
+        status=Order.STATUS_PENDING,
+        expires__lt=now(),
+        require_approval=False,
+        valid_if_pending=False,
+    ).exclude(
+        pk__in=OrderFee.objects.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).values('order_id'),
+    ).only('pk', 'event_id').order_by('event_id')
+
+    event_id = None
+    expire_automatically = False
+    for o in qs:
+        if event_id != o.event_id:
+            expire_automatically = o.event.settings.get('payment_term_expire_automatically', as_type=bool)
+            event_id = o.event_id
+
+        if not expire_automatically:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PENDING or o.expires >= now():
+                # Race condition
+                continue
+            mark_order_expired(o)
+
