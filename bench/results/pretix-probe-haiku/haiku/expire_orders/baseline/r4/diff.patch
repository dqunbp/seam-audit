+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    # Same conditions as the auto-expire check in send_expiry_warnings: orders that are valid while pending,
+    # awaiting approval or carrying a cancellation fee are not expired automatically.
+    qs = Order.objects.filter(
+        expires__lt=now(), status=Order.STATUS_PENDING, require_approval=False, valid_if_pending=False,
+    ).select_related('event').order_by('event_id')
+
+    event_id = None
+    expire_automatically = False
+    for o in qs:
+        if event_id != o.event_id:
+            expire_automatically = o.event.settings.get('payment_term_expire_automatically', as_type=bool)
+            event_id = o.event_id
+
+        if not expire_automatically:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_for_update(of=OF_SELF).get(pk=o.pk)
+            if (
+                    o.status != Order.STATUS_PENDING or o.expires >= now() or o.valid_if_pending or o.require_approval or
+                    o.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+            ):
+                # Race condition
+                continue
+
+            mark_order_expired(o)
+
+
