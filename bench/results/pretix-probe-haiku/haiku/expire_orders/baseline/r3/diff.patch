+class OrderExpireTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=2),
+                plugins='pretix.plugins.banktransfer'
+            )
+            self.event.settings.payment_term_expire_automatically = True
+            self.order = self._create_order('FOO', expires=now() - timedelta(days=1))
+
+    def _create_order(self, code, event=None, **kwargs):
+        event = event or self.event
+        defaults = dict(
+            code=code, event=event, email='dummy@dummy.test',
+            status=Order.STATUS_PENDING, locale='en',
+            datetime=now() - timedelta(days=3),
+            expires=now() + timedelta(days=10),
+            total=Decimal('46.00'),
+            sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        )
+        defaults.update(kwargs)
+        return Order.objects.create(**defaults)
+
+    @classscope(attr='o')
+    def test_expires_overdue_pending_order(self):
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_EXPIRED
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.expired').exists()
+
+    @classscope(attr='o')
+    def test_keeps_order_before_deadline(self):
+        self.order.expires = now() + timedelta(hours=1)
+        self.order.save()
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_disabled_setting_keeps_order_pending(self):
+        self.event.settings.payment_term_expire_automatically = False
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_setting_is_evaluated_per_event(self):
+        with scope(organizer=self.o):
+            other_event = Event.objects.create(
+                organizer=self.o, name='Other', slug='other',
+                date_from=now() + timedelta(days=2),
+            )
+        other_event.settings.payment_term_expire_automatically = False
+        other_order = self._create_order('BAR', event=other_event, expires=now() - timedelta(days=1))
+
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        other_order.refresh_from_db()
+        assert self.order.status == Order.STATUS_EXPIRED
+        assert other_order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_ignores_paid_orders(self):
+        paid = self._create_order('PAID', status=Order.STATUS_PAID, expires=now() - timedelta(days=1))
+        expire_orders(sender=self.event)
+        paid.refresh_from_db()
+        assert paid.status == Order.STATUS_PAID
+
+    @classscope(attr='o')
+    def test_ignores_orders_requiring_approval(self):
+        self.order.require_approval = True
+        self.order.save()
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_ignores_valid_if_pending_orders(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_ignores_orders_with_cancellation_fee(self):
+        self.order.fees.create(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'))
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+
