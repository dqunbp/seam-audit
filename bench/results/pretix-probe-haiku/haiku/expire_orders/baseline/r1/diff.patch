+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    # Same exclusions as the "can_autoexpire" logic in send_expiry_warnings: orders that are already
+    # confirmed (valid_if_pending), waiting for approval or carrying an open cancellation fee stay pending.
+    qs = Order.objects.filter(
+        status=Order.STATUS_PENDING,
+        expires__lt=now(),
+        require_approval=False,
+        valid_if_pending=False,
+    ).exclude(
+        Exists(OrderFee.objects.filter(order=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION))
+    ).select_related('event').order_by('event_id')
+
+    event_id = None
+    expire_automatically = False
+    for o in qs:
+        if event_id != o.event_id:
+            expire_automatically = o.event.settings.get('payment_term_expire_automatically', as_type=bool)
+            event_id = o.event_id
+
+        if not expire_automatically:
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+            if o.status != Order.STATUS_PENDING or o.expires >= now():
+                # Race condition, e.g. the order was paid or its deadline was extended in the meantime
+                continue
+            mark_order_expired(o)
+
