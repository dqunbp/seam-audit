+class ExpireOrdersTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+            )
+            self.event2 = Event.objects.create(
+                organizer=self.o, name='Dummy 2', slug='dummy2',
+                date_from=now() + timedelta(days=30),
+            )
+            self.sales_channel = self.o.sales_channels.get(identifier="web")
+
+    def _order(self, event, code, **kwargs):
+        defaults = dict(
+            code=code, event=event, email='dummy@dummy.test', locale='en',
+            status=Order.STATUS_PENDING, datetime=now() - timedelta(days=8),
+            expires=now() - timedelta(days=1), total=Decimal('46.00'),
+            sales_channel=self.sales_channel,
+        )
+        defaults.update(kwargs)
+        return Order.objects.create(**defaults)
+
+    @classscope(attr='o')
+    def test_expires_overdue_pending_order(self):
+        o = self._order(self.event, 'A')
+        expire_orders(sender=None)
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_EXPIRED
+        assert o.all_logentries().filter(action_type='pretix.event.order.expired').exists()
+
+    @classscope(attr='o')
+    def test_keeps_order_whose_deadline_is_in_the_future(self):
+        o = self._order(self.event, 'A', expires=now() + timedelta(days=1))
+        expire_orders(sender=None)
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_ignores_paid_and_canceled_orders(self):
+        paid = self._order(self.event, 'A', status=Order.STATUS_PAID)
+        canceled = self._order(self.event, 'B', status=Order.STATUS_CANCELED)
+        expire_orders(sender=None)
+        paid.refresh_from_db()
+        canceled.refresh_from_db()
+        assert paid.status == Order.STATUS_PAID
+        assert canceled.status == Order.STATUS_CANCELED
+
+    @classscope(attr='o')
+    def test_respects_disabled_setting(self):
+        self.event.settings.payment_term_expire_automatically = False
+        o = self._order(self.event, 'A')
+        expire_orders(sender=None)
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_setting_is_evaluated_per_event(self):
+        self.event2.settings.payment_term_expire_automatically = False
+        o1 = self._order(self.event, 'A')
+        o2 = self._order(self.event2, 'B')
+        expire_orders(sender=None)
+        o1.refresh_from_db()
+        o2.refresh_from_db()
+        assert o1.status == Order.STATUS_EXPIRED
+        assert o2.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_keeps_valid_if_pending_order(self):
+        o = self._order(self.event, 'A', valid_if_pending=True)
+        expire_orders(sender=None)
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_keeps_order_awaiting_approval(self):
+        o = self._order(self.event, 'A', require_approval=True)
+        expire_orders(sender=None)
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_keeps_order_with_open_cancellation_fee(self):
+        o = self._order(self.event, 'A')
+        OrderFee.objects.create(order=o, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'))
+        expire_orders(sender=None)
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_running_twice_is_harmless(self):
+        o = self._order(self.event, 'A')
+        expire_orders(sender=None)
+        expire_orders(sender=None)
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_EXPIRED
+
+
