+def _is_due_for_automatic_expiry(order: Order, now_dt: datetime) -> bool:
+    # Mirrors the conditions under which the order is shown as "will expire automatically" in the backend
+    return (
+        order.status == Order.STATUS_PENDING
+        and not order.require_approval
+        and not order.valid_if_pending
+        and order.event.settings.payment_term_expire_automatically
+        and order.payment_term_expire_date < now_dt
+        and not order.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+    )
+
+
+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    now_dt = now()
+    candidates = Order.objects.filter(
+        status=Order.STATUS_PENDING,
+        require_approval=False,
+        valid_if_pending=False,
+        expires__lt=now_dt,
+    ).select_related('event').order_by('event_id')
+
+    for o in candidates:
+        if not _is_due_for_automatic_expiry(o, now_dt):
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_for_update(of=OF_SELF).select_related('event').get(pk=o.pk)
+            if not _is_due_for_automatic_expiry(o, now_dt):
+                # Race condition
+                continue
+            mark_order_expired(o)
+
+
