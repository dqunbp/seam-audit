+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    settings = None
+    event_id = None
+    auto_expire = False
+
+    for o in Order.objects.filter(
+            expires__lt=now(), status=Order.STATUS_PENDING, require_approval=False, valid_if_pending=False,
+    ).select_related('event').order_by('event_id', 'pk'):
+        if event_id != o.event_id:
+            settings = o.event.settings
+            auto_expire = settings.get('payment_term_expire_automatically', as_type=bool)
+            event_id = o.event_id
+
+        if not auto_expire:
+            continue
+
+        if o.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists():
+            continue
+
+        with transaction.atomic():
+            o = Order.objects.select_for_update(of=OF_SELF).select_related('event').get(pk=o.pk)
+            if o.status != Order.STATUS_PENDING or o.expires >= now():
+                # Race condition
+                continue
+
+            mark_order_expired(o)
+
