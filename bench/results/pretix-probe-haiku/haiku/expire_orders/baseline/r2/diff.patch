+class ExpireOrdersTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=10),
+                plugins='pretix.plugins.banktransfer'
+            )
+            self.event.settings.payment_term_expire_automatically = True
+            self.event2 = Event.objects.create(
+                organizer=self.o, name='Dummy 2', slug='dummy2',
+                date_from=now() + timedelta(days=10),
+                plugins='pretix.plugins.banktransfer'
+            )
+            self.event2.settings.payment_term_expire_automatically = False
+            self.ticket = Item.objects.create(event=self.event, name='Ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.ticket2 = Item.objects.create(event=self.event2, name='Ticket',
+                                               default_price=Decimal('23.00'), admission=True)
+
+    def _order(self, event=None, code='FOO', status=Order.STATUS_PENDING, expires=None, **kwargs):
+        event = event or self.event
+        order = Order.objects.create(
+            code=code, event=event, email='dummy@dummy.test',
+            status=status, locale='en',
+            datetime=now() - timedelta(days=5),
+            expires=expires if expires is not None else now() - timedelta(days=1),
+            total=Decimal('23.00'),
+            sales_channel=event.organizer.sales_channels.get(identifier="web"),
+            **kwargs
+        )
+        ticket = self.ticket if event == self.event else self.ticket2
+        OrderPosition.objects.create(
+            order=order, item=ticket, variation=None,
+            price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+        )
+        return order
+
+    @classscope(attr='o')
+    def test_expires_overdue_pending_order(self):
+        order = self._order()
+        expire_orders(sender=self.event)
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_EXPIRED
+        assert order.all_logentries().filter(action_type='pretix.event.order.expired').exists()
+
+    @classscope(attr='o')
+    def test_keeps_order_not_yet_due(self):
+        order = self._order(expires=now() + timedelta(hours=1))
+        expire_orders(sender=self.event)
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_ignores_paid_and_other_states(self):
+        paid = self._order(code='PAID', status=Order.STATUS_PAID)
+        canceled = self._order(code='CANC', status=Order.STATUS_CANCELED)
+        expire_orders(sender=self.event)
+        paid.refresh_from_db()
+        canceled.refresh_from_db()
+        assert paid.status == Order.STATUS_PAID
+        assert canceled.status == Order.STATUS_CANCELED
+
+    @classscope(attr='o')
+    def test_respects_event_setting_disabled(self):
+        order = self._order(event=self.event2)
+        expire_orders(sender=self.event2)
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_setting_is_per_event(self):
+        enabled = self._order(code='ON')
+        disabled = self._order(event=self.event2, code='OFF')
+        expire_orders(sender=self.event)
+        enabled.refresh_from_db()
+        disabled.refresh_from_db()
+        assert enabled.status == Order.STATUS_EXPIRED
+        assert disabled.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_skips_orders_requiring_approval(self):
+        order = self._order(require_approval=True)
+        expire_orders(sender=self.event)
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_skips_valid_if_pending(self):
+        order = self._order(valid_if_pending=True)
+        expire_orders(sender=self.event)
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_skips_orders_with_cancellation_fee(self):
+        order = self._order()
+        order.fees.create(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'))
+        expire_orders(sender=self.event)
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PENDING
+
+
