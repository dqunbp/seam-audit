+def _create_overdue_order(event, code, **kwargs):
+    fields = dict(
+        code=code, event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING,
+        datetime=now() - timedelta(days=20), expires=now() - timedelta(days=10),
+        total=Decimal('23.00'), locale='en',
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    fields.update(kwargs)
+    return Order.objects.create(**fields)
+
+
+@pytest.mark.django_db
+def test_expire_orders_expires_overdue_pending_order(event):
+    event.settings.set('payment_term_expire_automatically', True)
+    o = _create_overdue_order(event, 'OVERDUE')
+    expire_orders(sender=None)
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_EXPIRED
+
+
+@pytest.mark.django_db
+def test_expire_orders_does_nothing_when_disabled(event):
+    event.settings.set('payment_term_expire_automatically', False)
+    o = _create_overdue_order(event, 'OVERDUE')
+    expire_orders(sender=None)
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+
+
+@pytest.mark.django_db
+def test_expire_orders_skips_orders_not_yet_due(event):
+    event.settings.set('payment_term_expire_automatically', True)
+    o = _create_overdue_order(event, 'FUTURE', expires=now() + timedelta(days=1))
+    expire_orders(sender=None)
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+
+
+@pytest.mark.django_db
+def test_expire_orders_respects_expiry_delay(event):
+    event.settings.set('payment_term_expire_automatically', True)
+    event.settings.set('payment_term_expire_delay_days', 30)
+    o = _create_overdue_order(event, 'DELAYED')
+    expire_orders(sender=None)
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+
+
+@pytest.mark.django_db
+def test_expire_orders_skips_ineligible_orders(event):
+    event.settings.set('payment_term_expire_automatically', True)
+    valid = _create_overdue_order(event, 'VALID', valid_if_pending=True)
+    approval = _create_overdue_order(event, 'APPROVAL', require_approval=True)
+    fee = _create_overdue_order(event, 'FEE')
+    fee.fees.create(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('1.00'))
+
+    expire_orders(sender=None)
+
+    for o in (valid, approval, fee):
+        o.refresh_from_db()
+        assert o.status == Order.STATUS_PENDING
+
+
+@pytest.mark.django_db
+def test_expire_orders_failure_on_one_order_does_not_stop_others(event):
+    event.settings.set('payment_term_expire_automatically', True)
+    broken = _create_overdue_order(event, 'BROKEN')
+    ok = _create_overdue_order(event, 'OK')
+    real_mark_order_expired = mark_order_expired
+
+    def flaky_mark_order_expired(order, **kwargs):
+        if order.code == 'BROKEN':
+            raise Exception('boom')
+        return real_mark_order_expired(order, **kwargs)
+
+    with mock.patch('pretix.base.services.orders.mark_order_expired', side_effect=flaky_mark_order_expired):
+        expire_orders(sender=None)
+
+    broken.refresh_from_db()
+    ok.refresh_from_db()
+    assert broken.status == Order.STATUS_PENDING
+    assert ok.status == Order.STATUS_EXPIRED
