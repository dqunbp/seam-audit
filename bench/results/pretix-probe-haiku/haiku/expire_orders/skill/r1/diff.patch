+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    """
+    Mark pending orders as expired once their payment deadline has passed, for events that have
+    automatic expiry enabled. The deadline is the order's ``payment_term_expire_date``, so the expiry
+    delay and the last payment date configured for the event are respected. The eligibility rules
+    mirror the ones used by ``send_expiry_warnings``.
+    """
+    candidates = Order.objects.filter(
+        status=Order.STATUS_PENDING,
+        require_approval=False,
+        valid_if_pending=False,
+        expires__lt=now(),
+    ).select_related('event').order_by('event_id', 'pk')
+
+    event_id = None
+    auto_expire = False
+    for o in candidates:
+        if o.event_id != event_id:
+            event_id = o.event_id
+            auto_expire = o.event.settings.get('payment_term_expire_automatically', as_type=bool)
+        if not auto_expire or o.payment_term_expire_date > now():
+            continue
+
+        try:
+            with transaction.atomic():
+                # Re-check under lock, the order may have been paid or changed since the query
+                o = Order.objects.select_for_update(of=OF_SELF).select_related('event').get(pk=o.pk)
+                if (
+                    o.status != Order.STATUS_PENDING or o.require_approval or o.valid_if_pending or
+                    o.payment_term_expire_date > now() or
+                    o.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+                ):
+                    continue
+                mark_order_expired(o)
+        except Exception:
+            # One broken order must not stop the others from being expired; the next run retries it
+            logger.exception('Could not automatically expire order %s', o.code)
+
+
