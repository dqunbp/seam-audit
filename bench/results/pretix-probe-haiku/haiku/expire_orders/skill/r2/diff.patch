+class OrderExpiryTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=2),
+                plugins='pretix.plugins.banktransfer'
+            )
+            self.order = self._make_order('FOO', self.event, expires=now() - timedelta(hours=1))
+
+    def _make_order(self, code, event, expires, **kwargs):
+        return Order.objects.create(
+            code=code, event=event, email='dummy@dummy.test',
+            status=Order.STATUS_PENDING, locale='en',
+            datetime=now() - timedelta(days=5),
+            expires=expires,
+            total=Decimal('46.00'),
+            sales_channel=event.organizer.sales_channels.get(identifier="web"),
+            **kwargs,
+        )
+
+    @classscope(attr='o')
+    def test_expires_overdue_order(self):
+        self.event.settings.payment_term_expire_automatically = True
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_EXPIRED
+
+    @classscope(attr='o')
+    def test_default_setting_expires_overdue_order(self):
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_EXPIRED
+
+    @classscope(attr='o')
+    def test_disabled_setting_keeps_order_pending(self):
+        self.event.settings.payment_term_expire_automatically = False
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_setting_is_read_per_event(self):
+        other_event = Event.objects.create(
+            organizer=self.o, name='Other', slug='other',
+            date_from=now() + timedelta(days=2),
+            plugins='pretix.plugins.banktransfer'
+        )
+        other_event.settings.payment_term_expire_automatically = False
+        other_order = self._make_order('BAR', other_event, expires=now() - timedelta(hours=1))
+        self.event.settings.payment_term_expire_automatically = True
+
+        expire_orders(sender=self.event)
+
+        self.order.refresh_from_db()
+        other_order.refresh_from_db()
+        assert self.order.status == Order.STATUS_EXPIRED
+        assert other_order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_not_yet_due(self):
+        self.order.expires = now() + timedelta(hours=1)
+        self.order.save()
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_paid_order_untouched(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+
+    @classscope(attr='o')
+    def test_valid_if_pending_not_expired(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_require_approval_not_expired(self):
+        self.order.require_approval = True
+        self.order.save()
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_open_cancellation_fee_not_expired(self):
+        OrderFee.objects.create(
+            order=self.order, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00'),
+        )
+        expire_orders(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+
+    @classscope(attr='o')
+    def test_failure_of_one_order_does_not_block_others(self):
+        other = self._make_order('BAR', self.event, expires=now() - timedelta(hours=2))
+        calls = []
+
+        def flaky_mark_order_expired(order, **kwargs):
+            calls.append(order.pk)
+            if len(calls) == 1:
+                raise Exception('boom')
+            return mark_order_expired(order, **kwargs)
+
+        with mock.patch('pretix.base.services.orders.mark_order_expired', side_effect=flaky_mark_order_expired):
+            expire_orders(sender=self.event)
+        assert len(calls) == 2
+        self.order.refresh_from_db()
+        other.refresh_from_db()
+        assert sorted([self.order.status, other.status]) == sorted([Order.STATUS_PENDING, Order.STATUS_EXPIRED])
+
