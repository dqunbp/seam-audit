+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    """
+    Marks pending orders as expired once their payment deadline has passed, provided the event
+    has automatic expiry enabled. Orders exempt from automatic expiry are skipped, using the same
+    rules as the expiry warning mail and the order detail page.
+    """
+    candidates = Order.objects.select_related('event').filter(
+        status=Order.STATUS_PENDING,
+        require_approval=False,
+        valid_if_pending=False,
+        expires__lt=now(),
+    ).exclude(
+        Exists(OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION))
+    ).order_by('event_id')
+
+    event_id = None
+    auto_expire = False
+    for o in candidates:
+        if event_id != o.event_id:
+            auto_expire = o.event.settings.get('payment_term_expire_automatically', as_type=bool)
+            event_id = o.event_id
+        if not auto_expire:
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+                # Re-check under the row lock, the order may have been paid or changed since the query ran
+                if (
+                        o.status != Order.STATUS_PENDING or o.expires >= now() or o.valid_if_pending or
+                        o.require_approval or o.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+                ):
+                    continue
+                mark_order_expired(o)
+        except Exception:
+            # Isolate failures so that one broken order does not block the expiry of all other orders
+            logger.exception('Could not expire order %s', o.code)
+
