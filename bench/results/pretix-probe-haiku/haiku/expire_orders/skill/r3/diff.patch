+@receiver(signal=periodic_task)
+@scopes_disabled()
+@minimum_interval(minutes_after_success=5)
+def expire_orders(sender, **kwargs):
+    """
+    Marks pending orders as expired once their payment deadline has passed. Only events with
+    ``payment_term_expire_automatically`` enabled are affected. Orders that are already confirmed
+    (``valid_if_pending``), require approval, or carry a cancellation fee are left alone, just like
+    the expiry reminder does.
+    """
+    auto_expire = {}
+    expired = 0
+
+    for o in Order.objects.filter(
+            status=Order.STATUS_PENDING, expires__lt=now(), require_approval=False, valid_if_pending=False,
+    ).exclude(
+        pk__in=OrderFee.objects.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).values('order_id'),
+    ).select_related('event').order_by('event_id'):
+        if o.event_id not in auto_expire:
+            auto_expire[o.event_id] = o.event.settings.get('payment_term_expire_automatically', as_type=bool)
+        if not auto_expire[o.event_id]:
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_for_update(of=OF_SELF).select_related('event').get(pk=o.pk)
+                if o.status != Order.STATUS_PENDING or o.expires >= now():
+                    # Paid, canceled or extended in the meantime
+                    continue
+                mark_order_expired(o)
+            expired += 1
+        except Exception:
+            logger.exception('Could not expire order %s', o.code)
+
+    if expired:
+        logger.info('Expired %d unpaid orders.', expired)
+
+
