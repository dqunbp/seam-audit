+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    """
+    Marks pending orders as expired once their payment deadline has passed, for events that have
+    automatic expiry enabled. The deadline is ``Order.payment_term_expire_date``, which takes the
+    expiry delay and the last date of payments into account.
+    """
+    settings = None
+    event_id = None
+
+    # ``payment_term_expire_date`` is never earlier than ``expires``, so this is a safe pre-filter
+    for o in Order.objects.filter(
+            status=Order.STATUS_PENDING, expires__lt=now(),
+    ).only('pk', 'event', 'expires').select_related('event').order_by('event_id'):
+        if event_id != o.event_id:
+            settings = o.event.settings
+            event_id = o.event_id
+
+        if not settings.payment_term_expire_automatically:
+            continue
+
+        try:
+            with transaction.atomic():
+                # Re-check under lock, the order may have been paid or changed since the query above
+                order = Order.objects.select_related('event').select_for_update(of=OF_SELF).get(pk=o.pk)
+                if order.status != Order.STATUS_PENDING:
+                    continue
+                if order.require_approval or order.valid_if_pending:
+                    continue
+                if order.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists():
+                    continue
+                if order.payment_term_expire_date >= now():
+                    continue
+
+                mark_order_expired(order)
+        except Exception:
+            # The order stays pending and is picked up again by the next run
+            logger.exception('Could not expire order %s', o.pk)
+
+
