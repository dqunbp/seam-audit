+@receiver(signal=periodic_task)
+@scopes_disabled()
+def expire_orders(sender, **kwargs):
+    """
+    Marks pending orders as expired once their payment deadline has passed, for events that have
+    automatic expiry enabled. Orders that are valid before payment, require approval or carry a
+    cancellation fee are left alone, matching the rules used by ``send_expiry_warnings``.
+    """
+    auto_expire = {}
+    candidates = list(
+        Order.objects.filter(
+            expires__lt=now(), status=Order.STATUS_PENDING, require_approval=False, valid_if_pending=False,
+        ).exclude(
+            pk__in=OrderFee.objects.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).values('order_id')
+        ).values_list('pk', 'event_id')
+    )
+
+    for pk, event_id in candidates:
+        if event_id not in auto_expire:
+            auto_expire[event_id] = Event.objects.get(pk=event_id).settings.get(
+                'payment_term_expire_automatically', as_type=bool
+            )
+        if not auto_expire[event_id]:
+            continue
+
+        try:
+            with transaction.atomic():
+                o = Order.objects.select_for_update(of=OF_SELF).get(pk=pk)
+                if o.status != Order.STATUS_PENDING or o.expires >= now() or o.valid_if_pending or o.require_approval:
+                    # Race condition: the order was paid, extended or changed since we selected it
+                    continue
+                mark_order_expired(o)
+        except Exception:
+            logger.exception('Could not expire order %s', pk)
+
+
