+def _create_order_to_cancel(event, status=Order.STATUS_PENDING, paid=False):
+    ticket = Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+    order = Order.objects.create(
+        code='FOOCANCEL', event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=Decimal('48.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    for i in range(1, 3):
+        OrderPosition.objects.create(
+            order=order, item=ticket, variation=None, price=Decimal('23.00'),
+            attendee_name_parts={'full_name': f'Attendee {i}'}, positionid=i,
+        )
+    order.fees.create(fee_type=OrderFee.FEE_TYPE_SERVICE, value=Decimal('2.00'))
+    order.create_transactions(is_new=True)
+    if paid:
+        order.payments.create(
+            provider='banktransfer', state=OrderPayment.PAYMENT_STATE_CONFIRMED, amount=Decimal('48.00')
+        )
+    return order
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely(event):
+    djmail.outbox = []
+    order = _create_order_to_cancel(event)
+    assert _cancel_order(order.pk) == order.pk
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.positions.count() == 2
+    assert order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+    assert len(djmail.outbox) == 1
+    assert 'canceled' in djmail.outbox[0].subject
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_without_mail(event):
+    djmail.outbox = []
+    order = _create_order_to_cancel(event)
+    _cancel_order(order, send_mail=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert djmail.outbox == []
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_paid_leaves_full_refund(event):
+    order = _create_order_to_cancel(event, status=Order.STATUS_PAID, paid=True)
+    _cancel_order(order)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.pending_sum == Decimal('-48.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_cancellation_fee_paid(event):
+    order = _create_order_to_cancel(event, status=Order.STATUS_PAID, paid=True)
+    _cancel_order(order, cancellation_fee=Decimal('10.00'))
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PAID
+    assert order.positions.count() == 0
+    assert [(f.fee_type, f.value) for f in order.fees.all()] == [(OrderFee.FEE_TYPE_CANCELLATION, Decimal('10.00'))]
+    assert order.total == Decimal('10.00')
+    assert order.pending_sum == Decimal('-38.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_cancellation_fee_pending(event):
+    order = _create_order_to_cancel(event)
+    _cancel_order(order, cancellation_fee=Decimal('10.00'))
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.positions.count() == 0
+    assert order.total == Decimal('10.00')
+    assert order.pending_sum == Decimal('10.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_cancellation_fee_keeps_fees(event):
+    order = _create_order_to_cancel(event)
+    keep = order.fees.get(fee_type=OrderFee.FEE_TYPE_SERVICE)
+    order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('5.00'))
+    _cancel_order(order, cancellation_fee=Decimal('10.00'), keep_fees=[keep])
+    order.refresh_from_db()
+    assert order.total == Decimal('10.00')
+    fees = {f.fee_type: f.value for f in order.fees.all()}
+    assert fees == {
+        OrderFee.FEE_TYPE_SERVICE: Decimal('2.00'),
+        OrderFee.FEE_TYPE_CANCELLATION: Decimal('8.00'),
+    }
+    assert order.all_fees.get(fee_type=OrderFee.FEE_TYPE_SHIPPING).canceled
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_cancellation_fee_taxed_by_default_rule(event):
+    tr = event.tax_rules.create(rate=Decimal('19.00'), default=True)
+    order = _create_order_to_cancel(event)
+    _cancel_order(order, cancellation_fee=Decimal('10.00'), tax_mode='default')
+    fee = order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert fee.tax_rule == tr
+    assert fee.tax_rate == Decimal('19.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_fee_higher_than_total(event):
+    order = _create_order_to_cancel(event)
+    with pytest.raises(OrderError):
+        _cancel_order(order, cancellation_fee=Decimal('100.00'))
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.positions.count() == 2
+
+
+@pytest.mark.django_db
+def test_cancel_order_not_allowed(event):
+    order = _create_order_to_cancel(event, status=Order.STATUS_CANCELED)
+    with pytest.raises(OrderError):
+        _cancel_order(order)
+
