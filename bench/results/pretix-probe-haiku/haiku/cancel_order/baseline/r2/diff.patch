+def _cancellation_fee_objects(order, positions, value, tax_mode):
+    """
+    Return the cancellation fees that make up the gross amount ``value``, one per tax rate, taxed according to
+    ``tax_mode`` (``default``, ``split`` or ``none``).
+    """
+    tax_rule_zero = TaxRule.zero()
+    if tax_mode == 'default':
+        fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, value)]
+    elif tax_mode == 'split':
+        fee_values = split_fee_for_taxes(positions, value, order.event)
+    else:
+        fee_values = [(tax_rule_zero, value)]
+
+    try:
+        ia = order.invoice_address
+    except InvoiceAddress.DoesNotExist:
+        ia = None
+
+    fees = []
+    for tax_rule, price in fee_values:
+        tax_rule = tax_rule or tax_rule_zero
+        tax = tax_rule.tax(price, invoice_address=ia, base_price_is="gross")
+        fees.append(OrderFee(
+            fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+            value=price,
+            order=order,
+            tax_rate=tax.rate,
+            tax_code=tax.code,
+            tax_value=tax.tax,
+            tax_rule=tax_rule,
+        ))
+    return fees
+
+
+def _cancel_order(order, user=None, send_mail: bool=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee``, the order is canceled completely. With a ``cancellation_fee``,
+    all positions and all fees except for ``keep_fees`` are canceled, and the order is reduced to the amount given
+    as ``cancellation_fee``. The customer still has to pay this amount, or it is kept from what they already paid.
+    The value of ``keep_fees`` counts towards that amount.
+
+    :param order: The order to cancel, or its primary key
+    :param user: The user performing the cancellation, or their primary key
+    :param send_mail: Whether the customer should be notified by email
+    :param api_token: The team API token performing the cancellation, or its primary key
+    :param device: The device performing the cancellation, or its primary key
+    :param oauth_application: The OAuth application performing the cancellation, or its primary key
+    :param cancellation_fee: The gross amount the order is reduced to instead of being canceled completely
+    :param keep_fees: Fees of the order that are not canceled
+    :param cancel_invoice: Whether invoices of the order should be canceled (or reissued, if a fee is kept)
+    :param comment: A comment to include in the notification email
+    :param tax_mode: How to tax the cancellation fee (``default``, ``split`` or ``none``), defaults to the event setting
+    :return: The primary key of the order
+    """
+    if isinstance(order, int):
+        order = Order.objects.select_related('event').get(pk=order)
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    auth = api_token or device or oauth_application
+
+    if not order.cancel_allowed():
+        raise OrderError(_('The order is not allowed to be canceled.'))
+    if cancellation_fee and cancellation_fee > order.total:
+        raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+    keep_fees = keep_fees or []
+    keep_fee_pks = {f.pk for f in keep_fees}
+    tax_mode = tax_mode or order.event.settings.tax_rule_cancellation
+
+    status_changed = False
+    with transaction.atomic():
+        positions = list(order.positions.all())
+        if cancellation_fee:
+            ocm = OrderChangeManager(
+                order, user=user, auth=auth, notify=False, reissue_invoice=cancel_invoice,
+                allow_complete_cancel=True,
+            )
+            for p in positions:
+                ocm.cancel(p)
+            for f in order.fees.all():
+                if f.pk not in keep_fee_pks:
+                    ocm.cancel_fee(f)
+
+            remaining_fee = round_decimal(cancellation_fee - sum(f.value for f in keep_fees), order.event.currency)
+            if remaining_fee > 0:
+                for f in _cancellation_fee_objects(order, positions, remaining_fee, tax_mode):
+                    ocm.add_fee(f)
+            ocm.commit()
+            order.refresh_from_db()
+        else:
+            # The positions stay as they are, just like for a denied order. We only release what the order holds
+            # in the same way the order change manager does when canceling a position.
+            for p in positions:
+                for gc in p.issued_gift_cards.all():
+                    gc = GiftCard.objects.select_for_update(of=OF_SELF).get(pk=gc.pk)
+                    if gc.value < p.price:
+                        raise OrderError(_(
+                            'A position can not be canceled since the gift card {card} purchased in this order has '
+                            'already been redeemed.').format(
+                            card=gc.secret
+                        ))
+                    gc.transactions.create(value=-p.price, order=order, acceptor=order.event.organizer)
+                    gc.log_action(
+                        action='pretix.giftcards.transaction.manual',
+                        user=user,
+                        auth=auth,
+                        data={
+                            'value': -p.price,
+                            'acceptor_id': order.event.organizer.id,
+                            'acceptor_slug': order.event.organizer.slug
+                        }
+                    )
+
+                for m in p.granted_memberships.with_usages().all():
+                    m.canceled = True
+                    m.save()
+
+                if p.voucher:
+                    Voucher.objects.filter(pk=p.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+            order.status = Order.STATUS_CANCELED
+            order.save(update_fields=['status'])
+            status_changed = True
+            order.create_transactions()
+
+            if cancel_invoice:
+                i = order.invoices.filter(is_cancellation=False).last()
+                if i and not i.refered.exists():
+                    generate_cancellation(i)
+
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+            'comment': comment,
+            'cancellation_fee': cancellation_fee,
+        })
+
+    if status_changed:
+        order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user, auth=auth
+            )
+
+    return order.pk
+
+
