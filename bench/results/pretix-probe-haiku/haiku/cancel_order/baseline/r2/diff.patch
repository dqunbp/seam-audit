+@pytest.mark.django_db
+def test_cancel_order_generates_cancellation_for_invoice(event):
+    event.settings.invoice_generate = 'True'
+    order = _create_order_to_cancel(event)
+    generate_invoice(order)
+    _cancel_order(order)
+    assert order.invoices.filter(is_cancellation=True).count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_order_without_cancelling_invoice(event):
+    event.settings.invoice_generate = 'True'
+    order = _create_order_to_cancel(event)
+    generate_invoice(order)
