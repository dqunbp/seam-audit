+class CancelOrderTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        djmail.outbox = []
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(organizer=self.o, name='Dummy', slug='dummy', date_from=now(),
+                                              plugins='pretix.plugins.banktransfer')
+            self.event.settings.invoice_generate = 'True'
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now(), expires=now() + timedelta(days=10),
+                total=Decimal('51.00'),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            )
+            self.order.payments.create(
+                provider='banktransfer', state=OrderPayment.PAYMENT_STATE_CREATED, amount=self.order.total
+            )
+            self.tr19 = self.event.tax_rules.create(rate=Decimal('19.00'), default=True)
+            self.ticket = Item.objects.create(event=self.event, name='Ticket', tax_rule=self.tr19,
+                                              default_price=Decimal('23.00'), admission=True)
+            self.op1 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            self.op2 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Dieter"}, positionid=2
+            )
+            self.shipping = self.order.fees.create(
+                fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('5.00'), tax_rule=self.tr19,
+                tax_rate=Decimal('19.00'), tax_value=Decimal('0.80'),
+            )
+            self.order.create_transactions(is_new=True)
+
+    @classscope(attr='o')
+    def test_cancel_completely(self):
+        result = _cancel_order(self.order.pk)
+        assert result == self.order.pk
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert self.order.payments.get().state == OrderPayment.PAYMENT_STATE_CANCELED
+
+    @classscope(attr='o')
+    def test_cancel_completely_logs_user_and_comment(self):
+        user = User.objects.create_user('admin@localhost', 'dummy')
+        _cancel_order(self.order, user=user, send_mail=False, comment='Sorry')
+        le = self.order.all_logentries().get(action_type='pretix.event.order.canceled')
+        assert le.parsed_data == {'comment': 'Sorry'}
+        assert le.user == user
+
+    @classscope(attr='o')
+    def test_cancel_completely_sends_mail(self):
+        _cancel_order(self.order, send_mail=True, comment='Sorry')
+        assert len(djmail.outbox) == 1
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.email.order_canceled').exists()
+
+    @classscope(attr='o')
+    def test_cancel_completely_without_mail(self):
+        _cancel_order(self.order, send_mail=False)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_cancel_completely_cancels_invoice(self):
+        inv = generate_invoice(self.order)
+        _cancel_order(self.order, send_mail=False)
+        inv.refresh_from_db()
+        assert inv.canceled
+
+    @classscope(attr='o')
+    def test_cancel_completely_keeps_invoice_if_requested(self):
+        inv = generate_invoice(self.order)
+        _cancel_order(self.order, send_mail=False, cancel_invoice=False)
+        inv.refresh_from_db()
+        assert not inv.canceled
+
+    @classscope(attr='o')
+    def test_cancel_completely_already_canceled(self):
+        self.order.status = Order.STATUS_CANCELED
+        self.order.save()
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, send_mail=False)
+
+    @classscope(attr='o')
+    def test_cancel_completely_with_zero_fee(self):
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('0.00'))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_leaves_only_fee(self):
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('10.00'), keep_fees=[])
+        self.order.refresh_from_db()
+        self.op1.refresh_from_db()
+        self.op2.refresh_from_db()
+        self.shipping.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.op1.canceled
+        assert self.op2.canceled
+        assert self.shipping.canceled
+        assert self.order.positions.count() == 0
+        fees = list(self.order.fees.all())
+        assert len(fees) == 1
+        assert fees[0].fee_type == OrderFee.FEE_TYPE_CANCELLATION
+        assert fees[0].value == Decimal('10.00')
+        assert self.order.total == Decimal('10.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_above_total(self):
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('100.00'))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.positions.count() == 2
+
+    @classscope(attr='o')
+    def test_cancel_removes_cancellation_requests(self):
+        self.order.cancellation_requests.create(cancellation_fee=Decimal('10.00'))
+        _cancel_order(self.order, send_mail=False)
+        assert not self.order.cancellation_requests.exists()
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_removes_cancellation_requests(self):
+        self.order.cancellation_requests.create(cancellation_fee=Decimal('10.00'))
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('10.00'))
+        assert not self.order.cancellation_requests.exists()
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_keeps_given_fees(self):
+        # The kept shipping fee (5.00) counts towards the 15.00 total, so only 10.00 is added as cancellation fee
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('15.00'), keep_fees=[self.shipping])
+        self.order.refresh_from_db()
+        self.shipping.refresh_from_db()
+        assert not self.shipping.canceled
+        assert self.order.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('10.00')).exists()
+        assert self.order.fees.count() == 2
+        assert self.order.total == Decimal('15.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_equal_to_kept_fees(self):
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('5.00'), keep_fees=[self.shipping])
+        self.order.refresh_from_db()
+        self.shipping.refresh_from_db()
+        assert not self.shipping.canceled
+        assert self.order.positions.count() == 0
+        assert list(self.order.fees.all()) == [self.shipping]
+        assert self.order.total == Decimal('5.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_given_as_string_cancels_unpaid_fees_by_default(self):
+        _cancel_order(self.order, send_mail=False, cancellation_fee='10.00')
+        self.order.refresh_from_db()
+        self.shipping.refresh_from_db()
+        assert self.shipping.canceled
+        assert list(self.order.fees.all()) == [self.order.fees.get()]
+        assert self.order.fees.get().fee_type == OrderFee.FEE_TYPE_CANCELLATION
+        assert self.order.total == Decimal('10.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_on_paid_order_keeps_paid_fees_by_default(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('10.00'))
+        self.order.refresh_from_db()
+        self.shipping.refresh_from_db()
+        assert not self.shipping.canceled
+        assert self.order.status == Order.STATUS_PAID
+        assert self.order.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('5.00')).exists()
+        assert self.order.total == Decimal('10.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_sends_mail(self):
+        _cancel_order(self.order, send_mail=True, cancellation_fee=Decimal('10.00'))
+        assert len(djmail.outbox) == 1
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+
+    @classscope(attr='o')
+    def test_accepts_primary_keys(self):
+        user = User.objects.create_user('admin@localhost', 'dummy')
+        _cancel_order(self.order.pk, user=user.pk, send_mail=False)
+        le = self.order.all_logentries().get(action_type='pretix.event.order.canceled')
+        assert le.user == user
+        assert LogEntry.objects.filter(action_type='pretix.event.order.canceled').count() == 1
