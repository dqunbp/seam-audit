+def _send_order_canceled_mail(order, user, auth, comment):
+    with language(order.locale, order.event.settings.region):
+        email_template = order.event.settings.mail_text_order_canceled
+        email_subject = order.event.settings.mail_subject_order_canceled
+        email_context = get_email_context(event=order.event, order=order, comment=comment)
+        order.send_mail(
+            email_subject, email_template, email_context,
+            'pretix.event.order.email.order_canceled', user, auth=auth,
+        )
+
+
+def _cancel_order_with_fee(order, user, auth, send_mail, cancellation_fee, keep_fees, cancel_invoice, comment):
+    cancellation_fee = round_decimal(cancellation_fee, order.event.currency)
+    if cancellation_fee > order.total:
+        raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+    # Fees that stay on the order count towards the cancellation fee, so only the remainder is added as a new fee.
+    # By default, fees the customer has already paid for stay on a paid order, unpaid fees are dropped.
+    if keep_fees is None:
+        kept_fees = list(order.fees.all()) if order.status == Order.STATUS_PAID else []
+    else:
+        kept_fees = list(keep_fees)
+    keep_fee_ids = {f.pk for f in kept_fees}
+    new_fee_value = cancellation_fee - sum((f.value for f in kept_fees), Decimal('0.00'))
+    positions = list(order.positions.all())
+
+    ocm = OrderChangeManager(order, user=user, auth=auth, notify=False, reissue_invoice=cancel_invoice,
+                             allow_fee_only=True)
+    for position in positions:
+        ocm.cancel(position)
+    for fee in order.fees.all():
+        if fee.pk not in keep_fee_ids:
+            ocm.cancel_fee(fee)
+
+    if new_fee_value > Decimal('0.00'):
+        tax_rule_zero = TaxRule.zero()
+        if order.event.settings.tax_rule_cancellation == "default":
+            fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, new_fee_value)]
+        elif order.event.settings.tax_rule_cancellation == "split":
+            fee_values = split_fee_for_taxes(positions, new_fee_value, order.event)
+        else:
+            fee_values = [(tax_rule_zero, new_fee_value)]
+
+        try:
+            ia = order.invoice_address
+        except InvoiceAddress.DoesNotExist:
+            ia = None
+        for tax_rule, price in fee_values:
+            tax_rule = tax_rule or tax_rule_zero
+            tax = tax_rule.tax(price, invoice_address=ia, base_price_is="gross")
+            ocm.add_fee(OrderFee(
+                fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                value=price,
+                order=order,
+                tax_rate=tax.rate,
+                tax_code=tax.code,
+                tax_value=tax.tax,
+                tax_rule=tax_rule,
+            ))
+    ocm.commit()
+
+    with transaction.atomic():
+        order.cancellation_requests.all().delete()
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={'comment': comment})
+    if send_mail:
+        _send_order_canceled_mail(order, user, auth, comment)
+
+
+def _cancel_order(order, user=None, send_mail: bool=True, api_token=None, device=None,
+                  oauth_application=None, cancellation_fee=None, keep_fees=None, cancel_invoice=True,
+                  comment=None, tax_mode=None):
+    """
+    Cancel an order, either completely or, if ``cancellation_fee`` is given, everything except that fee.
+
+    :param order: The order to cancel, or its primary key
+    :param user: The user performing the cancellation, or their primary key
+    :param send_mail: Whether the customer should be notified by email
+    :param api_token: The team API token used for the cancellation, or its primary key
+    :param device: The device used for the cancellation, or its primary key
+    :param oauth_application: The OAuth application used for the cancellation, or its primary key
+    :param cancellation_fee: If set, all positions are canceled and the order is kept at this total amount, which the
+                             customer still has to pay (or which is kept from what they already paid). The order
+                             itself stays open in that case.
+    :param keep_fees: Used with ``cancellation_fee``: the existing ``OrderFee`` instances that stay on the order. All
+                      other fees are canceled. If ``None``, existing fees stay on a paid order and are canceled
+                      otherwise. Kept fees count towards ``cancellation_fee``; only the remainder is added as a new fee.
+    :param cancel_invoice: Whether the open invoice(s) of the order should be canceled
+    :param comment: A comment that is included in the log entry and the customer email
+    :param tax_mode: Currently unused, accepted for compatibility with existing callers
+    :return: The primary key of the order
+    """
+    if isinstance(order, int):
+        order = Order.objects.get(pk=order)
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    if isinstance(cancellation_fee, str):
+        cancellation_fee = Decimal(cancellation_fee)
+
+    auth = device or oauth_application or api_token
+
+    if cancellation_fee:
+        _cancel_order_with_fee(order, user, auth, send_mail, cancellation_fee, keep_fees, cancel_invoice, comment)
+        return order.pk
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order.pk)
+        if order.status == Order.STATUS_CANCELED:
+            raise OrderError(_('The order has already been canceled.'))
+
+        open_payments = order.payments.filter(
+            state__in=(OrderPayment.PAYMENT_STATE_CREATED, OrderPayment.PAYMENT_STATE_PENDING)
+        )
+        for payment in open_payments:
+            try:
+                payment.payment_provider.cancel_payment(payment)
+                order.log_action('pretix.event.order.payment.canceled', {
+                    'local_id': payment.local_id,
+                    'provider': payment.provider,
+                }, user=user, auth=auth)
+            except PaymentException as e:
+                order.log_action('pretix.event.order.payment.canceled.failed', {
+                    'local_id': payment.local_id,
+                    'provider': payment.provider,
+                    'error': str(e)
+                }, user=user, auth=auth)
+
+        for position in order.positions.all():
+            if position.voucher:
+                Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+        order.status = Order.STATUS_CANCELED
+        order.save(update_fields=['status'])
+        order.cancellation_requests.all().delete()
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={'comment': comment})
+
+        if cancel_invoice:
+            for i in order.invoices.filter(is_cancellation=False):
+                if not i.canceled:
+                    generate_cancellation(i)
+        order.create_transactions()
+
+    order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        _send_order_canceled_mail(order, user, auth, comment)
+
+    return order.pk
+
+
 @app.task(base=ProfiledTask, bind=True, max_retries=5, default_retry_delay=1, throws=(OrderError,))
 @scopes_disabled()
 def cancel_order(self, order: int, user: int=None, send_mail: bool=True, api_token=None, oauth_application=None,
