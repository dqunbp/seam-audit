+def _revert_issued_gift_cards(order, position, user=None, auth=None):
+    for gc in position.issued_gift_cards.all():
+        gc = GiftCard.objects.select_for_update(of=OF_SELF).get(pk=gc.pk)
+        if gc.value < position.price:
+            raise OrderError(_(
+                'A position can not be canceled since the gift card {card} purchased in this order has '
+                'already been redeemed.').format(
+                card=gc.secret
+            ))
+        gc.transactions.create(value=-position.price, order=order, acceptor=order.event.organizer)
+        gc.log_action(
+            action='pretix.giftcards.transaction.manual',
+            user=user,
+            auth=auth,
+            data={
+                'value': -position.price,
+                'acceptor_id': order.event.organizer.id,
+                'acceptor_slug': order.event.organizer.slug
+            }
+        )
+
+
+def _cancellation_fees(order, fee, positions, tax_mode=None):
+    tax_rule_zero = TaxRule.zero()
+    mode = tax_mode or order.event.settings.tax_rule_cancellation
+    if mode == "default":
+        fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, fee)]
+    elif mode == "split":
+        fee_values = split_fee_for_taxes(positions, fee, order.event)
+    else:
+        fee_values = [(tax_rule_zero, fee)]
+
+    try:
+        ia = order.invoice_address
+    except InvoiceAddress.DoesNotExist:
+        ia = None
+
+    fees = []
+    for tax_rule, price in fee_values:
+        tax_rule = tax_rule or tax_rule_zero
+        tax = tax_rule.tax(price, invoice_address=ia, base_price_is="gross")
+        fees.append(OrderFee(
+            fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+            value=price,
+            order=order,
+            tax_rate=tax.rate,
+            tax_code=tax.code,
+            tax_value=tax.tax,
+            tax_rule=tax_rule,
+        ))
+    return fees
+
+
+def _cancel_order(order, user=None, send_mail=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order completely or, if a ``cancellation_fee`` is given, cancel everything except that fee.
+
+    :param order: The order to cancel, or its primary key
+    :param user: The user that performed the change, or their primary key
+    :param send_mail: Whether the customer should be notified by email
+    :param api_token: The API token used to perform the change, or its primary key
+    :param device: The device used to perform the change, or its primary key
+    :param oauth_application: The OAuth application used to perform the change, or its primary key
+    :param cancellation_fee: The total amount that remains on the order as cancellation fee. The customer still has
+                             to pay it, or it is kept from what they already paid. Without it, the order is canceled
+                             completely.
+    :param keep_fees: Existing fees of the order that are not canceled. Their values count towards ``cancellation_fee``.
+    :param cancel_invoice: Whether the invoice should be canceled (and reissued if the order keeps a fee)
+    :param comment: Comment that is included in the log entry and the customer email
+    :param tax_mode: How tax is charged on the cancellation fee, one of the values of the ``tax_rule_cancellation``
+                     setting. Defaults to that setting.
+    :return: The primary key of the order
+    """
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    if cancellation_fee is not None:
+        cancellation_fee = Decimal(str(cancellation_fee))
+    auth = device or oauth_application or api_token
+    comment = comment or ''
+    order_pk = order if isinstance(order, int) else order.pk
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order_pk)
+        if not order.cancel_allowed():
+            raise OrderError(_('This order cannot be canceled.'))
+
+        if cancellation_fee:
+            if cancellation_fee > order.total:
+                raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+            ocm = OrderChangeManager(order, user=user, auth=auth, notify=False, reissue_invoice=cancel_invoice,
+                                     allow_empty_positions=True)
+            # Canceling a top-level position also cancels its add-ons, so only the top-level positions are queued.
+            positions = list(order.positions.filter(addon_to__isnull=True))
+            for p in positions:
+                ocm.cancel(p)
+
+            fees = list(order.fees.all())
+            keep_fee_ids = {f.pk for f in keep_fees or []}
+            kept_fees = [f for f in fees if f.pk in keep_fee_ids]
+            payment_fees = [f for f in fees if f.fee_type == OrderFee.FEE_TYPE_PAYMENT and f.pk not in keep_fee_ids]
+            # The payment fee of a paid order has already been paid, so it stays on the order and counts towards the
+            # cancellation fee. If it does not fit into the cancellation fee, it is canceled like any other fee.
+            if order.status == Order.STATUS_PAID and sum(f.value for f in kept_fees + payment_fees) <= cancellation_fee:
+                kept_fees += payment_fees
+            for f in fees:
+                if f not in kept_fees:
+                    ocm.cancel_fee(f)
+
+            kept_sum = sum((f.value for f in kept_fees), Decimal('0.00'))
+            if cancellation_fee < kept_sum:
+                raise OrderError(_('The cancellation fee cannot be lower than the fees that are kept.'))
+            if cancellation_fee > kept_sum:
+                for f in _cancellation_fees(order, cancellation_fee - kept_sum, positions, tax_mode):
+                    ocm.add_fee(f)
+            ocm.commit()
+        else:
+            order.status = Order.STATUS_CANCELED
+            order.save(update_fields=['status'])
+
+            for p in order.positions.all():
+                if p.voucher:
+                    Voucher.objects.filter(pk=p.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+                _revert_issued_gift_cards(order, p, user=user, auth=auth)
+
+            for payment in order.payments.filter(state__in=(OrderPayment.PAYMENT_STATE_CREATED,
+                                                            OrderPayment.PAYMENT_STATE_PENDING)):
+                try:
+                    payment.payment_provider.cancel_payment(payment)
+                    order.log_action('pretix.event.order.payment.canceled', {
+                        'local_id': payment.local_id,
+                        'provider': payment.provider,
+                    }, user=user, auth=auth)
+                except PaymentException as e:
+                    order.log_action('pretix.event.order.payment.canceled.failed', {
+                        'local_id': payment.local_id,
+                        'provider': payment.provider,
+                        'error': str(e)
+                    }, user=user, auth=auth)
+
+            i = order.invoices.filter(is_cancellation=False).last()
+            if cancel_invoice and i and not i.canceled:
+                generate_cancellation(i)
+
+            order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+                'comment': comment,
+            })
+            order.create_transactions()
+
+        order.cancellation_requests.all().delete()
+
+    if not cancellation_fee:
+        order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user
+            )
+
+    return order.pk
+
+
 @app.task(base=ProfiledTask, bind=True, max_retries=5, default_retry_delay=1, throws=(OrderError,))
 @scopes_disabled()
 def cancel_order(self, order: int, user: int=None, send_mail: bool=True, api_token=None, oauth_application=None,
