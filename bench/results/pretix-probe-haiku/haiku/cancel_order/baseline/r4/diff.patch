+from datetime import timedelta
+from decimal import Decimal
+
+from django.core import mail as djmail
+from django.test import TestCase
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, Item, Order, OrderPosition, Organizer, User, Voucher,
+)
+from pretix.base.models.orders import OrderFee, OrderPayment
+from pretix.base.services.invoices import generate_invoice
+from pretix.base.services.orders import OrderError, _cancel_order
+from pretix.testutils.scope import classscope
+
+
+class CancelOrderTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(organizer=self.o, name='Dummy', slug='dummy', date_from=now(),
+                                              plugins='tests.testdummy')
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PAID, locale='en',
+                datetime=now(), expires=now() + timedelta(days=10),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+                total=Decimal('46.00'),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Early-bird ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.op1 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            self.op2 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Dieter"}, positionid=2
+            )
+            self.order.payments.create(
+                amount=Decimal('46.00'),
+                state=OrderPayment.PAYMENT_STATE_CONFIRMED,
+                provider='manual',
+            )
+            generate_invoice(self.order)
+            self.user = User.objects.create_user('admin@dummy.test', 'dummy')
+            djmail.outbox = []
+
+    def _make_pending(self):
+        self.order.status = Order.STATUS_PENDING
+        self.order.save()
+        self.order.payments.all().delete()
+
+    @classscope(attr='o')
+    def test_cancel_completely(self):
+        pk = _cancel_order(self.order.pk, user=self.user.pk, comment="Sorry")
+        assert pk == self.order.pk
+
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert self.order.invoices.filter(is_cancellation=True).count() == 1
+        assert self.order.positions.count() == 2
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.canceled', user=self.user).exists()
+        assert len(djmail.outbox) == 1
+        assert 'Sorry' in djmail.outbox[0].body
+
+    @classscope(attr='o')
+    def test_cancel_completely_without_mail(self):
+        _cancel_order(self.order, send_mail=False)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_cancel_completely_keeps_invoice(self):
+        _cancel_order(self.order, cancel_invoice=False)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert not self.order.invoices.filter(is_cancellation=True).exists()
+
+    @classscope(attr='o')
+    def test_cancel_completely_releases_voucher(self):
+        v = Voucher.objects.create(event=self.event, code='FOO', redeemed=1)
+        self.op1.voucher = v
+        self.op1.save()
+        _cancel_order(self.order, send_mail=False)
+        v.refresh_from_db()
+        assert v.redeemed == 0
+
+    @classscope(attr='o')
+    def test_cancel_completely_reverts_issued_gift_card(self):
+        gc = self.o.issued_gift_cards.create(currency="EUR", issued_in=self.op1)
+        gc.transactions.create(value=23, acceptor=self.o)
+        _cancel_order(self.order, send_mail=False)
+        gc.refresh_from_db()
+        assert gc.value == Decimal('0.00')
+
+    @classscope(attr='o')
+    def test_cancel_completely_fails_if_gift_card_redeemed(self):
+        gc = self.o.issued_gift_cards.create(currency="EUR", issued_in=self.op1)
+        gc.transactions.create(value=23, acceptor=self.o)
+        gc.transactions.create(value=-10, acceptor=self.o)
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, send_mail=False)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+
+    @classscope(attr='o')
+    def test_cancel_already_canceled(self):
+        self.order.status = Order.STATUS_CANCELED
+        self.order.save()
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, send_mail=False)
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_paid_order(self):
+        _cancel_order(self.order, cancellation_fee=Decimal('5.00'), send_mail=True)
+
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+        assert self.order.total == Decimal('5.00')
+        self.op1.refresh_from_db()
+        self.op2.refresh_from_db()
+        assert self.op1.canceled
+        assert self.op2.canceled
+        fee = self.order.fees.get()
+        assert fee.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+        assert fee.value == Decimal('5.00')
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_pending_order_still_has_to_pay(self):
+        self._make_pending()
+        _cancel_order(self.order, cancellation_fee=Decimal('5.00'), send_mail=False)
+
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.total == Decimal('5.00')
+        assert self.order.pending_sum == Decimal('5.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_keeps_given_fees(self):
+        self._make_pending()
+        shipping = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('3.00'))
+        self.order.total = Decimal('49.00')
+        self.order.save()
+
+        _cancel_order(self.order, cancellation_fee=Decimal('8.00'), keep_fees=[shipping], send_mail=False)
+
+        self.order.refresh_from_db()
+        shipping.refresh_from_db()
+        assert not shipping.canceled
+        assert self.order.total == Decimal('8.00')
+        cancellation = self.order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        assert cancellation.value == Decimal('5.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_lower_than_kept_fees(self):
+        self._make_pending()
+        shipping = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('3.00'))
+        self.order.total = Decimal('49.00')
+        self.order.save()
+
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, cancellation_fee=Decimal('2.00'), keep_fees=[shipping], send_mail=False)
+
+        self.order.refresh_from_db()
+        self.op1.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert not self.op1.canceled
+        assert self.order.total == Decimal('49.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_higher_than_total(self):
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, cancellation_fee=Decimal('100.00'), send_mail=False)
+
+        self.order.refresh_from_db()
+        self.op1.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+        assert not self.op1.canceled
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_paid_order_keeps_payment_fee(self):
+        payment_fee = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.00'))
+        self.order.total = Decimal('48.00')
+        self.order.save()
+
+        _cancel_order(self.order, cancellation_fee=Decimal('5.00'), send_mail=False)
+
+        self.order.refresh_from_db()
+        payment_fee.refresh_from_db()
+        assert not payment_fee.canceled
+        assert self.order.total == Decimal('5.00')
+        cancellation = self.order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        assert cancellation.value == Decimal('3.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_pending_order_cancels_payment_fee(self):
+        self._make_pending()
+        payment_fee = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.00'))
+        self.order.total = Decimal('48.00')
+        self.order.save()
+
+        _cancel_order(self.order, cancellation_fee=Decimal('5.00'), send_mail=False)
+
+        self.order.refresh_from_db()
+        payment_fee.refresh_from_db()
+        assert payment_fee.canceled
+        assert self.order.total == Decimal('5.00')
+        assert self.order.fees.get().fee_type == OrderFee.FEE_TYPE_CANCELLATION
+
+    @classscope(attr='o')
+    def test_cancel_removes_cancellation_requests(self):
+        self.order.cancellation_requests.create(cancellation_fee=Decimal('5.00'), refund_as_giftcard=False)
+        _cancel_order(self.order, cancellation_fee=Decimal('5.00'), send_mail=False)
+        assert not self.order.cancellation_requests.exists()
