+def _cancel_order(order, user=None, send_mail: bool=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order, either completely or, if ``cancellation_fee`` is given, except for a cancellation fee.
+
+    :param order: The order to cancel (or its primary key)
+    :param user: The user performing the cancellation (or their primary key)
+    :param send_mail: Whether the customer should be notified by email
+    :param api_token: The team API token performing the cancellation (or its primary key)
+    :param device: The device performing the cancellation (or its primary key)
+    :param oauth_application: The OAuth application performing the cancellation (or its primary key)
+    :param cancellation_fee: If set, all positions and fees are canceled except for a cancellation fee of this value,
+                             which the customer still has to pay or which is kept from what they already paid. Fees
+                             passed in ``keep_fees`` are not canceled and count towards this value.
+    :param keep_fees: Order fees that are kept when ``cancellation_fee`` is set
+    :param cancel_invoice: Whether the current invoice is canceled (and a new one with the cancellation fee issued)
+    :param comment: A comment that is added to the log entry and the email
+    :param tax_mode: ``'net'`` or ``'gross'``, whether ``cancellation_fee`` is a net or gross value. Defaults to gross.
+                     Only used if the cancellation fee is taxed with the default tax rate of the event.
+    :return: The primary key of the order
+    """
+    if isinstance(order, int):
+        order = Order.objects.get(pk=order)
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    auth = api_token or device or oauth_application
+    if cancellation_fee is not None:
+        cancellation_fee = Decimal(cancellation_fee)
+    keep_fee_ids = {f.pk for f in keep_fees or []}
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order.pk)
+        if not order.cancel_allowed():
+            raise OrderError(_('You cannot cancel this order.'))
+
+        if cancellation_fee:
+            if cancellation_fee < Decimal('0.00'):
+                raise OrderError(_('The cancellation fee cannot be negative.'))
+            if cancellation_fee > order.total:
+                raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+            ocm = OrderChangeManager(order, user=user, auth=auth, notify=False, reissue_invoice=cancel_invoice,
+                                     allow_empty_order=True)
+            positions = list(order.positions.filter(addon_to__isnull=True))
+            for p in positions:
+                ocm.cancel(p)
+
+            kept_sum = Decimal('0.00')
+            for f in order.fees.filter(canceled=False):
+                if f.pk in keep_fee_ids:
+                    kept_sum += f.value
+                else:
+                    ocm.cancel_fee(f)
+
+            fee_diff = cancellation_fee - kept_sum
+            if fee_diff > Decimal('0.00'):
+                tax_rule_zero = TaxRule.zero()
+                try:
+                    ia = order.invoice_address
+                except InvoiceAddress.DoesNotExist:
+                    ia = None
+
+                if order.event.settings.tax_rule_cancellation == "default":
+                    fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, fee_diff, tax_mode or 'gross')]
+                elif order.event.settings.tax_rule_cancellation == "split":
+                    fee_values = [(t, p, 'gross') for t, p in split_fee_for_taxes(positions, fee_diff, order.event)]
+                else:
+                    fee_values = [(tax_rule_zero, fee_diff, 'gross')]
+
+                for tax_rule, price, base_price_is in fee_values:
+                    tax_rule = tax_rule or tax_rule_zero
+                    tax = tax_rule.tax(price, invoice_address=ia, base_price_is=base_price_is)
+                    ocm.add_fee(OrderFee(
+                        fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                        value=tax.gross,
+                        order=order,
+                        tax_rate=tax.rate,
+                        tax_code=tax.code,
+                        tax_value=tax.tax,
+                        tax_rule=tax_rule,
+                    ))
+            ocm.commit()
+
+            order.cancellation_date = now()
+            order.save(update_fields=['cancellation_date'])
+            order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+                'comment': comment,
+                'cancellation_fee': cancellation_fee,
+            })
+        else:
+            order.status = Order.STATUS_CANCELED
+            order.cancellation_date = now()
+            order.save(update_fields=['status', 'cancellation_date'])
+            order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+                'comment': comment,
+            })
+
+            open_payment = order.payments.last()
+            if open_payment and open_payment.state not in (OrderPayment.PAYMENT_STATE_CONFIRMED,
+                                                           OrderPayment.PAYMENT_STATE_REFUNDED):
+                try:
+                    open_payment.payment_provider.cancel_payment(open_payment)
+                    order.log_action('pretix.event.order.payment.canceled', {
+                        'local_id': open_payment.local_id,
+                        'provider': open_payment.provider,
+                    }, user=user, auth=auth)
+                except PaymentException as e:
+                    order.log_action('pretix.event.order.payment.canceled.failed', {
+                        'local_id': open_payment.local_id,
+                        'provider': open_payment.provider,
+                        'error': str(e)
+                    }, user=user, auth=auth)
+
+            i = order.invoices.filter(is_cancellation=False).last()
+            if i and cancel_invoice and not i.canceled:
+                generate_cancellation(i)
+
+            for position in order.positions.all():
+                if position.voucher:
+                    Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+            order.create_transactions()
+
+        order.cancellation_requests.all().delete()
+
+    order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user, auth=auth,
+            )
+
+    return order.pk
+
+
 @app.task(base=ProfiledTask, bind=True, max_retries=5, default_retry_delay=1, throws=(OrderError,))
 @scopes_disabled()
 def cancel_order(self, order: int, user: int=None, send_mail: bool=True, api_token=None, oauth_application=None,
