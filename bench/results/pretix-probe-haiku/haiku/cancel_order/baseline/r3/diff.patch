+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, LogEntry, Order, OrderPosition, Organizer, User,
+)
+from pretix.base.models.orders import OrderFee
+from pretix.base.models.tax import TaxRule
+from pretix.base.services.invoices import generate_invoice
+from pretix.base.services.orders import OrderError, _cancel_order
+
+
+@pytest.fixture(scope='function')
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now(),
+    )
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def item(event):
+    return event.items.create(name='Ticket', default_price=Decimal('23.00'), admission=True)
+
+
+def _create_order(event, status=Order.STATUS_PENDING, total=Decimal('23.00'), positions=1, item=None):
+    o = Order.objects.create(
+        code='FOO', event=event, email='dummy@example.org', status=status, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10), total=total,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    for _ in range(positions):
+        OrderPosition.objects.create(order=o, item=item, variation=None, price=Decimal('23.00'))
+    return o
+
+
+def _has_canceled_log(order):
+    return LogEntry.objects.filter(object_id=order.pk, action_type='pretix.event.order.canceled').exists()
+
+
+@pytest.mark.django_db
+def test_cancel_completely_pending_order(event, item):
+    o = _create_order(event, item=item)
+    djmail.outbox = []
+
+    assert _cancel_order(o.pk) == o.pk
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_CANCELED
+    assert o.cancellation_date is not None
+    assert _has_canceled_log(o)
+    assert o.positions.count() == 1  # positions are kept as they are on a complete cancellation
+    assert len(djmail.outbox) == 1
+    assert o.email in djmail.outbox[0].to
+
+
+@pytest.mark.django_db
+def test_cancel_completely_without_email(event, item):
+    o = _create_order(event, item=item)
+    djmail.outbox = []
+
+    _cancel_order(o, send_mail=False)
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_CANCELED
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_completely_records_user_and_comment(event, item):
+    user = User.objects.create_user('admin@example.org', 'dummy')
+    o = _create_order(event, item=item)
+
+    _cancel_order(o.pk, user=user.pk, comment='Sorry for the trouble', send_mail=False)
+
+    entry = LogEntry.objects.get(object_id=o.pk, action_type='pretix.event.order.canceled')
+    assert entry.user == user
+    assert entry.parsed_data['comment'] == 'Sorry for the trouble'
+
+
+@pytest.mark.django_db
+def test_cancel_completely_cancels_invoice(event, item):
+    o = _create_order(event, status=Order.STATUS_PAID, item=item)
+    generate_invoice(o)
+    assert o.invoices.filter(is_cancellation=False).count() == 1
+
+    _cancel_order(o.pk, send_mail=False)
+
+    assert o.invoices.filter(is_cancellation=True).count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_completely_keeps_invoice_if_requested(event, item):
+    o = _create_order(event, status=Order.STATUS_PAID, item=item)
+    generate_invoice(o)
+
+    _cancel_order(o.pk, send_mail=False, cancel_invoice=False)
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_CANCELED
+    assert o.invoices.filter(is_cancellation=True).count() == 0
+
+
+@pytest.mark.django_db
+def test_cancel_completely_releases_voucher(event, item):
+    v = event.vouchers.create(code='ABC', item=item, redeemed=1)
+    o = _create_order(event, item=item)
+    o.positions.update(voucher=v)
+
+    _cancel_order(o.pk, send_mail=False)
+
+    v.refresh_from_db()
+    assert v.redeemed == 0
+
+
+@pytest.mark.django_db
+def test_cancel_not_allowed_for_canceled_order(event, item):
+    o = _create_order(event, status=Order.STATUS_CANCELED, item=item)
+
+    with pytest.raises(OrderError):
+        _cancel_order(o.pk, send_mail=False)
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_CANCELED
+    assert not _has_canceled_log(o)
+
+
+@pytest.mark.django_db
+def test_cancel_with_zero_fee_cancels_completely(event, item):
+    o = _create_order(event, item=item)
+
+    _cancel_order(o.pk, cancellation_fee=Decimal('0.00'), send_mail=False)
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_CANCELED
+    assert not o.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_only_the_fee(event, item):
+    o = _create_order(event, total=Decimal('48.50'), positions=2, item=item)
+    payment_fee = o.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.50'))
+    djmail.outbox = []
+
+    assert _cancel_order(o.pk, cancellation_fee=Decimal('5.00'), send_mail=False) == o.pk
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+    assert o.cancellation_date is not None
+    assert o.positions.count() == 0
+    assert _has_canceled_log(o)
+    assert o.total == Decimal('5.00')
+    payment_fee.refresh_from_db()
+    assert payment_fee.canceled
+    cancellation_fee = o.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert cancellation_fee.value == Decimal('5.00')
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_given_fees(event, item):
+    o = _create_order(event, total=Decimal('48.50'), positions=2, item=item)
+    kept = o.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.50'))
+    dropped = o.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('3.00'))
+
+    _cancel_order(o.pk, cancellation_fee=Decimal('10.00'), keep_fees=[kept], send_mail=False)
+
+    o.refresh_from_db()
+    kept.refresh_from_db()
+    dropped.refresh_from_db()
+    assert not kept.canceled
+    assert dropped.canceled
+    assert o.total == Decimal('10.00')
+    # The kept fee counts towards the cancellation fee, so only the remainder is added as a new fee
+    assert o.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION).value == Decimal('7.50')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_is_refused_above_order_total(event, item):
+    o = _create_order(event, total=Decimal('23.00'), item=item)
+
+    with pytest.raises(OrderError):
+        _cancel_order(o.pk, cancellation_fee=Decimal('24.00'), send_mail=False)
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+    assert o.positions.count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_resolves_pending_cancellation_requests(event, item):
+    o = _create_order(event, total=Decimal('23.00'), item=item)
+    o.cancellation_requests.create(cancellation_fee=Decimal('4.00'), refund_as_giftcard=True)
+
+    _cancel_order(o.pk, cancellation_fee=Decimal('4.00'), send_mail=False)
+
+    assert not o.cancellation_requests.exists()
+
+
+@pytest.mark.django_db
+def test_cancel_completely_resolves_pending_cancellation_requests(event, item):
+    o = _create_order(event, total=Decimal('23.00'), item=item)
+    o.cancellation_requests.create(cancellation_fee=Decimal('4.00'), refund_as_giftcard=True)
+
+    _cancel_order(o.pk, send_mail=False)
+
+    assert not o.cancellation_requests.exists()
+
+
+@pytest.mark.django_db
+def test_cancel_with_negative_fee_is_refused(event, item):
+    o = _create_order(event, total=Decimal('23.00'), item=item)
+
+    with pytest.raises(OrderError):
+        _cancel_order(o.pk, cancellation_fee=Decimal('-1.00'), send_mail=False)
+
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+    assert o.positions.count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_taxed_with_default_rate(event, item):
+    TaxRule.objects.create(event=event, name='VAT', rate=Decimal('20.00'), default=True)
+    event.settings.set('tax_rule_cancellation', 'default')
+    o = _create_order(event, total=Decimal('23.00'), item=item)
+
+    _cancel_order(o.pk, cancellation_fee=Decimal('12.00'), tax_mode='net', send_mail=False)
+
+    fee = o.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert fee.value == Decimal('14.40')
+    assert fee.tax_value == Decimal('2.40')
+    assert fee.tax_rate == Decimal('20.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_taxed_as_gross_by_default(event, item):
+    TaxRule.objects.create(event=event, name='VAT', rate=Decimal('20.00'), default=True)
+    event.settings.set('tax_rule_cancellation', 'default')
+    o = _create_order(event, total=Decimal('23.00'), item=item)
+
+    _cancel_order(o.pk, cancellation_fee=Decimal('12.00'), send_mail=False)
+
+    fee = o.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert fee.value == Decimal('12.00')
+    assert fee.tax_value == Decimal('2.00')
