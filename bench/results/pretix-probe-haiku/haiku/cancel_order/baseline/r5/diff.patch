+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, Item, Order, OrderPosition, Organizer, Voucher,
+)
+from pretix.base.models.orders import OrderFee, OrderPayment
+from pretix.base.services.invoices import generate_invoice
+from pretix.base.services.orders import OrderError, _cancel_order, cancel_order
+
+
+@pytest.fixture
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now(),
+        plugins='pretix.plugins.banktransfer'
+    )
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def item(event):
+    return Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+
+
+@pytest.fixture
+def order(event, item):
+    o = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=Decimal('46.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    OrderPosition.objects.create(
+        order=o, item=item, variation=None, price=Decimal('23.00'),
+        attendee_name_parts={'full_name': "Peter"}, positionid=1,
+    )
+    OrderPosition.objects.create(
+        order=o, item=item, variation=None, price=Decimal('23.00'),
+        attendee_name_parts={'full_name': "Dieter"}, positionid=2,
+    )
+    return o
+
+
+def _pay(order, amount):
+    order.payments.create(amount=Decimal(amount), state=OrderPayment.PAYMENT_STATE_CONFIRMED, provider='banktransfer')
+
+
+@pytest.mark.django_db
+def test_cancel_full(event, order):
+    with scope(organizer=event.organizer):
+        assert _cancel_order(order.pk, send_mail=False) == order.pk
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_CANCELED
+        assert order.cancellation_date is not None
+        assert order.positions.count() == 2
+        assert not order.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+        assert order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+
+
+@pytest.mark.django_db
+def test_cancel_full_accepts_order_object(event, order):
+    with scope(organizer=event.organizer):
+        assert _cancel_order(order, send_mail=False) == order.pk
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_CANCELED
+
+
+@pytest.mark.django_db
+def test_cancel_full_sends_mail(event, order):
+    djmail.outbox = []
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, comment="Sorry")
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    assert order.all_logentries().filter(action_type='pretix.event.order.email.order_canceled').exists()
+
+
+@pytest.mark.django_db
+def test_cancel_full_no_mail(event, order):
+    djmail.outbox = []
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_full_releases_voucher(event, order, item):
+    v = Voucher.objects.create(event=event, code='ABC', redeemed=1, max_usages=1)
+    order.positions.filter(positionid=1).update(voucher=v)
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False)
+    v.refresh_from_db()
+    assert v.redeemed == 0
+
+
+@pytest.mark.django_db
+def test_cancel_full_cancels_invoice(event, order):
+    with scope(organizer=event.organizer):
+        generate_invoice(order)
+        _cancel_order(order.pk, send_mail=False)
+        assert order.invoices.filter(is_cancellation=True).count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_full_keeps_invoice_if_requested(event, order):
+    with scope(organizer=event.organizer):
+        generate_invoice(order)
+        _cancel_order(order.pk, send_mail=False, cancel_invoice=False)
+        assert not order.invoices.filter(is_cancellation=True).exists()
+
+
+@pytest.mark.django_db
+def test_cancel_full_cancels_open_payment(event, order):
+    p = order.payments.create(amount=Decimal('46.00'), state=OrderPayment.PAYMENT_STATE_CREATED, provider='banktransfer')
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False)
+    p.refresh_from_db()
+    assert p.state == OrderPayment.PAYMENT_STATE_CANCELED
+
+
+@pytest.mark.django_db
+def test_cancel_not_allowed_for_canceled_order(event, order):
+    order.status = Order.STATUS_CANCELED
+    order.save()
+    with scope(organizer=event.organizer):
+        with pytest.raises(OrderError):
+            _cancel_order(order.pk, send_mail=False)
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_pending_order(event, order):
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('5.00'))
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PENDING
+        assert order.total == Decimal('5.00')
+        assert order.positions.count() == 0
+        assert order.all_positions.filter(canceled=True).count() == 2
+        fee = order.fees.get()
+        assert fee.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+        assert fee.value == Decimal('5.00')
+        assert not order.cancel_allowed()
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_paid_order_stays_paid_with_refund_due(event, order):
+    _pay(order, '46.00')
+    order.status = Order.STATUS_PAID
+    order.save()
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('10.00'))
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PAID
+        assert order.total == Decimal('10.00')
+        assert order.pending_sum == Decimal('-36.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_covered_by_payment_becomes_paid(event, order):
+    _pay(order, '12.00')
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('12.00'))
+        order.refresh_from_db()
+        assert order.total == Decimal('12.00')
+        assert order.status == Order.STATUS_PAID
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_given_fees(event, order):
+    payment_fee = order.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.50'))
+    order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('2.50'))
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('10.00'), keep_fees=[payment_fee])
+        order.refresh_from_db()
+        assert order.total == Decimal('10.00')
+        assert order.all_fees.get(fee_type=OrderFee.FEE_TYPE_SHIPPING).canceled
+        assert not order.all_fees.get(fee_type=OrderFee.FEE_TYPE_PAYMENT).canceled
+        # The kept payment fee counts towards the requested total, so the new fee only covers the rest
+        assert order.all_fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION).value == Decimal('7.50')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_tax_mode_none(event, order):
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('5.00'), tax_mode='none')
+        fee = order.fees.get()
+        assert fee.tax_rate == Decimal('0.00')
+        assert fee.tax_value == Decimal('0.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_sends_mail_and_logs_cancel(event, order):
+    djmail.outbox = []
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, cancellation_fee=Decimal('5.00'), comment="Partly canceled")
+        assert order.all_logentries().filter(action_type='pretix.event.order.changed.cancel').count() == 2
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_higher_than_total_not_allowed(event, order):
+    with scope(organizer=event.organizer):
+        with pytest.raises(OrderError):
+            _cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('100.00'))
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_PENDING
+        assert order.positions.count() == 2
+
+
+@pytest.mark.django_db
+def test_cancel_removes_cancellation_requests(event, order):
+    order.cancellation_requests.create(cancellation_fee=Decimal('4.00'), refund_as_giftcard=False)
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False)
+    assert not order.cancellation_requests.exists()
+
+
+@pytest.mark.django_db
+def test_cancel_zero_fee_is_full_cancel(event, order):
+    with scope(organizer=event.organizer):
+        _cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('0.00'))
+        order.refresh_from_db()
+        assert order.status == Order.STATUS_CANCELED
+        assert not order.fees.exists()
+
+
+@pytest.mark.django_db
+def test_cancel_order_task_with_fee(event, order):
+    with scope(organizer=event.organizer):
+        cancel_order(order.pk, send_mail=False, cancellation_fee=Decimal('5.00'))
+        order.refresh_from_db()
+        assert order.total == Decimal('5.00')
+        assert order.status == Order.STATUS_PENDING
