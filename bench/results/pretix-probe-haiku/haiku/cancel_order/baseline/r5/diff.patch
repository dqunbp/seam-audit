+def _cancel_order(order, user=None, send_mail: bool=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee``, the order is marked as canceled as a whole. With a
+    ``cancellation_fee``, all positions and all fees except ``keep_fees`` are canceled and the order is left with
+    a cancellation fee, so that its total equals the ``cancellation_fee``. The kept fees count towards that total.
+    The customer either still has to pay the rest or the rest is kept from what they already paid.
+
+    :param order: The order to cancel, or its primary key
+    :param user: The user that performed the cancellation, or their primary key
+    :param keep_fees: ``OrderFee`` objects of this order that are not canceled
+    :param tax_mode: How to tax the new cancellation fee (``none``, ``split`` or ``default``). Defaults to the
+                     ``tax_rule_cancellation`` event setting.
+    :return: The primary key of the order
+    """
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    auth = device or oauth_application or api_token
+    order_pk = order if isinstance(order, int) else order.pk
+    if cancellation_fee is not None:
+        cancellation_fee = Decimal(cancellation_fee)
+    keep_fees = list(keep_fees or [])
+    partial = cancellation_fee is not None and (cancellation_fee > Decimal('0.00') or bool(keep_fees))
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order_pk)
+        if not order.cancel_allowed():
+            raise OrderError(_('You cannot cancel this order.'))
+        if partial and cancellation_fee > order.total:
+            raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+        order.cancellation_requests.all().delete()
+        positions = list(order.positions.all())
+        for p in order.payments.filter(state__in=(OrderPayment.PAYMENT_STATE_CREATED, OrderPayment.PAYMENT_STATE_PENDING)):
+            if not p.payment_provider:
+                # The provider is no longer enabled, so there is nothing to abort on its side
+                p.state = OrderPayment.PAYMENT_STATE_CANCELED
+                p.save(update_fields=['state'])
+                continue
+            try:
+                p.payment_provider.cancel_payment(p)
+                order.log_action('pretix.event.order.payment.canceled', {
+                    'local_id': p.local_id,
+                    'provider': p.provider,
+                }, user=user, auth=auth)
+            except PaymentException as e:
+                order.log_action('pretix.event.order.payment.canceled.failed', {
+                    'local_id': p.local_id,
+                    'provider': p.provider,
+                    'error': str(e)
+                }, user=user, auth=auth)
+
+        for position in positions:
+            if position.voucher:
+                Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+            for gc in position.issued_gift_cards.all():
+                gc = GiftCard.objects.select_for_update(of=OF_SELF).get(pk=gc.pk)
+                if gc.value < position.price:
+                    raise OrderError(_(
+                        'A position can not be canceled since the gift card {card} purchased in this order has '
+                        'already been redeemed.').format(card=gc.secret)
+                    )
+                gc.transactions.create(value=-position.price, order=order, acceptor=order.event.organizer)
+                gc.log_action(
+                    action='pretix.giftcards.transaction.manual',
+                    user=user,
+                    auth=auth,
+                    data={
+                        'value': -position.price,
+                        'acceptor_id': order.event.organizer.id,
+                        'acceptor_slug': order.event.organizer.slug
+                    }
+                )
+
+            for m in position.granted_memberships.with_usages().all():
+                m.canceled = True
+                m.save()
+
+            if partial:
+                order.log_action('pretix.event.order.changed.cancel', user=user, auth=auth, data={
+                    'position': position.pk,
+                    'positionid': position.positionid,
+                    'old_item': position.item.pk,
+                    'old_variation': position.variation.pk if position.variation else None,
+                    'old_price': position.price,
+                    'addon_to': position.addon_to_id,
+                })
+                position.canceled = True
+                assign_ticket_secret(
+                    event=order.event, position=position, force_invalidate_if_revokation_list_used=True,
+                    force_invalidate=False, save=False
+                )
+                position.save(update_fields=['canceled', 'secret'])
+
+        kept_sum = Decimal('0.00')
+        keep_fee_pks = {f.pk for f in keep_fees}
+        for fee in order.fees.all():
+            if fee.pk in keep_fee_pks:
+                kept_sum += fee.value
+            elif partial:
+                fee.canceled = True
+                fee.save(update_fields=['canceled'])
+
+        invoice_canceled = False
+        if partial:
+            fee_value = max(Decimal('0.00'), cancellation_fee - kept_sum)
+            if fee_value:
+                tax_mode = tax_mode or order.event.settings.tax_rule_cancellation
+                tax_rule_zero = TaxRule.zero()
+                if tax_mode == 'default':
+                    fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, fee_value)]
+                elif tax_mode == 'split':
+                    fee_values = split_fee_for_taxes(positions, fee_value, order.event)
+                else:
+                    fee_values = [(tax_rule_zero, fee_value)]
+
+                try:
+                    ia = order.invoice_address
+                except InvoiceAddress.DoesNotExist:
+                    ia = None
+
+                for tax_rule, price in fee_values:
+                    tax_rule = tax_rule or tax_rule_zero
+                    tax = tax_rule.tax(price, invoice_address=ia, base_price_is="gross")
+                    OrderFee(
+                        fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                        value=price,
+                        order=order,
+                        tax_rate=tax.rate,
+                        tax_code=tax.code,
+                        tax_value=tax.tax,
+                        tax_rule=tax_rule,
+                    ).save()
+
+            order.total = order.fees.aggregate(s=Sum('value'))['s'] or Decimal('0.00')
+            if order.status == Order.STATUS_PENDING and not order.require_approval and order.pending_sum <= Decimal('0.00'):
+                order.status = Order.STATUS_PAID
+            order.save(update_fields=['total', 'status'])
+        else:
+            order.status = Order.STATUS_CANCELED
+            order.cancellation_date = now()
+            order.save(update_fields=['status', 'cancellation_date'])
+
+        if cancel_invoice:
+            i = order.invoices.filter(is_cancellation=False).last()
+            if i and not i.refered.exists():
+                generate_cancellation(i)
+                invoice_canceled = True
+
+        if partial and invoice_canceled and invoice_qualified(order) and (
+            order.event.settings.invoice_generate == 'True' or
+            (order.event.settings.invoice_generate == 'paid' and order.status == Order.STATUS_PAID)
+        ):
+            generate_invoice(order)
+
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+            'comment': comment,
+        })
+        order.create_transactions()
+
+    tickets.invalidate_cache.apply_async(kwargs={'event': order.event_id, 'order': order.pk})
+
+    if partial:
+        order_changed.send(order.event, order=order)
+    else:
+        order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user, auth=auth,
+            )
+
+    return order.pk
+
+
 @app.task(base=ProfiledTask, bind=True, max_retries=5, default_retry_delay=1, throws=(OrderError,))
 @scopes_disabled()
 def cancel_order(self, order: int, user: int=None, send_mail: bool=True, api_token=None, oauth_application=None,
