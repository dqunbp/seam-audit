+from datetime import timedelta
+from decimal import Decimal
+
+from django.core import mail as djmail
+from django.test import TestCase
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, Item, Order, OrderPosition, Organizer, Voucher,
+)
+from pretix.base.models.orders import OrderFee, OrderPayment
+from pretix.base.services.invoices import generate_invoice
+from pretix.base.services.orders import OrderError, _cancel_order
+from pretix.testutils.scope import classscope
+
+
+class CancelOrderTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(organizer=self.o, name='Dummy', slug='dummy', date_from=now(),
+                                              plugins='tests.testdummy')
+            self.order = Order.objects.create(
+                code='FOO', event=self.event, email='dummy@dummy.test',
+                status=Order.STATUS_PENDING, locale='en',
+                datetime=now(), expires=now() + timedelta(days=10),
+                sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+                total=Decimal('46.00'),
+            )
+            self.ticket = Item.objects.create(event=self.event, name='Early-bird ticket',
+                                              default_price=Decimal('23.00'), admission=True)
+            self.op1 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+            )
+            self.op2 = OrderPosition.objects.create(
+                order=self.order, item=self.ticket, variation=None,
+                price=Decimal("23.00"), attendee_name_parts={'full_name': "Dieter"}, positionid=2
+            )
+            self.order.create_transactions()
+            djmail.outbox = []
+
+    def _pay(self, amount=Decimal('46.00')):
+        self.order.payments.create(
+            amount=amount,
+            state=OrderPayment.PAYMENT_STATE_CONFIRMED,
+            provider='manual',
+        )
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+
+    @classscope(attr='o')
+    def test_full_cancel(self):
+        self._pay()
+        assert _cancel_order(self.order.pk, send_mail=False) == self.order.pk
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert self.order.cancellation_date is not None
+        assert self.order.pending_sum == Decimal('-46.00')
+        assert self.order.positions.count() == 2
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+
+    @classscope(attr='o')
+    def test_full_cancel_cancels_invoice(self):
+        generate_invoice(self.order)
+        self._pay()
+        _cancel_order(self.order, send_mail=False, cancel_invoice=True)
+        self.order.refresh_from_db()
+        assert self.order.invoices.filter(is_cancellation=True).exists()
+
+    @classscope(attr='o')
+    def test_full_cancel_keeps_invoice_if_not_requested(self):
+        generate_invoice(self.order)
+        self._pay()
+        _cancel_order(self.order, send_mail=False, cancel_invoice=False)
+        self.order.refresh_from_db()
+        assert not self.order.invoices.filter(is_cancellation=True).exists()
+
+    @classscope(attr='o')
+    def test_full_cancel_releases_voucher(self):
+        v = Voucher.objects.create(event=self.event, code='ABC', redeemed=1)
+        self.op1.voucher = v
+        self.op1.save()
+        self._pay()
+        _cancel_order(self.order.pk, send_mail=False)
+        v.refresh_from_db()
+        assert v.redeemed == 0
+
+    @classscope(attr='o')
+    def test_full_cancel_deletes_cancellation_requests(self):
+        self._pay()
+        self.order.cancellation_requests.create(cancellation_fee=Decimal('4.00'), refund_as_giftcard=False)
+        _cancel_order(self.order.pk, send_mail=False)
+        assert not self.order.cancellation_requests.exists()
+
+    @classscope(attr='o')
+    def test_already_canceled(self):
+        self.order.status = Order.STATUS_CANCELED
+        self.order.save()
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order.pk, send_mail=False)
+
+    @classscope(attr='o')
+    def test_send_mail(self):
+        self._pay()
+        _cancel_order(self.order.pk, send_mail=True, comment='Sorry')
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_no_mail(self):
+        self._pay()
+        _cancel_order(self.order.pk, send_mail=False)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_cancellation_fee_keeps_paid_order_paid(self):
+        self._pay()
+        _cancel_order(self.order.pk, send_mail=False, cancellation_fee=Decimal('6.00'))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+        assert self.order.total == Decimal('6.00')
+        assert self.order.pending_sum == Decimal('-40.00')
+        f = self.order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        assert f.value == Decimal('6.00')
+        assert self.order.positions.count() == 0
+
+    @classscope(attr='o')
+    def test_cancellation_fee_keeps_only_kept_fees(self):
+        shipping = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('2.50'))
+        payment = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.50'))
+        self.order.total = Decimal('51.00')
+        self.order.save()
+        self._pay(amount=Decimal('51.00'))
+        _cancel_order(self.order.pk, send_mail=False, cancellation_fee=Decimal('6.60'), keep_fees=[payment])
+        shipping.refresh_from_db()
+        payment.refresh_from_db()
+        assert shipping.canceled
+        assert not payment.canceled
+        cf = self.order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        assert cf.value == Decimal('4.10')
+        self.order.refresh_from_db()
+        assert self.order.total == Decimal('6.60')
+        assert self.order.status == Order.STATUS_PAID
+
+    @classscope(attr='o')
+    def test_cancellation_fee_too_high(self):
+        self._pay()
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order.pk, send_mail=False, cancellation_fee=Decimal('700.00'))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+        assert self.order.positions.count() == 2
+        assert not self.order.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+
+    @classscope(attr='o')
+    def test_cancellation_fee_pending_order_stays_pending(self):
+        _cancel_order(self.order.pk, send_mail=False, cancellation_fee=Decimal('7.00'))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.total == Decimal('7.00')
+        assert self.order.pending_sum == Decimal('7.00')
+
+    @classscope(attr='o')
+    def test_cancellation_fee_tax_mode_zero(self):
+        self._pay()
+        _cancel_order(self.order.pk, send_mail=False, cancellation_fee=Decimal('6.00'), tax_mode='zero')
+        f = self.order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        assert f.tax_value == Decimal('0.00')
+
+    @classscope(attr='o')
+    def test_cancellation_fee_with_mail(self):
+        self._pay()
+        _cancel_order(self.order.pk, send_mail=True, cancellation_fee=Decimal('6.00'))
+        assert len(djmail.outbox) == 1
