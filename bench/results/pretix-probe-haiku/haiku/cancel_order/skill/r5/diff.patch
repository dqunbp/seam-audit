+def _cancel_order(order, user=None, send_mail=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee``, the order is canceled completely. With a
+    ``cancellation_fee``, all positions and all fees except ``keep_fees`` are canceled instead, and the order keeps
+    a new cancellation fee so that the total still owed on it equals ``cancellation_fee``. The kept fees count
+    towards that total. The order then stays open, or it is marked paid if the payments already cover the total.
+
+    :param order: The order, or its primary key
+    :param user: The user performing the cancellation, or their primary key
+    :param send_mail: Whether to notify the customer
+    :param cancellation_fee: The total the customer keeps from the order, including the kept fees
+    :param keep_fees: The ``OrderFee`` objects that stay on the order if ``cancellation_fee`` is given. If not
+                      given, the fees of a paid order stay and the fees of an unpaid order are replaced.
+    :param cancel_invoice: Whether to cancel the current invoice of the order
+    :param comment: A comment passed on to the customer notification
+    :param tax_mode: How the cancellation fee is taxed (``default``, ``split`` or ``zero``). Defaults to the
+                     ``tax_rule_cancellation`` setting of the event.
+    :return: The primary key of the order
+    """
+    if isinstance(order, int):
+        order = Order.objects.get(pk=order)
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    if cancellation_fee is not None:
+        cancellation_fee = Decimal(str(cancellation_fee))
+    auth = api_token or device or oauth_application
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order.pk)
+        if order.status == Order.STATUS_CANCELED:
+            raise OrderError(_('This order has already been canceled.'))
+        if cancellation_fee and cancellation_fee > order.total:
+            raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+        positions = list(order.positions.all())
+        subevents = list(order.event.subevents.filter(
+            id__in=[p.subevent_id for p in positions if p.subevent_id]
+        ))
+        for position in positions:
+            for gc in position.issued_gift_cards.all():
+                gc = GiftCard.objects.select_for_update(of=OF_SELF).get(pk=gc.pk)
+                if gc.value < position.price:
+                    raise OrderError(_(
+                        'A position can not be canceled since the gift card {card} purchased in this order has '
+                        'already been redeemed.').format(
+                        card=gc.secret
+                    ))
+                gc.transactions.create(value=-position.price, order=order, acceptor=order.event.organizer)
+                gc.log_action(
+                    action='pretix.giftcards.transaction.manual',
+                    user=user,
+                    auth=auth,
+                    data={
+                        'value': -position.price,
+                        'acceptor_id': order.event.organizer.id,
+                        'acceptor_slug': order.event.organizer.slug
+                    }
+                )
+
+            for m in position.granted_memberships.with_usages().all():
+                m.canceled = True
+                m.save()
+
+            if position.voucher:
+                Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+            if cancellation_fee:
+                # Only a partial cancellation removes positions from the order. A complete cancellation keeps them
+                # on the canceled order, the same as ``deny_order`` does.
+                position.canceled = True
+                assign_ticket_secret(
+                    event=order.event, position=position, force_invalidate_if_revokation_list_used=True,
+                    force_invalidate=False, save=False
+                )
+                position.save(update_fields=['canceled', 'secret'])
+
+        if cancellation_fee:
+            if keep_fees is None:
+                # Fees of a paid order were already paid by the customer and stay, fees of an unpaid order are
+                # replaced by the cancellation fee.
+                kept_fees = list(order.fees.all()) if order.status == Order.STATUS_PAID else []
+            else:
+                kept_fees = [f for f in order.fees.all() if f in keep_fees]
+            for fee in order.fees.all():
+                if fee not in kept_fees:
+                    fee.canceled = True
+                    fee.save(update_fields=['canceled'])
+
+            fee_value = cancellation_fee - sum((f.value for f in kept_fees), Decimal('0.00'))
+            if fee_value > Decimal('0.00'):
+                tax_mode = tax_mode or order.event.settings.tax_rule_cancellation
+                tax_rule_zero = TaxRule.zero()
+                if tax_mode == "default":
+                    fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, fee_value)]
+                elif tax_mode == "split":
+                    fee_values = split_fee_for_taxes(positions, fee_value, order.event)
+                else:
+                    fee_values = [(tax_rule_zero, fee_value)]
+
+                try:
+                    ia = order.invoice_address
+                except InvoiceAddress.DoesNotExist:
+                    ia = None
+
+                for tax_rule, price in fee_values:
+                    tax_rule = tax_rule or tax_rule_zero
+                    tax = tax_rule.tax(price, invoice_address=ia, base_price_is="gross")
+                    order.fees.create(
+                        fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                        value=price,
+                        tax_rate=tax.rate,
+                        tax_code=tax.code,
+                        tax_value=tax.tax,
+                        tax_rule=tax_rule,
+                    )
+
+            order.total = sum((f.value for f in order.fees.filter(canceled=False)), Decimal('0.00'))
+            if order.pending_sum <= Decimal('0.00') and not order.require_approval:
+                order.status = Order.STATUS_PAID
+            elif order.status == Order.STATUS_PAID:
+                order.status = Order.STATUS_PENDING
+                order.set_expires(now(), subevents)
+        else:
+            order.status = Order.STATUS_CANCELED
+            order.cancellation_date = now()
+
+        if order.status != Order.STATUS_PAID:
+            open_payment = order.payments.last()
+            if open_payment and open_payment.state not in (OrderPayment.PAYMENT_STATE_CONFIRMED,
+                                                           OrderPayment.PAYMENT_STATE_REFUNDED):
+                try:
+                    open_payment.payment_provider.cancel_payment(open_payment)
+                    order.log_action('pretix.event.order.payment.canceled', {
+                        'local_id': open_payment.local_id,
+                        'provider': open_payment.provider,
+                    }, user=user, auth=auth)
+                except PaymentException as e:
+                    order.log_action('pretix.event.order.payment.canceled.failed', {
+                        'local_id': open_payment.local_id,
+                        'provider': open_payment.provider,
+                        'error': str(e)
+                    }, user=user, auth=auth)
+
+        if cancel_invoice:
+            i = order.invoices.filter(is_cancellation=False).last()
+            if i and not i.canceled:
+                generate_cancellation(i)
+
+        order.save(update_fields=['status', 'total', 'cancellation_date', 'expires'])
+        order.cancellation_requests.all().delete()
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth)
+        order.create_transactions()
+        order.touch()
+
+        if cancellation_fee and cancel_invoice and invoice_qualified(order):
+            try:
+                new_invoice = generate_invoice(order)
+            except Exception as e:
+                logger.exception("Could not generate invoice.")
+                order.log_action("pretix.event.order.invoice.failed", data={
+                    "exception": str(e)
+                })
+            else:
+                order.log_action('pretix.event.order.invoice.generated', data={
+                    'invoice': new_invoice.pk
+                })
+
+    if order.status == Order.STATUS_CANCELED:
+        order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user, auth=auth
+            )
+
+    return order.pk
+
+
 @app.task(base=ProfiledTask, bind=True, max_retries=5, default_retry_delay=1, throws=(OrderError,))
 @scopes_disabled()
 def cancel_order(self, order: int, user: int=None, send_mail: bool=True, api_token=None, oauth_application=None,
