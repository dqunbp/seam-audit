+import datetime
+from decimal import Decimal
+
+import pytest
+from django.core import mail
+from django.utils.timezone import now
+from django_scopes import scopes_disabled
+
+from pretix.base.models import (
+    Event, Item, Order, OrderFee, OrderPayment, OrderPosition, Organizer,
+    User,
+)
+from pretix.base.services.orders import OrderError, _cancel_order
+
+
+@pytest.fixture
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy')
+    return Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy', date_from=now(), live=True,
+    )
+
+
+@pytest.fixture
+def item(event):
+    return Item.objects.create(name='Test item', event=event, default_price=23)
+
+
+@pytest.fixture
+def order(event, item):
+    o = Order.objects.create(
+        event=event, status=Order.STATUS_PAID, expires=now() + datetime.timedelta(days=10),
+        total=Decimal('23.25'), code='FOO', email='dummy@dummy.test',
+        sales_channel=event.organizer.sales_channels.get(identifier="web"), datetime=now(), locale='en',
+    )
+    o.payments.create(provider='banktransfer', state=OrderPayment.PAYMENT_STATE_CONFIRMED, amount=Decimal('23.25'))
+    OrderPosition.objects.create(order=o, item=item, price=Decimal('23.00'))
+    o.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('0.25'))
+    return o
+
+
+@pytest.fixture
+def user(event):
+    return User.objects.create_user('dummy@dummy.dummy', 'dummy')
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_completely(order):
+    mail.outbox = []
+    assert _cancel_order(order, send_mail=True) == order.pk
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.cancellation_date is not None
+    assert order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+    assert len(mail.outbox) == 1
+    assert mail.outbox[0].to == ['dummy@dummy.test']
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_completely_without_mail(order):
+    mail.outbox = []
+    _cancel_order(order.pk, send_mail=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert len(mail.outbox) == 0
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_completely_resolves_cancellation_request(order):
+    order.cancellation_requests.create(cancellation_fee=Decimal('2.00'), refund_as_giftcard=False)
+    _cancel_order(order, send_mail=False)
+    assert not order.cancellation_requests.exists()
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_completely_not_allowed_twice(order):
+    _cancel_order(order, send_mail=False)
+    with pytest.raises(OrderError):
+        _cancel_order(order, send_mail=False)
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_with_fee_reduces_order_to_fee(order):
+    mail.outbox = []
+    _cancel_order(order, cancellation_fee=Decimal('6.00'), send_mail=True)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PAID
+    assert order.total == Decimal('6.00')
+    assert not order.positions.exists()
+    assert order.all_positions.exists()
+    # The payment fee is canceled as well and the cancellation fee holds the whole amount
+    fee = order.fees.get()
+    assert fee.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+    assert fee.value == Decimal('6.00')
+    assert len(mail.outbox) == 1
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_with_fee_keeps_given_fees(order):
+    kept = order.fees.get(fee_type=OrderFee.FEE_TYPE_PAYMENT)
+    _cancel_order(order, cancellation_fee=Decimal('6.00'), keep_fees=[kept], send_mail=False)
+    order.refresh_from_db()
+    assert order.total == Decimal('6.00')
+    kept.refresh_from_db()
+    assert not kept.canceled
+    # The cancellation fee only makes up the part of the fee that is not already kept
+    assert order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION).value == Decimal('5.75')
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_with_fee_applies_tax_setting(order, event):
+    event.tax_rules.create(rate=Decimal('19.00'), default=True)
+    event.settings.tax_rule_cancellation = 'default'
+    _cancel_order(order, cancellation_fee=Decimal('6.00'), send_mail=False)
+    fee = order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert fee.tax_rate == Decimal('19.00')
+    assert fee.tax_rule == event.tax_rules.get()
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_with_fee_above_total(order):
+    with pytest.raises(OrderError) as e:
+        _cancel_order(order, cancellation_fee=Decimal('700.00'), send_mail=False)
+    assert str(e.value) == 'The cancellation fee cannot be higher than the total amount of this order.'
+    order.refresh_from_db()
+    assert order.positions.exists()
+    assert order.total == Decimal('23.25')
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_with_fee_below_kept_fees(order):
+    kept = order.fees.get(fee_type=OrderFee.FEE_TYPE_PAYMENT)
+    with pytest.raises(OrderError):
+        _cancel_order(order, cancellation_fee=Decimal('0.10'), keep_fees=[kept], send_mail=False)
+    order.refresh_from_db()
+    assert order.positions.exists()
+
+
+@pytest.mark.django_db
+@scopes_disabled()
+def test_cancel_accepts_primary_keys_and_logs_actor(order, user):
+    _cancel_order(order.pk, user=user.pk, send_mail=False, cancellation_fee=Decimal('6.00'))
+    entry = order.all_logentries().filter(action_type='pretix.event.order.canceled').get()
+    assert entry.user == user
