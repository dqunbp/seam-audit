+def _cancel_order(order, user=None, send_mail: bool=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee`` the order is canceled completely. With one, all positions and all
+    fees except ``keep_fees`` are canceled and a cancellation fee is charged instead, so that the order's total
+    becomes ``cancellation_fee`` (kept fees included). The customer keeps the order, and the difference to what they
+    already paid can be refunded afterwards.
+    :param order: The order to cancel, or its primary key
+    :param user: The user that performed the cancellation, or their primary key
+    :param keep_fees: Fees that stay on the order and count towards ``cancellation_fee``
+    :param tax_mode: How to tax the cancellation fee, one of the values of the ``tax_rule_cancellation`` setting.
+                     Defaults to that setting.
+    :return: The primary key of the order
+    """
+    if isinstance(order, int):
+        order = Order.objects.get(pk=order)
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    auth = api_token or device or oauth_application
+    keep_fees = keep_fees or []
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order.pk)
+        if not order.cancel_allowed():
+            raise OrderError(_('The order is not allowed to be canceled.'))
+        if cancellation_fee and cancellation_fee > order.total:
+            raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+        if not cancellation_fee:
+            for p in order.payments.filter(state__in=(OrderPayment.PAYMENT_STATE_CREATED, OrderPayment.PAYMENT_STATE_PENDING)):
+                if not p.payment_provider:
+                    continue
+                try:
+                    p.payment_provider.cancel_payment(p)
+                    order.log_action('pretix.event.order.payment.canceled', {
+                        'local_id': p.local_id,
+                        'provider': p.provider,
+                    }, user=user, auth=auth)
+                except PaymentException as e:
+                    order.log_action('pretix.event.order.payment.canceled.failed', {
+                        'local_id': p.local_id,
+                        'provider': p.provider,
+                        'error': str(e)
+                    }, user=user, auth=auth)
+
+            order.status = Order.STATUS_CANCELED
+            order.save(update_fields=['status'])
+            for position in order.positions.all():
+                if position.voucher:
+                    Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+            i = order.invoices.filter(is_cancellation=False).last()
+            if cancel_invoice and i and not i.refered.exists():
+                generate_cancellation(i)
+            order.create_transactions()
+        else:
+            keep_pks = {f.pk for f in keep_fees}
+            kept_sum = sum((f.value for f in keep_fees), Decimal('0.00'))
+            positions = list(order.positions.all())
+            ocm = OrderChangeManager(order, user=user, auth=auth, notify=False, reissue_invoice=cancel_invoice,
+                                     allow_complete_cancel=True)
+            # Addons are canceled together with their parent position
+            for position in order.positions.filter(addon_to__isnull=True):
+                ocm.cancel(position)
+            for fee in order.fees.all():
+                if fee.pk not in keep_pks:
+                    ocm.cancel_fee(fee)
+
+            remaining = max(cancellation_fee - kept_sum, Decimal('0.00'))
+            if remaining:
+                tax_mode = tax_mode or order.event.settings.tax_rule_cancellation
+                tax_rule_zero = TaxRule.zero()
+                if tax_mode == 'default':
+                    fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, remaining)]
+                elif tax_mode == 'split':
+                    fee_values = split_fee_for_taxes(positions, remaining, order.event)
+                else:
+                    fee_values = [(tax_rule_zero, remaining)]
+
+                try:
+                    ia = order.invoice_address
+                except InvoiceAddress.DoesNotExist:
+                    ia = None
+
+                for tax_rule, price in fee_values:
+                    tax_rule = tax_rule or tax_rule_zero
+                    tax = tax_rule.tax(price, invoice_address=ia, base_price_is="gross")
+                    ocm.add_fee(OrderFee(
+                        fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                        value=price,
+                        order=order,
+                        tax_rate=tax.rate,
+                        tax_code=tax.code,
+                        tax_value=tax.tax,
+                        tax_rule=tax_rule,
+                    ))
+            ocm.commit()
+
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+            'comment': comment,
+        })
+
+    order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user, auth=auth
+            )
+
+    return order.pk
+
+
