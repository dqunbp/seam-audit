+class CancelOrderTests(BaseOrderChangeManagerTestCase, TestCase):
+    @classscope(attr='o')
+    def test_cancel_completely(self):
+        djmail.outbox = []
+        assert _cancel_order(self.order.pk, send_mail=True) == self.order.pk
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert self.order.positions.count() == 2
+        assert self.order.payments.get().state == OrderPayment.PAYMENT_STATE_CANCELED
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_cancel_completely_without_mail(self):
+        djmail.outbox = []
+        _cancel_order(self.order, send_mail=False)
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_cancel_completely_cancels_invoice(self):
+        generate_invoice(self.order)
+        _cancel_order(self.order, send_mail=False, cancel_invoice=True)
+        assert self.order.invoices.filter(is_cancellation=True).count() == 1
+
+    @classscope(attr='o')
+    def test_cancel_completely_keeps_invoice(self):
+        generate_invoice(self.order)
+        _cancel_order(self.order, send_mail=False, cancel_invoice=False)
+        assert self.order.invoices.filter(is_cancellation=True).count() == 0
+
+    @classscope(attr='o')
+    def test_cancel_twice_forbidden(self):
+        _cancel_order(self.order, send_mail=False)
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, send_mail=False)
+
+    @classscope(attr='o')
+    def test_cancel_fee_too_high(self):
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('47.00'))
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.positions.count() == 2
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_leaves_only_fee(self):
+        djmail.outbox = []
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('7.00'), tax_mode='none')
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.positions.count() == 0
+        assert self.order.total == Decimal('7.00')
+        fee = self.order.fees.get()
+        assert fee.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+        assert fee.value == Decimal('7.00')
+        assert fee.tax_value == Decimal('0.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_default_tax(self):
+        self.event.settings.tax_rule_cancellation = 'default'
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('7.00'))
+        fee = self.order.fees.get()
+        assert fee.tax_rule == self.tr19
+        assert fee.tax_rate == Decimal('19.00')
+        assert fee.tax_value == Decimal('1.12')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_keeps_fees_and_counts_them(self):
+        shipping = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('2.00'))
+        self.order.total = Decimal('48.00')
+        self.order.save()
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('5.00'), keep_fees=[shipping],
+                      tax_mode='none')
+        self.order.refresh_from_db()
+        assert self.order.total == Decimal('5.00')
+        shipping.refresh_from_db()
+        assert not shipping.canceled
+        assert self.order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION).value == Decimal('3.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_refund_amount(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        self.order.payments.create(
+            provider='banktransfer', state=OrderPayment.PAYMENT_STATE_CONFIRMED, amount=self.order.total
+        )
+        _cancel_order(self.order, send_mail=False, cancellation_fee=Decimal('7.00'), tax_mode='none')
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PAID
+        assert self.order.pending_sum == Decimal('-39.00')
+
