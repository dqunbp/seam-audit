+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import Event, Order, OrderPosition, Organizer, User
+from pretix.base.models.orders import OrderFee
+from pretix.base.services.invoices import generate_invoice
+from pretix.base.services.orders import OrderError, _cancel_order
+
+
+@pytest.fixture
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now(),
+        plugins='pretix.plugins.banktransfer'
+    )
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def user():
+    return User.objects.create_user('dummy@dummy.dummy', 'dummy')
+
+
+@pytest.fixture
+def item(event):
+    return event.items.create(name='Ticket', default_price=Decimal('20.00'))
+
+
+@pytest.fixture
+def taxrule(event):
+    return event.tax_rules.create(name="VAT", rate=19, code="S/standard", default=True)
+
+
+def _create_order(event, status=Order.STATUS_PENDING, total=Decimal('25.00')):
+    o = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=total,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    return o
+
+
+def _add_position(order, item, price=Decimal('20.00'), positionid=1):
+    return OrderPosition.objects.create(
+        order=order, item=item, variation=None, price=price, positionid=positionid,
+    )
+
+
+@pytest.fixture
+def order(event, item):
+    o = _create_order(event)
+    _add_position(o, item)
+    o.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('5.00'))
+    return o
+
+
+@pytest.mark.django_db
+def test_cancel_completely(event, order):
+    djmail.outbox = []
+    assert _cancel_order(order, send_mail=True) == order.pk
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.cancellation_date is not None
+    assert len(djmail.outbox) == 1
+    assert order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+    assert order.all_logentries().filter(action_type='pretix.event.order.email.order_canceled').exists()
+
+
+@pytest.mark.django_db
+def test_cancel_completely_without_mail(event, order):
+    djmail.outbox = []
+    _cancel_order(order, send_mail=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_completely_logs_comment(event, order):
+    _cancel_order(order, send_mail=False, comment="Sorry about this")
+    le = order.all_logentries().filter(action_type='pretix.event.order.canceled').get()
+    assert le.parsed_data['comment'] == "Sorry about this"
+
+
+@pytest.mark.django_db
+def test_cancel_completely_accepts_primary_keys(event, order, user):
+    assert _cancel_order(order.pk, user=user.pk, send_mail=False) == order.pk
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.all_logentries().get(action_type='pretix.event.order.canceled').user == user
+
+
+@pytest.mark.django_db
+def test_cancel_completely_cancels_invoice(event, order):
+    generate_invoice(order)
+    _cancel_order(order, send_mail=False, cancel_invoice=True)
+    assert order.invoices.filter(is_cancellation=True).count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_completely_keeps_invoice_if_requested(event, order):
+    generate_invoice(order)
+    _cancel_order(order, send_mail=False, cancel_invoice=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.invoices.filter(is_cancellation=True).count() == 0
+
+
+@pytest.mark.django_db
+def test_cancel_removes_cancellation_requests(event, order):
+    order.cancellation_requests.create(cancellation_fee=Decimal('2.00'), refund_as_giftcard=False)
+    _cancel_order(order, send_mail=False)
+    assert not order.cancellation_requests.exists()
+
+
+@pytest.mark.django_db
+def test_cancel_not_allowed_for_canceled_order(event, order):
+    order.status = Order.STATUS_CANCELED
+    order.save()
+    with pytest.raises(OrderError):
+        _cancel_order(order, send_mail=False)
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_order_open(event, item, order):
+    djmail.outbox = []
+    _cancel_order(order, send_mail=True, cancellation_fee=Decimal('7.00'), tax_mode='none')
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.total == Decimal('7.00')
+    assert not order.positions.exists()
+    fee = order.fees.get()
+    assert fee.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+    assert fee.value == Decimal('7.00')
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_kept_fees(event, item, order):
+    kept = order.fees.get()
+    _cancel_order(order, send_mail=False, cancellation_fee=Decimal('9.00'), keep_fees=[kept], tax_mode='none')
+    order.refresh_from_db()
+    assert order.total == Decimal('9.00')
+    kept.refresh_from_db()
+    assert not kept.canceled
+    cancellation = order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert cancellation.value == Decimal('4.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_only_kept_fees_without_new_fee(event, item, order):
+    kept = order.fees.get()
+    _cancel_order(order, send_mail=False, cancellation_fee=kept.value, keep_fees=[kept], tax_mode='none')
+    assert not order.fees.filter(fee_type=OrderFee.FEE_TYPE_CANCELLATION).exists()
+    assert order.fees.get().pk == kept.pk
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_higher_than_total(event, order):
+    djmail.outbox = []
+    with pytest.raises(OrderError):
+        _cancel_order(order, send_mail=True, cancellation_fee=Decimal('700.00'))
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.positions.count() == 1
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_tax_mode_overrides_setting(event, taxrule, order):
+    event.settings.tax_rule_cancellation = 'none'
+    _cancel_order(order, send_mail=False, cancellation_fee=Decimal('7.00'), tax_mode='default')
+    fee = order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert fee.tax_rate == taxrule.rate
+    assert fee.tax_value == Decimal('1.12')
+
+
+@pytest.mark.django_db
+def test_cancel_completely_gift_card_already_redeemed(event, item, order):
+    organizer = event.organizer
+    position = order.positions.get()
+    gc = organizer.issued_gift_cards.create(currency="EUR", issued_in=position)
+    gc.transactions.create(value=Decimal('20.00'), acceptor=organizer)
+    gc.transactions.create(value=Decimal('-1.00'), acceptor=organizer)
+    with pytest.raises(OrderError):
+        _cancel_order(order, send_mail=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
