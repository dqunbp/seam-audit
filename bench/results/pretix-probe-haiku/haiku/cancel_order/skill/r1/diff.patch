+def _make_pending_order_with_ticket_and_fee(event, code):
+    item = Item.objects.create(event=event, name="Ticket", default_price=10, admission=True)
+    o = Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING,
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=Decimal('12.00'), locale='en',
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    OrderPosition.objects.create(order=o, item=item, variation=None, price=Decimal('10.00'))
+    OrderFee.objects.create(order=o, fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.00'))
+    return o
+
+
+@pytest.mark.django_db
+def test_cancel_order_full(event):
+    djmail.outbox = []
+    event.settings.invoice_generate = 'True'
+    o1 = _make_pending_order_with_ticket_and_fee(event, 'FOO')
+    generate_invoice(o1)
+    assert _cancel_order(o1.pk) == o1.pk
+    o1.refresh_from_db()
+    assert o1.status == Order.STATUS_CANCELED
+    assert o1.positions.count() == 1
+    assert o1.invoices.count() == 2
+    assert o1.invoices.filter(is_cancellation=True).count() == 1
+    assert o1.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_cancel_order_full_without_invoice_cancellation(event):
+    djmail.outbox = []
+    event.settings.invoice_generate = 'True'
+    o1 = _make_pending_order_with_ticket_and_fee(event, 'FOO')
+    generate_invoice(o1)
+    _cancel_order(o1.pk, cancel_invoice=False, send_mail=False)
+    o1.refresh_from_db()
+    assert o1.status == Order.STATUS_CANCELED
+    assert o1.invoices.count() == 1
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_order_except_fee(event):
+    o1 = _make_pending_order_with_ticket_and_fee(event, 'FOO')
+    _cancel_order(o1.pk, cancellation_fee=Decimal('3.00'), send_mail=False)
+    o1.refresh_from_db()
+    assert o1.status == Order.STATUS_PENDING
+    assert o1.positions.count() == 0
+    assert o1.total == Decimal('3.00')
+    fees = list(o1.fees.all())
+    assert len(fees) == 1
+    assert fees[0].fee_type == OrderFee.FEE_TYPE_CANCELLATION
+    assert fees[0].value == Decimal('3.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_except_fee_keeps_kept_fees(event):
+    o1 = _make_pending_order_with_ticket_and_fee(event, 'FOO')
+    kept = o1.fees.get(fee_type=OrderFee.FEE_TYPE_PAYMENT)
+    _cancel_order(o1.pk, cancellation_fee=Decimal('3.00'), keep_fees=[kept], send_mail=False)
+    o1.refresh_from_db()
+    assert o1.total == Decimal('3.00')
+    assert o1.fees.get(fee_type=OrderFee.FEE_TYPE_PAYMENT).pk == kept.pk
+    assert o1.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION).value == Decimal('1.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_settles_cancellation_request(event):
+    o1 = _make_pending_order_with_ticket_and_fee(event, 'FOO')
+    o1.cancellation_requests.create(cancellation_fee=Decimal('0.00'))
+    _cancel_order(o1.pk, send_mail=False)
+    assert not o1.cancellation_requests.exists()
+
+
+@pytest.mark.django_db
+def test_cancel_order_already_canceled(event):
+    o1 = _make_pending_order_with_ticket_and_fee(event, 'FOO')
+    o1.status = Order.STATUS_CANCELED
+    o1.save()
+    with pytest.raises(OrderError):
+        _cancel_order(o1.pk)
+    o1.refresh_from_db()
+    assert o1.positions.count() == 1
+
+
