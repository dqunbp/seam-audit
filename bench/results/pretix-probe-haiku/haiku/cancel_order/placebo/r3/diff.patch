+def _cancel_order(order, user=None, send_mail: bool=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee``, the order is marked as canceled. With a ``cancellation_fee``,
+    all positions and all fees except the ``keep_fees`` are removed and a cancellation fee is added instead. The
+    order stays open until the cancellation fee is paid (or is covered by what has already been paid).
+    :param order: The primary key of the order to cancel
+    :param user: The user that performed the change
+    :param comment: A comment that is included in the notification email and the log entry
+    :param tax_mode: How the tax of the cancellation fee is determined, one of the values of the
+                     ``tax_rule_cancellation`` setting. Defaults to that setting.
+    :return: The primary key of the order
+    """
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    auth = api_token or device or oauth_application
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order.pk if isinstance(order, Order) else order)
+        if order.status == Order.STATUS_CANCELED:
+            raise OrderError(_('This order is already canceled.'))
+        order.cancellation_requests.all().delete()
+
+        if cancellation_fee:
+            if cancellation_fee > order.total:
+                raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+            positions = list(order.positions.all())
+            # Cancelling every position is intended here, the remaining cancellation fee keeps the order open.
+            ocm = OrderChangeManager(
+                order, user=user, auth=auth, notify=False, reissue_invoice=cancel_invoice,
+                allow_complete_cancel=True,
+            )
+            # Addons are cancelled together with their base position
+            for p in order.positions.filter(addon_to__isnull=True):
+                ocm.cancel(p)
+
+            keep_fee_pks = {f.pk for f in keep_fees or []}
+            kept_fee_sum = Decimal('0.00')
+            for f in order.fees.all():
+                if f.pk in keep_fee_pks:
+                    kept_fee_sum += f.value
+                else:
+                    ocm.cancel_fee(f)
+
+            # The cancellation fee is the total amount kept from the customer, so the kept fees are part of it
+            fee = round_decimal(max(cancellation_fee - kept_fee_sum, Decimal('0.00')), order.event.currency)
+            if fee:
+                tax_mode = tax_mode or order.event.settings.tax_rule_cancellation
+                tax_rule_zero = TaxRule.zero()
+                if tax_mode == "default":
+                    fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, fee)]
+                elif tax_mode == "split":
+                    fee_values = split_fee_for_taxes(positions, fee, order.event)
+                else:
+                    fee_values = [(tax_rule_zero, fee)]
+
+                try:
+                    ia = order.invoice_address
+                except InvoiceAddress.DoesNotExist:
+                    ia = None
+
+                for tax_rule, price in fee_values:
+                    tax_rule = tax_rule or tax_rule_zero
+                    tax = tax_rule.tax(price, invoice_address=ia, base_price_is="gross")
+                    ocm.add_fee(OrderFee(
+                        fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                        value=price,
+                        order=order,
+                        tax_rate=tax.rate,
+                        tax_code=tax.code,
+                        tax_value=tax.tax,
+                        tax_rule=tax_rule,
+                    ))
+            ocm.commit()
+        else:
+            for p in order.positions.filter(voucher__isnull=False):
+                Voucher.objects.filter(pk=p.voucher_id).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+            for p in order.payments.filter(state__in=(OrderPayment.PAYMENT_STATE_CREATED,
+                                                      OrderPayment.PAYMENT_STATE_PENDING)):
+                try:
+                    p.payment_provider.cancel_payment(p)
+                    order.log_action('pretix.event.order.payment.canceled', {
+                        'local_id': p.local_id,
+                        'provider': p.provider,
+                    }, user=user, auth=auth)
+                except PaymentException as e:
+                    order.log_action('pretix.event.order.payment.canceled.failed', {
+                        'local_id': p.local_id,
+                        'provider': p.provider,
+                        'error': str(e)
+                    }, user=user, auth=auth)
+
+            order.status = Order.STATUS_CANCELED
+            order.cancellation_date = now()
+            order.save(update_fields=['status', 'cancellation_date'])
+
+            if cancel_invoice:
+                i = order.invoices.filter(is_cancellation=False).last()
+                if i and not i.refered.exists():
+                    generate_cancellation(i)
+            order.create_transactions()
+
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth, api_token=api_token, data={
+            'comment': comment,
+        })
+
+    order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user
+            )
+
+    return order.pk
+
+
