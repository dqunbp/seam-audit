+class CancelOrderTests(BaseOrderChangeManagerTestCase, TestCase):
+    @classscope(attr='o')
+    def test_cancel_full(self):
+        assert _cancel_order(self.order.pk, send_mail=False) == self.order.pk
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_CANCELED
+        assert self.order.cancellation_date
+        assert self.order.positions.count() == 2
+        assert self.order.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+
+    @classscope(attr='o')
+    def test_cancel_full_already_canceled(self):
+        self.order.status = Order.STATUS_CANCELED
+        self.order.save()
+        with self.assertRaises(OrderError):
+            _cancel_order(self.order.pk, send_mail=False)
+
+    @classscope(attr='o')
+    def test_cancel_full_cancels_open_payments(self):
+        _cancel_order(self.order.pk, send_mail=False)
+        assert not self.order.payments.filter(
+            state__in=(OrderPayment.PAYMENT_STATE_CREATED, OrderPayment.PAYMENT_STATE_PENDING)
+        ).exists()
+
+    @classscope(attr='o')
+    def test_cancel_full_releases_voucher(self):
+        v = self.event.vouchers.create(item=self.ticket, redeemed=1)
+        self.op1.voucher = v
+        self.op1.save()
+        _cancel_order(self.order.pk, send_mail=False)
+        v.refresh_from_db()
+        assert v.redeemed == 0
+
+    @classscope(attr='o')
+    def test_cancel_full_cancels_invoice(self):
+        generate_invoice(self.order)
+        _cancel_order(self.order.pk, send_mail=False)
+        assert self.order.invoices.filter(is_cancellation=True).count() == 1
+
+    @classscope(attr='o')
+    def test_cancel_full_keeps_invoice_if_not_requested(self):
+        generate_invoice(self.order)
+        _cancel_order(self.order.pk, send_mail=False, cancel_invoice=False)
+        assert not self.order.invoices.filter(is_cancellation=True).exists()
+
+    @classscope(attr='o')
+    def test_cancel_full_sends_mail(self):
+        _cancel_order(self.order.pk, send_mail=True, comment="Sorry")
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+
+    @classscope(attr='o')
+    def test_cancel_full_no_mail(self):
+        _cancel_order(self.order.pk, send_mail=False)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_cancel_with_fee(self):
+        assert _cancel_order(self.order.pk, cancellation_fee=Decimal('5.00'), send_mail=False) == self.order.pk
+        self.order.refresh_from_db()
+        assert self.order.status == Order.STATUS_PENDING
+        assert self.order.positions.count() == 0
+        assert self.order.all_positions.filter(canceled=True).count() == 2
+        f = self.order.fees.get()
+        assert f.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+        assert f.value == Decimal('5.00')
+        assert self.order.total == Decimal('5.00')
+        assert not self.order.payments.filter(
+            state__in=(OrderPayment.PAYMENT_STATE_CREATED, OrderPayment.PAYMENT_STATE_PENDING)
+        ).exists()
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_keeps_kept_fees(self):
+        payment_fee = self.order.fees.create(fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.50'))
+        self.order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('2.50'))
+        _cancel_order(self.order.pk, cancellation_fee=Decimal('5.00'), keep_fees=[payment_fee], send_mail=False)
+        self.order.refresh_from_db()
+        assert self.order.all_fees.get(fee_type=OrderFee.FEE_TYPE_SHIPPING).canceled
+        assert not self.order.all_fees.get(fee_type=OrderFee.FEE_TYPE_PAYMENT).canceled
+        # The kept payment fee is part of the 5.00 that the customer keeps, so only 2.50 is a new cancellation fee
+        assert self.order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION).value == Decimal('2.50')
+        assert self.order.total == Decimal('5.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_tax_mode_zero(self):
+        _cancel_order(self.order.pk, cancellation_fee=Decimal('5.00'), tax_mode="zero", send_mail=False)
+        f = self.order.fees.get()
+        assert f.tax_rate == Decimal('0.00')
+        assert f.tax_value == Decimal('0.00')
+
+    @classscope(attr='o')
+    def test_cancel_with_fee_sends_mail(self):
+        _cancel_order(self.order.pk, cancellation_fee=Decimal('5.00'), send_mail=True)
+        assert len(djmail.outbox) == 1
+
+
