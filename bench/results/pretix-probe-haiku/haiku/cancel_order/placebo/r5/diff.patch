+def _create_cancelable_order(event, code, status=Order.STATUS_PAID, total=Decimal('23.00')):
+    item = event.items.create(name='Ticket', default_price=Decimal('23.00'))
+    o = Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=total,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    OrderPosition.objects.create(order=o, item=item, price=Decimal('23.00'))
+    return o
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely(event):
+    djmail.outbox = []
+    event.settings.invoice_generate = 'True'
+    o = _create_cancelable_order(event, 'FOO', status=Order.STATUS_PENDING)
+    generate_invoice(o)
+    assert _cancel_order(o) == o.pk
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_CANCELED
+    assert o.invoices.count() == 2
+    assert o.invoices.filter(is_cancellation=True).count() == 1
+    assert len(djmail.outbox) == 1
+    assert o.positions.count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_without_mail_and_invoice_cancellation(event):
+    djmail.outbox = []
+    event.settings.invoice_generate = 'True'
+    o = _create_cancelable_order(event, 'FOO2')
+    generate_invoice(o)
+    _cancel_order(o.pk, send_mail=False, cancel_invoice=False)
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_CANCELED
+    assert o.invoices.count() == 1
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_order_already_canceled(event):
+    o = _create_cancelable_order(event, 'FOO3', status=Order.STATUS_CANCELED)
+    with pytest.raises(OrderError):
+        _cancel_order(o)
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_unpaid(event):
+    djmail.outbox = []
+    o = _create_cancelable_order(event, 'FOO4', status=Order.STATUS_PENDING)
+    assert _cancel_order(o, cancellation_fee=Decimal('5.00'), send_mail=False) == o.pk
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+    assert o.total == Decimal('5.00')
+    assert o.positions.count() == 0
+    fees = list(o.fees.all())
+    assert len(fees) == 1
+    assert fees[0].fee_type == OrderFee.FEE_TYPE_CANCELLATION
+    assert fees[0].value == Decimal('5.00')
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_kept_from_payment(event):
+    o = _create_cancelable_order(event, 'FOO5', status=Order.STATUS_PAID)
+    o.payments.create(
+        state=OrderPayment.PAYMENT_STATE_CONFIRMED, amount=Decimal('23.00'), provider='banktransfer'
+    )
+    _cancel_order(o, cancellation_fee=Decimal('5.00'), send_mail=False)
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PAID
+    assert o.total == Decimal('5.00')
+    assert o.pending_sum == Decimal('-18.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_keeps_selected_fees(event):
+    o = _create_cancelable_order(event, 'FOO6', status=Order.STATUS_PENDING, total=Decimal('25.00'))
+    kept = o.fees.create(fee_type=OrderFee.FEE_TYPE_SERVICE, value=Decimal('2.00'))
+    o.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('3.00'))
+    _cancel_order(o, cancellation_fee=Decimal('10.00'), keep_fees=[kept], send_mail=False)
+    o.refresh_from_db()
+    assert o.total == Decimal('10.00')
+    assert o.status == Order.STATUS_PENDING
+    fees = {f.fee_type: f.value for f in o.fees.all()}
+    assert fees == {
+        OrderFee.FEE_TYPE_SERVICE: Decimal('2.00'),
+        OrderFee.FEE_TYPE_CANCELLATION: Decimal('8.00'),
+    }
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_larger_than_total(event):
+    o = _create_cancelable_order(event, 'FOO7', status=Order.STATUS_PENDING)
+    with pytest.raises(OrderError):
+        _cancel_order(o, cancellation_fee=Decimal('30.00'), send_mail=False)
+    o.refresh_from_db()
+    assert o.status == Order.STATUS_PENDING
+    assert o.positions.count() == 1
+
+
