+def _create_order_to_cancel(event, status=Order.STATUS_PENDING, total=Decimal('23.00')):
+    o = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test', status=status,
+        datetime=now(), expires=now() + timedelta(days=10), total=total, locale='en',
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    ticket = Item.objects.create(event=event, name='Early-bird ticket',
+                                 default_price=Decimal('23.00'), admission=True)
+    OrderPosition.objects.create(
+        order=o, item=ticket, variation=None,
+        price=Decimal("23.00"), attendee_name_parts={'full_name': "Peter"}, positionid=1
+    )
+    return o
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely(event):
+    djmail.outbox = []
+    o1 = _create_order_to_cancel(event)
+    assert _cancel_order(o1.pk) == o1.pk
+    o1.refresh_from_db()
+    assert o1.status == Order.STATUS_CANCELED
+    assert o1.cancellation_date is not None
+    assert o1.positions.exists()
+    assert o1.all_logentries().filter(action_type='pretix.event.order.canceled').exists()
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_without_mail(event):
+    djmail.outbox = []
+    o1 = _create_order_to_cancel(event)
+    _cancel_order(o1, send_mail=False)
+    o1.refresh_from_db()
+    assert o1.status == Order.STATUS_CANCELED
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_releases_voucher(event):
+    o1 = _create_order_to_cancel(event)
+    v = Voucher.objects.create(event=event, code='FOO', redeemed=1)
+    o1.positions.update(voucher=v)
+    _cancel_order(o1)
+    v.refresh_from_db()
+    assert v.redeemed == 0
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_cancels_open_payment(event):
+    o1 = _create_order_to_cancel(event)
+    p = o1.payments.create(provider='banktransfer', amount=o1.total, state=OrderPayment.PAYMENT_STATE_PENDING)
+    _cancel_order(o1)
+    p.refresh_from_db()
+    assert p.state == OrderPayment.PAYMENT_STATE_CANCELED
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_cancels_invoice(event):
+    o1 = _create_order_to_cancel(event)
+    generate_invoice(o1)
+    _cancel_order(o1)
+    assert o1.invoices.filter(is_cancellation=True).count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_order_completely_keeps_invoice_if_not_requested(event):
+    o1 = _create_order_to_cancel(event)
+    generate_invoice(o1)
+    _cancel_order(o1, cancel_invoice=False)
+    o1.refresh_from_db()
+    assert o1.status == Order.STATUS_CANCELED
+    assert o1.invoices.filter(is_cancellation=True).count() == 0
+
+
+@pytest.mark.django_db
+def test_cancel_order_zero_fee_cancels_completely(event):
+    o1 = _create_order_to_cancel(event)
+    _cancel_order(o1, cancellation_fee=Decimal('0.00'))
+    o1.refresh_from_db()
+    assert o1.status == Order.STATUS_CANCELED
+    assert o1.positions.exists()
+    assert not o1.fees.exists()
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_unpaid(event):
+    o1 = _create_order_to_cancel(event)
+    _cancel_order(o1, cancellation_fee=Decimal('6.00'))
+    o1.refresh_from_db()
+    assert not o1.positions.exists()
+    assert o1.all_positions.exists()
+    f = o1.fees.get()
+    assert f.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+    assert f.value == Decimal('6.00')
+    assert f.tax_rule is None
+    assert f.tax_rate == Decimal('0.00')
+    assert f.tax_value == Decimal('0.00')
+    assert o1.status == Order.STATUS_PENDING
+    assert o1.total == Decimal('6.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_paid(event):
+    o1 = _create_order_to_cancel(event, status=Order.STATUS_PAID)
+    o1.payments.create(state=OrderPayment.PAYMENT_STATE_CONFIRMED, amount=o1.total)
+    _cancel_order(o1, cancellation_fee=Decimal('6.00'))
+    o1.refresh_from_db()
+    assert not o1.positions.exists()
+    assert o1.fees.get().value == Decimal('6.00')
+    assert o1.status == Order.STATUS_PAID
+    assert o1.total == Decimal('6.00')
+    assert o1.pending_sum == Decimal('-17.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_default_tax(event):
+    event.settings.tax_rule_cancellation = 'default'
+    tr7 = event.tax_rules.create(rate=Decimal('7.00'), default=True)
+    o1 = _create_order_to_cancel(event)
+    _cancel_order(o1, cancellation_fee=Decimal('6.00'))
+    f = o1.fees.get()
+    assert f.tax_rule == tr7
+    assert f.tax_rate == Decimal('7')
+    assert f.tax_value == Decimal('0.39')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_keeps_fees(event):
+    o1 = _create_order_to_cancel(event, total=Decimal('28.00'))
+    shipping = o1.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('5.00'))
+    _cancel_order(o1, cancellation_fee=Decimal('6.00'), keep_fees=[shipping])
+    o1.refresh_from_db()
+    assert not o1.positions.exists()
+    shipping.refresh_from_db()
+    assert not shipping.canceled
+    f = o1.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert f.value == Decimal('1.00')
+    assert o1.total == Decimal('6.00')
+
+
+@pytest.mark.django_db
+def test_cancel_order_with_fee_higher_than_total(event):
+    o1 = _create_order_to_cancel(event)
+    with pytest.raises(OrderError):
+        _cancel_order(o1, cancellation_fee=Decimal('24.00'))
+    o1.refresh_from_db()
+    assert o1.positions.exists()
+    assert not o1.fees.exists()
+
