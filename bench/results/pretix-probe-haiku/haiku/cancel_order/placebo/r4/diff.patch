+def _cancel_order(order, user=None, send_mail: bool=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee``, the order is marked as canceled. With a ``cancellation_fee``,
+    all positions and all fees except the ones in ``keep_fees`` are canceled instead, and the order stays open with
+    the cancellation fee (plus the kept fees) as its new total.
+
+    :param order: The order or its primary key
+    :param cancellation_fee: The gross amount the customer still has to pay, including the value of ``keep_fees``
+    :param keep_fees: Fees of the order that are not canceled
+    :param tax_mode: How the cancellation fee is taxed, one of ``none``, ``default`` or ``split``. Defaults to the
+                     ``tax_rule_cancellation`` setting of the event.
+    :return: The primary key of the order
+    """
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    auth = device or oauth_application
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order if isinstance(order, int) else order.pk)
+
+        for payment in order.payments.filter(state__in=(OrderPayment.PAYMENT_STATE_CREATED,
+                                                        OrderPayment.PAYMENT_STATE_PENDING)):
+            try:
+                payment.payment_provider.cancel_payment(payment)
+                order.log_action('pretix.event.order.payment.canceled', {
+                    'local_id': payment.local_id,
+                    'provider': payment.provider,
+                })
+            except PaymentException as e:
+                order.log_action('pretix.event.order.payment.canceled.failed', {
+                    'local_id': payment.local_id,
+                    'provider': payment.provider,
+                    'error': str(e)
+                })
+
+        if cancellation_fee:
+            cancellation_fee = Decimal(cancellation_fee)
+            if cancellation_fee > order.total:
+                raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+            keep_pks = {f.pk for f in keep_fees or []}
+            kept_total = sum((f.value for f in keep_fees or []), Decimal('0.00'))
+            positions = list(order.positions.all())
+
+            for position in positions:
+                order.log_action('pretix.event.order.changed.cancel', user=user, auth=auth, api_token=api_token, data={
+                    'position': position.pk,
+                    'positionid': position.positionid,
+                    'old_item': position.item_id,
+                    'old_variation': position.variation_id,
+                    'addon_to': position.addon_to_id,
+                    'old_price': position.price,
+                })
+                if position.voucher:
+                    Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+                position.canceled = True
+                position.save(update_fields=['canceled'])
+
+            for fee in order.fees.all():
+                if fee.pk not in keep_pks:
+                    order.log_action('pretix.event.order.changed.cancelfee', user=user, auth=auth, api_token=api_token, data={
+                        'fee': fee.pk,
+                    })
+                    fee.canceled = True
+                    fee.save(update_fields=['canceled'])
+
+            fee_amount = cancellation_fee - kept_total
+            if fee_amount > Decimal('0.00'):
+                tax_mode = tax_mode or order.event.settings.tax_rule_cancellation
+                if tax_mode == 'default':
+                    fee_values = [(order.event.cached_default_tax_rule, fee_amount)]
+                elif tax_mode == 'split':
+                    fee_values = split_fee_for_taxes(positions, fee_amount, order.event)
+                else:
+                    fee_values = [(None, fee_amount)]
+
+                try:
+                    ia = order.invoice_address
+                except InvoiceAddress.DoesNotExist:
+                    ia = None
+
+                for tax_rule, price in fee_values:
+                    if tax_rule:
+                        tax = tax_rule.tax(price, invoice_address=ia, base_price_is='gross')
+                        fee_tax = {'tax_rate': tax.rate, 'tax_code': tax.code, 'tax_value': tax.tax}
+                    else:
+                        fee_tax = {'tax_rate': Decimal('0.00'), 'tax_code': None, 'tax_value': Decimal('0.00')}
+                    fee = order.fees.create(
+                        fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                        value=price,
+                        tax_rule=tax_rule,
+                        **fee_tax,
+                    )
+                    order.log_action('pretix.event.order.changed.addfee', user=user, auth=auth, api_token=api_token, data={
+                        'fee': fee.pk,
+                    })
+
+            order.total = sum((f.value for f in order.fees.all()), Decimal('0.00'))
+            order.save(update_fields=['total'])
+            order.status = Order.STATUS_PAID if order.pending_sum <= Decimal('0.00') else Order.STATUS_PENDING
+            order.save(update_fields=['status'])
+            order.touch()
+
+            if cancel_invoice:
+                i = order.invoices.filter(is_cancellation=False).last()
+                if i and not i.canceled:
+                    generate_cancellation(i)
+                    if invoice_qualified(order) and (
+                        order.event.settings.invoice_generate == 'True' or (
+                            order.event.settings.invoice_generate == 'paid' and order.status == Order.STATUS_PAID
+                        )
+                    ):
+                        generate_invoice(order)
+        else:
+            order.status = Order.STATUS_CANCELED
+            order.cancellation_date = now()
+            order.save(update_fields=['status', 'cancellation_date'])
+
+            for position in order.positions.all():
+                if position.voucher:
+                    Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+            if cancel_invoice:
+                i = order.invoices.filter(is_cancellation=False).last()
+                if i and not i.canceled:
+                    generate_cancellation(i)
+
+            order.log_action('pretix.event.order.canceled', user=user, auth=auth, api_token=api_token, data={
+                'comment': comment,
+            })
+
+        order.cancellation_requests.all().delete()
+        order.create_transactions()
+
+    if cancellation_fee:
+        order_changed.send(order.event, order=order)
+        if send_mail:
+            notify_user_changed_order(order, user, auth)
+    else:
+        order_canceled.send(order.event, order=order)
+        if send_mail:
+            with language(order.locale, order.event.settings.region):
+                email_template = order.event.settings.mail_text_order_canceled
+                email_subject = order.event.settings.mail_subject_order_canceled
+                email_context = get_email_context(event=order.event, order=order, comment=comment)
+                order.send_mail(
+                    email_subject, email_template, email_context,
+                    'pretix.event.order.email.order_canceled', user
+                )
+
+    return order.pk
+
+
