+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, Item, LogEntry, Order, OrderPosition, Organizer, User, Voucher,
+)
+from pretix.base.models.orders import OrderFee
+from pretix.base.services.invoices import generate_invoice
+from pretix.base.services.orders import OrderError, _cancel_order
+
+
+@pytest.fixture
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now(),
+        plugins='pretix.plugins.banktransfer'
+    )
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def ticket(event):
+    return Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+
+
+@pytest.fixture
+def order(event, ticket):
+    order = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test',
+        status=Order.STATUS_PENDING, locale='en',
+        datetime=now(), expires=now() + timedelta(days=10),
+        total=Decimal('46.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    OrderPosition.objects.create(
+        order=order, item=ticket, variation=None, price=Decimal('23.00'),
+        attendee_name_parts={'full_name': "Peter"}, positionid=1,
+    )
+    OrderPosition.objects.create(
+        order=order, item=ticket, variation=None, price=Decimal('23.00'),
+        attendee_name_parts={'full_name': "Paul"}, positionid=2,
+    )
+    order.create_transactions()
+    return order
+
+
+@pytest.mark.django_db
+def test_cancel_completely(event, order):
+    ret = _cancel_order(order.pk)
+    assert ret == order.pk
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.cancellation_date is not None
+    assert order.positions.count() == 2
+    assert LogEntry.objects.filter(object_id=order.pk, action_type='pretix.event.order.canceled').exists()
+
+
+@pytest.mark.django_db
+def test_cancel_completely_with_zero_fee_is_full_cancel(event, order):
+    _cancel_order(order.pk, cancellation_fee=Decimal('0.00'))
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.positions.count() == 2
+
+
+@pytest.mark.django_db
+def test_cancel_completely_cancels_invoice(event, order):
+    generate_invoice(order)
+    _cancel_order(order)
+    order.refresh_from_db()
+    assert order.invoices.filter(is_cancellation=True).count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_completely_keeps_invoice_if_not_requested(event, order):
+    generate_invoice(order)
+    _cancel_order(order, cancel_invoice=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.invoices.filter(is_cancellation=True).count() == 0
+
+
+@pytest.mark.django_db
+def test_cancel_completely_releases_voucher(event, order, ticket):
+    voucher = Voucher.objects.create(event=event, code='ABC', redeemed=1, max_usages=1)
+    order.positions.update(voucher=voucher)
+    _cancel_order(order)
+    voucher.refresh_from_db()
+    assert voucher.redeemed == 0
+
+
+@pytest.mark.django_db
+def test_cancel_accepts_primary_keys_of_actors(event, order):
+    user = User.objects.create_user('admin@localhost', 'admin')
+    _cancel_order(order.pk, user=user.pk)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert LogEntry.objects.filter(object_id=order.pk, action_type='pretix.event.order.canceled', user=user).exists()
+
+
+@pytest.mark.django_db
+def test_cancel_not_allowed_for_canceled_order(event, order):
+    order.status = Order.STATUS_CANCELED
+    order.save()
+    with pytest.raises(OrderError):
+        _cancel_order(order)
+
+
+@pytest.mark.django_db
+def test_cancel_sends_mail_if_requested(event, order):
+    djmail.outbox = []
+    _cancel_order(order, send_mail=True)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_cancel_does_not_send_mail_if_not_requested(event, order):
+    djmail.outbox = []
+    _cancel_order(order, send_mail=False)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_only_fee(event, order):
+    ret = _cancel_order(order, cancellation_fee=Decimal('5.00'))
+    assert ret == order.pk
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.total == Decimal('5.00')
+    assert order.positions.count() == 0
+    fee = order.fees.get()
+    assert fee.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+    assert fee.value == Decimal('5.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_selected_fees(event, order):
+    kept = order.fees.create(fee_type=OrderFee.FEE_TYPE_SHIPPING, value=Decimal('3.00'))
+    dropped = order.fees.create(fee_type=OrderFee.FEE_TYPE_SERVICE, value=Decimal('2.00'))
+    order.total = Decimal('51.00')
+    order.save()
+    _cancel_order(order, cancellation_fee=Decimal('5.00'), keep_fees=[kept])
+    order.refresh_from_db()
+    kept.refresh_from_db()
+    dropped.refresh_from_db()
+    assert not kept.canceled
+    assert dropped.canceled
+    assert order.total == Decimal('5.00')
+    fee = order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION, canceled=False)
+    assert fee.value == Decimal('2.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_reissues_invoice(event, order):
+    generate_invoice(order)
+    _cancel_order(order, cancellation_fee=Decimal('5.00'))
+    order.refresh_from_db()
+    assert order.invoices.filter(is_cancellation=True).count() == 1
+    assert order.invoices.filter(is_cancellation=False).count() == 2
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_order_open(event, order):
+    _cancel_order(order, cancellation_fee=Decimal('5.00'), send_mail=False)
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.cancellation_date is None
