+def _cancel_position(order: Order, position: OrderPosition, user=None, auth=None):
+    for gc in position.issued_gift_cards.all():
+        gc = GiftCard.objects.select_for_update(of=OF_SELF).get(pk=gc.pk)
+        if gc.value < position.price:
+            raise OrderError(_(
+                'A position can not be canceled since the gift card {card} purchased in this order has '
+                'already been redeemed.'
+            ).format(card=gc.secret))
+        gc.transactions.create(value=-position.price, order=order, acceptor=order.event.organizer)
+
+    for m in position.granted_memberships.with_usages().all():
+        m.canceled = True
+        m.save()
+
+    if position.voucher:
+        Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+    position.canceled = True
+    position.save(update_fields=['canceled'])
+    order.log_action('pretix.event.order.changed.cancel', user=user, auth=auth, data={
+        'position': position.pk,
+        'positionid': position.positionid,
+    })
+
+
+def _cancel_order(order, user=None, send_mail=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee``, the order is canceled completely. With a
+    ``cancellation_fee``, all positions and all fees except ``keep_fees`` are canceled, and the cancellation
+    fee becomes the only remaining amount of the order.
+    :param order: The order to cancel (or its primary key)
+    :param user: The user that performed the change (or their primary key)
+    :param send_mail: Whether to notify the customer
+    :param api_token: The API token that performed the change (or its primary key)
+    :param device: The device that performed the change (or its primary key)
+    :param oauth_application: The OAuth application that performed the change (or its primary key)
+    :param cancellation_fee: The amount the customer still has to pay or keeps from what they paid
+    :param keep_fees: Fees (instances) that are not canceled together with the rest of the order
+    :param cancel_invoice: Whether to cancel the current invoice (and issue a new one for the cancellation fee)
+    :param comment: A comment that is passed on to the customer email
+    :param tax_mode: Not used yet, no caller passes it
+    :returns: The primary key of the order
+    """
+    if isinstance(order, int):
+        order = Order.objects.get(pk=order)
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    if isinstance(api_token, int):
+        api_token = TeamAPIToken.objects.get(pk=api_token)
+    if isinstance(device, int):
+        device = Device.objects.get(pk=device)
+    if isinstance(oauth_application, int):
+        oauth_application = OAuthApplication.objects.get(pk=oauth_application)
+    auth = api_token or device or oauth_application
+    if cancellation_fee:
+        cancellation_fee = Decimal(cancellation_fee)
+
+    if not order.cancel_allowed():
+        raise OrderError(_('You cannot cancel this order.'))
+    if cancellation_fee and cancellation_fee > order.total:
+        raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+    keep_fee_pks = {f.pk for f in keep_fees or []}
+
+    with transaction.atomic():
+        lock_objects([order])
+        # Clear prefetched objects cache of order, the positions and fees are modified below
+        order._prefetched_objects_cache = {}
+        invoice = order.invoices.filter(is_cancellation=False).last()
+        if cancel_invoice and invoice and not invoice.refered.exists():
+            generate_cancellation(invoice)
+
+        if cancellation_fee:
+            positions = list(order.positions.all())
+            for position in positions:
+                _cancel_position(order, position, user=user, auth=auth)
+
+            kept_fees = []
+            for fee in order.fees.filter(canceled=False):
+                if fee.pk in keep_fee_pks:
+                    kept_fees.append(fee)
+                else:
+                    fee.canceled = True
+                    fee.save(update_fields=['canceled'])
+                    order.log_action('pretix.event.order.changed.cancelfee', user=user, auth=auth, data={
+                        'fee': fee.pk,
+                        'fee_type': fee.fee_type,
+                        'old_price': fee.value,
+                    })
+
+            # The kept fees are part of the cancellation fee, so only the rest needs a new fee
+            kept_value = sum(f.value for f in kept_fees)
+            new_fee_value = max(cancellation_fee - kept_value, Decimal('0.00'))
+            if new_fee_value:
+                tax_rule_zero = TaxRule.zero()
+                if order.event.settings.tax_rule_cancellation == "default":
+                    fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, new_fee_value)]
+                elif order.event.settings.tax_rule_cancellation == "split":
+                    fee_values = split_fee_for_taxes(positions, new_fee_value, order.event)
+                else:
+                    fee_values = [(tax_rule_zero, new_fee_value)]
+                for tax_rule, price in fee_values:
+                    fee = OrderFee(order=order, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=price,
+                                   tax_rule=tax_rule or tax_rule_zero)
+                    fee._calculate_tax()
+                    fee.save()
+
+            order.total = kept_value + new_fee_value
+            if order.status == Order.STATUS_PENDING and order.pending_sum <= Decimal('0.00') and not order.require_approval:
+                order.status = Order.STATUS_PAID
+            order.save(update_fields=['total', 'status'])
+            order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+                'comment': comment,
+                'cancellation_fee': str(cancellation_fee),
+            })
+            if invoice and cancel_invoice and invoice_qualified(order):
+                generate_invoice(order)
+        else:
+            for position in order.positions.all():
+                if position.voucher:
+                    Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+
+            order.status = Order.STATUS_CANCELED
+            order.cancellation_date = now()
+            order.save(update_fields=['status', 'cancellation_date'])
+            order.log_action('pretix.event.order.canceled', user=user, auth=auth, data={
+                'comment': comment,
+            })
+
+        order.cancellation_requests.all().delete()
+        order.create_transactions()
+
+    if not cancellation_fee:
+        order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user
+            )
+
+    return order.pk
+
+
 @transaction.atomic
