+def _cancel_order_position(order: Order, position: OrderPosition, user=None, auth=None, api_token=None):
+    for gc in position.issued_gift_cards.all():
+        gc = GiftCard.objects.select_for_update(of=OF_SELF).get(pk=gc.pk)
+        if gc.value < position.price:
+            raise OrderError(_(
+                'A position can not be canceled since the gift card {card} purchased in this order has '
+                'already been redeemed.').format(card=gc.secret))
+        gc.transactions.create(value=-position.price, order=order, acceptor=order.event.organizer)
+        gc.log_action(
+            action='pretix.giftcards.transaction.manual',
+            user=user,
+            auth=auth,
+            api_token=api_token,
+            data={
+                'value': -position.price,
+                'acceptor_id': order.event.organizer.id,
+                'acceptor_slug': order.event.organizer.slug
+            }
+        )
+
+    for m in position.granted_memberships.with_usages().all():
+        m.canceled = True
+        m.save()
+
+    order.log_action('pretix.event.order.changed.cancel', user=user, auth=auth, api_token=api_token, data={
+        'position': position.pk,
+        'positionid': position.positionid,
+        'old_item': position.item.pk,
+        'old_variation': position.variation.pk if position.variation else None,
+        'old_price': position.price,
+        'addon_to': position.addon_to_id,
+    })
+    position.canceled = True
+    if position.voucher:
+        Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+    assign_ticket_secret(
+        event=order.event, position=position, force_invalidate_if_revokation_list_used=True, force_invalidate=False, save=False
+    )
+    position.save(update_fields=['canceled', 'secret'])
+
+
+def _cancel_order(order, user=None, send_mail=True, api_token=None, device=None, oauth_application=None,
+                  cancellation_fee=None, keep_fees=None, cancel_invoice=True, comment=None, tax_mode=None):
+    """
+    Cancel an order. Without a ``cancellation_fee``, the order is canceled completely. With a
+    ``cancellation_fee``, all positions and all fees except those in ``keep_fees`` are canceled, and the
+    cancellation fee is what the customer still has to pay. Fees in ``keep_fees`` stay on the order and
+    count towards that fee.
+    :param order: The order (or its primary key) to cancel
+    :param user: The user (or primary key) that performed the cancellation
+    :return: The primary key of the order
+    """
+    # tax_mode is accepted for signature compatibility but no caller uses it yet.
+    if isinstance(order, int):
+        order = Order.objects.get(pk=order)
+    if isinstance(user, int):
+        user = User.objects.get(pk=user)
+    auth = device or oauth_application
+    kept_fee_pks = {f.pk for f in keep_fees or []} if cancellation_fee else set()
+
+    with transaction.atomic():
+        order = Order.objects.select_for_update(of=OF_SELF).select_related('event').get(pk=order.pk)
+        if not order.cancel_allowed():
+            raise OrderError(error_messages['cancel_not_allowed'])
+        if cancellation_fee and cancellation_fee > order.total:
+            raise OrderError(_('The cancellation fee cannot be higher than the total amount of this order.'))
+
+        positions = list(order.positions.all())
+        previous_status = order.status
+        if cancellation_fee:
+            for position in positions:
+                _cancel_order_position(order, position, user=user, auth=auth, api_token=api_token)
+
+            for fee in order.fees.all():
+                if fee.pk in kept_fee_pks:
+                    continue
+                fee.canceled = True
+                fee.save(update_fields=['canceled'])
+                order.log_action('pretix.event.order.changed.cancelfee', user=user, auth=auth, api_token=api_token, data={
+                    'fee': fee.pk,
+                    'fee_type': fee.fee_type,
+                    'old_price': fee.value,
+                })
+
+            kept_sum = sum((f.value for f in order.fees.all()), Decimal('0.00'))
+            fee_value = round_decimal(cancellation_fee - kept_sum, order.event.currency)
+            if fee_value > Decimal('0.00'):
+                try:
+                    invoice_address = order.invoice_address
+                except InvoiceAddress.DoesNotExist:
+                    invoice_address = None
+                tax_rule_zero = TaxRule.zero()
+                if order.event.settings.tax_rule_cancellation == "default":
+                    fee_values = [(order.event.cached_default_tax_rule or tax_rule_zero, fee_value)]
+                elif order.event.settings.tax_rule_cancellation == "split":
+                    fee_values = split_fee_for_taxes(positions, fee_value, order.event)
+                else:
+                    fee_values = [(tax_rule_zero, fee_value)]
+                for tax_rule, price in fee_values:
+                    tax_rule = tax_rule or tax_rule_zero
+                    tax = tax_rule.tax(price, invoice_address=invoice_address, base_price_is="gross")
+                    OrderFee(
+                        fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+                        value=price,
+                        order=order,
+                        tax_rate=tax.rate,
+                        tax_code=tax.code,
+                        tax_value=tax.tax,
+                        tax_rule=tax_rule,
+                    ).save()
+
+            order.total = sum((f.value for f in order.fees.all()), Decimal('0.00'))
+            if order.payment_refund_sum >= order.total:
+                order.status = Order.STATUS_PAID
+            else:
+                order.status = Order.STATUS_PENDING
+        else:
+            for position in positions:
+                if position.voucher:
+                    Voucher.objects.filter(pk=position.voucher.pk).update(redeemed=Greatest(0, F('redeemed') - 1))
+            order.status = Order.STATUS_CANCELED
+
+        if order.status == Order.STATUS_PENDING and previous_status == Order.STATUS_EXPIRED:
+            order.set_expires(now(), order.event.subevents.filter(id__in=[p.subevent_id for p in positions]))
+            order.save(update_fields=['status', 'total', 'expires'])
+        else:
+            order.save(update_fields=['status', 'total'])
+
+        order.log_action('pretix.event.order.canceled', user=user, auth=auth, api_token=api_token, data={
+            'comment': comment,
+        })
+        order.cancellation_requests.all().delete()
+
+        if cancel_invoice:
+            i = order.invoices.filter(is_cancellation=False).last()
+            if i and not i.refered.exists():
+                generate_cancellation(i)
+                if cancellation_fee and order.event.settings.invoice_generate == 'True' and invoice_qualified(order):
+                    try:
+                        generate_invoice(order)
+                    except Exception as e:
+                        logger.exception("Could not generate invoice.")
+                        order.log_action("pretix.event.order.invoice.failed", data={
+                            "exception": str(e)
+                        })
+
+        order.create_transactions()
+
+    if cancellation_fee:
+        order_changed.send(order.event, order=order)
+    else:
+        order_canceled.send(order.event, order=order)
+
+    if send_mail:
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_canceled
+            email_subject = order.event.settings.mail_subject_order_canceled
+            email_context = get_email_context(event=order.event, order=order, comment=comment)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.order_canceled', user, auth=auth
+            )
+
+    return order.pk
+
+
 @app.task(base=ProfiledTask, bind=True, max_retries=5, default_retry_delay=1, throws=(OrderError,))
 @scopes_disabled()
 def cancel_order(self, order: int, user: int=None, send_mail: bool=True, api_token=None, oauth_application=None,
