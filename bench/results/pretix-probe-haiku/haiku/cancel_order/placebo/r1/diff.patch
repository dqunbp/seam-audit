+from datetime import timedelta
+from decimal import Decimal
+
+import pytest
+from django.core import mail as djmail
+from django.utils.timezone import now
+from django_scopes import scope
+
+from pretix.base.models import (
+    Event, Item, Order, OrderPosition, Organizer,
+)
+from pretix.base.models.orders import OrderFee, OrderPayment
+from pretix.base.services.invoices import generate_invoice
+from pretix.base.services.orders import OrderError, _cancel_order
+
+
+@pytest.fixture(scope='function')
+def event():
+    o = Organizer.objects.create(name='Dummy', slug='dummy', plugins='pretix.plugins.banktransfer')
+    event = Event.objects.create(
+        organizer=o, name='Dummy', slug='dummy',
+        date_from=now(),
+        plugins='pretix.plugins.banktransfer'
+    )
+    with scope(organizer=o):
+        yield event
+
+
+@pytest.fixture
+def ticket(event):
+    return Item.objects.create(event=event, name='Ticket', default_price=Decimal('23.00'), admission=True)
+
+
+def _create_order(event, ticket, status=Order.STATUS_PENDING, paid=False):
+    djmail.outbox = []
+    order = Order.objects.create(
+        code='FOO', event=event, email='dummy@dummy.test', status=status,
+        datetime=now(), expires=now() + timedelta(days=10), total=Decimal('23.00'), locale='en',
+        sales_channel=event.organizer.sales_channels.get(identifier='web'),
+    )
+    OrderPosition.objects.create(
+        order=order, item=ticket, variation=None, price=Decimal('23.00'),
+        attendee_name_parts={'full_name': 'Peter'}, positionid=1,
+    )
+    order.create_transactions()
+    if paid:
+        order.payments.create(state=OrderPayment.PAYMENT_STATE_CONFIRMED, amount=order.total)
+        order.create_transactions()
+    return order
+
+
+@pytest.mark.django_db
+def test_cancel_completely(event, ticket):
+    order = _create_order(event, ticket)
+    OrderFee.objects.create(order=order, fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.00'))
+
+    assert _cancel_order(order.pk) == order.pk
+
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.total == Decimal('23.00')
+    assert order.positions.count() == 1
+    assert order.fees.count() == 1
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+
+
+@pytest.mark.django_db
+def test_cancel_completely_without_mail(event, ticket):
+    order = _create_order(event, ticket)
+
+    _cancel_order(order, send_mail=False)
+
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_completely_cancels_invoice(event, ticket):
+    order = _create_order(event, ticket)
+    generate_invoice(order)
+
+    _cancel_order(order.pk, cancel_invoice=True)
+
+    assert order.invoices.filter(is_cancellation=True).count() == 1
+
+
+@pytest.mark.django_db
+def test_cancel_completely_keeps_invoice_if_requested(event, ticket):
+    order = _create_order(event, ticket)
+    generate_invoice(order)
+
+    _cancel_order(order.pk, cancel_invoice=False)
+
+    assert order.invoices.filter(is_cancellation=True).count() == 0
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_pending_order_stays_pending(event, ticket):
+    order = _create_order(event, ticket)
+
+    assert _cancel_order(order.pk, cancellation_fee=Decimal('7.00')) == order.pk
+
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.total == Decimal('7.00')
+    assert not order.positions.exists()
+    fee = order.fees.get()
+    assert fee.fee_type == OrderFee.FEE_TYPE_CANCELLATION
+    assert fee.value == Decimal('7.00')
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_paid_order_stays_paid(event, ticket):
+    order = _create_order(event, ticket, status=Order.STATUS_PAID, paid=True)
+
+    _cancel_order(order.pk, cancellation_fee=Decimal('6.00'))
+
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PAID
+    assert order.total == Decimal('6.00')
+    assert order.fees.get().value == Decimal('6.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_keeps_fees_and_counts_them(event, ticket):
+    order = _create_order(event, ticket)
+    payment_fee = OrderFee.objects.create(order=order, fee_type=OrderFee.FEE_TYPE_PAYMENT, value=Decimal('2.00'))
+    order.total = Decimal('25.00')
+    order.save(update_fields=['total'])
+
+    _cancel_order(order.pk, cancellation_fee=Decimal('10.00'), keep_fees=[payment_fee])
+
+    order.refresh_from_db()
+    assert order.total == Decimal('10.00')
+    payment_fee.refresh_from_db()
+    assert not payment_fee.canceled
+    cancellation_fee = order.fees.get(fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+    assert cancellation_fee.value == Decimal('8.00')
+
+
+@pytest.mark.django_db
+def test_cancel_with_fee_higher_than_total_raises(event, ticket):
+    order = _create_order(event, ticket)
+
+    with pytest.raises(OrderError) as excinfo:
+        _cancel_order(order.pk, cancellation_fee=Decimal('700.00'))
+
+    assert str(excinfo.value) == 'The cancellation fee cannot be higher than the total amount of this order.'
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_PENDING
+    assert order.positions.exists()
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_cancel_not_allowed_for_canceled_order(event, ticket):
+    order = _create_order(event, ticket, status=Order.STATUS_CANCELED)
+
+    with pytest.raises(OrderError):
+        _cancel_order(order.pk)
+
+    order.refresh_from_db()
+    assert order.status == Order.STATUS_CANCELED
+    assert order.positions.exists()
+    assert len(djmail.outbox) == 0
