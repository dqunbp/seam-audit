+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    """
+    Warn customers with unpaid orders shortly before their order expires. The number of days before
+    expiry is configured per event with ``mail_days_order_expire_warning``, where 0 disables the warning.
+    Each order is warned at most once.
+    """
+    events = Event.objects.filter(
+        Exists(
+            Order.objects.filter(
+                event_id=OuterRef('pk'),
+                status=Order.STATUS_PENDING,
+                expiry_reminder_sent=False,
+                expires__gt=now(),
+            )
+        )
+    ).order_by()
+
+    for event in events.iterator(chunk_size=10_000):
+        days = event.settings.get('mail_days_order_expire_warning', as_type=int)
+        if not days:
+            continue
+
+        # ``expires`` is what the e-mail states as the deadline (``{expire_date}``), so we key on it too.
+        # The ``datetime`` condition skips orders placed after the warning point, so nobody gets a warning
+        # right after ordering.
+        qs = event.orders.filter(
+            status=Order.STATUS_PENDING,
+            expiry_reminder_sent=False,
+            valid_if_pending=False,
+            require_approval=False,
+            expires__gt=now(),
+            expires__lte=now() + timedelta(days=days),
+            datetime__lte=F('expires') - timedelta(days=days),
+        ).exclude(
+            Exists(
+                OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+            )
+        ).order_by()
+
+        for order_pk in qs.values_list('pk', flat=True):
+            # One failing order must not block the others. The flag is rolled back with the transaction,
+            # so the order is retried on the next run.
+            try:
+                with transaction.atomic():
+                    o = Order.objects.select_for_update(of=OF_SELF).get(pk=order_pk)
+                    if o.expiry_reminder_sent or o.status != Order.STATUS_PENDING:
+                        # Race condition
+                        continue
+
+                    with language(o.locale, event.settings.region):
+                        o.expiry_reminder_sent = True
+                        o.save(update_fields=['expiry_reminder_sent'])
+                        email_template = event.settings.mail_text_order_expire_warning
+                        email_subject = event.settings.mail_subject_order_expire_warning
+                        email_context = get_email_context(event=event, order=o, pending_sum=o.pending_sum)
+                        o.send_mail(
+                            email_subject, email_template, email_context,
+                            'pretix.event.order.email.expire_warning_sent',
+                        )
+            except Exception:
+                logger.exception('Could not send expiry warning for order %s', order_pk)
+
