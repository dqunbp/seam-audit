+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.mail_days_order_expire_warning = 3
+            self.order = self._order('FOO')
+            djmail.outbox = []
+
+    def _order(self, code, **kwargs):
+        defaults = dict(
+            code=code, event=self.event, email='dummy@dummy.test',
+            status=Order.STATUS_PENDING, locale='en',
+            datetime=now() - timedelta(days=4),
+            expires=now() + timedelta(days=2),
+            total=Decimal('46.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+        )
+        defaults.update(kwargs)
+        return Order.objects.create(**defaults)
+
+    @classscope(attr='o')
+    def test_sent_once_within_window(self):
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        assert 'FOO' in djmail.outbox[0].subject
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert self.order.all_logentries().filter(
+            action_type='pretix.event.order.email.expire_warning_sent'
+        ).exists()
+
+    @classscope(attr='o')
+    def test_disabled_with_zero_days(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_not_sent_before_window(self):
+        self.order.expires = now() + timedelta(days=5)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_paid_order(self):
+        self.order.status = Order.STATUS_PAID
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_already_expired_order(self):
+        self.order.expires = now() - timedelta(hours=1)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_valid_if_pending_order(self):
+        self.order.valid_if_pending = True
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_order_placed_inside_window(self):
+        self.order.datetime = now() - timedelta(hours=1)
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_for_order_with_cancellation_fee(self):
+        OrderFee.objects.create(
+            order=self.order, fee_type=OrderFee.FEE_TYPE_CANCELLATION,
+            value=Decimal('1.00'), value_includes_rounding_correction=Decimal('0.00'),
+        )
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_twice_when_already_flagged(self):
+        self.order.expiry_reminder_sent = True
+        self.order.save()
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_failing_order_does_not_block_others_and_is_retried(self):
+        other = self._order('BAR')
+        original = Order.send_mail
+
+        def failing_for_foo(order, *args, **kwargs):
+            if order.code == 'FOO':
+                raise Exception('boom')
+            return original(order, *args, **kwargs)
+
+        with mock.patch.object(Order, 'send_mail', autospec=True, side_effect=failing_for_foo):
+            send_expiry_warnings(sender=self.event)
+
+        self.order.refresh_from_db()
+        other.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+        assert other.expiry_reminder_sent
+        assert len(djmail.outbox) == 1
+        assert 'BAR' in djmail.outbox[0].subject
+
+        send_expiry_warnings(sender=self.event)
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert len(djmail.outbox) == 2
+
