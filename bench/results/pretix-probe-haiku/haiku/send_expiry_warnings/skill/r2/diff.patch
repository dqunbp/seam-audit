+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.mail_days_order_expire_warning = 3
+            self.order = self._create_order('FOO', expires=now() + timedelta(days=2))
+            djmail.outbox = []
+
+    def _create_order(self, code, **kwargs):
+        defaults = dict(
+            event=self.event, email='dummy@dummy.test', status=Order.STATUS_PENDING, locale='en',
+            datetime=now() - timedelta(days=4), expires=now() + timedelta(days=2), total=Decimal('46.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+        )
+        defaults.update(kwargs)
+        return Order.objects.create(code=code, **defaults)
+
+    @classscope(attr='o')
+    def test_sent_within_window(self):
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+        assert 'FOO' in djmail.outbox[0].subject
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+        self.order.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert self.order.all_logentries().filter(
+            action_type='pretix.event.order.email.expire_warning_sent'
+        ).exists()
+
+    @classscope(attr='o')
+    def test_not_sent_before_window(self):
+        self.order.expires = now() + timedelta(days=10)
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_disabled_when_zero(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_not_sent_twice(self):
+        send_expiry_warnings(sender=None)
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_not_sent_for_order_already_past_deadline(self):
+        self.order.expires = now() - timedelta(hours=1)
+        self.order.save()
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_skips_orders_that_do_not_expire(self):
+        self._create_order('PAID', status=Order.STATUS_PAID)
+        self._create_order('VALID', valid_if_pending=True)
+        self._create_order('APPR', require_approval=True)
+        cancelled = self._create_order('CANC')
+        OrderFee.objects.create(order=cancelled, fee_type=OrderFee.FEE_TYPE_CANCELLATION, value=Decimal('1.00'))
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+        assert 'FOO' in djmail.outbox[0].subject
+
+    @classscope(attr='o')
+    def test_skipped_when_provider_prevents_reminder(self):
+        OrderPayment.objects.create(
+            order=self.order, provider='testdummy', amount=self.order.total,
+            state=OrderPayment.PAYMENT_STATE_CREATED, local_id=1,
+        )
+        with mocker_context() as mocker:
+            prevent = mocker.patch.object(DummyPaymentProvider, 'prevent_reminder_mail', return_value=True)
+            send_expiry_warnings(sender=None)
+        assert prevent.called
+        assert len(djmail.outbox) == 0
+        self.order.refresh_from_db()
+        assert not self.order.expiry_reminder_sent
+
+    @classscope(attr='o')
+    def test_sent_if_provider_unavailable_for_event(self):
+        # The provider is not registered for this event, so there is nothing to ask: the reminder is still sent.
+        OrderPayment.objects.create(
+            order=self.order, provider='banktransfer', amount=self.order.total,
+            state=OrderPayment.PAYMENT_STATE_CREATED, local_id=1,
+        )
+        send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_sent_if_one_open_provider_allows_reminder(self):
+        OrderPayment.objects.create(
+            order=self.order, provider='testdummy', amount=self.order.total,
+            state=OrderPayment.PAYMENT_STATE_CREATED, local_id=1,
+        )
+        OrderPayment.objects.create(
+            order=self.order, provider='testdummy', amount=self.order.total,
+            state=OrderPayment.PAYMENT_STATE_PENDING, local_id=2,
+        )
+        with mocker_context() as mocker:
+            mocker.patch.object(DummyPaymentProvider, 'prevent_reminder_mail', side_effect=[True, False])
+            send_expiry_warnings(sender=None)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_failed_send_is_retried_on_next_run(self):
+        other = self._create_order('BAR')
+        with mocker_context() as mocker:
+            mocker.patch.object(Order, 'send_mail', side_effect=[Exception('smtp down'), None])
+            send_expiry_warnings(sender=None)
+        self.order.refresh_from_db()
+        other.refresh_from_db()
+        # Exactly one of the two failed; the failure must not leave the flag set, and must not stop the other order.
+        assert sorted([self.order.expiry_reminder_sent, other.expiry_reminder_sent]) == [False, True]
+
+        send_expiry_warnings(sender=None)
+        self.order.refresh_from_db()
+        other.refresh_from_db()
+        assert self.order.expiry_reminder_sent
+        assert other.expiry_reminder_sent
+        assert len(djmail.outbox) == 1
+
