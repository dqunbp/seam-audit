+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    # Mirrors the filter of expire_orders: orders that will never expire (valid_if_pending, awaiting approval,
+    # cancellation fee) must not get a "your order is about to expire" mail.
+    qs = Order.objects.filter(
+        status=Order.STATUS_PENDING,
+        valid_if_pending=False,
+        require_approval=False,
+        expiry_reminder_sent=False,
+        expires__gt=now(),
+    ).exclude(
+        Exists(
+            OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        )
+    ).prefetch_related('event').order_by('event_id')
+
+    event_id = None
+    days = None
+    for o in qs:
+        if o.event_id != event_id:
+            days = o.event.settings.get('mail_days_order_expire_warning', as_type=int)
+            event_id = o.event_id
+        if not days or now() < o.expires - timedelta(days=days):
+            continue
+
+        try:
+            _send_expiry_warning(o)
+        except Exception:
+            # The transaction was rolled back, so the flag is still unset and the order is retried on the next run.
+            # Logging and continuing keeps one broken order from blocking the others.
+            logger.exception('Could not send expiry warning for order %s', o.code)
+
+
+def _send_expiry_warning(order):
+    with transaction.atomic():
+        # Re-read under a row lock: the order may have been paid, expired or already warned since the query ran.
+        order = Order.objects.select_for_update(of=OF_SELF).get(pk=order.pk)
+        if order.expiry_reminder_sent or order.status != Order.STATUS_PENDING or order.expires <= now():
+            return
+
+        open_payments = list(order.payments.filter(
+            state__in=(OrderPayment.PAYMENT_STATE_CREATED, OrderPayment.PAYMENT_STATE_PENDING),
+        ))
+        # payment_provider is None if the provider is no longer enabled for the event; we cannot ask it, so we don't opt out.
+        if open_payments and all(
+            p.payment_provider is not None and p.payment_provider.prevent_reminder_mail(order, p)
+            for p in open_payments
+        ):
+            # Not flagged, so this is re-evaluated on each run and a reminder is still possible if the customer
+            # switches to a payment method that does not opt out.
+            return
+
+        order.expiry_reminder_sent = True
+        order.save(update_fields=['expiry_reminder_sent'])
+        with language(order.locale, order.event.settings.region):
+            email_template = order.event.settings.mail_text_order_expire_warning
+            email_subject = order.event.settings.mail_subject_order_expire_warning
+            email_context = get_email_context(event=order.event, order=order)
+            order.send_mail(
+                email_subject, email_template, email_context,
+                'pretix.event.order.email.expire_warning_sent',
+            )
+
+
