+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    qs = Order.objects.filter(
+        expires__gt=now(),
+        status=Order.STATUS_PENDING,
+        expiry_reminder_sent=False,
+        valid_if_pending=False,
+        require_approval=False,
+    ).exclude(
+        Exists(
+            OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+        )
+    ).select_related('event').order_by('event_id')
+    days = None
+    event_id = None
+    for o in qs:
+        if o.event_id != event_id:
+            days = o.event.settings.get('mail_days_order_expire_warning', as_type=int)
+            event_id = o.event_id
+        if not days or now() < o.expires - timedelta(days=days):
+            continue
+
+        # Claim the reminder before sending, so that two concurrent runs cannot both send it.
+        if not Order.objects.filter(pk=o.pk, expiry_reminder_sent=False).update(expiry_reminder_sent=True):
+            continue
+        try:
+            with language(o.locale, o.event.settings.region):
+                email_template = o.event.settings.mail_text_order_expire_warning
+                email_context = get_email_context(event=o.event, order=o)
+                email_subject = o.event.settings.mail_subject_order_expire_warning
+                o.send_mail(
+                    email_subject, email_template, email_context,
+                    'pretix.event.order.email.expire_warning_sent'
+                )
+        except Exception:
+            # Release the claim so that the next run retries this order.
+            Order.objects.filter(pk=o.pk).update(expiry_reminder_sent=False)
+            logger.exception('Error sending expiry warning for order %s', o.code)
+
