+def _create_pending_order(event, code, **kwargs):
+    defaults = dict(
+        status=Order.STATUS_PENDING, locale='en', email='dummy@dummy.test',
+        datetime=now(), expires=now() + timedelta(days=2), total=12,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+    defaults.update(kwargs)
+    return Order.objects.create(code=code, event=event, **defaults)
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _create_pending_order(event, 'EW1')
+    djmail.outbox = []
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 1
+    assert 'EW1' in djmail.outbox[0].subject
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_before_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _create_pending_order(event, 'EW2', expires=now() + timedelta(days=10))
+    djmail.outbox = []
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+
+
