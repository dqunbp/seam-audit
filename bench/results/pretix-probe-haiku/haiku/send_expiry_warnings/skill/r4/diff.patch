+@pytest.mark.django_db
+def test_expiry_warning_uses_payment_term_deadline(event):
+    # The deadline is pushed out by the payment term delay, so the order is not yet inside the window
+    event.settings.mail_days_order_expire_warning = 3
+    event.settings.payment_term_expire_delay_days = 5
+    o = _create_pending_order(event, 'EW5', expires=now() + timedelta(days=2))
+    djmail.outbox = []
+    send_expiry_warnings(None)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
