+@pytest.mark.django_db
+def test_expiry_warning_skips_paid_and_unapprovable_orders(event):
+    djmail.outbox = []
+    event.settings.mail_days_order_expire_warning = 3
+    paid = _create_pending_order(event, code='PAI', status=Order.STATUS_PAID)
+    valid_if_pending = _create_pending_order(event, code='VIP', valid_if_pending=True)
+    needs_approval = _create_pending_order(event, code='APP', require_approval=True)
+
+    send_expiry_warnings(None)
+
+    for o in (paid, valid_if_pending, needs_approval):
+        o.refresh_from_db()
+        assert not o.expiry_reminder_sent
+    assert len(djmail.outbox) == 0
