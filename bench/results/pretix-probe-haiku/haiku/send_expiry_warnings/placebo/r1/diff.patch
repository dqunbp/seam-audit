+def _make_expiry_warning_order(event, expires, status=Order.STATUS_PENDING, **kwargs):
+    return Order.objects.create(
+        code=kwargs.pop('code', 'EXP1'), event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=expires,
+        total=Decimal('12.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs,
+    )
+
