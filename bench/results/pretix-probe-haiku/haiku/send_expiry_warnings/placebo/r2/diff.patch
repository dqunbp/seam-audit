+def _create_pending_order(event, code, expires, status=Order.STATUS_PENDING):
+    return Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=expires,
+        total=12,
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+    )
+
+
+def _expiry_warning_log_count(order):
+    return order.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').count()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    o = _create_pending_order(event, 'FO1', now() + timedelta(days=2))
+
+    send_expiry_warnings(None)
+
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent
+    assert _expiry_warning_log_count(o) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_before_window(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    o = _create_pending_order(event, 'FO1', now() + timedelta(days=10))
+
+    send_expiry_warnings(None)
+
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+    assert _expiry_warning_log_count(o) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_disabled_if_zero_days(event):
+    event.settings.set('mail_days_order_expire_warning', 0)
+    o = _create_pending_order(event, 'FO1', now() + timedelta(days=2))
+
+    send_expiry_warnings(None)
+
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+    assert _expiry_warning_log_count(o) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_uses_payment_term_expire_date(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    event.settings.set('payment_term_expire_delay_days', 10)
+    # The order's own expiry is inside the window, but the actual payment deadline is not
+    o = _create_pending_order(event, 'FO1', now() + timedelta(days=1))
+
+    send_expiry_warnings(None)
+
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+    assert _expiry_warning_log_count(o) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_only_once(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    o = _create_pending_order(event, 'FO1', now() + timedelta(days=2))
+
+    send_expiry_warnings(None)
+    send_expiry_warnings(None)
+
+    assert _expiry_warning_log_count(o) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_skips_paid_and_expired_orders(event):
+    event.settings.set('mail_days_order_expire_warning', 3)
+    paid = _create_pending_order(event, 'FO1', now() + timedelta(days=2), status=Order.STATUS_PAID)
+    past_deadline = _create_pending_order(event, 'FO2', now() - timedelta(days=1))
+
+    send_expiry_warnings(None)
+
+    paid.refresh_from_db()
+    past_deadline.refresh_from_db()
+    assert not paid.expiry_reminder_sent
+    assert not past_deadline.expiry_reminder_sent
+    assert _expiry_warning_log_count(paid) == 0
+    assert _expiry_warning_log_count(past_deadline) == 0
+
+
