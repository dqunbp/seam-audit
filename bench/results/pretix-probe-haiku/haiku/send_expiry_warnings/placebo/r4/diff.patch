+def _create_expiry_warning_order(event, expires, status=Order.STATUS_PENDING, code='FOO', **kwargs):
+    return Order.objects.create(
+        code=code, event=event, email='dummy@dummy.test',
+        status=status, locale='en',
+        datetime=now(), expires=expires,
+        total=Decimal('46.00'),
+        sales_channel=event.organizer.sales_channels.get(identifier="web"),
+        **kwargs
+    )
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_within_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _create_expiry_warning_order(event, expires=now() + timedelta(days=2))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+    assert djmail.outbox[0].to == ['dummy@dummy.test']
+    o.refresh_from_db()
+    assert o.expiry_reminder_sent
+    assert o.all_logentries().filter(action_type='pretix.event.order.email.expire_warning_sent').exists()
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_outside_window(event):
+    event.settings.mail_days_order_expire_warning = 3
+    o = _create_expiry_warning_order(event, expires=now() + timedelta(days=10))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+    o.refresh_from_db()
+    assert not o.expiry_reminder_sent
+
+
+@pytest.mark.django_db
+def test_expiry_warning_disabled_with_zero_days(event):
+    event.settings.mail_days_order_expire_warning = 0
+    _create_expiry_warning_order(event, expires=now() + timedelta(days=1))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_sent_only_once(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _create_expiry_warning_order(event, expires=now() + timedelta(days=2))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 1
+
+
+@pytest.mark.django_db
+def test_expiry_warning_not_sent_after_deadline(event):
+    event.settings.mail_days_order_expire_warning = 3
+    _create_expiry_warning_order(event, expires=now() - timedelta(hours=1))
+    djmail.outbox = []
+    send_expiry_warnings(sender=event)
+    assert len(djmail.outbox) == 0
+
+
+@pytest.mark.django_db
+def test_expiry_warning_uses_payment_term_expire_date(event):
+    event.settings.mail_days_order_expire_warning = 3
+    event.settings.payment_term_expire_delay_days = 4
+    event.settings.payment_term_weekdays = False
