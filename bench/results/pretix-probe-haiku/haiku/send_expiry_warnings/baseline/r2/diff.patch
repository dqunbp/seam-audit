+@receiver(signal=periodic_task)
+@scopes_disabled()
+def send_expiry_warnings(sender, **kwargs):
+    events = Event.objects.filter(
+        Exists(Order.objects.filter(
+            event_id=OuterRef('pk'),
+            status=Order.STATUS_PENDING,
+            valid_if_pending=False,
+            require_approval=False,
+        ))
+    ).order_by()
+    warning_sent = LogEntry.objects.filter(
+        content_type=ContentType.objects.get_for_model(Order),
+        object_id=OuterRef('pk'),
+        action_type='pretix.event.order.email.expire_warning_sent',
+    )
+
+    for event in events.iterator(chunk_size=10_000):
+        days = event.settings.get('mail_days_order_expire_warning', as_type=int)
+        if not days or not event.settings.get('payment_term_expire_automatically', as_type=bool):
+            continue
+
+        qs = event.orders.filter(
+            status=Order.STATUS_PENDING,
+            valid_if_pending=False,
+            require_approval=False,
+            expires__lte=now() + timedelta(days=days),
+        ).exclude(
+            Exists(warning_sent)
+        ).exclude(
+            Exists(
+                OrderFee.objects.filter(order_id=OuterRef('pk'), fee_type=OrderFee.FEE_TYPE_CANCELLATION)
+            )
+        ).order_by()
+
+        for o in qs:
+            # The deadline is the point at which the order is actually expired by ``expire_orders``. ``expires``
+            # is always a lower bound for it, so the query above is only a cheap pre-filter.
+            if not now() < o.payment_term_expire_date <= now() + timedelta(days=days):
+                continue
+
+            with transaction.atomic():
+                # Lock the order and re-check, so concurrent runs of the periodic task don't send twice.
+                o = Order.objects.select_for_update(of=OF_SELF).exclude(
+                    Exists(warning_sent)
+                ).filter(pk=o.pk, status=Order.STATUS_PENDING).first()
+                if not o:
+                    continue
+
+                with language(o.locale, event.settings.region):
+                    email_template = event.settings.mail_text_order_expire_warning
+                    email_subject = event.settings.mail_subject_order_expire_warning
+                    email_context = get_email_context(event=event, order=o)
+                    o.send_mail(
+                        email_subject, email_template, email_context,
+                        'pretix.event.order.email.expire_warning_sent',
+                    )
+
+
