+class ExpiryWarningTests(TestCase):
+    def setUp(self):
+        super().setUp()
+        self.o = Organizer.objects.create(name='Dummy', slug='dummy')
+        with scope(organizer=self.o):
+            self.event = Event.objects.create(
+                organizer=self.o, name='Dummy', slug='dummy',
+                date_from=now() + timedelta(days=30),
+                plugins='pretix.plugins.banktransfer,tests.testdummy'
+            )
+            self.event.settings.payment_term_expire_automatically = True
+            self.event.settings.mail_days_order_expire_warning = 3
+            djmail.outbox = []
+
+    def _create_order(self, code, expires, **kwargs):
+        kwargs.setdefault('status', Order.STATUS_PENDING)
+        return Order.objects.create(
+            code=code, event=self.event, email='dummy@dummy.test',
+            locale='en', datetime=now(), expires=expires, total=Decimal('46.00'),
+            sales_channel=self.event.organizer.sales_channels.get(identifier="web"),
+            **kwargs
+        )
+
+    @classscope(attr='o')
+    def test_sends_warning_within_window(self):
+        self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+        assert djmail.outbox[0].to == ['dummy@dummy.test']
+
+    @classscope(attr='o')
+    def test_does_not_send_outside_window(self):
+        self._create_order('FOO', now() + timedelta(days=10))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_sends_only_once(self):
+        self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+    @classscope(attr='o')
+    def test_disabled_if_days_is_zero(self):
+        self.event.settings.mail_days_order_expire_warning = 0
+        self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_disabled_if_auto_expiry_disabled(self):
+        self.event.settings.payment_term_expire_automatically = False
+        self._create_order('FOO', now() + timedelta(days=2))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_skips_paid_and_already_expired_orders(self):
+        self._create_order('FOO', now() + timedelta(days=2), status=Order.STATUS_PAID)
+        self._create_order('FO2', now() - timedelta(days=1))
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_skips_orders_that_do_not_expire_or_need_approval(self):
+        self._create_order('FOO', now() + timedelta(days=2), valid_if_pending=True)
+        self._create_order('FO2', now() + timedelta(days=2), require_approval=True)
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+    @classscope(attr='o')
+    def test_uses_payment_deadline_including_delay(self):
+        self.event.settings.payment_term_expire_delay_days = 5
+        self._create_order('FOO', now() + timedelta(days=1))
+
+        # The deadline is about 6 days away, so a 3 day warning period is too early ...
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 0
+
+        # ... but a 7 day warning period is inside it.
+        self.event.settings.mail_days_order_expire_warning = 7
+        send_expiry_warnings(sender=self.event)
+        assert len(djmail.outbox) == 1
+
+
